[
  {"id": "LEGACY-CONTROL-FLOW", "pattern": "\\*ngIf=|\\*ngFor=|\\*ngSwitchCase|\\[ngSwitch\\]", "globs": ["*.html", "*.ts"], "severity_hint": "Info", "description": "Legacy structural directive; a finding only when @if/@for also exist in the repo (mixing) or on v17+ with no migration plan", "reference": "angular.dev/reference/migrations/control-flow"},
  {"id": "NGFOR-NO-TRACKBY", "pattern": "\\*ngFor=\"(?![^\"]*trackBy)[^\"]*\"", "globs": ["*.html", "*.ts"], "severity_hint": "Low", "description": "*ngFor without trackBy re-creates DOM rows on every change", "reference": "angular.dev/api/common/NgForOf"},
  {"id": "NGMODULE-DECLARATIONS", "pattern": "^\\s*declarations\\s*:\\s*\\[", "globs": ["*.ts"], "severity_hint": "Info", "description": "NgModule with declarations - legacy component model when standalone components also exist", "reference": "angular.dev/reference/migrations/standalone"},
  {"id": "STANDALONE-FALSE", "pattern": "standalone\\s*:\\s*false", "globs": ["*.ts"], "severity_hint": "Low", "description": "Component explicitly opts out of standalone", "reference": "angular.dev/reference/migrations/standalone"},
  {"id": "CD-DEFAULT-EXPLICIT", "pattern": "ChangeDetectionStrategy\\.Default", "globs": ["*.ts"], "severity_hint": "Low", "description": "Explicit Default change detection; check whether this component renders lists", "reference": "angular.dev/best-practices/skipping-subtrees"},
  {"id": "DETECT-CHANGES-CALL", "pattern": "\\.detectChanges\\(\\)|ApplicationRef\\.tick\\(\\)", "globs": ["*.ts"], "severity_hint": "Info", "description": "Manual change detection; a smell when used in loops or timers", "reference": "angular.dev/best-practices/skipping-subtrees"},
  {"id": "TS-IGNORE", "pattern": "@ts-ignore|@ts-nocheck|@ts-expect-error", "globs": ["*.ts"], "severity_hint": "Low", "description": "Type checking suppressed", "reference": "CWE-1078"},
  {"id": "ANY-TYPE", "pattern": ":\\s*any\\b|\\bas\\s+any\\b|<any>", "globs": ["*.ts"], "severity_hint": "Info", "description": "any escapes strict typing; count per file, report hot spots only", "reference": "CWE-1078"},
  {"id": "LEGACY-STRING-LOADCHILDREN", "pattern": "loadChildren\\s*:\\s*['\"]", "globs": ["*.ts"], "severity_hint": "Medium", "description": "String loadChildren syntax (removed in Angular 9) - build will not lazy-load it", "reference": "angular.dev/guide/routing"},
  {"id": "DEPRECATED-API", "pattern": "ComponentFactoryResolver|ReflectiveInjector|@angular/flex-layout|\\bHttpModule\\b|entryComponents|rxjs-compat|from ['\"]rxjs/Rx['\"]|enableIvy\\s*:\\s*false", "globs": ["*.ts", "*.json"], "severity_hint": "Medium", "description": "Removed or deprecated Angular/RxJS API", "reference": "angular.dev/reference/releases"},
  {"id": "NGMODEL-IN-REACTIVE-FORM", "pattern": "\\[\\(ngModel\\)\\][^>]*formControlName|formControlName[^>]*\\[\\(ngModel\\)\\]", "globs": ["*.html"], "severity_hint": "Medium", "description": "ngModel mixed with reactive forms on one control (deprecated since v6)", "reference": "angular.dev/guide/forms/reactive-forms"},
  {"id": "FULL-LIB-IMPORT", "pattern": "from\\s+['\"](lodash|moment|rxjs/Rx|@angular/material|underscore)['\"]", "globs": ["*.ts"], "severity_hint": "Low", "description": "Whole-library import defeats tree shaking (use lodash-es/deep paths, date-fns/luxon, material entry points)", "reference": "angular.dev/tools/cli/build#configuring-size-budgets"},
  {"id": "PROD-SOURCEMAP-TRUE", "pattern": "\"sourceMap\"\\s*:\\s*true", "globs": ["angular.json", "project.json"], "severity_hint": "Medium", "description": "Source maps enabled in a build configuration; confirm it is the production one", "reference": "CWE-540"},
  {"id": "PROD-OPTIMIZATION-FALSE", "pattern": "\"optimization\"\\s*:\\s*false", "globs": ["angular.json", "project.json"], "severity_hint": "High", "description": "Optimization disabled in a build configuration; confirm it is not production", "reference": "ASVS-14.3.2"},
  {"id": "WEBPACK-BUILDER", "pattern": "@angular-devkit/build-angular:browser\"", "globs": ["angular.json", "project.json"], "severity_hint": "Low", "description": "Legacy webpack builder on a project that could use the esbuild application builder", "reference": "angular.dev/tools/cli/build-system-migration"},
  {"id": "INPUT-DECORATOR-MIX", "pattern": "@Input\\(\\)|@Output\\(\\)", "globs": ["*.ts"], "severity_hint": "Info", "description": "Decorator inputs; only a mixing finding when input()/output() signals are also used in the repo", "reference": "angular.dev/guide/components/inputs"}
]
