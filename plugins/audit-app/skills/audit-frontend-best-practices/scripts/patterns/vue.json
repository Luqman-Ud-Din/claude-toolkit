[
  {"id": "VUE2-GLOBAL-API", "pattern": "new Vue\\(|Vue\\.extend\\(|Vue\\.component\\(|Vue\\.use\\(|Vue\\.prototype\\.|Vue\\.config\\.productionTip", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Vue 2 global API (Vue 2 is end-of-life)", "reference": "CWE-1104"},
  {"id": "VUE2-INSTANCE-API", "pattern": "this\\.\\$set\\(|this\\.\\$delete\\(|\\$listeners|\\$scopedSlots|\\$children\\b", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Medium", "description": "Removed Vue 2 instance API", "reference": "v3-migration.vuejs.org/breaking-changes"},
  {"id": "SYNC-MODIFIER", "pattern": "\\.sync=", "globs": ["*.vue", "*.html"], "severity_hint": "Medium", "description": ".sync modifier removed in Vue 3 (use v-model:prop)", "reference": "v3-migration.vuejs.org/breaking-changes/v-model"},
  {"id": "FILTERS-OPTION", "pattern": "^\\s*filters\\s*:\\s*\\{", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "filters option removed in Vue 3", "reference": "v3-migration.vuejs.org/breaking-changes/filters"},
  {"id": "MIXINS", "pattern": "mixins\\s*:\\s*\\[", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Info", "description": "Mixins; a mixing finding when composables are also used", "reference": "vuejs.org/guide/reusability/composables"},
  {"id": "VFOR-NO-KEY", "pattern": "<\\w[^>]*\\sv-for=(?![^>]*(:key|v-bind:key))[^>]*>", "globs": ["*.vue", "*.html"], "severity_hint": "Low", "description": "v-for without :key", "reference": "vuejs.org/style-guide/rules-essential#use-keyed-v-for"},
  {"id": "INDEX-KEY", "pattern": ":key=\"\\s*(index|i|idx)\\s*\"", "globs": ["*.vue", "*.html"], "severity_hint": "Low", "description": "Index used as key on a list; wrong if the list is mutable", "reference": "vuejs.org/guide/essentials/list#maintaining-state-with-key"},
  {"id": "VIF-WITH-VFOR", "pattern": "v-if=[^>]*v-for=|v-for=[^>]*v-if=", "globs": ["*.vue", "*.html"], "severity_hint": "Low", "description": "v-if and v-for on the same element (precedence changed in Vue 3)", "reference": "vuejs.org/style-guide/rules-essential#avoid-v-if-with-v-for"},
  {"id": "TS-IGNORE", "pattern": "@ts-ignore|@ts-nocheck|@ts-expect-error", "globs": ["*.ts", "*.vue"], "severity_hint": "Low", "description": "Type checking suppressed", "reference": "CWE-1078"},
  {"id": "ANY-TYPE", "pattern": ":\\s*any\\b|\\bas\\s+any\\b|defineProps<any>", "globs": ["*.ts", "*.vue"], "severity_hint": "Info", "description": "any escapes strict typing; report hot spots only", "reference": "CWE-1078"},
  {"id": "UNTYPED-PROPS", "pattern": "props\\s*:\\s*\\[", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Low", "description": "Props declared as a string array - no types or validation", "reference": "vuejs.org/guide/components/props#prop-validation"},
  {"id": "FULL-LIB-IMPORT", "pattern": "from\\s+['\"](lodash|moment|underscore|element-plus|vuetify)['\"]", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Low", "description": "Whole-library import defeats tree shaking (use unplugin-vue-components / deep imports)", "reference": "vitejs.dev/guide/performance"},
  {"id": "PROD-SOURCEMAP-TRUE", "pattern": "sourcemap\\s*:\\s*true|productionSourceMap\\s*:\\s*true|client\\s*:\\s*true", "globs": ["vite.config.*", "vue.config.*", "nuxt.config.*"], "severity_hint": "Medium", "description": "Source maps enabled for the client build", "reference": "CWE-540"},
  {"id": "MINIFY-FALSE", "pattern": "minify\\s*:\\s*false", "globs": ["vite.config.*", "nuxt.config.*"], "severity_hint": "High", "description": "Minification disabled", "reference": "ASVS-14.3.2"},
  {"id": "VUE-CLI-PLATFORM", "pattern": "\"@vue/cli-service\"\\s*:", "globs": ["package.json"], "severity_hint": "Low", "description": "Vue CLI is in maintenance mode; migrate to Vite", "reference": "CWE-1104"}
]
