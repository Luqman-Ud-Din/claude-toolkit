[
  {"id": "CLASS-COMPONENT", "pattern": "extends\\s+(React\\.)?(Pure)?Component\\b|createReactClass\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Info", "description": "Class component; error boundaries are the accepted exception", "reference": "react.dev/reference/react/Component"},
  {"id": "UNSAFE-LIFECYCLE", "pattern": "componentWillMount|componentWillReceiveProps|componentWillUpdate|UNSAFE_component", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Deprecated lifecycle method", "reference": "react.dev/reference/react/legacy"},
  {"id": "LEGACY-ROOT-API", "pattern": "ReactDOM\\.render\\(|ReactDOM\\.hydrate\\(|findDOMNode\\(|React\\.createFactory", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Legacy React 17 root/API on React 18+", "reference": "react.dev/blog/2022/03/08/react-18-upgrade-guide"},
  {"id": "STRING-REF", "pattern": "\\sref=\"[A-Za-z_]+\"", "globs": ["*.jsx", "*.tsx"], "severity_hint": "Low", "description": "String ref (removed in React 19)", "reference": "react.dev/reference/react/legacy"},
  {"id": "PROPTYPES-IN-TS", "pattern": "from\\s+['\"]prop-types['\"]", "globs": ["*.tsx", "*.ts"], "severity_hint": "Info", "description": "PropTypes alongside TypeScript - duplicate typing", "reference": "react.dev/reference/react/Component#static-proptypes"},
  {"id": "INDEX-KEY", "pattern": "key=\\{\\s*(index|i|idx|key)\\s*\\}", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Array index used as key; wrong on mutable/reorderable lists", "reference": "react.dev/learn/rendering-lists#why-does-react-need-keys"},
  {"id": "TS-IGNORE", "pattern": "@ts-ignore|@ts-nocheck|@ts-expect-error", "globs": ["*.ts", "*.tsx"], "severity_hint": "Low", "description": "Type checking suppressed", "reference": "CWE-1078"},
  {"id": "ANY-TYPE", "pattern": ":\\s*any\\b|\\bas\\s+any\\b|<any>|React\\.FC<any>", "globs": ["*.ts", "*.tsx"], "severity_hint": "Info", "description": "any escapes strict typing; report hot spots only", "reference": "CWE-1078"},
  {"id": "FULL-LIB-IMPORT", "pattern": "from\\s+['\"](lodash|moment|underscore)['\"]", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Whole-library import defeats tree shaking", "reference": "vitejs.dev/guide/performance"},
  {"id": "PROD-SOURCEMAP-TRUE", "pattern": "sourcemap\\s*:\\s*true|productionBrowserSourceMaps\\s*:\\s*true|GENERATE_SOURCEMAP\\s*=\\s*true", "globs": ["vite.config.*", "next.config.*", ".env.production", ".env"], "severity_hint": "Medium", "description": "Source maps enabled for the browser build", "reference": "CWE-540"},
  {"id": "MINIFY-FALSE", "pattern": "minify\\s*:\\s*false|swcMinify\\s*:\\s*false", "globs": ["vite.config.*", "next.config.*"], "severity_hint": "High", "description": "Minification disabled", "reference": "ASVS-14.3.2"},
  {"id": "CRA-PLATFORM", "pattern": "\"react-scripts\"\\s*:", "globs": ["package.json"], "severity_hint": "Medium", "description": "Create React App is unmaintained; migrate to Vite/Next", "reference": "CWE-1104"},
  {"id": "DERIVED-STATE-EFFECT", "pattern": "useEffect\\(\\(\\)\\s*=>\\s*\\{?\\s*set[A-Z]\\w*\\(", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Effect that only sets state from props/state - derive during render instead", "reference": "react.dev/learn/you-might-not-need-an-effect"}
]
