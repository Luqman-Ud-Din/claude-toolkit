[
  {"id": "HARDCODED-TOAST", "pattern": "\\b(toast|notify|notification|message|enqueueSnackbar|showToast|Swal\\.fire|alertDialog)(\\.\\w+)?\\(\\s*['\"`][A-Za-z][^'\"`]{2,}['\"`]", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Medium", "description": "User-facing message literal in code, not routed through t()", "reference": "i18n"},
  {"id": "WINDOW-ALERT-LITERAL", "pattern": "\\b(alert|confirm|prompt)\\(\\s*['\"`][A-Za-z]", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Medium", "description": "Native dialog with a hard-coded string", "reference": "i18n"},
  {"id": "VALIDATION-MESSAGE-LITERAL", "pattern": "(message|errorMessage|required_error|invalid_type_error)\\s*[:=]\\s*['\"`][A-Z][a-z]+\\s|\\.(min|max|email|nonempty|regex|refine|url|length)\\([^)]*,\\s*['\"`][A-Z][a-z]+\\s", "globs": ["*.ts", "*.tsx"], "severity_hint": "Low", "description": "Zod/Yup/react-hook-form message literal in code", "reference": "i18n"},
  {"id": "DATE-NO-LOCALE", "pattern": "toLocale(Date|Time)?String\\(\\s*\\)", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Medium", "description": "Locale-sensitive formatting without an explicit locale", "reference": "i18n"},
  {"id": "DATE-FIXED-PATTERN", "pattern": "moment\\([^)]*\\)\\.format\\(|dayjs\\([^)]*\\)\\.format\\(|\\bformat\\([^,)]*,\\s*['\"](dd|DD|MM|yyyy|YYYY)", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Fixed date pattern instead of Intl.DateTimeFormat with the locale", "reference": "i18n"},
  {"id": "TOFIXED-MONEY", "pattern": "\\.toFixed\\(\\s*[0-4]\\s*\\)", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Number formatted with toFixed: wrong separators outside en", "reference": "i18n"},
  {"id": "CURRENCY-CONCAT", "pattern": "['\"`](\\$|€|£|₹|Rs\\.?|PKR|SAR|AED|USD)\\s*['\"`]\\s*\\+|\\+\\s*['\"`]\\s*(\\$|€|£|₹|Rs\\.?|PKR|SAR|AED|USD)['\"`]|`(\\$|€|£|Rs\\.?)\\$\\{|>\\s*(\\$|€|£|Rs\\.?)\\s*\\{", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Medium", "description": "Currency symbol concatenated by hand; use Intl.NumberFormat style currency", "reference": "i18n"},
  {"id": "PLURAL-CONCAT", "pattern": "\\+\\s*['\"] ?(items?|records?|rows?|products?|orders?|users?|files?|days?|minutes?|results?)['\"]|\\$\\{\\w+\\}\\s+(items?|records?|rows?|products?|orders?|results?)\\b|===?\\s*1\\s*\\?\\s*['\"][a-z]*['\"]\\s*:\\s*['\"][a-z]*s['\"]|\\}\\s+(items?|records?|rows?|results?)\\s*<", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Medium", "description": "Plural built by concatenation or a binary ternary; use i18next count / ICU plural", "reference": "i18n"},
  {"id": "HARDCODED-LOCALE", "pattern": "Intl\\.\\w+\\(\\s*['\"]en-(US|GB)['\"]|toLocale\\w+\\(\\s*['\"]en-(US|GB)['\"]", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Locale hard-coded to en-US/en-GB", "reference": "i18n"},
  {"id": "SENTENCE-CONCAT-TRANSLATE", "pattern": "\\bt\\([^)]*\\)\\s*\\+\\s*['\"`]|['\"`]\\s*\\+\\s*t\\(", "globs": ["*.tsx", "*.ts", "*.jsx"], "severity_hint": "Low", "description": "Translated fragment concatenated into a sentence", "reference": "i18n"},
  {"id": "DIR-LTR-HARDCODED", "pattern": "\\bdir=[\"']ltr[\"']", "globs": ["*.tsx", "*.jsx", "*.html"], "severity_hint": "Low", "description": "Text direction hard-coded; set from the active locale", "reference": "i18n"},
  {"id": "TAILWIND-PHYSICAL", "pattern": "className=[\"'`][^\"'`]*\\b(ml|mr|pl|pr|left|right|text-left|text-right|rounded-l|rounded-r|border-l|border-r)-", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Physical Tailwind utilities; use ms-/me-/ps-/pe-/start-/end-/text-start for RTL", "reference": "i18n"},
  {"id": "OUTLINE-NONE-TW", "pattern": "outline-none(?![^\"'`]*(focus-visible:|focus:ring|focus:outline))", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Medium", "description": "Focus outline removed with no visible replacement", "reference": "WCAG-2.4.7"},
  {"id": "POSITIVE-TABINDEX", "pattern": "tabIndex=\\{?[\"']?[1-9]", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Medium", "description": "Positive tabIndex overrides natural focus order", "reference": "WCAG-2.4.3"},
  {"id": "AUTOCOMPLETE-OFF-PASSWORD", "pattern": "type=[\"']password[\"'][^>]*autoComplete=[\"']off[\"']|autoComplete=[\"']off[\"'][^>]*type=[\"']password[\"']", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Medium", "description": "Password managers blocked on a password field", "reference": "WCAG-3.3.8"},
  {"id": "PASTE-BLOCKED", "pattern": "onPaste=\\{[^}]*preventDefault", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Medium", "description": "Paste blocked on an input", "reference": "WCAG-3.3.8"},
  {"id": "AUTO-SUBMIT-ON-CHANGE", "pattern": "onChange=\\{[^}]*(submit|navigate|router\\.push|history\\.push)", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Changing a control submits or navigates (On Input)", "reference": "WCAG-3.2.2"},
  {"id": "NOWRAP-TRUNCATE", "pattern": "\\btruncate\\b|whitespace-nowrap|white-space\\s*:\\s*nowrap", "globs": ["*.tsx", "*.jsx", "*.css", "*.scss"], "severity_hint": "Info", "description": "Truncation on possibly translatable text; check text-expansion tolerance", "reference": "i18n"},
  {"id": "NO-LIVE-REGION-TOAST", "pattern": "className=[\"'][^\"']*(toast|snackbar|alert|notification)[^\"']*[\"'](?![^>]*(aria-live|role=))", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Toast/alert container without aria-live or role=status/alert", "reference": "WCAG-4.1.3"}
]
