[
  {"id": "USE-I18N-FALSE", "pattern": "^\\s*USE_I18N\\s*=\\s*False", "globs": ["settings*.py", "base.py", "production.py"], "severity_hint": "Medium", "description": "Translation machinery disabled", "reference": "i18n"},
  {"id": "MESSAGES-LITERAL", "pattern": "messages\\.(success|error|warning|info|add_message)\\(\\s*request\\s*,\\s*(f?['\"][A-Z]|constants\\.\\w+\\s*,\\s*f?['\"][A-Z])", "globs": ["*.py"], "severity_hint": "Medium", "description": "Flash message literal without gettext", "reference": "i18n"},
  {"id": "VALIDATION-ERROR-LITERAL", "pattern": "ValidationError\\(\\s*f?['\"][A-Z]", "globs": ["*.py"], "severity_hint": "Medium", "description": "ValidationError text without gettext", "reference": "i18n"},
  {"id": "FORM-LABEL-LITERAL", "pattern": "(label|help_text|verbose_name|empty_label|placeholder)\\s*=\\s*['\"][A-Z][a-z]", "globs": ["forms.py", "models.py", "admin.py", "serializers.py"], "severity_hint": "Low", "description": "Form/model label literal without gettext_lazy", "reference": "i18n"},
  {"id": "GETTEXT-FSTRING", "pattern": "\\b(_|gettext|gettext_lazy|ngettext)\\(\\s*f['\"]|\\b(_|gettext)\\(\\s*['\"][^'\"]*['\"]\\s*%", "globs": ["*.py"], "severity_hint": "Medium", "description": "String formatted before translation (untranslatable / wrong plural)", "reference": "i18n"},
  {"id": "STRFTIME-DISPLAY", "pattern": "\\.strftime\\(\\s*['\"][^'\"]*['\"]\\s*\\)", "globs": ["views.py", "serializers.py", "*.py"], "severity_hint": "Low", "description": "Date formatted with strftime; use the date filter / formats.date_format for display", "reference": "i18n"},
  {"id": "FLOAT-FORMAT-DISPLAY", "pattern": "['\"]%\\.\\df['\"]\\s*%|f['\"][^'\"]*:\\.\\df\\}", "globs": ["views.py", "serializers.py", "templatetags/*.py"], "severity_hint": "Low", "description": "Number formatted with % / f-string precision; use floatformat / localize", "reference": "i18n"},
  {"id": "PLURAL-CONCAT", "pattern": "f['\"]\\{\\w+\\}\\s+(items?|records?|rows?|products?|orders?|users?|files?|days?|results?)\\b|\\+\\s*['\"] ?(items?|records?|rows?|results?)['\"]", "globs": ["*.py"], "severity_hint": "Low", "description": "Plural built by formatting; use ngettext", "reference": "i18n"},
  {"id": "TEMPLATE-IMG-NO-ALT", "pattern": "<img(?![^>]*\\balt=)[^>]*>", "globs": ["*.html"], "severity_hint": "Medium", "description": "Image without alt in a Django template", "reference": "WCAG-1.1.1"},
  {"id": "TEMPLATE-HTML-NO-LANG", "pattern": "<html(?![^>]*\\blang=)[^>]*>", "globs": ["*.html"], "severity_hint": "Medium", "description": "html element without lang (use LANGUAGE_CODE)", "reference": "WCAG-3.1.1"},
  {"id": "TEMPLATE-DATE-FIXED", "pattern": "\\|date:\"[dmYjnNF/.\\- ]+\"", "globs": ["*.html"], "severity_hint": "Info", "description": "Fixed date pattern; use SHORT_DATE_FORMAT / DATE_FORMAT", "reference": "i18n"},
  {"id": "TEMPLATE-ERRORS-NO-ALERT", "pattern": "\\.errors\\s*\\}\\}(?![^<]*role=)", "globs": ["*.html"], "severity_hint": "Low", "description": "Field errors rendered without role=alert / aria-describedby", "reference": "WCAG-3.3.1"}
]
