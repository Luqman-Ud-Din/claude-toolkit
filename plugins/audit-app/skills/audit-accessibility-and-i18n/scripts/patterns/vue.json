[
  {"id": "HARDCODED-TOAST", "pattern": "\\b(ElMessage|ElNotification|ElMessageBox\\.\\w+|\\$message|\\$notify|\\$toast|toast|notify|\\$q\\.notify|\\$q\\.dialog|Notify\\.create|useToast\\(\\)\\.\\w+)(\\.\\w+)?\\(\\s*\\{?\\s*(message\\s*:\\s*)?['\"`][A-Za-z][^'\"`]{2,}['\"`]", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "User-facing message literal in code, not routed through t()", "reference": "i18n"},
  {"id": "WINDOW-ALERT-LITERAL", "pattern": "\\b(alert|confirm|prompt)\\(\\s*['\"`][A-Za-z]", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Native dialog with a hard-coded string", "reference": "i18n"},
  {"id": "VALIDATION-MESSAGE-LITERAL", "pattern": "(message|errorMessage|trigger\\s*:\\s*['\"]blur['\"],\\s*message)\\s*[:=]\\s*['\"`][A-Z][a-z]+\\s|\\.(min|max|email|required|regex|refine)\\([^)]*['\"`][A-Z][a-z]+\\s", "globs": ["*.vue", "*.ts"], "severity_hint": "Low", "description": "Validation message literal (Element/Vuelidate/Zod/Yup) in code", "reference": "i18n"},
  {"id": "DATE-NO-LOCALE", "pattern": "toLocale(Date|Time)?String\\(\\s*\\)", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Locale-sensitive formatting without an explicit locale", "reference": "i18n"},
  {"id": "DATE-FIXED-PATTERN", "pattern": "moment\\([^)]*\\)\\.format\\(|dayjs\\([^)]*\\)\\.format\\(|\\bformat\\([^,)]*,\\s*['\"](dd|DD|MM|yyyy|YYYY)", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Low", "description": "Fixed date pattern instead of $d / Intl.DateTimeFormat with the locale", "reference": "i18n"},
  {"id": "TOFIXED-MONEY", "pattern": "\\.toFixed\\(\\s*[0-4]\\s*\\)", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Low", "description": "Number formatted with toFixed: wrong separators outside en", "reference": "i18n"},
  {"id": "CURRENCY-CONCAT", "pattern": "['\"`](\\$|€|£|₹|Rs\\.?|PKR|SAR|AED|USD)\\s*['\"`]\\s*\\+|\\+\\s*['\"`]\\s*(\\$|€|£|₹|Rs\\.?|PKR|SAR|AED|USD)['\"`]|>\\s*(\\$|€|£|Rs\\.?)\\s*\\{\\{", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Currency symbol concatenated by hand; use $n(value, 'currency')", "reference": "i18n"},
  {"id": "PLURAL-CONCAT", "pattern": "\\+\\s*['\"] ?(items?|records?|rows?|products?|orders?|users?|files?|days?|minutes?|results?)['\"]|\\}\\}\\s*(items?|records?|rows?|products?|orders?|results?)\\b|===?\\s*1\\s*\\?\\s*['\"][a-z]*['\"]\\s*:\\s*['\"][a-z]*s['\"]", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Plural built by concatenation or a binary ternary; use vue-i18n plural forms", "reference": "i18n"},
  {"id": "TC-DEPRECATED", "pattern": "\\$tc\\(", "globs": ["*.vue", "*.ts"], "severity_hint": "Info", "description": "$tc is deprecated in vue-i18n v9+; use t(key, count)", "reference": "i18n"},
  {"id": "HARDCODED-LOCALE", "pattern": "Intl\\.\\w+\\(\\s*['\"]en-(US|GB)['\"]|toLocale\\w+\\(\\s*['\"]en-(US|GB)['\"]|locale\\s*:\\s*['\"]en-(US|GB)['\"]", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Low", "description": "Locale hard-coded to en-US/en-GB", "reference": "i18n"},
  {"id": "SENTENCE-CONCAT-TRANSLATE", "pattern": "\\$?t\\([^)]*\\)\\s*\\+\\s*['\"`]|['\"`]\\s*\\+\\s*\\$?t\\(", "globs": ["*.vue", "*.ts"], "severity_hint": "Low", "description": "Translated fragment concatenated into a sentence", "reference": "i18n"},
  {"id": "DIR-LTR-HARDCODED", "pattern": "\\bdir=\"ltr\"", "globs": ["*.vue", "*.html"], "severity_hint": "Low", "description": "Text direction hard-coded; bind :dir from the active locale", "reference": "i18n"},
  {"id": "POSITIVE-TABINDEX", "pattern": "tabindex=\"[1-9]", "globs": ["*.vue", "*.html"], "severity_hint": "Medium", "description": "Positive tabindex overrides natural focus order", "reference": "WCAG-2.4.3"},
  {"id": "AUTOCOMPLETE-OFF-PASSWORD", "pattern": "type=\"password\"[^>]*autocomplete=\"off\"|autocomplete=\"off\"[^>]*type=\"password\"", "globs": ["*.vue", "*.html"], "severity_hint": "Medium", "description": "Password managers blocked on a password field", "reference": "WCAG-3.3.8"},
  {"id": "PASTE-BLOCKED", "pattern": "@paste\\.prevent|@paste=\"[^\"]*preventDefault", "globs": ["*.vue"], "severity_hint": "Medium", "description": "Paste blocked on an input", "reference": "WCAG-3.3.8"},
  {"id": "AUTO-SUBMIT-ON-CHANGE", "pattern": "@change=\"[^\"]*(submit|save|navigate|router\\.push)", "globs": ["*.vue"], "severity_hint": "Low", "description": "Changing a control submits or navigates (On Input)", "reference": "WCAG-3.2.2"},
  {"id": "NOWRAP-HIDDEN", "pattern": "white-space\\s*:\\s*nowrap|text-overflow\\s*:\\s*ellipsis", "globs": ["*.vue", "*.scss", "*.css", "*.less"], "severity_hint": "Info", "description": "Truncation on possibly translatable text; check text-expansion tolerance", "reference": "i18n"},
  {"id": "NO-LIVE-REGION-TOAST", "pattern": "<(div|span)[^>]*class=\"[^\"]*(toast|snackbar|alert|notification)[^\"]*\"(?![^>]*(aria-live|role=))", "globs": ["*.vue"], "severity_hint": "Low", "description": "Toast/alert container without aria-live or role=status/alert", "reference": "WCAG-4.1.3"}
]
