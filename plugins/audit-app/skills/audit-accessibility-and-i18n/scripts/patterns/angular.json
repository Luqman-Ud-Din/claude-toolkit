[
  {"id": "HARDCODED-TOAST", "pattern": "\\b(toast|toastr|snackBar|snackbar|notification|notify|message|messageService|alertCtrl|alertController|dialog)\\w*\\.(show|open|success|error|info|warning|warn|create|present|confirm)\\(\\s*['\"][A-Za-z][^'\"]{2,}['\"]", "globs": ["*.ts"], "severity_hint": "Medium", "description": "User-facing message literal in code, not routed through the translation service", "reference": "i18n"},
  {"id": "WINDOW-ALERT-LITERAL", "pattern": "\\b(alert|confirm|prompt)\\(\\s*['\"][A-Za-z]", "globs": ["*.ts"], "severity_hint": "Medium", "description": "Native dialog with a hard-coded string (also blocks screen-reader-friendly dialogs)", "reference": "i18n"},
  {"id": "VALIDATION-MESSAGE-LITERAL", "pattern": "(message|errorMessage|errorText|hint)\\s*[:=]\\s*['\"][A-Z][a-z]+\\s", "globs": ["*.ts"], "severity_hint": "Low", "description": "Validation/help text literal in code", "reference": "i18n"},
  {"id": "DATE-NO-LOCALE", "pattern": "toLocale(Date|Time)?String\\(\\s*\\)", "globs": ["*.ts", "*.html"], "severity_hint": "Medium", "description": "Locale-sensitive formatting without an explicit locale (uses the browser default, not the app locale)", "reference": "i18n"},
  {"id": "DATE-FIXED-PATTERN", "pattern": "\\|\\s*date\\s*:\\s*['\"](dd|d|MM|M|yyyy|yy)[^'\"]*['\"]|moment\\([^)]*\\)\\.format\\(|dayjs\\([^)]*\\)\\.format\\(|formatDate\\([^,]*,\\s*['\"](dd|MM|yyyy)", "globs": ["*.ts", "*.html"], "severity_hint": "Low", "description": "Fixed date pattern instead of a locale format name (shortDate/mediumDate)", "reference": "i18n"},
  {"id": "TOFIXED-MONEY", "pattern": "\\.toFixed\\(\\s*[0-4]\\s*\\)", "globs": ["*.ts", "*.html"], "severity_hint": "Low", "description": "Number formatted with toFixed: wrong decimal separator and grouping outside en", "reference": "i18n"},
  {"id": "CURRENCY-CONCAT", "pattern": "['\"](\\$|€|£|₹|Rs\\.?|PKR|SAR|AED|USD)\\s*['\"]\\s*\\+|\\+\\s*['\"]\\s*(\\$|€|£|₹|Rs\\.?|PKR|SAR|AED|USD)['\"]|>\\s*(\\$|€|£|Rs\\.?)\\s*\\{\\{", "globs": ["*.ts", "*.html"], "severity_hint": "Medium", "description": "Currency symbol concatenated by hand; use the currency pipe with the currency code", "reference": "i18n"},
  {"id": "PLURAL-CONCAT", "pattern": "\\+\\s*['\"] ?(items?|records?|rows?|products?|orders?|users?|files?|days?|minutes?|hours?|results?|errors?)['\"]|\\}\\}\\s*(items?|records?|rows?|products?|orders?|results?)\\b|===?\\s*1\\s*\\?\\s*['\"][a-z]+['\"]\\s*:\\s*['\"][a-z]+s['\"]", "globs": ["*.ts", "*.html"], "severity_hint": "Medium", "description": "Plural built by concatenation or a binary ternary; use ICU plural", "reference": "i18n"},
  {"id": "HARDCODED-LOCALE", "pattern": "(Intl\\.\\w+|formatDate|formatNumber|formatCurrency|toLocale\\w+|registerLocaleData|LOCALE_ID[^\\n]*useValue)\\([^)]*['\"]en-(US|GB)['\"]|useValue\\s*:\\s*['\"]en-(US|GB)['\"]", "globs": ["*.ts"], "severity_hint": "Low", "description": "Locale hard-coded to en-US/en-GB", "reference": "i18n"},
  {"id": "SENTENCE-CONCAT-TRANSLATE", "pattern": "\\.instant\\([^)]*\\)\\s*\\+\\s*['\"]|['\"]\\s*\\+\\s*this\\.translate\\.instant\\(", "globs": ["*.ts"], "severity_hint": "Low", "description": "Translated fragment concatenated into a sentence (word order breaks in other languages)", "reference": "i18n"},
  {"id": "DIR-LTR-HARDCODED", "pattern": "\\bdir=\"ltr\"", "globs": ["*.html"], "severity_hint": "Low", "description": "Text direction hard-coded; bind from the active locale", "reference": "i18n"},
  {"id": "POSITIVE-TABINDEX", "pattern": "tabindex=\"[1-9]", "globs": ["*.html", "*.ts"], "severity_hint": "Medium", "description": "Positive tabindex overrides natural focus order", "reference": "WCAG-2.4.3"},
  {"id": "AUTOCOMPLETE-OFF-PASSWORD", "pattern": "type=\"password\"[^>]*autocomplete=\"off\"|autocomplete=\"off\"[^>]*type=\"password\"", "globs": ["*.html"], "severity_hint": "Medium", "description": "Password managers blocked on a password field", "reference": "WCAG-3.3.8"},
  {"id": "PASTE-BLOCKED", "pattern": "\\(paste\\)=\"[^\"]*preventDefault|onpaste=\"return false\"", "globs": ["*.html"], "severity_hint": "Medium", "description": "Paste blocked on an input (accessible authentication / redundant entry)", "reference": "WCAG-3.3.8"},
  {"id": "COLOR-ONLY-STATUS", "pattern": "\\[class\\.(red|green|danger|success|warning|error)\\]=|\\[ngClass\\]=\"\\{\\s*['\"]?(text-)?(red|green|danger|success)", "globs": ["*.html"], "severity_hint": "Low", "description": "Status conveyed by a colour class; confirm text or icon accompanies it", "reference": "WCAG-1.4.1"},
  {"id": "AUTO-SUBMIT-ON-CHANGE", "pattern": "\\((change|ngModelChange|selectionChange)\\)=\"[^\"]*(submit|save|navigate|router)", "globs": ["*.html"], "severity_hint": "Low", "description": "Changing a control submits or navigates (On Input)", "reference": "WCAG-3.2.2"},
  {"id": "NOWRAP-HIDDEN", "pattern": "white-space\\s*:\\s*nowrap|text-overflow\\s*:\\s*ellipsis", "globs": ["*.scss", "*.css", "*.less"], "severity_hint": "Info", "description": "Truncation on possibly translatable text; check text-expansion tolerance", "reference": "i18n"},
  {"id": "FIXED-WIDTH-PX", "pattern": "^\\s*(width|max-width|height)\\s*:\\s*\\d{2,3}px", "globs": ["*.scss", "*.css", "*.less"], "severity_hint": "Info", "description": "Fixed pixel width/height; buttons and labels need room for longer translations", "reference": "i18n"},
  {"id": "NO-LIVE-REGION-TOAST", "pattern": "<(div|span)[^>]*class=\"[^\"]*(toast|snackbar|alert|notification)[^\"]*\"(?![^>]*(aria-live|role=))", "globs": ["*.html"], "severity_hint": "Low", "description": "Toast/alert container without aria-live or role=status/alert", "reference": "WCAG-4.1.3"}
]
