[
  {"id": "ANNOTATION-MESSAGE-LITERAL", "pattern": "ErrorMessage\\s*=\\s*\"[A-Z][a-z]", "globs": ["*.cs"], "severity_hint": "Medium", "description": "DataAnnotations error message literal; use ErrorMessageResourceType/Name or IStringLocalizer", "reference": "i18n"},
  {"id": "API-MESSAGE-LITERAL", "pattern": "(BadRequest|NotFound|Conflict|Unauthorized|Forbid|Problem|StatusCode)\\(\\s*(\\d+\\s*,\\s*)?\\$?\"[A-Z][a-z]+\\s", "globs": ["*.cs"], "severity_hint": "Low", "description": "API error sentence in English; return a code/key the client can translate", "reference": "i18n"},
  {"id": "DISPLAY-FORMAT-FIXED", "pattern": "\\.ToString\\(\\s*\"(dd|d|MM|M|yyyy|yy|N[0-9]|C[0-9]|F[0-9]|#,##)[^\"]*\"\\s*\\)", "globs": ["*.cs", "*.cshtml", "*.razor"], "severity_hint": "Low", "description": "Fixed display format with the server culture; format in the client or pass CultureInfo", "reference": "i18n"},
  {"id": "CULTURE-HARDCODED", "pattern": "new CultureInfo\\(\\s*\"en-(US|GB)\"\\s*\\)|CurrentCulture\\s*=\\s*new CultureInfo|CurrentUICulture\\s*=\\s*new CultureInfo|DefaultThreadCurrentCulture\\s*=", "globs": ["*.cs"], "severity_hint": "Low", "description": "Culture set globally in code instead of RequestLocalization", "reference": "i18n"},
  {"id": "PARSE-WITHOUT-CULTURE", "pattern": "\\b(decimal|double|float|int|DateTime)\\.(Parse|TryParse)\\(\\s*[^,)]+\\s*\\)", "globs": ["*.cs"], "severity_hint": "Low", "description": "Numeric/date parse without a culture; user input in comma-decimal locales fails", "reference": "i18n"},
  {"id": "PLURAL-INTERPOLATION", "pattern": "\\$\"\\{\\w+\\}\\s+(items?|records?|rows?|products?|orders?|users?|files?|days?|results?)\\b", "globs": ["*.cs"], "severity_hint": "Low", "description": "Plural built by interpolation", "reference": "i18n"},
  {"id": "NO-REQUEST-LOCALIZATION", "pattern": "AddLocalization\\((?![\\s\\S]*UseRequestLocalization)", "globs": ["Program.cs", "Startup.cs"], "severity_hint": "Info", "description": "Localization registered; confirm UseRequestLocalization is in the pipeline (single-line heuristic)", "reference": "i18n"},
  {"id": "RAZOR-IMG-NO-ALT", "pattern": "<img(?![^>]*\\balt=)[^>]*>", "globs": ["*.cshtml", "*.razor"], "severity_hint": "Medium", "description": "Image without alt in a server-rendered view", "reference": "WCAG-1.1.1"},
  {"id": "RAZOR-HTML-NO-LANG", "pattern": "<html(?![^>]*\\blang=)[^>]*>", "globs": ["*.cshtml", "*.razor"], "severity_hint": "Medium", "description": "html element without lang", "reference": "WCAG-3.1.1"},
  {"id": "RAZOR-VALIDATION-NO-ALERT", "pattern": "asp-validation-(for|summary)=\"[^\"]*\"(?![^>]*role=)", "globs": ["*.cshtml"], "severity_hint": "Low", "description": "Validation message element without role=alert/aria-live", "reference": "WCAG-3.3.1"},
  {"id": "RAZOR-LITERAL-TEXT-LABEL", "pattern": "<label[^>]*>\\s*[A-Z][a-z]+[^<@{]*<", "globs": ["*.cshtml", "*.razor"], "severity_hint": "Low", "description": "Label text literal instead of @Localizer", "reference": "i18n"}
]
