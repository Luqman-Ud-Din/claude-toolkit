[
  {"id": "API-MESSAGE-LITERAL", "pattern": "new (BadRequestException|NotFoundException|ForbiddenException|UnauthorizedException|ConflictException|HttpException|UnprocessableEntityException)\\(\\s*['\"`][A-Z][a-z]+\\s|res\\.status\\(\\d+\\)\\.(send|json)\\(\\s*['\"`][A-Z][a-z]+\\s|\\.send\\(\\s*['\"`][A-Z][a-z]+\\s", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Error sentence in English surfaced to clients; return a code/key", "reference": "i18n"},
  {"id": "VALIDATION-MESSAGE-LITERAL", "pattern": "message\\s*:\\s*['\"`][A-Z][a-z]+\\s|\\.(min|max|email|required|regex|pattern|refine|nonempty)\\([^)]*['\"`][A-Z][a-z]+\\s|\\.messages\\(\\s*\\{[^}]*['\"`][A-Z][a-z]+\\s", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Joi/Zod/class-validator message literal in server code", "reference": "i18n"},
  {"id": "DATE-NO-LOCALE", "pattern": "toLocale(Date|Time)?String\\(\\s*\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Server-side locale formatting with the process default locale", "reference": "i18n"},
  {"id": "DATE-FIXED-PATTERN-API", "pattern": "moment\\([^)]*\\)\\.format\\(|dayjs\\([^)]*\\)\\.format\\(|date-fns['\"]\\)?;?[\\s\\S]{0,200}format\\([^,]*,\\s*['\"](dd|DD|MM|yyyy)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Date pre-formatted on the server; send ISO strings and format in the client", "reference": "i18n"},
  {"id": "TOFIXED-MONEY", "pattern": "\\.toFixed\\(\\s*[0-4]\\s*\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Amount formatted with toFixed on the server", "reference": "i18n"},
  {"id": "PLURAL-CONCAT", "pattern": "\\+\\s*['\"] ?(items?|records?|rows?|products?|orders?|users?|files?|days?|results?)['\"]|\\$\\{\\w+\\}\\s+(items?|records?|rows?|results?)\\b", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Plural built by concatenation", "reference": "i18n"},
  {"id": "MOMENT-LOCALE-GLOBAL", "pattern": "moment\\.locale\\(\\s*['\"]\\w+['\"]\\s*\\)|dayjs\\.locale\\(\\s*['\"]\\w+['\"]\\s*\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Global locale set for the whole process", "reference": "i18n"},
  {"id": "TEMPLATE-IMG-NO-ALT", "pattern": "<img(?![^>]*\\balt=)[^>]*>", "globs": ["*.ejs", "*.hbs", "*.handlebars", "*.html"], "severity_hint": "Medium", "description": "Image without alt in a server template", "reference": "WCAG-1.1.1"},
  {"id": "TEMPLATE-HTML-NO-LANG", "pattern": "<html(?![^>]*\\blang=)[^>]*>", "globs": ["*.ejs", "*.hbs", "*.handlebars", "*.html"], "severity_hint": "Medium", "description": "html element without lang", "reference": "WCAG-3.1.1"},
  {"id": "NO-ACCEPT-LANGUAGE", "pattern": "i18next\\.init\\((?![\\s\\S]*LanguageDetector)", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "i18next initialized; confirm a language detector / Accept-Language middleware is used (single-line heuristic)", "reference": "i18n"}
]
