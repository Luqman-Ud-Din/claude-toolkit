[
  {"id": "ANNOTATION-MESSAGE-LITERAL", "pattern": "message\\s*=\\s*\"[A-Z][a-z]+\\s", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Bean Validation message literal; use {key} resolved via MessageSource", "reference": "i18n"},
  {"id": "API-MESSAGE-LITERAL", "pattern": "(badRequest|notFound|status\\([^)]*\\))\\(\\)\\.body\\(\\s*\"[A-Z][a-z]+\\s|new (ResponseStatusException|IllegalArgumentException|IllegalStateException)\\([^,)]*\"[A-Z][a-z]+\\s", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Error sentence in English surfaced to clients; return a code/key", "reference": "i18n"},
  {"id": "SIMPLEDATEFORMAT-NO-LOCALE", "pattern": "new SimpleDateFormat\\(\\s*\"[^\"]*\"\\s*\\)|DateTimeFormatter\\.ofPattern\\(\\s*\"[^\"]*\"\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Date pattern without a Locale (JVM default); fine for machine formats, wrong for display", "reference": "i18n"},
  {"id": "STRING-FORMAT-NUMBER", "pattern": "String\\.format\\(\\s*\"[^\"]*%[,.\\d]*[fd]", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Number formatted with String.format and the default locale", "reference": "i18n"},
  {"id": "NUMBERFORMAT-DEFAULT", "pattern": "NumberFormat\\.(getInstance|getCurrencyInstance|getNumberInstance)\\(\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "NumberFormat with the JVM default locale", "reference": "i18n"},
  {"id": "LOCALE-SET-DEFAULT", "pattern": "Locale\\.setDefault\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Global locale set in code instead of per-request LocaleResolver", "reference": "i18n"},
  {"id": "JSONFORMAT-DISPLAY-PATTERN", "pattern": "@JsonFormat\\([^)]*pattern\\s*=\\s*\"(dd|MM|yyyy)[^\"]*\"", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "API date pre-formatted with a display pattern; send ISO-8601", "reference": "i18n"},
  {"id": "PLURAL-CONCAT", "pattern": "\\+\\s*\" ?(items?|records?|rows?|products?|orders?|users?|files?|days?|results?)\"", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Plural built by concatenation", "reference": "i18n"},
  {"id": "THYMELEAF-IMG-NO-ALT", "pattern": "<img(?![^>]*\\b(alt|th:alt)=)[^>]*>", "globs": ["*.html"], "severity_hint": "Medium", "description": "Image without alt in a Thymeleaf template", "reference": "WCAG-1.1.1"},
  {"id": "THYMELEAF-HTML-NO-LANG", "pattern": "<html(?![^>]*\\b(lang|th:lang)=)[^>]*>", "globs": ["*.html"], "severity_hint": "Medium", "description": "html element without lang", "reference": "WCAG-3.1.1"},
  {"id": "THYMELEAF-LITERAL-TEXT", "pattern": "th:text=\"'[A-Z][a-z]+", "globs": ["*.html"], "severity_hint": "Low", "description": "th:text with a literal string instead of #{key}", "reference": "i18n"},
  {"id": "THYMELEAF-ERRORS-NO-ALERT", "pattern": "th:errors=\"[^\"]*\"(?![^>]*role=)", "globs": ["*.html"], "severity_hint": "Low", "description": "Validation error element without role=alert", "reference": "WCAG-3.3.1"}
]
