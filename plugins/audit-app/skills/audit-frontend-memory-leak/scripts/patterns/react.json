[
  {"id": "EFFECT-LISTENER", "pattern": "addEventListener\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Listener added; leak unless the enclosing effect returns a cleanup that removes the same handler (leak_scan.py pairs these)", "reference": "CWE-401"},
  {"id": "EFFECT-TIMER", "pattern": "setInterval\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Interval started; leak unless cleared in the effect cleanup", "reference": "CWE-401"},
  {"id": "STORE-SUBSCRIBE-DISCARDED", "pattern": "^\\s*(store|useStore|api|query)\\.subscribe\\(|^\\s*onAuthStateChanged\\(|^\\s*onSnapshot\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Subscription function called as a statement: the returned unsubscribe is discarded", "reference": "CWE-401"},
  {"id": "ROUTER-EVENTS-ON", "pattern": "router\\.events\\.on\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Next.js router event handler; confirm router.events.off in cleanup", "reference": "nextjs.org/docs/pages/api-reference/functions/use-router#routerevents"},
  {"id": "EVENT-BUS-ON", "pattern": "\\b(emitter|bus|eventBus|mitt|events)\\.on\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Event bus handler; confirm .off in cleanup", "reference": "CWE-401"},
  {"id": "SET-MAX-LISTENERS-ZERO", "pattern": "setMaxListeners\\(\\s*0\\s*\\)", "globs": ["*.ts", "*.js", "*.tsx"], "severity_hint": "Low", "description": "Listener-leak warning silenced", "reference": "nodejs.org/api/events.html#emittersetmaxlistenersn"},
  {"id": "WINDOW-GLOBAL-WRITE", "pattern": "\\(window as any\\)\\.\\w+\\s*=|\\bwindow\\.__\\w+\\s*=", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "State attached to window survives navigation", "reference": "CWE-401"},
  {"id": "MODULE-LEVEL-CACHE", "pattern": "^(const|let|var)\\s+\\w*(cache|store|registry|map|list|history|buffer)\\w*\\s*[:=].*(new Map|new Set|\\[\\]|\\{\\})", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Module-level collection; leak if written per render/route without a cap", "reference": "CWE-400"},
  {"id": "CONTEXT-REGISTER", "pattern": "(register|addListener|subscribe)\\w*\\s*[:=]\\s*(\\(|function)", "globs": ["*Context.tsx", "*Provider.tsx", "*.context.tsx"], "severity_hint": "Medium", "description": "Provider exposes a register function; confirm an unregister path", "reference": "CWE-401"},
  {"id": "CLASS-DIDMOUNT", "pattern": "componentDidMount\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Info", "description": "Class lifecycle; pair every acquisition with componentWillUnmount", "reference": "react.dev/reference/react/Component#componentwillunmount"},
  {"id": "SUBSCRIBE-IN-EFFECT", "pattern": "\\.subscribe\\(", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Medium", "description": "Observable subscribed in a component; confirm unsubscribe in cleanup", "reference": "CWE-401"}
]
