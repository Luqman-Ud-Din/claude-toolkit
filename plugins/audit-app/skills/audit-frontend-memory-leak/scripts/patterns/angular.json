[
  {"id": "BARE-SUBSCRIBE", "pattern": "\\.subscribe\\(", "globs": ["*.component.ts", "*.directive.ts", "*.page.ts"], "severity_hint": "Medium", "description": "subscribe in a component/directive; leak unless the chain has takeUntil/takeUntilDestroyed/first/take(1) or the Subscription is unsubscribed in ngOnDestroy (leak_scan.py pairs these)", "reference": "CWE-401"},
  {"id": "SHAREREPLAY-NO-REFCOUNT", "pattern": "shareReplay\\(\\s*\\d*\\s*\\)", "globs": ["*.ts"], "severity_hint": "Low", "description": "shareReplay without { refCount: true } keeps the source alive after the last subscriber leaves", "reference": "rxjs.dev/api/operators/shareReplay"},
  {"id": "UNBOUNDED-REPLAYSUBJECT", "pattern": "new ReplaySubject(<[^>]*>)?\\(\\s*\\)", "globs": ["*.ts"], "severity_hint": "Medium", "description": "ReplaySubject with no buffer size retains every emission", "reference": "CWE-400"},
  {"id": "RENDERER-LISTEN-DISCARDED", "pattern": "^\\s*(this\\.)?renderer2?\\.listen\\(", "globs": ["*.ts"], "severity_hint": "Medium", "description": "Renderer2.listen return value (the unlisten function) discarded", "reference": "angular.dev/api/core/Renderer2#listen"},
  {"id": "SERVICE-KEEPS-REFS", "pattern": "(listeners|callbacks|handlers|components|subscribers|registry|instances)\\.(push|set|add)\\(", "globs": ["*.service.ts", "*.store.ts"], "severity_hint": "High", "description": "Service collection that grows per registration; verify a remove/delete path exists", "reference": "CWE-401"},
  {"id": "WINDOW-GLOBAL-WRITE", "pattern": "\\(window as any\\)\\.\\w+\\s*=|\\bwindow\\.\\w+\\s*=\\s*(this|new |\\[|\\{)", "globs": ["*.ts"], "severity_hint": "Medium", "description": "Component/service state attached to window survives navigation", "reference": "CWE-401"},
  {"id": "MODULE-LEVEL-CACHE", "pattern": "^(const|let|var)\\s+\\w*(cache|store|registry|map|list|history|buffer)\\w*\\s*[:=].*(new Map|new Set|\\[\\]|\\{\\})", "globs": ["*.ts"], "severity_hint": "Low", "description": "Module-level collection; leak if written per navigation without a cap", "reference": "CWE-400"},
  {"id": "CREATE-COMPONENT-DYNAMIC", "pattern": "\\.createComponent\\(|createEmbeddedView\\(", "globs": ["*.ts"], "severity_hint": "Low", "description": "Dynamic component/view created; confirm destroy() or clear() on teardown", "reference": "angular.dev/api/core/ViewContainerRef"},
  {"id": "EMPTY-NGONDESTROY", "pattern": "ngOnDestroy\\(\\)\\s*(:\\s*void)?\\s*\\{\\s*\\}", "globs": ["*.ts"], "severity_hint": "Info", "description": "Empty ngOnDestroy: teardown intended but not implemented", "reference": "CWE-401"},
  {"id": "IONIC-ENTER-WITHOUT-LEAVE", "pattern": "ionViewDidEnter\\(|ionViewWillEnter\\(", "globs": ["*.page.ts", "*.component.ts"], "severity_hint": "Info", "description": "Ionic enter hook; acquisitions here must be released in ionViewWillLeave, not ngOnDestroy (outlet caches pages)", "reference": "ionicframework.com/docs/angular/lifecycle"},
  {"id": "HUB-ON-WITHOUT-OFF", "pattern": "(hubConnection|connection|hub)\\.on\\(\\s*['\"]", "globs": ["*.component.ts", "*.page.ts"], "severity_hint": "High", "description": "SignalR handler registered in a component; confirm .off() on destroy", "reference": "learn.microsoft.com/aspnet/core/signalr/javascript-client"}
]
