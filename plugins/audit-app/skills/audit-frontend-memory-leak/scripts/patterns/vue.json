[
  {"id": "MOUNTED-LISTENER", "pattern": "addEventListener\\(", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Listener added; leak unless removed in onUnmounted/onBeforeUnmount/onScopeDispose (leak_scan.py pairs these)", "reference": "CWE-401"},
  {"id": "MOUNTED-TIMER", "pattern": "setInterval\\(", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Interval started; leak unless cleared on unmount", "reference": "CWE-401"},
  {"id": "WATCH-OUTSIDE-SETUP", "pattern": "^\\s*watch(Effect)?\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "watch/watchEffect in a plain module or store (not inside setup): the stop handle must be called manually", "reference": "vuejs.org/api/reactivity-core.html#watch"},
  {"id": "PINIA-SUBSCRIBE-DISCARDED", "pattern": "^\\s*\\w+\\.\\$(subscribe|onAction)\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "$subscribe/$onAction called as a statement outside a component: unsubscribe discarded", "reference": "pinia.vuejs.org/core-concepts/state.html#subscribing-to-the-state"},
  {"id": "EVENT-BUS-ON", "pattern": "\\b(emitter|bus|eventBus|mitt|events)\\.on\\(", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Event bus handler; confirm .off on unmount", "reference": "CWE-401"},
  {"id": "ROUTER-GUARD-IN-COMPONENT", "pattern": "router\\.(beforeEach|afterEach|beforeResolve)\\(", "globs": ["*.vue"], "severity_hint": "Medium", "description": "Global router guard registered from a component; the returned unregister function must be called on unmount", "reference": "router.vuejs.org/guide/advanced/navigation-guards.html"},
  {"id": "WIDGET-NOT-MARKRAW", "pattern": "=\\s*new\\s+(Chart|Quill|Swiper|Sortable)\\(|=\\s*(echarts\\.init|L\\.map|monaco\\.editor\\.create)\\(", "globs": ["*.vue", "*.ts"], "severity_hint": "Low", "description": "Widget instance assigned; if it lands in a ref()/reactive() without markRaw, Vue proxies and retains it", "reference": "vuejs.org/api/reactivity-advanced.html#markraw"},
  {"id": "KEEPALIVE-ACTIVATED", "pattern": "onActivated\\(|\\bactivated\\s*\\(", "globs": ["*.vue", "*.ts"], "severity_hint": "Info", "description": "KeepAlive hook; acquisitions here must be released in onDeactivated, not onUnmounted", "reference": "vuejs.org/guide/built-ins/keep-alive.html"},
  {"id": "STORE-ARRAY-PUSH", "pattern": "^\\s*(this\\.)?(state\\.)?\\w*(history|notifications|messages|log|events|cache)\\w*\\.push\\(", "globs": ["*.store.ts", "stores/*.ts", "*.ts"], "severity_hint": "Medium", "description": "Store array appended; confirm a cap or removal (grows per navigation/message)", "reference": "CWE-400"},
  {"id": "GLOBAL-PROPERTY-WRITE", "pattern": "globalProperties\\.\\$?\\w+\\s*=|\\bwindow\\.__\\w+\\s*=", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Low", "description": "State attached to app/window globals survives navigation", "reference": "CWE-401"},
  {"id": "SUBSCRIBE-IN-COMPONENT", "pattern": "\\.subscribe\\(", "globs": ["*.vue"], "severity_hint": "Medium", "description": "Observable subscribed in a component; confirm unsubscribe on unmount (or use VueUse useObservable)", "reference": "CWE-401"}
]
