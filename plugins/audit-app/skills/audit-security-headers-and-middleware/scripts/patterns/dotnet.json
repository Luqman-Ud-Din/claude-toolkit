[
  {"id": "ORDER-ENDPOINTS-BEFORE-AUTH", "pattern": "app\\.(MapControllers|UseEndpoints|MapRazorPages|MapGet|MapPost|UseMvc)\\s*\\(", "globs": ["Program.cs", "Startup.cs"], "severity_hint": "Info", "description": "Endpoint registration - compare its line with UseAuthentication/UseAuthorization (extract_middleware.py does this)", "reference": "CWE-306"},
  {"id": "ORDER-AUTH-CALL", "pattern": "app\\.Use(Authentication|Authorization)\\s*\\(", "globs": ["Program.cs", "Startup.cs", "*Extensions.cs"], "severity_hint": "Info", "description": "Auth middleware registration line", "reference": "CWE-306"},
  {"id": "ERRORS-DEV-PAGE", "pattern": "UseDeveloperExceptionPage\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Developer exception page - must be inside an IsDevelopment() guard", "reference": "CWE-209"},
  {"id": "HEADERS-HSTS-SHORT", "pattern": "MaxAge\\s*=\\s*TimeSpan\\.From(Days|Hours|Minutes)\\s*\\(\\s*([0-9]|[1-9][0-9]|1[0-7][0-9])\\s*\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "HSTS MaxAge shorter than 180 days", "reference": "CWE-319"},
  {"id": "HEADERS-CUSTOM-SET", "pattern": "Headers\\.(Append|Add|TryAdd)\\s*\\(\\s*\"(Content-Security-Policy|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy|Strict-Transport-Security)|Headers\\[\\s*\"(Content-Security-Policy|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)\"\\s*\\]\\s*=", "globs": ["*.cs"], "severity_hint": "Info", "description": "Security header set by hand - collect the full set and values", "reference": "CWE-693"},
  {"id": "HEADERS-CSP-UNSAFE", "pattern": "Content-Security-Policy[^;\\n]*('unsafe-inline'|'unsafe-eval'|script-src[^;]*\\*)", "globs": ["*.cs", "*.json", "web.config"], "severity_hint": "Medium", "description": "CSP allows unsafe-inline/unsafe-eval or any script host", "reference": "CWE-693"},
  {"id": "HEADERS-SERVER-HEADER", "pattern": "AddServerHeader\\s*=\\s*false", "globs": ["*.cs"], "severity_hint": "Info", "description": "Kestrel Server header suppressed (good) - absence means 'Server: Kestrel' is sent", "reference": "CWE-200"},
  {"id": "CORS-ANY-ORIGIN", "pattern": "AllowAnyOrigin\\s*\\(\\s*\\)|WithOrigins\\s*\\(\\s*\"\\*\"", "globs": ["*.cs"], "severity_hint": "Medium", "description": "CORS allows any origin - High if AllowCredentials() is also used", "reference": "CWE-942"},
  {"id": "CORS-REFLECT-WITH-CREDENTIALS", "pattern": "SetIsOriginAllowed\\s*\\(\\s*_?\\w*\\s*=>\\s*true\\s*\\)", "globs": ["*.cs"], "severity_hint": "High", "description": "Every origin accepted (works with AllowCredentials - reflected origin)", "reference": "CWE-942"},
  {"id": "CORS-CREDENTIALS", "pattern": "AllowCredentials\\s*\\(\\s*\\)", "globs": ["*.cs"], "severity_hint": "Info", "description": "CORS credentials enabled - origin list must be explicit", "reference": "CWE-942"},
  {"id": "COOKIE-APPEND", "pattern": "Response\\.Cookies\\.Append\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Cookie issued - CookieOptions must set HttpOnly, Secure, SameSite (defaults are false/false/unspecified)", "reference": "CWE-1004"},
  {"id": "COOKIE-HTTPONLY-FALSE", "pattern": "HttpOnly\\s*=\\s*false", "globs": ["*.cs"], "severity_hint": "High", "description": "Cookie explicitly readable by script", "reference": "CWE-1004"},
  {"id": "COOKIE-SECURE-OFF", "pattern": "Secure\\s*=\\s*false|SecurePolicy\\s*=\\s*CookieSecurePolicy\\.(None|SameAsRequest)", "globs": ["*.cs"], "severity_hint": "High", "description": "Cookie may be sent over plain HTTP", "reference": "CWE-614"},
  {"id": "COOKIE-SAMESITE-NONE", "pattern": "SameSite\\s*=\\s*SameSiteMode\\.None|MinimumSameSitePolicy\\s*=\\s*SameSiteMode\\.None", "globs": ["*.cs"], "severity_hint": "Medium", "description": "SameSite=None - requires Secure and a CSRF defence", "reference": "CWE-352"},
  {"id": "CSRF-COOKIE-AUTH", "pattern": "AddCookie\\s*\\(|AddIdentity\\s*<|AddDefaultIdentity\\s*<|AddSession\\s*\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "Cookie/session auth registered - CSRF protection required on state-changing routes", "reference": "CWE-352"},
  {"id": "CSRF-PROTECTION-PRESENT", "pattern": "ValidateAntiForgeryToken|AutoValidateAntiforgeryToken|UseAntiforgery\\s*\\(|AddAntiforgery\\s*\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "Anti-forgery in use (good) - check coverage", "reference": "CWE-352"},
  {"id": "CSRF-IGNORED", "pattern": "IgnoreAntiforgeryToken", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Anti-forgery explicitly disabled on an action", "reference": "CWE-352"},
  {"id": "RATELIMIT-PRESENT", "pattern": "AddRateLimiter\\s*\\(|UseRateLimiter\\s*\\(|UseIpRateLimiting\\s*\\(|EnableRateLimiting", "globs": ["*.cs"], "severity_hint": "Info", "description": "Rate limiting present - confirm login/OTP/reset endpoints are covered", "reference": "CWE-307"},
  {"id": "RATELIMIT-DISABLED", "pattern": "DisableRateLimiting", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Rate limiting disabled on an action - check it is not an auth endpoint", "reference": "CWE-307"},
  {"id": "RATELIMIT-AUTH-ENDPOINT", "pattern": "\\[Http(Post|Get)\\s*\\(\\s*\"[^\"]*(login|signin|register|signup|forgot|reset|otp|verify|resend|refresh)", "globs": ["*.cs"], "severity_hint": "Info", "description": "Auth-related endpoint - must carry [EnableRateLimiting] or a global limiter policy", "reference": "CWE-307"},
  {"id": "BODYLIMIT-UNBOUNDED", "pattern": "MaxRequestBodySize\\s*=\\s*(null|long\\.MaxValue|int\\.MaxValue)|DisableRequestSizeLimit|RequestSizeLimit\\s*\\(\\s*(long|int)\\.MaxValue|MultipartBodyLengthLimit\\s*=\\s*(long|int)\\.MaxValue|maxAllowedContentLength\\s*=\\s*\"4294967295\"", "globs": ["*.cs", "web.config"], "severity_hint": "Medium", "description": "Request body size limit removed", "reference": "CWE-400"},
  {"id": "BODYLIMIT-SET", "pattern": "MaxRequestBodySize\\s*=|RequestSizeLimit\\s*\\(|MultipartBodyLengthLimit\\s*=", "globs": ["*.cs"], "severity_hint": "Info", "description": "Body size limit configured - record the value", "reference": "CWE-400"},
  {"id": "HTTPS-HSTS-PRESENT", "pattern": "UseHsts\\s*\\(|UseHttpsRedirection\\s*\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "HTTPS/HSTS middleware present - check it is not inside an inverted environment guard", "reference": "CWE-319"},
  {"id": "PROXY-FORWARDED-HEADERS", "pattern": "UseForwardedHeaders\\s*\\(|ForwardedHeadersOptions", "globs": ["*.cs"], "severity_hint": "Info", "description": "Forwarded headers configured - needed behind a proxy for Secure cookies, HSTS and rate-limit IPs", "reference": "CWE-348"}
]
