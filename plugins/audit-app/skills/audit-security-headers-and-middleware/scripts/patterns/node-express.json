[
  {"id": "HEADERS-HELMET-PRESENT", "pattern": "helmet\\s*\\(|@fastify/helmet|fastifyHelmet", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "helmet in use - check options (CSP off? HSTS max-age?)", "reference": "CWE-693"},
  {"id": "HEADERS-CSP-OFF", "pattern": "contentSecurityPolicy\\s*:\\s*false", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "helmet CSP disabled", "reference": "CWE-693"},
  {"id": "HEADERS-CSP-UNSAFE", "pattern": "(scriptSrc|script-src)[^\\]\\n;]*('unsafe-inline'|'unsafe-eval'|[\"']\\*[\"'])", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "CSP script-src allows unsafe-inline/unsafe-eval or any host", "reference": "CWE-693"},
  {"id": "HEADERS-HSTS-OFF-OR-SHORT", "pattern": "hsts\\s*:\\s*false|maxAge\\s*:\\s*([0-9]{1,7})\\s*[,}]", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "HSTS disabled or max-age below 180 days (check it is the hsts maxAge, not a cookie)", "reference": "CWE-319"},
  {"id": "HEADERS-FRAMEGUARD-OFF", "pattern": "frameguard\\s*:\\s*false", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Low", "description": "X-Frame-Options disabled", "reference": "CWE-1021"},
  {"id": "HEADERS-POWERED-BY", "pattern": "disable\\s*\\(\\s*['\"]x-powered-by['\"]\\s*\\)|poweredByHeader\\s*:\\s*false", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "X-Powered-By suppressed (good) - absence without helmet means it is sent", "reference": "CWE-200"},
  {"id": "HEADERS-CUSTOM-SET", "pattern": "setHeader\\s*\\(\\s*['\"](Content-Security-Policy|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy|Strict-Transport-Security)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "Security header set by hand - collect the full set", "reference": "CWE-693"},
  {"id": "CORS-ANY-ORIGIN", "pattern": "cors\\s*\\(\\s*\\)|enableCors\\s*\\(\\s*\\)|origin\\s*:\\s*['\"]\\*['\"]|origin\\s*:\\s*true", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "CORS allows/reflects any origin - High with credentials: true", "reference": "CWE-942"},
  {"id": "CORS-REFLECT-WITH-CREDENTIALS", "pattern": "origin\\s*:\\s*(true|['\"]\\*['\"]|\\([^)]*\\)\\s*=>\\s*\\w+\\s*\\(\\s*null\\s*,\\s*true\\s*\\))[^}]*credentials\\s*:\\s*true|credentials\\s*:\\s*true[^}]*origin\\s*:\\s*(true|['\"]\\*['\"])", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Reflected/any origin combined with credentials", "reference": "CWE-942"},
  {"id": "COOKIE-SET", "pattern": "res\\.cookie\\s*\\(|reply\\.setCookie\\s*\\(|ctx\\.cookies\\.set\\s*\\(|cookies\\(\\)\\.set\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Cookie issued - confirm httpOnly, secure, sameSite options", "reference": "CWE-1004"},
  {"id": "COOKIE-HTTPONLY-FALSE", "pattern": "httpOnly\\s*:\\s*false", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Cookie explicitly readable by script", "reference": "CWE-1004"},
  {"id": "COOKIE-SECURE-FALSE", "pattern": "secure\\s*:\\s*false", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Cookie may be sent over plain HTTP - check it is not only in a dev branch", "reference": "CWE-614"},
  {"id": "COOKIE-SAMESITE-NONE", "pattern": "sameSite\\s*:\\s*['\"]none['\"]", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "SameSite=None - requires secure and a CSRF defence", "reference": "CWE-352"},
  {"id": "SESSION-CONFIG", "pattern": "session\\s*\\(\\s*\\{|cookieSession\\s*\\(\\s*\\{|@fastify/session|@fastify/secure-session", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "Session middleware - check cookie flags, secret source, store, resave/saveUninitialized, trust proxy", "reference": "CWE-352"},
  {"id": "SESSION-HARDCODED-SECRET", "pattern": "secret\\s*:\\s*['\"][^'\"]{1,}['\"]", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Session/cookie secret hard-coded", "reference": "CWE-798"},
  {"id": "PROXY-TRUST", "pattern": "trust proxy|trustProxy", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "trust proxy configured - required behind a proxy for secure cookies and rate-limit IPs", "reference": "CWE-348"},
  {"id": "CSRF-PRESENT", "pattern": "csurf|csrf-csrf|doubleCsrf|@fastify/csrf-protection|csrfProtection|lusca\\.csrf", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "CSRF middleware present - check it covers every state-changing router", "reference": "CWE-352"},
  {"id": "RATELIMIT-PRESENT", "pattern": "rateLimit\\s*\\(|express-rate-limit|rate-limiter-flexible|RateLimiterMemory|RateLimiterRedis|ThrottlerModule|@Throttle|@fastify/rate-limit|slowDown\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "Rate limiting present - confirm login/register/forgot/otp routes are covered", "reference": "CWE-307"},
  {"id": "RATELIMIT-SKIP-SUCCESS", "pattern": "skipSuccessfulRequests\\s*:\\s*true", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Low", "description": "Successful requests not counted - weak on login endpoints", "reference": "CWE-307"},
  {"id": "RATELIMIT-AUTH-ROUTE", "pattern": "(router|app)\\.(post|get)\\s*\\(\\s*['\"][^'\"]*(login|signin|register|signup|forgot|reset|otp|verify|resend|refresh)|@Post\\s*\\(\\s*['\"][^'\"]*(login|signin|register|signup|forgot|reset|otp|verify|resend|refresh)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "Auth-related route - must be rate limited", "reference": "CWE-307"},
  {"id": "BODYLIMIT-LARGE", "pattern": "limit\\s*:\\s*['\"]([2-9][0-9]|[1-9][0-9]{2,})\\s*mb['\"]|bodyLimit\\s*:\\s*[0-9]{8,}|sizeLimit\\s*:\\s*['\"]([2-9][0-9]|[1-9][0-9]{2,})mb['\"]", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Body size limit of 20 MB or more on a JSON parser", "reference": "CWE-400"},
  {"id": "BODYLIMIT-SET", "pattern": "express\\.json\\s*\\(\\s*\\{[^}]*limit|urlencoded\\s*\\(\\s*\\{[^}]*limit|multer\\s*\\([^)]*limits|bodyLimit\\s*:", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "Body limit configured - record the value", "reference": "CWE-400"},
  {"id": "ERRORS-STACK-IN-RESPONSE", "pattern": "(res\\.(json|send)|reply\\.send|ctx\\.body\\s*=)[^;\\n]*(err|error|exception)\\.stack", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Stack trace returned to the client", "reference": "CWE-209"},
  {"id": "ORDER-ROUTES-REGISTERED", "pattern": "app\\.use\\s*\\(\\s*['\"]/[^'\"]*['\"]\\s*,\\s*\\w*(router|Router|routes)|app\\.(get|post|put|delete)\\s*\\(\\s*['\"]/", "globs": ["app.js", "app.ts", "server.js", "server.ts", "index.js", "index.ts", "main.ts"], "severity_hint": "Info", "description": "Route registration line - compare with helmet/cors/auth registration lines (extract_middleware.py)", "reference": "CWE-306"}
]
