[
  {"id": "HOST-HEADERS-NGINX", "pattern": "add_header\\s+(Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)", "globs": ["*.conf", "nginx*", "*.nginx"], "severity_hint": "Info", "description": "Security header set by nginx - collect the set and check 'always'", "reference": "CWE-693"},
  {"id": "HOST-HEADERS-JSON", "pattern": "[\"'](Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)[\"']\\s*[:,]", "globs": ["firebase.json", "staticwebapp.config.json", "vercel.json", "netlify.toml", "_headers", "nuxt.config.*", "web.config"], "severity_hint": "Info", "description": "Security header set by the hosting config or Nuxt routeRules", "reference": "CWE-693"},
  {"id": "NUXT-ROUTE-RULES-HEADERS", "pattern": "routeRules\\s*:\\s*\\{[\\s\\S]{0,200}headers\\s*:", "globs": ["nuxt.config.*"], "severity_hint": "Info", "description": "Nuxt routeRules headers present - check '/**' coverage and directives", "reference": "CWE-693"},
  {"id": "NUXT-SECURITY-MODULE", "pattern": "nuxt-security", "globs": ["nuxt.config.*", "package.json"], "severity_hint": "Info", "description": "nuxt-security module present - check overrides (contentSecurityPolicy: false, rateLimiter: false)", "reference": "CWE-693"},
  {"id": "NUXT-SECURITY-DISABLED", "pattern": "(contentSecurityPolicy|rateLimiter|csrf|strictTransportSecurity|xFrameOptions)\\s*:\\s*false", "globs": ["nuxt.config.*"], "severity_hint": "Medium", "description": "nuxt-security control disabled", "reference": "CWE-693"},
  {"id": "HOST-CSP-UNSAFE", "pattern": "script-src[^;\\n\"']*('unsafe-inline'|'unsafe-eval'|\\s\\*(\\s|;|\"|'))", "globs": ["*.conf", "*.json", "*.toml", "_headers", "*.html", "nuxt.config.*"], "severity_hint": "Medium", "description": "CSP script-src allows unsafe-inline/unsafe-eval or any host", "reference": "CWE-693"},
  {"id": "META-CSP", "pattern": "<meta\\s+http-equiv\\s*=\\s*[\"']Content-Security-Policy|http-equiv\\s*:\\s*['\"]Content-Security-Policy", "globs": ["*.html", "nuxt.config.*", "*.vue"], "severity_hint": "Low", "description": "CSP via meta tag - cannot set frame-ancestors or report; header preferred", "reference": "CWE-693"},
  {"id": "NUXT-SERVER-COOKIE", "pattern": "setCookie\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Cookie issued by a Nuxt server route - confirm httpOnly, secure, sameSite", "reference": "CWE-1004"},
  {"id": "NUXT-SERVER-CORS-ANY", "pattern": "Access-Control-Allow-Origin['\"]?\\s*[,:]\\s*['\"]\\*['\"]|handleCors\\s*\\([^)]*origin\\s*:\\s*['\"]\\*['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Server route allows any origin - High with credentials", "reference": "CWE-942"},
  {"id": "NUXT-SERVER-MIDDLEWARE", "pattern": "defineEventHandler\\s*\\(", "globs": ["server/middleware/*.ts", "server/middleware/*.js"], "severity_hint": "Info", "description": "Server middleware (runs for every request, alphabetical order) - check what it enforces and its order", "reference": "CWE-306"},
  {"id": "CREDENTIALS-INCLUDE", "pattern": "credentials\\s*:\\s*['\"]include['\"]|withCredentials\\s*:\\s*true", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Cookies sent with requests - CSRF defence and CORS credentials list must exist server-side", "reference": "CWE-352"},
  {"id": "BUILD-SOURCEMAP-PROD", "pattern": "sourcemap\\s*:\\s*true", "globs": ["vite.config.*", "nuxt.config.*", "quasar.config.*"], "severity_hint": "Low", "description": "Source maps enabled for production builds", "reference": "CWE-540"},
  {"id": "DEV-PROXY-TARGET", "pattern": "target\\s*:\\s*['\"]http://", "globs": ["vite.config.*", "quasar.config.*", "nuxt.config.*"], "severity_hint": "Info", "description": "Dev proxy target - confirm production does not depend on it", "reference": "CWE-319"},
  {"id": "PUBLIC-API-HTTP", "pattern": "apiBase\\s*:\\s*['\"]http://(?!localhost|127\\.0\\.0\\.1)", "globs": ["nuxt.config.*"], "severity_hint": "Medium", "description": "Plain-http API base in runtime config", "reference": "CWE-319"}
]
