[
  {"id": "HOST-HEADERS-NGINX", "pattern": "add_header\\s+(Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)", "globs": ["*.conf", "nginx*", "*.nginx"], "severity_hint": "Info", "description": "Security header set by nginx - collect the set and check 'always'", "reference": "CWE-693"},
  {"id": "HOST-HEADERS-JSON", "pattern": "\"(Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)\"\\s*[:,]", "globs": ["firebase.json", "staticwebapp.config.json", "vercel.json", "netlify.toml", "_headers", "web.config"], "severity_hint": "Info", "description": "Security header set by the hosting config - collect the set", "reference": "CWE-693"},
  {"id": "HOST-CSP-UNSAFE", "pattern": "Content-Security-Policy[^\\n]*script-src[^;\\n]*('unsafe-inline'|'unsafe-eval'|\\s\\*(\\s|;|\"))", "globs": ["*.conf", "*.json", "*.toml", "_headers", "*.html", "web.config"], "severity_hint": "Medium", "description": "CSP script-src allows unsafe-inline/unsafe-eval or any host", "reference": "CWE-693"},
  {"id": "HOST-CSP-STYLE-INLINE", "pattern": "style-src[^;\\n]*'unsafe-inline'", "globs": ["*.conf", "*.json", "*.toml", "_headers", "*.html"], "severity_hint": "Low", "description": "style-src unsafe-inline - common for Angular < 16; use ngCspNonce to remove", "reference": "CWE-693"},
  {"id": "META-CSP", "pattern": "<meta\\s+http-equiv\\s*=\\s*[\"']Content-Security-Policy", "globs": ["*.html"], "severity_hint": "Low", "description": "CSP via meta tag - cannot set frame-ancestors or report; header preferred", "reference": "CWE-693"},
  {"id": "CSRF-XSRF-CONFIG", "pattern": "withXsrfConfiguration\\s*\\(|HttpClientXsrfModule|withNoXsrfProtection", "globs": ["*.ts"], "severity_hint": "Info", "description": "Angular XSRF configuration - required when the API uses cookie auth", "reference": "CWE-352"},
  {"id": "CREDENTIALS-GLOBAL", "pattern": "withCredentials\\s*:\\s*true", "globs": ["*.ts"], "severity_hint": "Info", "description": "Cookies sent with requests - CSRF defence and CORS credentials list must exist server-side", "reference": "CWE-352"},
  {"id": "BUILD-SOURCEMAP-PROD", "pattern": "\"production\"\\s*:\\s*\\{[^}]*\"sourceMap\"\\s*:\\s*true", "globs": ["angular.json"], "severity_hint": "Low", "description": "Source maps enabled in the production configuration", "reference": "CWE-540"},
  {"id": "DEV-PROXY-TARGET", "pattern": "\"target\"\\s*:\\s*\"http://", "globs": ["proxy.conf.json", "proxy.conf.js"], "severity_hint": "Info", "description": "Dev proxy target - confirm production does not depend on it", "reference": "CWE-319"},
  {"id": "CAPACITOR-CLEARTEXT", "pattern": "cleartext\\s*:\\s*true|androidScheme\\s*:\\s*['\"]http['\"]|allowNavigation\\s*:\\s*\\[[^\\]]*['\"]\\*['\"]", "globs": ["capacitor.config.*"], "severity_hint": "Medium", "description": "Capacitor allows cleartext or navigation to any host", "reference": "CWE-319"},
  {"id": "SW-CACHE-API", "pattern": "\"dataGroups\"[\\s\\S]{0,400}\"strategy\"\\s*:\\s*\"performance\"", "globs": ["ngsw-config.json"], "severity_hint": "Low", "description": "Service worker caches API responses (performance strategy) - check no authenticated data is cached", "reference": "CWE-524"}
]
