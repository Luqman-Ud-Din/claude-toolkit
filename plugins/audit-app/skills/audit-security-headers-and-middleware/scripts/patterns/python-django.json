[
  {"id": "ERRORS-DEBUG-TRUE", "pattern": "^\\s*DEBUG\\s*=\\s*True|app\\.run\\s*\\([^)]*debug\\s*=\\s*True|FastAPI\\s*\\([^)]*debug\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "High", "description": "Debug mode on - check it is not the production settings module", "reference": "CWE-209"},
  {"id": "ERRORS-ALLOWED-HOSTS-ANY", "pattern": "ALLOWED_HOSTS\\s*=\\s*\\[\\s*['\"]\\*['\"]\\s*\\]", "globs": ["*.py"], "severity_hint": "Medium", "description": "ALLOWED_HOSTS wildcard - host header attacks", "reference": "CWE-16"},
  {"id": "HEADERS-HSTS-OFF-OR-SHORT", "pattern": "SECURE_HSTS_SECONDS\\s*=\\s*([0-9]{1,7})\\b|strict_transport_security_max_age\\s*=\\s*[0-9]{1,7}\\b|strict_transport_security\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "Medium", "description": "HSTS disabled or max-age below 180 days", "reference": "CWE-319"},
  {"id": "HEADERS-HSTS-SET", "pattern": "SECURE_HSTS_SECONDS\\s*=|SECURE_HSTS_INCLUDE_SUBDOMAINS|SECURE_HSTS_PRELOAD", "globs": ["*.py"], "severity_hint": "Info", "description": "HSTS configured - record values", "reference": "CWE-319"},
  {"id": "HEADERS-SSL-REDIRECT-OFF", "pattern": "SECURE_SSL_REDIRECT\\s*=\\s*False|force_https\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "Low", "description": "SSL redirect off - fine only if the proxy redirects and SECURE_PROXY_SSL_HEADER is set", "reference": "CWE-319"},
  {"id": "HEADERS-NOSNIFF-OFF", "pattern": "SECURE_CONTENT_TYPE_NOSNIFF\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "Low", "description": "X-Content-Type-Options disabled", "reference": "CWE-693"},
  {"id": "HEADERS-XFRAME-WEAK", "pattern": "X_FRAME_OPTIONS\\s*=\\s*['\"](ALLOWALL|ALLOW-FROM)", "globs": ["*.py"], "severity_hint": "Medium", "description": "Framing allowed", "reference": "CWE-1021"},
  {"id": "HEADERS-REFERRER-WEAK", "pattern": "SECURE_REFERRER_POLICY\\s*=\\s*(None|['\"](unsafe-url|no-referrer-when-downgrade|origin-when-cross-origin)['\"])", "globs": ["*.py"], "severity_hint": "Low", "description": "Referrer policy leaks URLs", "reference": "CWE-200"},
  {"id": "HEADERS-CSP-PRESENT", "pattern": "CSP_DEFAULT_SRC|CSP_SCRIPT_SRC|CONTENT_SECURITY_POLICY\\s*=|content_security_policy\\s*=|csp\\.middleware", "globs": ["*.py"], "severity_hint": "Info", "description": "CSP configured (django-csp / Talisman) - check directives", "reference": "CWE-693"},
  {"id": "HEADERS-CSP-UNSAFE", "pattern": "CSP_SCRIPT_SRC\\s*=[^\\n]*('unsafe-inline'|'unsafe-eval'|['\"]\\*['\"])|script-src[^\\n;]*('unsafe-inline'|'unsafe-eval')", "globs": ["*.py"], "severity_hint": "Medium", "description": "CSP script-src allows unsafe-inline/unsafe-eval or any host", "reference": "CWE-693"},
  {"id": "HEADERS-TALISMAN-CSP-OFF", "pattern": "content_security_policy\\s*=\\s*None", "globs": ["*.py"], "severity_hint": "Medium", "description": "Flask-Talisman CSP disabled", "reference": "CWE-693"},
  {"id": "ORDER-MIDDLEWARE-LIST", "pattern": "^\\s*MIDDLEWARE(_CLASSES)?\\s*=", "globs": ["*.py"], "severity_hint": "Info", "description": "Django middleware list - extract_middleware.py checks the order", "reference": "CWE-693"},
  {"id": "CORS-ALL-ORIGINS", "pattern": "CORS_ALLOW_ALL_ORIGINS\\s*=\\s*True|CORS_ORIGIN_ALLOW_ALL\\s*=\\s*True|CORS_ALLOWED_ORIGIN_REGEXES\\s*=\\s*\\[[^\\]]*\\.\\*|CORS\\s*\\(\\s*app\\s*\\)|allow_origins\\s*=\\s*\\[\\s*['\"]\\*['\"]", "globs": ["*.py"], "severity_hint": "Medium", "description": "CORS allows any origin - High with credentials", "reference": "CWE-942"},
  {"id": "CORS-CREDENTIALS", "pattern": "CORS_ALLOW_CREDENTIALS\\s*=\\s*True|supports_credentials\\s*=\\s*True|allow_credentials\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Info", "description": "CORS credentials enabled - origin list must be explicit", "reference": "CWE-942"},
  {"id": "COOKIE-FLAGS-OFF", "pattern": "(SESSION|CSRF)_COOKIE_(SECURE|HTTPONLY)\\s*=\\s*False|SESSION_COOKIE_SAMESITE\\s*=\\s*(None|['\"]None['\"])", "globs": ["*.py"], "severity_hint": "High", "description": "Session/CSRF cookie without Secure/HttpOnly or SameSite=None (CSRF_COOKIE_HTTPONLY=False is intended for JS double-submit)", "reference": "CWE-1004"},
  {"id": "COOKIE-FLAGS-SET", "pattern": "(SESSION|CSRF)_COOKIE_(SECURE|HTTPONLY|SAMESITE)\\s*=", "globs": ["*.py"], "severity_hint": "Info", "description": "Cookie flags configured - record values (defaults: SECURE False, HTTPONLY True, SAMESITE Lax)", "reference": "CWE-1004"},
  {"id": "COOKIE-SET-CALL", "pattern": "\\.set_cookie\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Cookie issued by hand - confirm httponly=True, secure=True, samesite=", "reference": "CWE-1004"},
  {"id": "CSRF-EXEMPT", "pattern": "@csrf_exempt|csrf_exempt\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "CSRF disabled on a view - fine for signature-verified webhooks, not for session-auth views", "reference": "CWE-352"},
  {"id": "CSRF-ENFORCE-SKIPPED", "pattern": "def\\s+enforce_csrf\\s*\\([^)]*\\)\\s*:\\s*(return|pass)", "globs": ["*.py"], "severity_hint": "High", "description": "Custom authentication class skips CSRF enforcement", "reference": "CWE-352"},
  {"id": "CSRF-TRUSTED-WILDCARD", "pattern": "CSRF_TRUSTED_ORIGINS\\s*=\\s*\\[[^\\]]*\\*", "globs": ["*.py"], "severity_hint": "Medium", "description": "CSRF trusted origins wildcard", "reference": "CWE-352"},
  {"id": "RATELIMIT-PRESENT", "pattern": "DEFAULT_THROTTLE_CLASSES|throttle_classes|@ratelimit|django_ratelimit|limiter\\.limit|slowapi|axes", "globs": ["*.py"], "severity_hint": "Info", "description": "Throttling/rate limiting present - confirm login/OTP/reset views are covered", "reference": "CWE-307"},
  {"id": "RATELIMIT-AUTH-VIEW", "pattern": "path\\s*\\(\\s*['\"][^'\"]*(login|signin|register|signup|forgot|reset|otp|verify|resend|token)[^'\"]*['\"]|@app\\.(route|post)\\s*\\(\\s*['\"][^'\"]*(login|register|otp|reset)", "globs": ["*.py"], "severity_hint": "Info", "description": "Auth-related route - must be throttled", "reference": "CWE-307"},
  {"id": "BODYLIMIT-UNBOUNDED", "pattern": "DATA_UPLOAD_MAX_MEMORY_SIZE\\s*=\\s*None|DATA_UPLOAD_MAX_NUMBER_FIELDS\\s*=\\s*None|MAX_CONTENT_LENGTH\\s*=\\s*None", "globs": ["*.py"], "severity_hint": "Medium", "description": "Request body limit disabled", "reference": "CWE-400"},
  {"id": "BODYLIMIT-SET", "pattern": "DATA_UPLOAD_MAX_MEMORY_SIZE\\s*=|FILE_UPLOAD_MAX_MEMORY_SIZE\\s*=|MAX_CONTENT_LENGTH\\s*=", "globs": ["*.py"], "severity_hint": "Info", "description": "Body/upload limit configured - record values", "reference": "CWE-400"},
  {"id": "PROXY-SSL-HEADER", "pattern": "SECURE_PROXY_SSL_HEADER\\s*=", "globs": ["*.py"], "severity_hint": "Info", "description": "Proxy SSL header configured - required behind a TLS-terminating proxy", "reference": "CWE-348"}
]
