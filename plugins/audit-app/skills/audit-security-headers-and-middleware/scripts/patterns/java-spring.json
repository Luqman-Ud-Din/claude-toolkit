[
  {"id": "HEADERS-DISABLED", "pattern": "\\.headers\\s*\\([^)]*disable|headers\\(\\)\\.disable\\(\\)|frameOptions\\s*\\([^)]*disable|frameOptions\\(\\)\\.disable\\(\\)|httpStrictTransportSecurity\\s*\\([^)]*disable", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Spring Security default headers disabled", "reference": "CWE-693"},
  {"id": "HEADERS-CSP-PRESENT", "pattern": "contentSecurityPolicy\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "CSP configured - check directives for unsafe-inline/unsafe-eval/*", "reference": "CWE-693"},
  {"id": "HEADERS-CSP-UNSAFE", "pattern": "policyDirectives\\s*\\([^)]*('unsafe-inline'|'unsafe-eval'|script-src[^;)]*\\*)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "CSP allows unsafe-inline/unsafe-eval or any script host", "reference": "CWE-693"},
  {"id": "HEADERS-HSTS-SHORT", "pattern": "maxAgeInSeconds\\s*\\(\\s*([0-9]{1,7})\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "HSTS max-age below 180 days (15552000)", "reference": "CWE-319"},
  {"id": "HEADERS-REFERRER-WEAK", "pattern": "ReferrerPolicy\\.(NO_REFERRER_WHEN_DOWNGRADE|UNSAFE_URL|ORIGIN_WHEN_CROSS_ORIGIN)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Referrer policy leaks URLs", "reference": "CWE-200"},
  {"id": "ERRORS-STACKTRACE", "pattern": "include-stacktrace\\s*[:=]\\s*always|include-message\\s*[:=]\\s*always|include-binding-errors\\s*[:=]\\s*always", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "Error responses include stack traces/messages - check the production profile", "reference": "CWE-209"},
  {"id": "ERRORS-ACTUATOR-EXPOSED", "pattern": "exposure\\.include\\s*[:=]\\s*\\*|include:\\s*\"?\\*\"?", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "All actuator endpoints exposed - env/heapdump need authentication", "reference": "CWE-200"},
  {"id": "CORS-ANY-ORIGIN", "pattern": "@CrossOrigin\\s*(\\(\\s*\\)|(?![^)]*origins))|@CrossOrigin\\s*\\([^)]*\"\\*\"|allowedOrigins\\s*\\([^)]*\"\\*\"|setAllowedOrigins\\s*\\([^)]*\"\\*\"|applyPermitDefaultValues", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "CORS allows any origin - High with allowCredentials(true)", "reference": "CWE-942"},
  {"id": "CORS-PATTERN-ANY-WITH-CREDENTIALS", "pattern": "allowedOriginPatterns\\s*\\([^)]*\"\\*\"|setAllowedOriginPatterns\\s*\\([^)]*\"\\*\"|allowCredentials\\s*=\\s*\"true\"", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Origin pattern * (accepted with credentials) or annotation credentials - reflected-origin risk", "reference": "CWE-942"},
  {"id": "COOKIE-FLAGS-OFF", "pattern": "cookie\\.(http-only|httponly|secure)\\s*[:=]\\s*false|httpOnly\\s*\\(\\s*false\\s*\\)|setHttpOnly\\s*\\(\\s*false|setSecure\\s*\\(\\s*false|secure\\s*\\(\\s*false\\s*\\)", "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "*.properties"], "severity_hint": "High", "description": "Session/auth cookie without HttpOnly or Secure", "reference": "CWE-1004"},
  {"id": "COOKIE-BUILD", "pattern": "ResponseCookie\\.from\\s*\\(|new\\s+Cookie\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Cookie issued - confirm httpOnly(true).secure(true).sameSite(...)", "reference": "CWE-1004"},
  {"id": "COOKIE-SAMESITE-CONFIG", "pattern": "same-site\\s*[:=]|sameSite\\s*\\(", "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "*.properties"], "severity_hint": "Info", "description": "SameSite configured - record the value", "reference": "CWE-352"},
  {"id": "CSRF-DISABLED", "pattern": "csrf\\s*\\([^)]*disable|csrf\\(\\)\\.disable\\(\\)|AbstractHttpConfigurer::disable", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "CSRF disabled - High if session/cookie auth (formLogin, sessions) is used on the same chain", "reference": "CWE-352"},
  {"id": "CSRF-COOKIE-AUTH", "pattern": "formLogin\\s*\\(|rememberMe\\s*\\(|spring-session|SessionCreationPolicy\\.(ALWAYS|IF_REQUIRED)", "globs": ["*.java", "*.kt", "pom.xml", "build.gradle*"], "severity_hint": "Info", "description": "Session/cookie auth present - CSRF protection required", "reference": "CWE-352"},
  {"id": "CSRF-IGNORING-ALL", "pattern": "ignoringRequestMatchers\\s*\\([^)]*\"/\\*\\*\"|ignoringAntMatchers\\s*\\([^)]*\"/\\*\\*\"", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "CSRF ignored for every path", "reference": "CWE-352"},
  {"id": "RATELIMIT-PRESENT", "pattern": "bucket4j|Bucket4j|RateLimiter|RequestRateLimiter|resilience4j.ratelimiter", "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "pom.xml", "build.gradle*"], "severity_hint": "Info", "description": "Rate limiting library present - confirm it covers /login, /auth/**, /otp", "reference": "CWE-307"},
  {"id": "RATELIMIT-AUTH-ENDPOINT", "pattern": "@(Post|Get|Request)Mapping\\s*\\([^)]*(login|signin|register|signup|forgot|reset|otp|verify|resend|refresh)", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Auth-related endpoint - must be rate limited", "reference": "CWE-307"},
  {"id": "BODYLIMIT-UNBOUNDED", "pattern": "max-(file|request)-size\\s*[:=]\\s*-1|max-swallow-size\\s*[:=]\\s*-1|max-in-memory-size\\s*[:=]\\s*-1", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "Upload/body size limit disabled", "reference": "CWE-400"},
  {"id": "BODYLIMIT-SET", "pattern": "max-(file|request)-size\\s*[:=]", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Info", "description": "Multipart limits configured - record values", "reference": "CWE-400"},
  {"id": "ORDER-PERMIT-ALL-CATCHALL", "pattern": "(requestMatchers|antMatchers)\\s*\\(\\s*\"/\\*\\*\"\\s*\\)\\s*\\.permitAll|anyRequest\\s*\\(\\s*\\)\\s*\\.permitAll", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Catch-all permitAll - every route is public unless another chain shadows it", "reference": "CWE-306"},
  {"id": "ORDER-FILTER-REGISTRATION", "pattern": "addFilter(Before|After|At)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Custom filter placement - confirm JWT filter is before UsernamePasswordAuthenticationFilter", "reference": "CWE-306"},
  {"id": "ORDER-FILTER-AS-COMPONENT", "pattern": "@Component[\\s\\S]{0,120}class\\s+\\w*(Jwt|Auth|Token)\\w*Filter\\s+extends\\s+(OncePerRequestFilter|GenericFilterBean)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Auth filter is a @Component - it also runs as a plain servlet filter outside the Security chain (double execution / ordering surprises)", "reference": "CWE-306"}
]
