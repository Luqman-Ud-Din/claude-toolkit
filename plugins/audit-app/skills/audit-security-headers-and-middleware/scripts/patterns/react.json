[
  {"id": "HOST-HEADERS-NGINX", "pattern": "add_header\\s+(Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)", "globs": ["*.conf", "nginx*", "*.nginx"], "severity_hint": "Info", "description": "Security header set by nginx - collect the set and check 'always'", "reference": "CWE-693"},
  {"id": "HOST-HEADERS-JSON", "pattern": "[\"'](Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)[\"']\\s*[:,]|key\\s*:\\s*['\"](Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy)['\"]", "globs": ["firebase.json", "staticwebapp.config.json", "vercel.json", "netlify.toml", "_headers", "next.config.*", "web.config"], "severity_hint": "Info", "description": "Security header set by the hosting config or next.config headers()", "reference": "CWE-693"},
  {"id": "NEXT-HEADERS-FN", "pattern": "async\\s+headers\\s*\\(\\s*\\)|headers\\s*:\\s*async\\s*\\(\\s*\\)", "globs": ["next.config.*"], "severity_hint": "Info", "description": "next.config headers() present - check coverage source '/(.*)' and directives", "reference": "CWE-693"},
  {"id": "NEXT-POWERED-BY", "pattern": "poweredByHeader\\s*:\\s*false", "globs": ["next.config.*"], "severity_hint": "Info", "description": "X-Powered-By suppressed (good) - absence means 'X-Powered-By: Next.js'", "reference": "CWE-200"},
  {"id": "HOST-CSP-UNSAFE", "pattern": "script-src[^;\\n\"']*('unsafe-inline'|'unsafe-eval'|\\s\\*(\\s|;|\"|'))", "globs": ["*.conf", "*.json", "*.toml", "_headers", "*.html", "next.config.*", "middleware.ts", "middleware.js"], "severity_hint": "Medium", "description": "CSP script-src allows unsafe-inline/unsafe-eval or any host (nonce-based policies excepted)", "reference": "CWE-693"},
  {"id": "NEXT-CSP-NONCE", "pattern": "nonce-\\$\\{|x-nonce|'nonce-'", "globs": ["middleware.ts", "middleware.js", "next.config.*", "*.tsx"], "severity_hint": "Info", "description": "Nonce-based CSP in use (good)", "reference": "CWE-693"},
  {"id": "META-CSP", "pattern": "<meta\\s+http-equiv\\s*=\\s*[\"']Content-Security-Policy", "globs": ["*.html", "*.tsx", "*.jsx"], "severity_hint": "Low", "description": "CSP via meta tag - cannot set frame-ancestors or report; header preferred", "reference": "CWE-693"},
  {"id": "NEXT-MIDDLEWARE-MATCHER", "pattern": "export\\s+const\\s+config\\s*=\\s*\\{\\s*matcher", "globs": ["middleware.ts", "middleware.js"], "severity_hint": "Info", "description": "Middleware matcher - check /api routes are included if middleware enforces auth/headers", "reference": "CWE-306"},
  {"id": "NEXT-API-CORS-ANY", "pattern": "Access-Control-Allow-Origin['\"]?\\s*[,:]\\s*['\"]\\*['\"]", "globs": ["*.ts", "*.js", "*.tsx"], "severity_hint": "Medium", "description": "API route allows any origin - High with Allow-Credentials", "reference": "CWE-942"},
  {"id": "NEXT-API-COOKIE", "pattern": "cookies\\(\\)\\.set\\s*\\(|res\\.setHeader\\s*\\(\\s*['\"]Set-Cookie|serialize\\s*\\(\\s*['\"]", "globs": ["*.ts", "*.js", "*.tsx"], "severity_hint": "Medium", "description": "Cookie issued by an API route - confirm httpOnly, secure, sameSite", "reference": "CWE-1004"},
  {"id": "NEXT-API-BODY-LIMIT", "pattern": "sizeLimit\\s*:\\s*['\"]([2-9][0-9]|[1-9][0-9]{2,})mb['\"]|bodySizeLimit\\s*:\\s*['\"]([2-9][0-9]|[1-9][0-9]{2,})mb['\"]", "globs": ["*.ts", "*.js", "next.config.*"], "severity_hint": "Medium", "description": "API route / Server Action body limit of 20 MB or more", "reference": "CWE-400"},
  {"id": "CREDENTIALS-INCLUDE", "pattern": "credentials\\s*:\\s*['\"]include['\"]|withCredentials\\s*:\\s*true", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Info", "description": "Cookies sent with requests - CSRF defence and CORS credentials list must exist server-side", "reference": "CWE-352"},
  {"id": "BUILD-SOURCEMAP-PROD", "pattern": "sourcemap\\s*:\\s*true|GENERATE_SOURCEMAP\\s*=\\s*true|productionBrowserSourceMaps\\s*:\\s*true", "globs": ["vite.config.*", ".env.production", "next.config.*"], "severity_hint": "Low", "description": "Source maps enabled for production", "reference": "CWE-540"},
  {"id": "DEV-PROXY-TARGET", "pattern": "target\\s*:\\s*['\"]http://|\"proxy\"\\s*:\\s*\"http://", "globs": ["vite.config.*", "package.json", "setupProxy.js"], "severity_hint": "Info", "description": "Dev proxy target - confirm production does not depend on it", "reference": "CWE-319"}
]
