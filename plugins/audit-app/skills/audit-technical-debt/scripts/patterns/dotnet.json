[
  {"id": "DEPR-WEBCLIENT", "pattern": "new\\s+WebClient\\s*\\(|WebRequest\\.Create\\(|HttpWebRequest\\b", "globs": ["*.cs"], "severity_hint": "Medium", "description": "WebClient/WebRequest are obsolete (SYSLIB0014); use IHttpClientFactory", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-BINARYFORMATTER", "pattern": "\\bBinaryFormatter\\b|\\bSoapFormatter\\b|\\bNetDataContractSerializer\\b", "globs": ["*.cs"], "severity_hint": "High", "description": "BinaryFormatter is obsolete (SYSLIB0011) and removed in .NET 9; security owned by audit-injection-vulnerabilities", "reference": "CWE-502", "ignore_case": false},
  {"id": "DEPR-CRYPTO-PROVIDERS", "pattern": "RNGCryptoServiceProvider|SHA1Managed|SHA256Managed|MD5CryptoServiceProvider|RijndaelManaged|Rfc2898DeriveBytes\\([^)]*\\)\\s*;", "globs": ["*.cs"], "severity_hint": "Low", "description": "Obsolete crypto provider types (SYSLIB0021/0022/0023/0041)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-THREAD-ABORT", "pattern": "Thread\\.(Abort|Suspend|Resume)\\(|\\.Abort\\(\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Thread.Abort/Suspend throw PlatformNotSupportedException on .NET Core+ (SYSLIB0006)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-IHOSTINGENVIRONMENT", "pattern": "\\bIHostingEnvironment\\b|\\bIApplicationLifetime\\b|UseMvc\\(|AddMvc\\(\\)|WebHost\\.CreateDefaultBuilder", "globs": ["*.cs"], "severity_hint": "Low", "description": "ASP.NET Core 2.x hosting APIs (obsolete since 3.0; CS0618)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-EF-EXECUTESQLCOMMAND", "pattern": "\\.ExecuteSqlCommand(Async)?\\(|\\.FromSql\\(\\s*\"", "globs": ["*.cs"], "severity_hint": "Low", "description": "EF Core 2.x raw SQL APIs removed in 3.0 (use ExecuteSqlRaw/Interpolated)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-SYSTEM-DATA-SQLCLIENT", "pattern": "using\\s+System\\.Data\\.SqlClient\\s*;", "globs": ["*.cs"], "severity_hint": "Medium", "description": "System.Data.SqlClient is deprecated; migrate to Microsoft.Data.SqlClient", "reference": "CWE-1104", "ignore_case": false},
  {"id": "DEPR-OBSOLETE-OWN", "pattern": "\\[Obsolete(\\(|\\])", "globs": ["*.cs"], "severity_hint": "Info", "description": "Member marked [Obsolete] in this codebase; check whether callers remain", "reference": "", "ignore_case": false},
  {"id": "DEPR-NEWTONSOFT-IN-NEW-CODE", "pattern": "AddNewtonsoftJson\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "MVC wired to Newtonsoft.Json; System.Text.Json is the default since 3.0", "reference": "", "ignore_case": false},
  {"id": "MIX-JSON-NEWTONSOFT", "pattern": "using\\s+Newtonsoft\\.Json|JsonConvert\\.(Serialize|Deserialize)", "globs": ["*.cs"], "severity_hint": "Low", "description": "JSON via Newtonsoft.Json (inconsistent when System.Text.Json is also used)", "reference": "", "ignore_case": false},
  {"id": "MIX-JSON-SYSTEMTEXTJSON", "pattern": "using\\s+System\\.Text\\.Json|JsonSerializer\\.(Serialize|Deserialize)", "globs": ["*.cs"], "severity_hint": "Low", "description": "JSON via System.Text.Json (inconsistent when Newtonsoft.Json is also used)", "reference": "", "ignore_case": false},
  {"id": "MIX-DATAACCESS-EFCORE", "pattern": "\\bDbSet<|:\\s*DbContext\\b", "globs": ["*.cs"], "severity_hint": "Low", "description": "Data access via EF Core", "reference": "", "ignore_case": false},
  {"id": "MIX-DATAACCESS-DAPPER", "pattern": "using\\s+Dapper|\\.Query(Async|FirstOrDefault|Single)?<\\w+>\\(\\s*(\"|sql)", "globs": ["*.cs"], "severity_hint": "Low", "description": "Data access via Dapper", "reference": "", "ignore_case": false},
  {"id": "MIX-DATAACCESS-ADONET", "pattern": "new\\s+SqlCommand\\(|new\\s+SqlDataAdapter\\(|ExecuteReader\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Data access via raw ADO.NET", "reference": "", "ignore_case": false},
  {"id": "MIX-LOGGING-ILOGGER", "pattern": "ILogger<\\w+>", "globs": ["*.cs"], "severity_hint": "Low", "description": "Logging through Microsoft.Extensions.Logging", "reference": "", "ignore_case": false},
  {"id": "MIX-LOGGING-SERILOGSTATIC", "pattern": "\\bLog\\.(Information|Warning|Error|Debug|Fatal|Verbose)\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Logging through the static Serilog Log class", "reference": "", "ignore_case": false},
  {"id": "MIX-LOGGING-CONSOLE", "pattern": "Console\\.Write(Line)?\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Logging through Console.WriteLine", "reference": "", "ignore_case": false},
  {"id": "MIX-MAPPING-AUTOMAPPER", "pattern": "\\bIMapper\\b|_mapper\\.Map<", "globs": ["*.cs"], "severity_hint": "Low", "description": "Object mapping via AutoMapper", "reference": "", "ignore_case": false},
  {"id": "MIX-MAPPING-MAPSTER", "pattern": "\\.Adapt<\\w+>\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Object mapping via Mapster", "reference": "", "ignore_case": false},
  {"id": "MIX-VALIDATION-FLUENT", "pattern": ":\\s*AbstractValidator<", "globs": ["*.cs"], "severity_hint": "Low", "description": "Validation via FluentValidation", "reference": "", "ignore_case": false},
  {"id": "MIX-VALIDATION-MANUALCHECKS", "pattern": "if\\s*\\(\\s*string\\.IsNullOrWhiteSpace\\(\\s*(model|request|dto)\\.", "globs": ["*Controller.cs"], "severity_hint": "Low", "description": "Hand-written request validation in controllers", "reference": "", "ignore_case": false}
]
