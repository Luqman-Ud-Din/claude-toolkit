[
  {"id": "DEPR-WEBSECURITYCONFIGURERADAPTER", "pattern": "extends\\s+WebSecurityConfigurerAdapter", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "WebSecurityConfigurerAdapter removed in Spring Security 6; use a SecurityFilterChain bean", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-ANTMATCHERS", "pattern": "\\.(antMatchers|mvcMatchers|regexMatchers|authorizeRequests)\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Matcher APIs removed in Spring Security 6 (requestMatchers/authorizeHttpRequests)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-JAVAX-NAMESPACE", "pattern": "import\\s+javax\\.(servlet|persistence|validation|annotation\\.PostConstruct|transaction)\\.", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "javax.* Jakarta EE 8 namespace; Spring Boot 3 requires jakarta.*", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-BOXED-CONSTRUCTORS", "pattern": "new\\s+(Integer|Long|Double|Float|Short|Byte|Boolean|Character)\\s*\\(", "globs": ["*.java"], "severity_hint": "Low", "description": "Boxed primitive constructors deprecated for removal since Java 9", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-FINALIZE", "pattern": "protected\\s+void\\s+finalize\\s*\\(|Runtime\\.runFinalizersOnExit|Thread\\.stop\\(", "globs": ["*.java"], "severity_hint": "Medium", "description": "finalize()/Thread.stop deprecated for removal (JEP 421)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-LEGACY-DATE", "pattern": "new\\s+SimpleDateFormat\\(|new\\s+Date\\(\\s*\\d|\\.getYear\\(\\)|Calendar\\.getInstance\\(", "globs": ["*.java"], "severity_hint": "Low", "description": "java.util.Date/Calendar legacy API; java.time since Java 8 (time bugs owned by audit-datetime-and-timezone)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-LOG4J1", "pattern": "import\\s+org\\.apache\\.log4j\\.(Logger|LogManager|PropertyConfigurator)", "globs": ["*.java"], "severity_hint": "High", "description": "Log4j 1.x is end-of-life since 2015", "reference": "CWE-1104", "ignore_case": false},
  {"id": "DEPR-SPRINGFOX", "pattern": "springfox\\.documentation|@EnableSwagger2", "globs": ["*.java", "*.kt", "pom.xml", "build.gradle*"], "severity_hint": "Low", "description": "Springfox is unmaintained; use springdoc-openapi", "reference": "CWE-1104", "ignore_case": false},
  {"id": "MIX-HTTP-RESTTEMPLATE", "pattern": "\\bRestTemplate\\b", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "HTTP via RestTemplate", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-WEBCLIENT", "pattern": "\\bWebClient\\.(builder|create)\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "HTTP via WebClient", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-RESTCLIENT", "pattern": "\\bRestClient\\.(builder|create)\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "HTTP via RestClient", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-FEIGN", "pattern": "@FeignClient\\b", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "HTTP via OpenFeign", "reference": "", "ignore_case": false},
  {"id": "MIX-JSON-JACKSON", "pattern": "import\\s+com\\.fasterxml\\.jackson", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "JSON via Jackson", "reference": "", "ignore_case": false},
  {"id": "MIX-JSON-GSON", "pattern": "import\\s+com\\.google\\.gson", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "JSON via Gson", "reference": "", "ignore_case": false},
  {"id": "MIX-TEST-JUNIT4", "pattern": "import\\s+org\\.junit\\.(Test|Before|After|Assert)\\b", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Tests on JUnit 4", "reference": "", "ignore_case": false},
  {"id": "MIX-TEST-JUNIT5", "pattern": "import\\s+org\\.junit\\.jupiter", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Tests on JUnit 5", "reference": "", "ignore_case": false},
  {"id": "MIX-DI-FIELDINJECTION", "pattern": "^\\s*@Autowired\\s*$", "globs": ["*.java"], "severity_hint": "Low", "description": "Field/setter injection with @Autowired", "reference": "", "ignore_case": false},
  {"id": "MIX-DI-CONSTRUCTORINJECTION", "pattern": "@RequiredArgsConstructor|public\\s+\\w+\\(\\s*final\\s+\\w+", "globs": ["*.java"], "severity_hint": "Low", "description": "Constructor injection", "reference": "", "ignore_case": false},
  {"id": "MIX-DATAACCESS-JPA", "pattern": "extends\\s+(JpaRepository|CrudRepository)<", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Data access via Spring Data JPA", "reference": "", "ignore_case": false},
  {"id": "MIX-DATAACCESS-JDBCTEMPLATE", "pattern": "\\bJdbcTemplate\\b|NamedParameterJdbcTemplate", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Data access via JdbcTemplate", "reference": "", "ignore_case": false},
  {"id": "MIX-DATAACCESS-MYBATIS", "pattern": "@Mapper\\b|org\\.apache\\.ibatis", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Data access via MyBatis", "reference": "", "ignore_case": false}
]
