[
  {"id": "DEPR-TOOLING-TSLINT", "pattern": "\"tslint\"\\s*:|tslint\\.json|\"@angular-devkit/build-angular:tslint\"", "globs": ["package.json", "angular.json", "tslint.json"], "severity_hint": "Medium", "description": "TSLint is end-of-life; migrate to angular-eslint (framework API deprecations are owned by audit-frontend-best-practices)", "reference": "CWE-1104", "ignore_case": false},
