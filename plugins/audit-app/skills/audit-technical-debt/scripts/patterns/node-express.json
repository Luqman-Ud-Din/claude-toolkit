  {"id": "MIX-ORM-TYPEORM", "pattern": "from\\s+['\"]typeorm['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Data access via TypeORM", "reference": "", "ignore_case": false},
  {"id": "MIX-ORM-SEQUELIZE", "pattern": "from\\s+['\"]sequelize['\"]|require\\(\\s*['\"]sequelize['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Data access via Sequelize", "reference": "", "ignore_case": false},
  {"id": "MIX-ORM-KNEX", "pattern": "from\\s+['\"]knex['\"]|require\\(\\s*['\"]knex['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Data access via knex", "reference": "", "ignore_case": false},
  {"id": "MIX-LOGGING-CONSOLE", "pattern": "console\\.(log|error|warn|info)\\(", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Logging through console", "reference": "", "ignore_case": false},
  {"id": "MIX-LOGGING-WINSTON", "pattern": "from\\s+['\"]winston['\"]|require\\(\\s*['\"]winston['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Logging through winston", "reference": "", "ignore_case": false},
  {"id": "MIX-LOGGING-PINO", "pattern": "from\\s+['\"]pino['\"]|require\\(\\s*['\"]pino['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Logging through pino", "reference": "", "ignore_case": false}
]
