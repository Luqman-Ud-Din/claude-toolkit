[
  {"id": "DEPR-NEW-BUFFER", "pattern": "new\\s+Buffer\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "new Buffer() is deprecated (DEP0005); use Buffer.from/alloc", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-URL-PARSE", "pattern": "\\burl\\.parse\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Low", "description": "url.parse() is deprecated (DEP0169); use new URL()", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-FS-EXISTS", "pattern": "\\bfs\\.exists\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Low", "description": "fs.exists() is deprecated (DEP0034)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-DOMAIN-MODULE", "pattern": "require\\(\\s*['\"]domain['\"]\\s*\\)|from\\s+['\"]domain['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Medium", "description": "The domain module is deprecated (DEP0032)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-CRYPTO-CREATECIPHER", "pattern": "crypto\\.createCipher\\(|crypto\\.createDecipher\\(", "globs": ["*.js", "*.ts"], "severity_hint": "High", "description": "createCipher/createDecipher removed in Node 22 (DEP0106); crypto strength owned by security skills", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-UTIL-IS", "pattern": "util\\.(isArray|isBoolean|isBuffer|isDate|isError|isFunction|isNull|isNumber|isObject|isPrimitive|isRegExp|isString|isSymbol|isUndefined)\\(", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "util.is* helpers deprecated (DEP0044-DEP0058), removed in Node 23", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-EXPRESS-REQ-PARAM", "pattern": "\\breq\\.param\\(|res\\.send\\(\\s*\\d{3}\\s*\\)|res\\.json\\(\\s*\\d{3}\\s*,|res\\.sendfile\\(", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Express 4 deprecated APIs removed in Express 5", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-REQUEST-PKG", "pattern": "require\\(\\s*['\"](request|request-promise)['\"]\\s*\\)|from\\s+['\"](request|request-promise)['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Medium", "description": "The request package is deprecated since 2020", "reference": "CWE-1104", "ignore_case": false},
  {"id": "DEPR-BODYPARSER-BARE", "pattern": "bodyParser\\(\\s*\\)", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Bare bodyParser() constructor is deprecated; use express.json()", "reference": "CWE-477", "ignore_case": false},
  {"id": "MIX-MODULES-COMMONJS", "pattern": "^\\s*(const|let|var)\\s+\\w+\\s*=\\s*require\\(", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "CommonJS require", "reference": "", "ignore_case": false},
  {"id": "MIX-MODULES-ESM", "pattern": "^\\s*import\\s+.+\\s+from\\s+['\"]", "globs": ["*.js", "*.mjs"], "severity_hint": "Low", "description": "ES module import in .js", "reference": "", "ignore_case": false},
  {"id": "MIX-ASYNC-CALLBACK", "pattern": "function\\s*\\(\\s*err\\s*,|\\(\\s*err\\s*,\\s*\\w+\\s*\\)\\s*=>", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Node-style error-first callbacks", "reference": "", "ignore_case": false},
  {"id": "MIX-ASYNC-THENCHAIN", "pattern": "\\.then\\(\\s*(function|\\(|\\w+\\s*=>)", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Promise .then chains", "reference": "", "ignore_case": false},
  {"id": "MIX-ASYNC-AWAIT", "pattern": "\\bawait\\s+\\w", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "async/await", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-AXIOS", "pattern": "from\\s+['\"]axios['\"]|require\\(\\s*['\"]axios['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "HTTP via axios", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-FETCH", "pattern": "\\bawait\\s+fetch\\(|from\\s+['\"](node-fetch|undici)['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "HTTP via fetch/undici", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-GOT", "pattern": "from\\s+['\"](got|superagent)['\"]|require\\(\\s*['\"](got|superagent)['\"]", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "HTTP via got/superagent", "reference": "", "ignore_case": false},
