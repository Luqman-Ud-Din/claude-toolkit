[
  {"id": "DEPR-DJANGO-CONF-URLS-URL", "pattern": "from\\s+django\\.conf\\.urls\\s+import\\s+.*\\burl\\b|^\\s*url\\(\\s*r?['\"]\\^", "globs": ["*.py"], "severity_hint": "Medium", "description": "django.conf.urls.url() removed in Django 4.0; use path()/re_path()", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-DJANGO-UGETTEXT", "pattern": "\\bugettext(_lazy|_noop)?\\b|\\bungettext\\b|\\bforce_text\\b|\\bsmart_text\\b", "globs": ["*.py"], "severity_hint": "Medium", "description": "ugettext/force_text aliases removed in Django 4.0", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-DJANGO-NULLBOOLEANFIELD", "pattern": "NullBooleanField\\(|postgres\\.fields\\.JSONField|index_together\\s*=", "globs": ["*.py"], "severity_hint": "Medium", "description": "Model APIs removed in Django 4.x/5.1 (NullBooleanField, contrib.postgres JSONField, index_together)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-DJANGO-SETTINGS", "pattern": "^\\s*USE_L10N\\s*=|^\\s*DEFAULT_FILE_STORAGE\\s*=|^\\s*STATICFILES_STORAGE\\s*=|default_app_config\\s*=", "globs": ["*.py"], "severity_hint": "Low", "description": "Settings removed in Django 5.0/5.1 (USE_L10N, DEFAULT_FILE_STORAGE -> STORAGES) or default_app_config", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-PYTZ", "pattern": "^\\s*import\\s+pytz|^\\s*from\\s+pytz\\s+import", "globs": ["*.py"], "severity_hint": "Low", "description": "pytz support removed in Django 5.0; use zoneinfo", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-DATETIME-UTCNOW", "pattern": "datetime\\.utcnow\\(|datetime\\.utcfromtimestamp\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "datetime.utcnow/utcfromtimestamp deprecated in Python 3.12", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-STDLIB-REMOVED", "pattern": "^\\s*import\\s+(imp|asynchat|asyncore|distutils|cgi|cgitb|pipes|telnetlib|crypt|nntplib|smtpd)\\b|^\\s*from\\s+(distutils|imp)\\b", "globs": ["*.py"], "severity_hint": "Medium", "description": "Standard-library modules removed in Python 3.12/3.13 (PEP 594, distutils, imp)", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-PKG-RESOURCES", "pattern": "import\\s+pkg_resources|from\\s+pkg_resources", "globs": ["*.py"], "severity_hint": "Low", "description": "pkg_resources is deprecated; use importlib.metadata/resources", "reference": "CWE-477", "ignore_case": false},
  {"id": "DEPR-ASYNCIO-GET-EVENT-LOOP", "pattern": "asyncio\\.get_event_loop\\(\\)", "globs": ["*.py"], "severity_hint": "Low", "description": "asyncio.get_event_loop() without a running loop is deprecated (3.10+)", "reference": "CWE-477", "ignore_case": false},
  {"id": "MIX-HTTP-REQUESTS", "pattern": "^\\s*import\\s+requests\\b|^\\s*from\\s+requests\\b", "globs": ["*.py"], "severity_hint": "Low", "description": "HTTP via requests", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-HTTPX", "pattern": "^\\s*import\\s+httpx\\b|^\\s*from\\s+httpx\\b", "globs": ["*.py"], "severity_hint": "Low", "description": "HTTP via httpx", "reference": "", "ignore_case": false},
  {"id": "MIX-HTTP-URLLIB", "pattern": "urllib\\.request\\.urlopen\\(|from\\s+urllib\\.request\\s+import", "globs": ["*.py"], "severity_hint": "Low", "description": "HTTP via urllib", "reference": "", "ignore_case": false},
  {"id": "MIX-VIEWS-FUNCTION", "pattern": "^def\\s+\\w+\\(\\s*request\\b", "globs": ["views.py", "*views*.py"], "severity_hint": "Low", "description": "Function-based views", "reference": "", "ignore_case": false},
  {"id": "MIX-VIEWS-CLASS", "pattern": "^class\\s+\\w+\\(.*(View|ViewSet|APIView|GenericAPIView)\\)", "globs": ["views.py", "*views*.py"], "severity_hint": "Low", "description": "Class-based views", "reference": "", "ignore_case": false},
  {"id": "MIX-SQL-RAW", "pattern": "\\.raw\\(|cursor\\.execute\\(|connection\\.cursor\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "Raw SQL beside the ORM", "reference": "", "ignore_case": false},
  {"id": "MIX-SQL-ORM", "pattern": "\\.objects\\.(filter|get|all|create|exclude)\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "Django ORM queries", "reference": "", "ignore_case": false},
  {"id": "MIX-TASKS-CELERY", "pattern": "@shared_task|@app\\.task|from\\s+celery", "globs": ["*.py"], "severity_hint": "Low", "description": "Background work via Celery", "reference": "", "ignore_case": false},
  {"id": "MIX-TASKS-THREADS", "pattern": "threading\\.Thread\\(|ThreadPoolExecutor\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "Background work via ad-hoc threads", "reference": "", "ignore_case": false}
]
