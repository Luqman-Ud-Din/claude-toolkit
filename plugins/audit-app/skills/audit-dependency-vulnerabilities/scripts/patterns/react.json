[
  {
    "id": "REACT-NEXT-MIDDLEWARE-BYPASS",
    "pattern": "\"next\"\\s*:\\s*\"[~^]?(?:1[1-3]\\.|14\\.(?:[01]\\.|2\\.(?:[0-9]|1\\d|2[0-4])\\b)|15\\.(?:0\\.|1\\.|2\\.[0-2]\\b))",
    "globs": ["package.json"],
    "severity_hint": "Critical",
    "description": "Next.js versions affected by middleware authorization bypass via x-middleware-subrequest (CVE-2025-29927)",
    "reference": "CVE-2025-29927"
  },
  {
    "id": "REACT-LODASH-LT-4.17.21",
    "pattern": "\"lodash(?:-es)?\"\\s*:\\s*\"[~^]?4\\.17\\.(?:[0-9]|1\\d|20)\"",
    "globs": ["package.json"],
    "severity_hint": "High",
    "description": "lodash below 4.17.21: prototype pollution (CVE-2020-8203)",
    "reference": "CVE-2020-8203"
  },
  {
    "id": "REACT-DOMPURIFY-LT-3.1.3",
    "pattern": "\"dompurify\"\\s*:\\s*\"[~^]?(?:[0-2]\\.|3\\.0\\.|3\\.1\\.[0-2]\\b)",
    "globs": ["package.json"],
    "severity_hint": "High",
    "description": "DOMPurify below 3.1.3: mXSS bypasses (CVE-2024-45801, CVE-2024-47875); directly feeds dangerouslySetInnerHTML",
    "reference": "CVE-2024-47875"
  },
  {
    "id": "REACT-SERIALIZE-JAVASCRIPT-LT-3.1",
    "pattern": "\"serialize-javascript\"\\s*:\\s*\"[~^]?(?:[0-2]\\.|3\\.0\\.)",
    "globs": ["package.json"],
    "severity_hint": "High",
    "description": "serialize-javascript below 3.1.0: RCE via crafted regex (CVE-2020-7660); common in SSR/webpack toolchains",
    "reference": "CVE-2020-7660"
  },
  {
    "id": "REACT-WEBPACK-DEV-SERVER-LT-5.2.1",
    "pattern": "\"webpack-dev-server\"\\s*:\\s*\"[~^]?(?:[0-4]\\.|5\\.[01]\\.|5\\.2\\.0\\b)",
    "globs": ["package.json"],
    "severity_hint": "Medium",
    "description": "webpack-dev-server below 5.2.1: source exposure during local dev (CVE-2025-30360)",
    "reference": "CVE-2025-30360"
  },
  {
    "id": "REACT-WILDCARD-OR-LATEST",
    "pattern": "\"[^\"]+\"\\s*:\\s*\"(?:\\*|latest)\"",
    "globs": ["package.json"],
    "severity_hint": "Low",
    "description": "Dependency pinned to * or latest",
    "reference": "CWE-1104"
  },
  {
    "id": "REACT-GIT-OR-URL-DEPENDENCY",
    "pattern": "\"[^\"]+\"\\s*:\\s*\"(?:git\\+|github:|https?://)",
    "globs": ["package.json"],
    "severity_hint": "Medium",
    "description": "Dependency fetched from git/URL: not covered by npm audit",
    "reference": "CWE-829"
  }
]
