[
  {"id": "BYPASS-V-HTML", "pattern": "\\bv-html\\s*=", "globs": ["*.vue", "*.html"], "severity_hint": "High", "description": "v-html renders raw HTML with no sanitization - justified only with a sanitizer in the bound computed", "reference": "CWE-79"},
  {"id": "BYPASS-INNERHTML-BIND", "pattern": "(v-bind:|:)inner-?html\\s*=|innerHTML\\s*:\\s*[A-Za-z_]|domProps\\s*:\\s*\\{[^}]*innerHTML", "globs": ["*.vue", "*.js", "*.ts", "*.jsx", "*.tsx"], "severity_hint": "High", "description": "innerHTML bound in a template or render function", "reference": "CWE-79"},
  {"id": "BYPASS-TRIPLE-MUSTACHE", "pattern": "\\{\\{\\{[^}]+\\}\\}\\}", "globs": ["*.vue", "*.html"], "severity_hint": "High", "description": "Triple mustache (unescaped) - legacy Vue 1 / Handlebars-style", "reference": "CWE-79"},
  {"id": "BYPASS-MARKDOWN-RAW", "pattern": "html\\s*:\\s*true\\s*[,}]|allowDangerousHtml\\s*:\\s*true", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "High", "description": "markdown-it / remark configured to pass raw HTML through", "reference": "CWE-79"},
  {"id": "BYPASS-USEHEAD-INNERHTML", "pattern": "useHead\\s*\\([^;]*innerHTML|script\\s*:\\s*\\[[^\\]]*innerHTML\\s*:\\s*[A-Za-z_]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "High", "description": "Nuxt useHead injecting script text from a variable", "reference": "CWE-79"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "DOM-REFS-WRITE", "pattern": "(\\$refs\\.\\w+|\\$el|\\.value)\\.(innerHTML|outerHTML|src|href|srcdoc)\\s*=|el\\.(innerHTML|outerHTML)\\s*=\\s*binding", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "High", "description": "$refs / directive element HTML or URL write", "reference": "CWE-79"},
  {"id": "DOM-SET-ATTRIBUTE-URL", "pattern": "setAttribute\\s*\\(\\s*['\"](href|src|srcdoc|action|formaction|xlink:href|on\\w+)['\"]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "Medium", "description": "Attribute write on a URL/handler attribute", "reference": "CWE-79"},
  {"id": "URL-BOUND-HREF", "pattern": "(v-bind:|:)(href|src|srcdoc|action|formaction|xlink:href)\\s*=\\s*\"(?!['`]?(/|#|mailto|tel|https?:))", "globs": ["*.vue", "*.html"], "severity_hint": "Medium", "description": "URL attribute bound to data - Vue does NOT block javascript: schemes", "reference": "CWE-79"},
  {"id": "URL-V-BIND-OBJECT", "pattern": "v-bind\\s*=\\s*\"(?!\\$attrs)", "globs": ["*.vue", "*.html"], "severity_hint": "Low", "description": "Object v-bind from data - can smuggle innerHTML/href from JSON", "reference": "CWE-79"},
  {"id": "URL-WINDOW-OPEN", "pattern": "(window\\.open|location\\.href\\s*=|location\\.assign\\s*\\(|location\\.replace\\s*\\(|router\\.(push|replace)|navigateTo)\\s*\\(?\\s*[^'\"`)]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "Low", "description": "Navigation to a non-literal URL - open redirect / javascript: scheme", "reference": "CWE-601"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.vue", "*.js", "*.ts", "*.html"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|\\bFunction\\s*\\(\\s*['\"`]|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "EVAL-RUNTIME-COMPILE", "pattern": "\\bcompile\\s*\\(\\s*[^'\"`)]|Vue\\.compile\\s*\\(|template\\s*:\\s*[A-Za-z_][\\w.]*\\s*[,}]", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "Medium", "description": "Runtime template compilation from a variable", "reference": "CWE-95"},
  {"id": "SSR-SCRIPT-JSON-EMBED", "pattern": "<script[^>]*>[^<]*JSON\\.stringify", "globs": ["*.vue", "*.html", "*.js", "*.ts"], "severity_hint": "Medium", "description": "JSON embedded in a script tag without escaping < (</script> breakout)", "reference": "CWE-79"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<script[^>]*src\\s*=\\s*[\"']https?://(?![^>]*integrity)|src\\s*:\\s*['\"]https?://(?![^}]*integrity)", "globs": ["*.html", "*.vue", "nuxt.config.*"], "severity_hint": "Low", "description": "External script without integrity", "reference": "CWE-829"},
  {"id": "SRI-DYNAMIC-SCRIPT", "pattern": "createElement\\s*\\(\\s*['\"]script['\"]\\s*\\)", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "Low", "description": "Script tag created at runtime - check src origin and integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*\\b(setup|lang)\\b)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline script block in static HTML - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=\\s*[\"']", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline event handler attribute in static HTML", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "DOMPurify\\.sanitize\\s*\\(|sanitizeHtml\\s*\\(|filterXSS\\s*\\(", "globs": ["*.vue", "*.js", "*.ts"], "severity_hint": "Info", "description": "Sanitizer call - use to decide whether a nearby v-html is justified", "reference": "CWE-79"}
]
