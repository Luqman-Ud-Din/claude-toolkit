[
  {"id": "BYPASS-TRUST-HTML", "pattern": "bypassSecurityTrustHtml\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "DomSanitizer HTML bypass - justified only with a sanitizer on the same value immediately before", "reference": "CWE-79"},
  {"id": "BYPASS-TRUST-SCRIPT", "pattern": "bypassSecurityTrustScript\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "DomSanitizer script bypass - no sanitizer exists for this context; only a literal is justified", "reference": "CWE-79"},
  {"id": "BYPASS-TRUST-URL", "pattern": "bypassSecurityTrust(Url|ResourceUrl)\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "DomSanitizer URL/resource URL bypass - needs a scheme/host check or a constant", "reference": "CWE-79"},
  {"id": "BYPASS-TRUST-STYLE", "pattern": "bypassSecurityTrustStyle\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "DomSanitizer style bypass (CSS injection / url() exfiltration)", "reference": "CWE-79"},
  {"id": "BYPASS-ANGULARJS-SCE", "pattern": "\\$sce\\.trustAs(Html|Url|ResourceUrl|Js)\\s*\\(|\\$sceProvider\\.enabled\\s*\\(\\s*false|ng-bind-html", "globs": ["*.ts", "*.js", "*.html"], "severity_hint": "High", "description": "AngularJS strict contextual escaping bypass", "reference": "CWE-79"},
  {"id": "BYPASS-TRUSTED-TYPES-POLICY", "pattern": "angular#unsafe-bypass|trusted-types[^;\"']*unsafe", "globs": ["*.ts", "*.js", "*.html", "*.json", "*.cs", "*.conf"], "severity_hint": "Info", "description": "Trusted Types policy allows Angular bypasses - note in scope", "reference": "CWE-79"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write (Angular does not sanitize this path)", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "DOM-RENDERER-INNERHTML", "pattern": "setProperty\\s*\\([^,]+,\\s*['\"](innerHTML|outerHTML|srcdoc)['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Renderer2.setProperty writing HTML", "reference": "CWE-79"},
  {"id": "DOM-SET-ATTRIBUTE-URL", "pattern": "setAttribute\\s*\\(\\s*['\"](href|src|srcdoc|action|formaction|xlink:href|on\\w+)['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Attribute write on a URL/handler attribute - check value source and scheme", "reference": "CWE-79"},
  {"id": "DOM-NATIVE-ELEMENT-WRITE", "pattern": "nativeElement\\.(innerHTML|outerHTML|src|href|srcdoc)\\s*=", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "ElementRef.nativeElement HTML/URL write", "reference": "CWE-79"},
  {"id": "URL-TEMPLATE-BINDING", "pattern": "\\[(attr\\.)?(href|src|srcdoc|action|formaction)\\]\\s*=\\s*\"[^\"]*(user|input|param|query|route|item|model|data|url|link)", "globs": ["*.html"], "severity_hint": "Low", "description": "URL attribute bound to data - Angular blocks javascript: but not open redirect; iframe src needs a bypass so check its source", "reference": "CWE-601"},
  {"id": "URL-WINDOW-OPEN", "pattern": "(window\\.open|location\\.href\\s*=|location\\.assign\\s*\\(|location\\.replace\\s*\\(|document\\.location\\s*=)\\s*\\(?\\s*[^'\"`)]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Navigation to a non-literal URL - javascript: scheme and open redirect", "reference": "CWE-601"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.ts", "*.js", "*.html"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|\\bFunction\\s*\\(\\s*['\"`]|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "EVAL-JIT-COMPILE", "pattern": "compileModule(AndAllComponents)?(Async|Sync)\\s*\\(|\\$compile\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Runtime template compilation", "reference": "CWE-95"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<script[^>]*src\\s*=\\s*[\"']https?://(?![^\"']*integrity)[^\"']*[\"'](?![^>]*integrity)", "globs": ["*.html"], "severity_hint": "Low", "description": "External script without integrity attribute (also checked by scan_html_scripts.py)", "reference": "CWE-829"},
  {"id": "SRI-DYNAMIC-SCRIPT", "pattern": "createElement\\s*\\(\\s*['\"]script['\"]\\s*\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Script tag created at runtime - check src origin and integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline script block - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline event handler attribute - blocks a strict CSP", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "DOMPurify\\.sanitize\\s*\\(|sanitizer\\.sanitize\\s*\\(\\s*SecurityContext|sanitizeHtml\\s*\\(|filterXSS\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Sanitizer call - use to decide whether a nearby bypass is justified", "reference": "CWE-79"}
]
