[
  {"id": "SSR-THYMELEAF-UTEXT", "pattern": "th:utext\\s*=|\\[\\(\\s*\\$\\{", "globs": ["*.html"], "severity_hint": "High", "description": "Thymeleaf unescaped text - trace the model attribute", "reference": "CWE-79"},
  {"id": "SSR-THYMELEAF-JS-EVENT", "pattern": "th:on\\w+\\s*=|th:attr\\s*=\\s*\"[^\"]*(innerHTML|on\\w+)", "globs": ["*.html"], "severity_hint": "Medium", "description": "Thymeleaf expression in a JS/handler context", "reference": "CWE-79"},
  {"id": "SSR-JSP-SCRIPTLET", "pattern": "<%=|<%\\s*out\\.print", "globs": ["*.jsp", "*.jspx", "*.tag"], "severity_hint": "High", "description": "JSP scriptlet output (no escaping)", "reference": "CWE-79"},
  {"id": "SSR-JSP-EL-UNESCAPED", "pattern": "(?<!<c:out value=\")\\$\\{[^}]+\\}", "globs": ["*.jsp", "*.jspx", "*.tag"], "severity_hint": "Medium", "description": "JSP EL outside c:out - EL does not HTML-escape", "reference": "CWE-79"},
  {"id": "SSR-JSP-ESCAPEXML-FALSE", "pattern": "escapeXml\\s*=\\s*\"false\"", "globs": ["*.jsp", "*.jspx", "*.tag"], "severity_hint": "High", "description": "c:out with escaping disabled", "reference": "CWE-79"},
  {"id": "SSR-FREEMARKER-NOESC", "pattern": "\\?no_esc|<#noautoesc>|auto_escaping_policy\\s*=\\s*disable|<#ftl[^>]*auto_esc\\s*=\\s*false", "globs": ["*.ftl", "*.ftlh", "*.properties", "*.java", "*.kt"], "severity_hint": "High", "description": "FreeMarker autoescape disabled", "reference": "CWE-79"},
  {"id": "SSR-VELOCITY", "pattern": "\\.vm\"|VelocityEngine|Velocity\\.evaluate", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Velocity templates - no autoescape unless EscapeHtmlReference configured", "reference": "CWE-79"},
  {"id": "SSR-HTML-STRING-BUILD", "pattern": "(\"<[a-z][^\"]*\"\\s*\\+\\s*[A-Za-z_]|append\\s*\\(\\s*\"<[^\"]*\"\\s*\\)\\s*\\.append\\s*\\(\\s*[A-Za-z_])", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "HTML built by string concatenation in Java", "reference": "CWE-79"},
  {"id": "SSR-HTML-RESPONSE", "pattern": "(contentType\\s*\\(\\s*MediaType\\.TEXT_HTML|produces\\s*=\\s*\"text/html\"|getWriter\\s*\\(\\s*\\)\\.(write|print|println)\\s*\\(\\s*\"<)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "HTML response written from strings", "reference": "CWE-79"},
  {"id": "SSR-JSON-IN-SCRIPT", "pattern": "<script[^>]*>[^<]*(writeValueAsString|toJson|JSON\\.stringify)", "globs": ["*.html", "*.jsp", "*.ftl", "*.ftlh"], "severity_hint": "Medium", "description": "JSON embedded in a script tag by hand (</script> breakout) - use th:inline=javascript", "reference": "CWE-79"},
  {"id": "URL-TH-HREF-USER", "pattern": "th:(href|src|action)\\s*=\\s*\"\\$\\{(?!.*(@|/))", "globs": ["*.html"], "severity_hint": "Low", "description": "URL attribute from a model expression - encoded but scheme unchecked", "reference": "CWE-79"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.js", "*.ts", "*.html", "*.jsp"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write in static or template scripts", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.js", "*.ts", "*.html", "*.jsp"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.html", "*.jsp"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.js", "*.ts", "*.html", "*.jsp"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.js", "*.ts", "*.html", "*.jsp"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<script[^>]*src\\s*=\\s*[\"']https?://(?![^>]*integrity)", "globs": ["*.html", "*.jsp", "*.ftl", "*.ftlh"], "severity_hint": "Low", "description": "External script without integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.html", "*.jsp", "*.ftl", "*.ftlh"], "severity_hint": "Low", "description": "Inline script block - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=\\s*[\"']", "globs": ["*.html", "*.jsp", "*.ftl", "*.ftlh"], "severity_hint": "Low", "description": "Inline event handler attribute", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "PolicyFactory|Sanitizers\\.|Jsoup\\.clean\\s*\\(|HtmlPolicyBuilder", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Server-side HTML sanitizer - evidence for a justified client bypass if on the write path", "reference": "CWE-79"}
]
