[
  {"id": "SSR-SAFE-FILTER", "pattern": "\\|\\s*safe(seq)?\\b", "globs": ["*.html", "*.txt", "*.jinja", "*.jinja2", "*.j2"], "severity_hint": "High", "description": "Django/Jinja2 |safe filter - trace the variable and the write-path sanitizer", "reference": "CWE-79"},
  {"id": "SSR-AUTOESCAPE-OFF", "pattern": "\\{%\\s*autoescape\\s+(off|false)\\s*%\\}", "globs": ["*.html", "*.txt", "*.jinja", "*.jinja2", "*.j2"], "severity_hint": "High", "description": "Autoescape disabled for a block", "reference": "CWE-79"},
  {"id": "SSR-MARK-SAFE", "pattern": "\\bmark_safe\\s*\\(|\\bSafeString\\s*\\(|\\bMarkup\\s*\\(\\s*[^'\"\\)]", "globs": ["*.py"], "severity_hint": "High", "description": "mark_safe/Markup on a variable", "reference": "CWE-79"},
  {"id": "SSR-FORMAT-HTML-DYNAMIC", "pattern": "format_html\\s*\\(\\s*[A-Za-z_f]", "globs": ["*.py"], "severity_hint": "Medium", "description": "format_html with a non-literal format string (args are escaped, the format is not)", "reference": "CWE-79"},
  {"id": "SSR-JINJA-AUTOESCAPE-FALSE", "pattern": "autoescape\\s*=\\s*False|Environment\\s*\\((?![^)]*autoescape)", "globs": ["*.py"], "severity_hint": "High", "description": "Jinja2 Environment without autoescape (default is off)", "reference": "CWE-79"},
  {"id": "SSR-HTML-RESPONSE", "pattern": "HttpResponse\\s*\\(\\s*(f['\"]|['\"][^'\"]*<[^'\"]*['\"]\\s*(%|\\+|\\.format)|[A-Za-z_]\\w*\\s*[,)])|return\\s+f?['\"]<[a-z]", "globs": ["*.py"], "severity_hint": "Medium", "description": "HTML response built from strings", "reference": "CWE-79"},
  {"id": "SSR-JSON-IN-SCRIPT", "pattern": "<script[^>]*>[^<]*\\{\\{[^}]*\\|\\s*safe", "globs": ["*.html"], "severity_hint": "Medium", "description": "|safe inside a script tag - use json_script (</script> breakout)", "reference": "CWE-79"},
  {"id": "URL-REDIRECT-INPUT", "pattern": "(HttpResponseRedirect|redirect)\\s*\\(\\s*(request\\.(GET|POST|data)|[A-Za-z_]*(next|url|return)\\w*)", "globs": ["*.py"], "severity_hint": "Medium", "description": "Redirect to request-derived URL - needs url_has_allowed_host_and_scheme", "reference": "CWE-601"},
  {"id": "URL-TEMPLATE-HREF-VAR", "pattern": "href\\s*=\\s*\"\\{\\{\\s*(?!url\\b|static\\b)[A-Za-z_][\\w.]*\\s*\\}\\}", "globs": ["*.html"], "severity_hint": "Low", "description": "href from a template variable - escaped but scheme unchecked", "reference": "CWE-79"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.js", "*.ts", "*.html"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.js", "*.ts", "*.html"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.html"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.js", "*.ts", "*.html"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.js", "*.ts", "*.html", "*.py"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<script[^>]*src\\s*=\\s*[\"']https?://(?![^>]*integrity)", "globs": ["*.html"], "severity_hint": "Low", "description": "External script without integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline script block - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=\\s*[\"']", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline event handler attribute", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "\\b(bleach\\.clean|nh3\\.clean|Cleaner\\s*\\(|html_sanitizer)", "globs": ["*.py"], "severity_hint": "Info", "description": "Server-side HTML sanitizer - evidence for a justified bypass if on the write path", "reference": "CWE-79"}
]
