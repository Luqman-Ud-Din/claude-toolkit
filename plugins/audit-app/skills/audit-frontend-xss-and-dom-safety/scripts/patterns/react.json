[
  {"id": "BYPASS-DANGEROUSLY-SET", "pattern": "dangerouslySetInnerHTML", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "High", "description": "React HTML bypass - justified only with a sanitizer on the same value", "reference": "CWE-79"},
  {"id": "BYPASS-MARKDOWN-RAW", "pattern": "rehype-raw|rehypeRaw|allowDangerousHtml\\s*:\\s*true|skipHtml\\s*:\\s*false|html\\s*:\\s*true\\s*[,}]", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "High", "description": "Markdown renderer configured to pass raw HTML through", "reference": "CWE-79"},
  {"id": "BYPASS-HTML-PARSER", "pattern": "(html-react-parser|react-html-parser|htmlParser|ReactHtmlParser)\\b", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Medium", "description": "HTML-to-React parser - javascript: hrefs and srcdoc survive; check sanitizer", "reference": "CWE-79"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "HTML-PROP-SPREAD", "pattern": "<[A-Za-z][^>]*\\{\\.\\.\\.(props\\.|item\\.|field\\.|config\\.|data\\.|json)", "globs": ["*.jsx", "*.tsx"], "severity_hint": "Low", "description": "Prop spread from data - can smuggle dangerouslySetInnerHTML from JSON", "reference": "CWE-79"},
  {"id": "DOM-REF-WRITE", "pattern": "(ref|Ref)\\.current\\.(innerHTML|outerHTML|src|href|srcdoc)\\s*=|findDOMNode\\s*\\([^)]*\\)\\.innerHTML", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "High", "description": "ref-based HTML/URL write", "reference": "CWE-79"},
  {"id": "DOM-SET-ATTRIBUTE-URL", "pattern": "setAttribute\\s*\\(\\s*['\"](href|src|srcdoc|action|formaction|xlink:href|on\\w+)['\"]", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Medium", "description": "Attribute write on a URL/handler attribute", "reference": "CWE-79"},
  {"id": "URL-JSX-HREF-DATA", "pattern": "\\b(href|src|srcDoc|action|formAction)\\s*=\\s*\\{\\s*(?!['\"`/])[A-Za-z_][\\w.]*", "globs": ["*.jsx", "*.tsx"], "severity_hint": "Medium", "description": "URL attribute bound to a variable - React blocks javascript: in href only (>=16.9), not srcDoc/formAction/data:", "reference": "CWE-79"},
  {"id": "URL-WINDOW-OPEN", "pattern": "(window\\.open|location\\.href\\s*=|location\\.assign\\s*\\(|location\\.replace\\s*\\(|router\\.(push|replace)|navigate)\\s*\\(?\\s*[^'\"`)]", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Low", "description": "Navigation to a non-literal URL - open redirect / javascript: scheme", "reference": "CWE-601"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts", "*.html"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|\\bFunction\\s*\\(\\s*['\"`]|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "EVAL-WEBVIEW-INJECT", "pattern": "injectedJavaScript(BeforeContentLoaded)?\\s*=\\s*\\{|source\\s*=\\s*\\{\\{\\s*html\\s*:", "globs": ["*.jsx", "*.tsx"], "severity_hint": "High", "description": "React Native WebView executing or rendering a string", "reference": "CWE-95"},
  {"id": "SSR-SCRIPT-JSON-EMBED", "pattern": "<script[^>]*>[^<]*JSON\\.stringify|__html\\s*:\\s*JSON\\.stringify\\s*\\((?![^)]*replace)", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Medium", "description": "JSON embedded in a script tag without escaping < (</script> breakout)", "reference": "CWE-79"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<(script|Script)[^>]*src\\s*=\\s*[\"'{]?\\s*[\"']?https?://(?![^>]*integrity)", "globs": ["*.html", "*.jsx", "*.tsx"], "severity_hint": "Low", "description": "External script without integrity (next/script supports the integrity prop)", "reference": "CWE-829"},
  {"id": "SRI-DYNAMIC-SCRIPT", "pattern": "createElement\\s*\\(\\s*['\"]script['\"]\\s*\\)", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Low", "description": "Script tag created at runtime - check src origin and integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.html", "*.jsx", "*.tsx"], "severity_hint": "Low", "description": "Inline script block - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=\\s*[\"']", "globs": ["*.html"], "severity_hint": "Low", "description": "Inline event handler attribute in static HTML", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "DOMPurify\\.sanitize\\s*\\(|sanitizeHtml\\s*\\(|filterXSS\\s*\\(|rehypeSanitize|rehype-sanitize", "globs": ["*.jsx", "*.tsx", "*.js", "*.ts"], "severity_hint": "Info", "description": "Sanitizer call - use to decide whether a nearby bypass is justified", "reference": "CWE-79"}
]
