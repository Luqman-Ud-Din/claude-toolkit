[
  {"id": "SSR-EJS-UNESCAPED", "pattern": "<%-\\s*(?!include\\b)", "globs": ["*.ejs", "*.html"], "severity_hint": "High", "description": "EJS unescaped output", "reference": "CWE-79"},
  {"id": "SSR-PUG-UNESCAPED", "pattern": "(^|\\s)!=\\s|!\\{[^}]+\\}", "globs": ["*.pug", "*.jade"], "severity_hint": "High", "description": "Pug unescaped output", "reference": "CWE-79"},
  {"id": "SSR-HBS-TRIPLE", "pattern": "\\{\\{\\{[^}]+\\}\\}\\}|\\{\\{&\\s*[^}]+\\}\\}|SafeString\\s*\\(", "globs": ["*.hbs", "*.handlebars", "*.mustache", "*.html", "*.js", "*.ts"], "severity_hint": "High", "description": "Handlebars/Mustache unescaped output or SafeString", "reference": "CWE-79"},
  {"id": "SSR-NUNJUCKS-SAFE", "pattern": "\\|\\s*safe\\b|autoescape\\s*:\\s*false", "globs": ["*.njk", "*.html", "*.js", "*.ts"], "severity_hint": "High", "description": "Nunjucks safe filter or autoescape disabled", "reference": "CWE-79"},
  {"id": "SSR-RES-SEND-HTML", "pattern": "(res|reply|ctx)\\.(send|write|end|body\\s*=)\\s*\\(?\\s*(`[^`]*<|\"[^\"]*<[^\"]*\"\\s*\\+|'[^']*<[^']*'\\s*\\+)", "globs": ["*.js", "*.ts"], "severity_hint": "High", "description": "HTML response built from a template literal or concatenation", "reference": "CWE-79"},
  {"id": "SSR-HTML-TYPE", "pattern": "res\\.type\\s*\\(\\s*['\"](html|text/html)['\"]|Content-Type['\"]?\\s*[,:]\\s*['\"]text/html", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "HTML content type set by hand - check the body source", "reference": "CWE-79"},
  {"id": "SSR-MARKDOWN-RAW", "pattern": "html\\s*:\\s*true\\s*[,}]|allowDangerousHtml\\s*:\\s*true|marked\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts"], "severity_hint": "Medium", "description": "Markdown rendered with raw HTML allowed and no sanitizer", "reference": "CWE-79"},
  {"id": "SSR-JSON-IN-SCRIPT", "pattern": "<script[^>]*>[^<]*(JSON\\.stringify|<%-\\s*JSON|\\{\\{\\{\\s*json)", "globs": ["*.ejs", "*.hbs", "*.njk", "*.pug", "*.html"], "severity_hint": "Medium", "description": "JSON embedded in a script tag (</script> breakout) - escape < or use serialize-javascript", "reference": "CWE-79"},
  {"id": "URL-REDIRECT-INPUT", "pattern": "res\\.redirect\\s*\\(\\s*(req\\.|request\\.|[A-Za-z_]*(url|Url|next|return)\\w*)", "globs": ["*.js", "*.ts"], "severity_hint": "Medium", "description": "Redirect to a request-derived URL (open redirect)", "reference": "CWE-601"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.js", "*.ts", "*.ejs", "*.hbs", "*.njk", "*.html"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.js", "*.ts", "*.ejs", "*.hbs", "*.njk", "*.html"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.ejs", "*.hbs", "*.njk", "*.html"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.js", "*.ts", "*.ejs", "*.hbs", "*.njk", "*.html"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.js", "*.ts", "*.ejs", "*.hbs", "*.njk", "*.html"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<script[^>]*src\\s*=\\s*[\"']https?://(?![^>]*integrity)", "globs": ["*.html", "*.ejs", "*.hbs", "*.njk", "*.pug"], "severity_hint": "Low", "description": "External script without integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.html", "*.ejs", "*.hbs", "*.njk"], "severity_hint": "Low", "description": "Inline script block - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=\\s*[\"']", "globs": ["*.html", "*.ejs", "*.hbs", "*.njk"], "severity_hint": "Low", "description": "Inline event handler attribute", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "sanitizeHtml\\s*\\(|sanitize-html|DOMPurify\\.sanitize\\s*\\(|filterXSS\\s*\\(|isomorphic-dompurify", "globs": ["*.js", "*.ts"], "severity_hint": "Info", "description": "Server-side sanitizer - evidence for a justified client bypass if on the write path", "reference": "CWE-79"}
]
