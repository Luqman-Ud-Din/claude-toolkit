[
  {"id": "SSR-HTML-RAW", "pattern": "Html\\.Raw\\s*\\(", "globs": ["*.cshtml", "*.cs"], "severity_hint": "High", "description": "Razor unescaped output - trace the argument", "reference": "CWE-79"},
  {"id": "SSR-HTMLSTRING", "pattern": "new\\s+HtmlString\\s*\\(|HtmlString\\.Create|\\(MarkupString\\)|new\\s+MarkupString\\s*\\(|AppendHtml\\s*\\(\\s*[^'\"$)]", "globs": ["*.cshtml", "*.razor", "*.cs"], "severity_hint": "High", "description": "HtmlString/MarkupString/AppendHtml from a variable", "reference": "CWE-79"},
  {"id": "SSR-HTML-RESPONSE", "pattern": "Content\\s*\\(\\s*(\\$\"|\"[^\"]*<|[A-Za-z_]\\w*)\\s*,\\s*\"text/html\"|Response\\.WriteAsync\\s*\\(\\s*(\\$\"|\"[^\"]*<[^\"]*\"\\s*\\+)|ContentType\\s*=\\s*\"text/html\"", "globs": ["*.cs"], "severity_hint": "Medium", "description": "HTML response built from strings", "reference": "CWE-79"},
  {"id": "SSR-JSON-IN-SCRIPT", "pattern": "<script[^>]*>[^<]*(JsonConvert\\.SerializeObject|Html\\.Raw\\s*\\(\\s*Json)", "globs": ["*.cshtml"], "severity_hint": "Medium", "description": "Serialized JSON inside a script tag - check the encoder escapes < (</script> breakout)", "reference": "CWE-79"},
  {"id": "SSR-UNSAFE-JSON-ENCODER", "pattern": "UnsafeRelaxedJsonEscaping", "globs": ["*.cs"], "severity_hint": "Low", "description": "System.Text.Json encoder that stops escaping < > - unsafe when JSON is embedded in HTML", "reference": "CWE-79"},
  {"id": "SSR-JS-INTEROP-EVAL", "pattern": "InvokeAsync\\s*(<[^>]*>)?\\s*\\(\\s*\"eval\"|InvokeVoidAsync\\s*\\(\\s*\"eval\"", "globs": ["*.cs", "*.razor"], "severity_hint": "High", "description": "Blazor JS interop calling eval", "reference": "CWE-95"},
  {"id": "URL-RAZOR-HREF-MODEL", "pattern": "href\\s*=\\s*\"@(Model|ViewBag|ViewData|item)\\.", "globs": ["*.cshtml"], "severity_hint": "Low", "description": "href from model - encoded but scheme unchecked (javascript:)", "reference": "CWE-79"},
  {"id": "HTML-INNERHTML-ASSIGN", "pattern": "\\.(innerHTML|outerHTML)\\s*=[^=]", "globs": ["*.js", "*.ts", "*.cshtml"], "severity_hint": "High", "description": "Raw innerHTML/outerHTML write in wwwroot/view scripts", "reference": "CWE-79"},
  {"id": "HTML-INSERT-ADJACENT", "pattern": "insertAdjacentHTML\\s*\\(|document\\.write(ln)?\\s*\\(", "globs": ["*.js", "*.ts", "*.cshtml"], "severity_hint": "High", "description": "Raw HTML insertion", "reference": "CWE-79"},
  {"id": "HTML-JQUERY", "pattern": "\\$\\([^)]*\\)\\.(html|append|prepend|after|before|replaceWith)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.cshtml"], "severity_hint": "Medium", "description": "jQuery HTML insertion with a non-literal", "reference": "CWE-79"},
  {"id": "EVAL-CODE-FROM-STRING", "pattern": "\\b(eval|execScript)\\s*\\(|new\\s+Function\\s*\\(|set(Timeout|Interval)\\s*\\(\\s*['\"`]", "globs": ["*.js", "*.ts", "*.cshtml"], "severity_hint": "High", "description": "Code executed from a string", "reference": "CWE-95"},
  {"id": "URL-JAVASCRIPT-SCHEME", "pattern": "['\"`]\\s*javascript:", "globs": ["*.js", "*.ts", "*.cshtml", "*.razor"], "severity_hint": "Medium", "description": "javascript: URL in source", "reference": "CWE-79"},
  {"id": "SRI-EXTERNAL-SCRIPT", "pattern": "<script[^>]*src\\s*=\\s*[\"']https?://(?![^>]*integrity)", "globs": ["*.cshtml", "*.razor", "*.html"], "severity_hint": "Low", "description": "External script without integrity", "reference": "CWE-829"},
  {"id": "INLINE-SCRIPT-BLOCK", "pattern": "<script(?![^>]*\\bsrc\\s*=)(?![^>]*type\\s*=\\s*[\"']application/(ld\\+)?json)[^>]*>\\s*\\S", "globs": ["*.cshtml", "*.razor", "*.html"], "severity_hint": "Low", "description": "Inline script block - blocks a nonce/hash CSP", "reference": "CWE-1021"},
  {"id": "INLINE-EVENT-HANDLER", "pattern": "<[a-z][^>]*\\son(click|load|error|mouseover|submit|focus|input|change)\\s*=\\s*[\"']", "globs": ["*.cshtml", "*.razor", "*.html"], "severity_hint": "Low", "description": "Inline event handler attribute", "reference": "CWE-1021"},
  {"id": "SANITIZER-PRESENT", "pattern": "HtmlSanitizer|Ganss\\.Xss|Sanitizer\\.GetSafeHtml|\\.Sanitize\\s*\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "Server-side HTML sanitizer - evidence for a justified client bypass if on the write path", "reference": "CWE-79"}
]
