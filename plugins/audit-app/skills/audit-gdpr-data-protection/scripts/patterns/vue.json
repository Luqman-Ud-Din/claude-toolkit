[
  {
    "id": "GDPR-VUE-CONSENT-CHECKBOX-NO-VERSION",
    "pattern": "v-model\\s*=\\s*['\"](?:form\\.|model\\.)?\\w*(?:consent|optIn|agree|acceptTerms|acceptPrivacy|marketing|newsletter)\\w*['\"]",
    "globs": ["*.vue"],
    "severity_hint": "Info",
    "description": "Consent checkbox bound to a boolean - the submitted payload should carry the policy version; the backend must stamp the time",
    "reference": "GDPR-Art.7(1)"
  },
  {
    "id": "GDPR-VUE-PRECHECKED-CONSENT",
    "pattern": "\\w*(?:consent|optIn|marketing|newsletter)\\w*\\s*:\\s*true\\b",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "Medium",
    "description": "Consent state initialised to true - not an affirmative act",
    "reference": "GDPR-Art.4(11)"
  },
  {
    "id": "GDPR-VUE-ANALYTICS-PII",
    "pattern": "\\b(?:gtag|\\$gtag|mixpanel|amplitude|posthog|analytics|logEvent|trackEvent|track|identify|setUserProperties|dataLayer\\.push)\\b[^;]*\\b(?:email|phone|mobile|firstName|lastName|fullName|name)\\s*:",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "High",
    "description": "Analytics event carrying personal data to the vendor",
    "reference": "GDPR-Art.5(1)(c)"
  },
  {
    "id": "GDPR-VUE-TAG-WITHOUT-CONSENT-GATE",
    "pattern": "<script[^>]*src\\s*=\\s*['\"]https?://(?:www\\.googletagmanager\\.com|www\\.google-analytics\\.com|static\\.hotjar\\.com|connect\\.facebook\\.net|www\\.clarity\\.ms|cdn\\.segment\\.com)|src\\s*:\\s*['\"]https?://(?:www\\.googletagmanager\\.com|static\\.hotjar\\.com)",
    "globs": ["index.html", "nuxt.config.*", "*.vue"],
    "severity_hint": "Medium",
    "description": "Tracking tag loaded unconditionally - no consent gate before it fires",
    "reference": "GDPR-Art.6(1)(a)"
  },
  {
    "id": "GDPR-VUE-SENTRY-PII",
    "pattern": "Sentry\\.setUser\\s*\\(|sendDefaultPii\\s*:\\s*true|replaysSessionSampleRate\\s*:\\s*[1-9]",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "Medium",
    "description": "Error tracker user context / session replay - personal data to the vendor",
    "reference": "GDPR-Art.28"
  },
  {
    "id": "GDPR-VUE-PERSISTED-PROFILE",
    "pattern": "persist\\s*:\\s*true|createPersistedState\\s*\\(|useStorage\\s*\\(\\s*['\"](?:user|profile|auth)|(?:localStorage|sessionStorage)\\.setItem\\s*\\(\\s*['\"][^'\"]*(?:user|profile|customer|email)",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "Low",
    "description": "Store/profile persisted in browser storage - a storage location for the inventory and the erasure path",
    "reference": "GDPR-Art.17"
  },
  {
    "id": "GDPR-VUE-SELF-SERVICE-PRIVACY-UI",
    "pattern": "(?:delete[_-]?account|deleteAccount|download[_-]?(?:my[_-]?)?data|exportData|privacy[_-]?settings|manage[_-]?consent|withdraw)\\w*",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "Info",
    "description": "Self-service privacy UI - evidence for the rights matrix; find the backend endpoint it calls",
    "reference": "GDPR-Art.12"
  },
  {
    "id": "GDPR-VUE-NUXT-SERVER-VENDOR-CALL",
    "pattern": "\\$fetch\\s*\\(\\s*[`'\"]https?://(?:api\\.hubapi\\.com|api\\.mailchimp|api\\.segment\\.io|api\\.mixpanel\\.com|api\\.intercom\\.io|api\\.sendgrid\\.com)",
    "globs": ["*.ts", "*.js"],
    "severity_hint": "Medium",
    "description": "Nuxt server call to a known processor - list it and check consent gating",
    "reference": "GDPR-Art.28"
  },
  {
    "id": "GDPR-VUE-PII-IN-QUERY",
    "pattern": "[?&](?:email|phone|mobile|ssn)=\\$\\{|query\\s*:\\s*\\{[^}]*\\b(?:email|phone|mobile)\\b",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "Medium",
    "description": "Personal data sent as a query/route parameter",
    "reference": "GDPR-Art.5(1)(c)"
  },
  {
    "id": "GDPR-VUE-CONSOLE-PII",
    "pattern": "console\\.(?:log|info|debug|warn|error)\\s*\\([^;]*\\b(?:email|phone|mobile|user|profile|customer)\\b",
    "globs": ["*.vue", "*.ts", "*.js"],
    "severity_hint": "Low",
    "description": "console output with user data - captured by session replay and error trackers",
    "reference": "GDPR-Art.5(1)(c)"
  }
]
