[
  {
    "id": "SOC2-BRANCH-PROTECTION-OFF",
    "pattern": "protection\\s*:\\s*(?:null|~|false)|required_pull_request_reviews\\s*:\\s*(?:null|~)|required_status_checks\\s*:\\s*(?:null|~)|enforce_admins\\s*:\\s*false|Branch not protected",
    "globs": ["*.yml", "*.yaml", "*.json"],
    "severity_hint": "High",
    "description": "Branch protection disabled or reviews/status checks not required",
    "reference": "SOC2-CC8.1"
  },
  {
    "id": "SOC2-CI-SCAN-STEP",
    "pattern": "dependency-check|org\\.owasp|github/codeql-action|trivy|grype|snyk|semgrep|spotbugs|find-sec-bugs|gitleaks|sonar|dependency-review-action",
    "globs": ["*.yml", "*.yaml", "Jenkinsfile", "pom.xml", "*.gradle", "*.kts"],
    "severity_hint": "Info",
    "description": "Security scan in CI/build. ZERO hits means no CI security scan - write the CC7.1 finding",
    "reference": "SOC2-CC7.1"
  },
  {
    "id": "SOC2-RBAC-MARKER",
    "pattern": "@PreAuthorize|@Secured|@RolesAllowed|hasRole\\(|hasAuthority\\(|permitAll\\(\\)",
    "globs": ["*.java", "*.kt"],
    "severity_hint": "Info",
    "description": "Role/authority enforcement and permitAll exceptions (CC6.1/CC6.3)",
    "reference": "SOC2-CC6.1"
  },
  {
    "id": "SOC2-MFA-SSO-MARKER",
    "pattern": "oauth2Login|oauth2ResourceServer|saml2Login|OidcUser|keycloak|okta|MultiFactor|totp",
    "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "*.properties"],
    "severity_hint": "Info",
    "description": "SSO / MFA marker. ZERO hits means MFA needs IdP evidence",
    "reference": "SOC2-CC6.1"
  },
  {
    "id": "SOC2-AUDIT-TRAIL-MARKER",
    "pattern": "@Audited|Envers|@EntityListeners\\(AuditingEntityListener|@CreatedBy|@LastModifiedBy|AuditEventRepository",
    "globs": ["*.java", "*.kt"],
    "severity_hint": "Info",
    "description": "Audit trail marker. ZERO hits means no data-change audit trail evidence",
    "reference": "SOC2-CC7.2"
  },
  {
    "id": "SOC2-HEALTH-ENDPOINT",
    "pattern": "spring-boot-starter-actuator|management\\.endpoints\\.web\\.exposure|livenessProbe|readinessProbe",
    "globs": ["pom.xml", "*.gradle", "*.yml", "*.yaml", "*.properties"],
    "severity_hint": "Info",
    "description": "Actuator health / probes for uptime monitoring (A1.1)",
    "reference": "SOC2-A1.1"
  },
  {
    "id": "SOC2-CONSOLE-ONLY-LOGGING",
    "pattern": "ConsoleAppender|<appender-ref ref=\"CONSOLE\"",
    "globs": ["*.xml"],
    "severity_hint": "Medium",
    "description": "Console appender - confirm shipping, retention and tamper-evidence at the platform (CC7.2)",
    "reference": "SOC2-CC7.2"
  },
  {
    "id": "SOC2-BACKUP-JOB",
    "pattern": "pg_dump|mysqldump|aws_backup_plan|backup_retention_period|velero",
    "globs": ["*.sh", "*.tf", "*.yml", "*.yaml", "*.md"],
    "severity_hint": "Info",
    "description": "Backup configuration - pair with a restore test record",
    "reference": "SOC2-A1.2"
  },
  {
    "id": "SOC2-RESTORE-TEST-RECORD",
    "pattern": "restore[ _-]?(?:test|drill|exercise|verified)|test[ _-]?restore|restored on|last restore|\\bRTO\\b|\\bRPO\\b",
    "globs": ["*.md", "*.txt"],
    "severity_hint": "Info",
    "description": "Restore test record. ZERO hits while backups exist means no documented restore test",
    "reference": "SOC2-A1.2"
  },
  {
    "id": "SOC2-SECRET-LITERAL",
    "pattern": "(?:password|secret|api[._-]?key|token)\\s*[=:]\\s*[\"']?[A-Za-z0-9+/_\\-]{12,}",
    "globs": ["*.properties", "*.yml", "*.yaml", "*.java"],
    "severity_hint": "High",
    "description": "Credential-looking literal - confirm with audit-secrets-and-config",
    "reference": "SOC2-C1.1"
  }
]
