[
  {
    "id": "SOC2-BRANCH-PROTECTION-OFF",
    "pattern": "protection\\s*:\\s*(?:null|~|false)|required_pull_request_reviews\\s*:\\s*(?:null|~)|required_status_checks\\s*:\\s*(?:null|~)|enforce_admins\\s*:\\s*false|Branch not protected",
    "globs": ["*.yml", "*.yaml", "*.json"],
    "severity_hint": "High",
    "description": "Branch protection disabled or reviews/status checks not required",
    "reference": "SOC2-CC8.1"
  },
  {
    "id": "SOC2-CI-SCAN-STEP",
    "pattern": "npm audit|pnpm audit|yarn audit|github/codeql-action|trivy|snyk|semgrep|gitleaks|sonar|dependency-review-action",
    "globs": ["*.yml", "*.yaml", "Jenkinsfile"],
    "severity_hint": "Info",
    "description": "Security scan in CI. ZERO hits means no CI security scan (CC7.1)",
    "reference": "SOC2-CC7.1"
  },
  {
    "id": "SOC2-FE-SSO-CLIENT",
    "pattern": "@azure/msal-react|next-auth|@auth/core|oidc-client-ts|react-oidc-context|@auth0/auth0-react|@okta/okta-react",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx", "package.json"],
    "severity_hint": "Info",
    "description": "OIDC/SSO client - supporting evidence for CC6.1 (MFA enforced at the IdP)",
    "reference": "SOC2-CC6.1"
  },
  {
    "id": "SOC2-FE-PROD-SOURCEMAP",
    "pattern": "productionBrowserSourceMaps\\s*:\\s*true|GENERATE_SOURCEMAP\\s*=\\s*true|sourcemap\\s*:\\s*true",
    "globs": ["next.config.*", "vite.config.*", ".env*", "*.js", "*.ts"],
    "severity_hint": "Low",
    "description": "Production source maps enabled",
    "reference": "SOC2-C1.1"
  },
  {
    "id": "SOC2-FE-ENV-SECRET",
    "pattern": "(?:NEXT_PUBLIC_|REACT_APP_|VITE_)\\w*(?:SECRET|PASSWORD|PRIVATE|TOKEN)\\w*\\s*=",
    "globs": [".env*", "*.js", "*.ts"],
    "severity_hint": "High",
    "description": "Secret-named variable exposed to the browser bundle by its public prefix",
    "reference": "SOC2-C1.1"
  },
  {
    "id": "SOC2-FE-CI-TEST",
    "pattern": "npm (?:run )?test|jest|vitest|playwright|cypress",
    "globs": ["*.yml", "*.yaml", "Jenkinsfile"],
    "severity_hint": "Info",
    "description": "Frontend test gate in CI (CC8.1). ZERO hits means no automated test gate",
    "reference": "SOC2-CC8.1"
  }
]
