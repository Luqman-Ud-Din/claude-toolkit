[
  {
    "id": "LOG-FE-CONSOLE-SENSITIVE",
    "pattern": "\\bconsole\\.(?:log|info|debug|warn|error)\\(.*\\b\\w*(?:token|password|jwt|authorization|refreshToken|accessToken|secret)\\b(?!\\s*(?:reset|policy|expir))",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "High",
    "description": "Token/password written to the browser console",
    "reference": "CWE-532"
  },
  {
    "id": "LOG-FE-REDUX-LOGGER",
    "pattern": "redux-logger|createLogger\\(|logger\\s*\\)\\s*;?\\s*$",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Medium",
    "description": "redux-logger prints every action and state (tokens, user profile) - confirm it is dev-only",
    "reference": "CWE-532"
  },
  {
    "id": "LOG-FE-CORRELATION-MARKER",
    "pattern": "x-correlation-id|x-request-id|traceparent|propagateTraceHeaderCorsUrls|instrumentation-fetch|instrumentation-xml-http-request|interceptors\\.request\\.use",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Info",
    "description": "Frontend starts the correlation chain. ZERO hits means requests leave the app with no correlation/trace header",
    "reference": "CWE-778"
  },
  {
    "id": "LOG-FE-ERROR-BOUNDARY",
    "pattern": "componentDidCatch|ErrorBoundary|Sentry\\.init|reportWebVitals|onRecoverableError",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Info",
    "description": "Error boundary / tracker marker. ZERO hits means render errors are never reported",
    "reference": "CWE-778"
  },
  {
    "id": "LOG-FE-SENTRY-PII",
    "pattern": "sendDefaultPii\\s*:\\s*true",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Medium",
    "description": "Error tracker configured to send PII by default",
    "reference": "CWE-532"
  },
  {
    "id": "LOG-FE-CONSOLE",
    "pattern": "\\bconsole\\.(?:log|debug|info)\\(",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Low",
    "description": "console.* left in production code",
    "reference": "CWE-489"
  }
]
