[
  {
    "id": "MONEY-FLOAT",
    "pattern": "parseFloat\\(\\s*[^)]*(amount|price|total|discount|balance)|\\.toFixed\\(\\s*2\\s*\\)\\s*[-+*/]|Number\\(\\s*[^)]*(amount|price|total)\\s*\\)\\s*[-+*/]|Math\\.round\\(\\s*\\w*(amount|price|total|discount)\\w*\\s*\\*\\s*100\\s*\\)",
    "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"],
    "severity_hint": "High",
    "description": "Money arithmetic on JS number (parseFloat/toFixed/Math.round*100); use integer cents or a decimal library",
    "reference": "CWE-682"
  },
  {
    "id": "STATE-SWITCH",
    "pattern": "switch\\s*\\(\\s*\\w+\\.(status|state)\\s*\\)|if\\s*\\(\\s*\\w+\\.(status|state)\\s*(===?|!==?)",
    "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"],
    "severity_hint": "Info",
    "description": "State-transition decision; map to the state diagram and check for a single transition table",
    "reference": "CWE-841"
  },
  {
    "id": "STATE-ASSIGN",
    "pattern": "\\.(status|state)\\s*=\\s*['\"`]\\w+['\"`]|\\.(status|state)\\s*=\\s*\\w+(Status|State)\\.\\w+|status:\\s*['\"`](paid|shipped|cancelled|canceled|completed|refunded|approved)['\"`]",
    "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"],
    "severity_hint": "Info",
    "description": "Status written directly; verify a transition guard precedes it",
    "reference": "CWE-841"
  },
  {
    "id": "DISCOUNT-APPLY",
    "pattern": "\\b(apply|add|use|redeem)(Discount|Coupon|Promo|Voucher)\\w*\\s*\\(|\\.(total|grandTotal|amount|subtotal)\\s*-=\\s*|\\.(total|grandTotal|amount)\\s*=\\s*\\w+\\.(total|grandTotal|amount)\\s*-\\s*",
    "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"],
    "severity_hint": "High",
    "description": "Discount application or incremental total mutation; check it cannot run twice per order",
    "reference": "CWE-840"
  },
  {
    "id": "MASS-ASSIGN",
    "pattern": "\\.(create|update|insert|save)\\(\\s*req\\.body\\s*\\)|Object\\.assign\\(\\s*\\w+\\s*,\\s*req\\.body\\s*\\)|data:\\s*req\\.body\\b|\\.\\.\\.req\\.body",
    "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"],
    "severity_hint": "Medium",
    "description": "Request body persisted wholesale; status/total/role may be client-writable",
    "reference": "CWE-915"
  },
  {
    "id": "ADMIN-OVERRIDE",
    "pattern": "(force|override|markAs|manual)(Paid|Approve|Complete|Cancel|Adjust)\\w*\\s*\\(|impersonat",
    "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"],
    "severity_hint": "Medium",
    "description": "Admin override or impersonation path; verify audit trail and limits",
    "reference": "CWE-840"
  }
]
