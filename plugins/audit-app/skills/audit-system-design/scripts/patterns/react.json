[
  {"id": "CROSS-FEATURE-IMPORT", "pattern": "from\\s+['\"](\\.\\./)+(features|modules|entities)/\\w+/(?!index)", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Medium", "description": "Import into another feature's internals (boundary leak)", "reference": ""},
  {"id": "DEEP-RELATIVE-IMPORT", "pattern": "from\\s+['\"](\\.\\./){3,}", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Deep relative import across module roots", "reference": ""},
  {"id": "MULTIPLE-BASE-URLS", "pattern": "(NEXT_PUBLIC|VITE|REACT_APP)_\\w*(URL|API|HOST)\\w*|https?://[\\w.-]+(:\\d+)?/", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx", ".env*"], "severity_hint": "Info", "description": "Backend origin referenced; count distinct origins (gateway/BFF vs direct)", "reference": ""},
  {"id": "WEBSOCKET-DIRECT", "pattern": "new\\s+WebSocket\\(|new\\s+EventSource\\(|io\\(\\s*['\"]", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Info", "description": "Realtime edge: backend needs a backplane for multiple instances", "reference": ""},
  {"id": "POLLING", "pattern": "refetchInterval\\s*:|setInterval\\(", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Polling; integration style check", "reference": ""},
  {"id": "GLOBAL-MUTABLE", "pattern": "window\\.__\\w+\\s*=|^(export\\s+)?let\\s+\\w*(cache|store|state)\\w*\\s*[:=]", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Global/module mutable state as a source of truth", "reference": ""},
  {"id": "CLIENT-BUSINESS-MATH", "pattern": "(total|grandTotal|netAmount|tax|discount)\\w*\\s*[=+]=?\\s*[^;]*\\*[^;]*;", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"], "severity_hint": "Low", "description": "Money computed on the client; confirm the server recomputes", "reference": ""},
  {"id": "NEXT-SERVER-DB-ACCESS", "pattern": "(prisma\\.|drizzle\\(|knex\\(|mongoose\\.)", "globs": ["route.ts", "route.js", "*actions*.ts", "*.server.ts"], "severity_hint": "Low", "description": "Next.js server code touching the DB directly; apply backend checklist (layering, shared DB)", "reference": ""},
  {"id": "NEXT-MIDDLEWARE-MATCHER", "pattern": "matcher\\s*:", "globs": ["middleware.ts", "middleware.js"], "severity_hint": "Info", "description": "Edge auth boundary matcher; list what is outside it", "reference": "CWE-306"}
]
