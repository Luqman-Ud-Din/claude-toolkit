[
  {"id": "CROSS-FEATURE-IMPORT", "pattern": "from\\s+['\"](\\.\\./)+(features/)?(account|auth|company|dashboard|expenses|manufacturing|organization|point-of-sale|product|purchase|reports|sale|stock|subscription|systemlog|orders|billing|inventory|customers|users)/", "globs": ["*.ts"], "severity_hint": "Medium", "description": "Feature module importing another feature directly (coupling that lazy routes were meant to prevent)", "reference": ""},
  {"id": "DEEP-SRC-IMPORT", "pattern": "from\\s+['\"](src/app/|\\.\\./\\.\\./\\.\\./)", "globs": ["*.ts"], "severity_hint": "Low", "description": "Deep path import bypassing barrels (@core/@shared)", "reference": ""},
  {"id": "MULTIPLE-BASE-URLS", "pattern": "https?://[\\w.-]+(:\\d+)?/|environment\\.\\w*(Url|Api|Base)\\w*", "globs": ["*.ts"], "severity_hint": "Info", "description": "Backend origin referenced; count distinct origins (gateway vs direct-to-service)", "reference": ""},
  {"id": "WEBSOCKET-DIRECT", "pattern": "new\\s+WebSocket\\(|HubConnectionBuilder\\(\\)|io\\(\\s*['\"]", "globs": ["*.ts"], "severity_hint": "Info", "description": "Realtime edge: stateful connection; backend needs a backplane for multiple instances", "reference": ""},
  {"id": "POLLING", "pattern": "interval\\(\\s*\\d+\\s*\\)|timer\\(\\s*\\d+\\s*,\\s*\\d+\\s*\\)|setInterval\\(", "globs": ["*.ts"], "severity_hint": "Low", "description": "Polling loop; integration style check (push vs poll, interval size)", "reference": ""},
  {"id": "CLIENT-BUSINESS-MATH", "pattern": "(total|grandTotal|netAmount|tax|discount)\\w*\\s*[=+]=?\\s*[^;]*\\*[^;]*;", "globs": ["*.ts"], "severity_hint": "Low", "description": "Money computed on the client; confirm the server recomputes (ownership)", "reference": ""},
  {"id": "ROOT-STATE-SERVICE", "pattern": "providedIn:\\s*['\"]root['\"]", "globs": ["*.service.ts", "*store*.ts", "*state*.ts"], "severity_hint": "Info", "description": "Singleton service; check whether it holds server-owned state without a sync strategy", "reference": ""},
  {"id": "LOCALSTORAGE-STATE", "pattern": "localStorage\\.(setItem|getItem)\\(", "globs": ["*.ts"], "severity_hint": "Info", "description": "Browser-persisted state; note what is trusted by the backend (delegate to audit-client-auth-and-storage)", "reference": ""}
]
