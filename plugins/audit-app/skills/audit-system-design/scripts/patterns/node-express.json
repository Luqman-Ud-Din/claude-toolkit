[
  {"id": "MODULE-MUTABLE-STATE", "pattern": "^(export\\s+)?(let|var)\\s+\\w*(cache|store|sessions?|state|registry|tokens?|users?)\\w*\\s*[:=]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Module-level mutable state shared across requests and instances", "reference": "CWE-362"},
  {"id": "GLOBAL-ASSIGN", "pattern": "\\bglobal\\.\\w+\\s*=|globalThis\\.\\w+\\s*=", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Global mutable state", "reference": ""},
  {"id": "MEMORY-SESSION", "pattern": "express-session|session\\(\\{(?![^}]*store)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "express-session; default MemoryStore breaks with >1 instance", "reference": ""},
  {"id": "SOCKETIO-NO-ADAPTER", "pattern": "new\\s+Server\\(.*socket|require\\(['\"]socket\\.io['\"]\\)|from\\s+['\"]socket\\.io['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "socket.io server; confirm a Redis adapter for multi-instance", "reference": ""},
  {"id": "IN-PROCESS-CACHE", "pattern": "new\\s+(NodeCache|LRUCache|LRU|Map)\\(\\)\\s*;?\\s*(//|$)|node-cache|lru-cache", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "In-process cache: diverges across instances; check what it holds", "reference": ""},
  {"id": "HTTP-NO-TIMEOUT", "pattern": "axios\\.(get|post|put|delete|create)\\((?![^)]*timeout)|\\bfetch\\((?![^)]*signal)|got\\((?![^)]*timeout)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Outbound HTTP without timeout/AbortSignal", "reference": "CWE-400"},
  {"id": "RESILIENCE-LIB-HINT", "pattern": "opossum|cockatiel|p-retry|axios-retry|bottleneck", "globs": ["package.json"], "severity_hint": "Info", "description": "Resilience library present; confirm applied to every external call", "reference": ""},
  {"id": "ORM-IN-ROUTE", "pattern": "(prisma\\.|knex\\(|getRepository\\(|\\.findOne\\(|\\.findMany\\()", "globs": ["*.controller.ts", "*routes*.ts", "*routes*.js", "*router*.ts"], "severity_hint": "Low", "description": "Data access inside route/controller code (layer skip)", "reference": ""},
  {"id": "FORWARDREF", "pattern": "forwardRef\\(\\s*\\(\\)\\s*=>", "globs": ["*.ts"], "severity_hint": "Medium", "description": "NestJS forwardRef: acknowledged circular module dependency", "reference": ""},
  {"id": "DEEP-RELATIVE-IMPORT", "pattern": "from\\s+['\"](\\.\\./){3,}", "globs": ["*.ts", "*.tsx", "*.js"], "severity_hint": "Low", "description": "Deep relative import across module roots (boundary leak)", "reference": ""},
  {"id": "PUBLISH-IN-HANDLER", "pattern": "\\.(add|publish|sendToQueue|send)\\(\\s*['\"]?\\w*(queue|event|job|topic)", "globs": ["*.controller.ts", "*.service.ts", "*routes*.ts"], "severity_hint": "Medium", "description": "Queue publish from request code; without an outbox this is a dual write", "reference": ""},
  {"id": "SILENT-CATCH", "pattern": "catch\\s*(\\(\\s*\\w*\\s*\\))?\\s*\\{\\s*\\}", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Silent catch: failure hidden instead of retried/degraded", "reference": "CWE-390"},
  {"id": "UNCAUGHT-SWALLOW", "pattern": "process\\.on\\(\\s*['\"]uncaughtException['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "uncaughtException handler; process should exit and restart, not continue", "reference": ""},
  {"id": "NO-GRACEFUL-SHUTDOWN-HINT", "pattern": "process\\.on\\(\\s*['\"]SIGTERM['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "SIGTERM handler present (absence in main.ts is the finding)", "reference": ""},
  {"id": "SETINTERVAL-SCHEDULER", "pattern": "setInterval\\(|cron\\.schedule\\(|new\\s+CronJob\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "In-process scheduler; duplicates with >1 instance unless locked", "reference": ""},
  {"id": "LOCAL-FILE-STATE", "pattern": "fs\\.(writeFile|writeFileSync|createWriteStream)\\(|multer\\(\\s*\\{[^}]*dest", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Local filesystem writes: state tied to one instance", "reference": ""},
  {"id": "SYNC-CPU-IN-HANDLER", "pattern": "(hashSync|gzipSync|readFileSync|execSync|pbkdf2Sync)\\(", "globs": ["*.controller.ts", "*routes*.ts", "*.service.ts"], "severity_hint": "Low", "description": "Synchronous CPU/IO in request path blocks the event loop", "reference": "CWE-400"},
  {"id": "DATABASE-URL", "pattern": "DATABASE_URL|MONGO_URL|REDIS_URL|AMQP_URL|RABBITMQ_URL|KAFKA_BROKERS", "globs": [".env*", "*.ts", "*.js", "*.json"], "severity_hint": "Info", "description": "Infrastructure edge: map which service uses which store/broker", "reference": ""}
]
