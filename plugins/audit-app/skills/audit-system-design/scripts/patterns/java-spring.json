[
  {"id": "STATIC-MUTABLE-STATE", "pattern": "(private|public|protected)\\s+static\\s+(?!final)[\\w<>,\\[\\] ]+\\s+\\w+\\s*(=|;)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Static mutable field: shared across requests and instances", "reference": "CWE-362"},
  {"id": "THREADLOCAL-CONTEXT", "pattern": "new\\s+ThreadLocal<|ThreadLocal\\.withInitial", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "ThreadLocal context (tenant/user): confirm cleared in finally and propagated to async/listeners", "reference": ""},
  {"id": "NEW-RESTTEMPLATE", "pattern": "new\\s+RestTemplate\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "RestTemplate created ad hoc: no timeouts, no resilience", "reference": "CWE-400"},
  {"id": "WEBCLIENT-NO-TIMEOUT-HINT", "pattern": "WebClient\\.(create|builder)\\(|@FeignClient", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Outbound client; confirm connect/read timeouts and Resilience4j annotations", "reference": ""},
  {"id": "BLOCKING-JOIN", "pattern": "\\.join\\(\\)|\\.get\\(\\)\\s*;|\\.block\\(\\)", "globs": ["*Controller.java", "*Service.java"], "severity_hint": "Low", "description": "Blocking wait on a future/reactive stream in request path; check timeout", "reference": "CWE-400"},
  {"id": "IN-PROCESS-CACHE", "pattern": "new\\s+ConcurrentHashMap<|CacheBuilder\\.newBuilder|Caffeine\\.newBuilder|spring\\.cache\\.type\\s*[:=]\\s*(simple|caffeine)", "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "In-process cache/state: diverges across instances", "reference": ""},
  {"id": "SIMPLE-BROKER-WEBSOCKET", "pattern": "enableSimpleBroker\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "STOMP simple broker: messages not shared across instances (use a relay)", "reference": ""},
  {"id": "SESSION-STORE", "pattern": "HttpSession\\b|spring\\.session\\.store-type", "globs": ["*.java", "*.kt", "*.yml", "*.properties"], "severity_hint": "Low", "description": "HTTP session used; confirm a distributed store", "reference": ""},
  {"id": "REPOSITORY-IN-CONTROLLER", "pattern": "@Autowired\\s+(?:private\\s+)?\\w+Repository\\b|private\\s+final\\s+\\w+Repository\\b", "globs": ["*Controller.java"], "severity_hint": "Low", "description": "Repository injected into a controller (layer skip)", "reference": ""},
  {"id": "PUBLISH-IN-TRANSACTION", "pattern": "(rabbitTemplate|kafkaTemplate|jmsTemplate|streamBridge)\\.(convertAndSend|send)\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Message publish from service code; without an outbox this is a dual write", "reference": ""},
  {"id": "SILENT-CATCH", "pattern": "catch\\s*\\((?:Exception|Throwable|RuntimeException)\\s+\\w+\\)\\s*\\{\\s*\\}", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Silent catch: failure hidden instead of retried/degraded", "reference": "CWE-390"},
  {"id": "THREAD-SLEEP-RETRY", "pattern": "Thread\\.sleep\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Fixed sleep, likely a hand-rolled retry without backoff", "reference": ""},
  {"id": "SCHEDULED-NO-LOCK", "pattern": "@Scheduled\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Scheduled task; confirm ShedLock/Quartz clustering for multi-instance", "reference": ""},
  {"id": "LOCAL-FILE-STATE", "pattern": "new\\s+FileOutputStream\\(|Files\\.write\\(|Files\\.copy\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Local filesystem writes: state tied to one instance", "reference": ""},
  {"id": "PERMIT-ALL", "pattern": "permitAll\\(\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Unauthenticated path; classify public vs internal", "reference": "CWE-306"},
  {"id": "DDL-AUTO", "pattern": "ddl-auto\\s*[:=]\\s*(update|create|create-drop)", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "Schema owned by the ORM at runtime: ownership unclear when several services share a DB", "reference": ""},
  {"id": "DATASOURCE", "pattern": "spring\\.datasource\\.url|datasource:\\s*$|url:\\s*jdbc:", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Info", "description": "Data store edge: map which service uses which DB", "reference": ""}
]
