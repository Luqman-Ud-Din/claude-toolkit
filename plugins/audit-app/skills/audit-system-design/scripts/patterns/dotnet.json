[
  {"id": "STATIC-MUTABLE-STATE", "pattern": "public\\s+static\\s+(?!readonly|class|void|async|[\\w<>\\[\\]]+\\s+\\w+\\s*\\()[\\w<>\\[\\]?]+\\s+\\w+\\s*(\\{\\s*get;\\s*set;|=|;)", "globs": ["*.cs"], "severity_hint": "High", "description": "Static mutable field/property: process-wide state shared across requests and instances", "reference": "CWE-362", "ignore_case": false},
  {"id": "NEW-HTTPCLIENT", "pattern": "new\\s+HttpClient\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "HttpClient created ad hoc: no timeout/resilience policy, socket exhaustion", "reference": "CWE-400"},
  {"id": "HTTPCLIENT-NO-RESILIENCE-HINT", "pattern": "AddHttpClient(<|\\()", "globs": ["*.cs"], "severity_hint": "Info", "description": "Named/typed client registration; confirm timeout + AddStandardResilienceHandler/Polly", "reference": ""},
  {"id": "SYNC-OVER-ASYNC", "pattern": "\\.Result\\b(?!\\s*=)|\\.Wait\\(\\)|GetAwaiter\\(\\)\\.GetResult\\(\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Sync over async: thread-pool starvation under load", "reference": "CWE-400"},
  {"id": "IN-PROCESS-CACHE", "pattern": "IMemoryCache|AddMemoryCache\\(|AddDistributedMemoryCache\\(|static\\s+(?:readonly\\s+)?(?:Concurrent)?Dictionary<", "globs": ["*.cs"], "severity_hint": "Medium", "description": "In-process cache/state: diverges across instances; check what it holds", "reference": ""},
  {"id": "SESSION-NO-BACKPLANE", "pattern": "AddSession\\(|AddSignalR\\(\\)(?!\\s*\\.AddStackExchangeRedis|\\s*\\.AddAzureSignalR)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Session/SignalR without a distributed store or backplane: breaks with >1 instance", "reference": ""},
  {"id": "DBCONTEXT-IN-CONTROLLER", "pattern": "(DbContext|IRepositoryWrapperService|DbSet<)\\s", "globs": ["*Controller.cs"], "severity_hint": "Low", "description": "Data access reachable from the presentation layer (layer skip); confirm no queries inline", "reference": ""},
  {"id": "PUBLISH-IN-HANDLER", "pattern": "\\.(Publish|Send|BasicPublish|SendAsync|PublishAsync)\\(", "globs": ["*Controller.cs", "*Manager*.cs", "*Service*.cs"], "severity_hint": "Medium", "description": "Message published from request code; without an outbox this is a dual write", "reference": ""},
  {"id": "TRANSACTIONSCOPE-WITH-HTTP", "pattern": "new\\s+TransactionScope\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Ambient transaction; check no HTTP/queue call happens inside it", "reference": ""},
  {"id": "SILENT-CATCH", "pattern": "catch\\s*(\\(\\s*Exception\\s*\\w*\\s*\\))?\\s*\\{\\s*\\}", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Silent catch around a call: failure hidden instead of retried/degraded", "reference": "CWE-390"},
  {"id": "THREAD-SLEEP-RETRY", "pattern": "Thread\\.Sleep\\(|Task\\.Delay\\(\\s*\\d{3,}\\s*\\)", "globs": ["*.cs"], "severity_hint": "Low", "description": "Fixed sleep, likely a hand-rolled retry without backoff/jitter", "reference": ""},
  {"id": "LOCAL-FILE-STATE", "pattern": "File\\.(WriteAllBytes|WriteAllText|Copy|Move)\\(|Directory\\.CreateDirectory\\(|Path\\.Combine\\([^)]*wwwroot", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Local filesystem writes: state tied to one instance", "reference": ""},
  {"id": "HANGFIRE-RECURRING-NO-LOCK", "pattern": "RecurringJob\\.AddOrUpdate", "globs": ["*.cs"], "severity_hint": "Low", "description": "Recurring job registration; confirm single job server or DisableConcurrentExecution", "reference": ""},
  {"id": "ALLOW-ANONYMOUS-INTERNAL", "pattern": "\\[AllowAnonymous\\]", "globs": ["*.cs"], "severity_hint": "Info", "description": "Anonymous endpoint; classify: public by design or internal call bypassing the boundary", "reference": "CWE-306"},
  {"id": "OCELOT-ROUTE", "pattern": "\"DownstreamHostAndPorts\"|\"UpstreamPathTemplate\"", "globs": ["ocelot*.json"], "severity_hint": "Info", "description": "Gateway route: add to the service map; check AuthenticationOptions per route", "reference": ""},
  {"id": "CONNECTION-STRING", "pattern": "\"ConnectionStrings\"|Server=|Data Source=", "globs": ["appsettings*.json"], "severity_hint": "Info", "description": "Data store edge: map which service uses which DB (shared DB detection)", "reference": ""},
  {"id": "PROJECT-REFERENCE", "pattern": "<ProjectReference", "globs": ["*.csproj"], "severity_hint": "Info", "description": "Build-unit edge (module_graph.py resolves cycles)", "reference": ""}
]
