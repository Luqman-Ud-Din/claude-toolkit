[
  {"id": "MODULE-MUTABLE-GLOBAL", "pattern": "^[A-Z_]*(CACHE|STATE|REGISTRY|CURRENT|SESSIONS?|TENANT)[A-Z_]*\\s*(:\\s*\\w+)?\\s*=\\s*(\\{\\}|\\[\\]|None|dict\\(\\)|set\\(\\))", "globs": ["*.py"], "severity_hint": "High", "description": "Module-level mutable global used as shared state", "reference": "CWE-362"},
  {"id": "THREADING-LOCAL", "pattern": "threading\\.local\\(\\)|contextvars\\.ContextVar\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Thread/context-local (tenant/user): confirm cleared in middleware finally and passed to tasks", "reference": ""},
  {"id": "LOCMEM-CACHE", "pattern": "LocMemCache|DummyCache|FileBasedCache", "globs": ["*.py"], "severity_hint": "Medium", "description": "Per-process cache backend; diverges across instances (fine in dev settings only)", "reference": ""},
  {"id": "SESSION-FILE-OR-CACHE", "pattern": "SESSION_ENGINE\\s*=\\s*['\"]django\\.contrib\\.sessions\\.backends\\.(file|signed_cookies)['\"]", "globs": ["*.py"], "severity_hint": "Low", "description": "Session engine tied to one instance or to cookies", "reference": ""},
  {"id": "INMEMORY-CHANNEL-LAYER", "pattern": "InMemoryChannelLayer", "globs": ["*.py"], "severity_hint": "Medium", "description": "Channels in-memory layer: websockets not shared across instances", "reference": ""},
  {"id": "MEDIA-LOCAL", "pattern": "MEDIA_ROOT\\s*=|FileSystemStorage", "globs": ["*.py"], "severity_hint": "Low", "description": "Local media storage; breaks with >1 instance unless a shared volume/object store", "reference": ""},
  {"id": "REQUESTS-NO-TIMEOUT", "pattern": "requests\\.(get|post|put|delete|patch|request)\\((?![^)]*timeout)", "globs": ["*.py"], "severity_hint": "Medium", "description": "Outbound HTTP without timeout", "reference": "CWE-400"},
  {"id": "HTTPX-NO-TIMEOUT-HINT", "pattern": "httpx\\.(Client|AsyncClient|get|post)\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "httpx call; confirm explicit timeout and retry/breaker", "reference": ""},
  {"id": "RESILIENCE-LIB-HINT", "pattern": "tenacity|pybreaker|backoff", "globs": ["requirements*.txt", "pyproject.toml"], "severity_hint": "Info", "description": "Resilience library present; confirm applied to every external call", "reference": ""},
  {"id": "TASK-INSIDE-ATOMIC-HINT", "pattern": "\\.(delay|apply_async)\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "Task enqueued; if inside transaction.atomic without on_commit, the task may run before commit (dual write)", "reference": ""},
  {"id": "CELERY-TASK-NO-RETRY", "pattern": "@(shared_task|app\\.task|celery\\.task)\\((?![^)]*(autoretry_for|max_retries|acks_late))", "globs": ["*.py"], "severity_hint": "Low", "description": "Celery task without retry/acks_late options", "reference": ""},
  {"id": "SILENT-EXCEPT", "pattern": "except\\s*(Exception)?\\s*:\\s*(pass|continue|\\.\\.\\.)\\s*$", "globs": ["*.py"], "severity_hint": "Medium", "description": "Silent except: failure hidden instead of retried/degraded", "reference": "CWE-390"},
  {"id": "TIME-SLEEP-RETRY", "pattern": "time\\.sleep\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "Fixed sleep, likely a hand-rolled retry without backoff", "reference": ""},
  {"id": "CROSS-APP-WRITE-IN-VIEW", "pattern": "\\b[A-Z]\\w+\\.objects\\.(create|update|bulk_create)\\(", "globs": ["views.py", "api.py", "viewsets.py"], "severity_hint": "Low", "description": "Model written directly from a view (layer skip); check the model belongs to this app", "reference": ""},
  {"id": "SIGNAL-SIDE-EFFECT", "pattern": "@receiver\\((post_save|pre_save|post_delete)", "globs": ["*.py"], "severity_hint": "Low", "description": "Signal handler: hidden cross-app coupling; check for external calls inside", "reference": ""},
  {"id": "ALLOWED-HOSTS-ANY", "pattern": "ALLOWED_HOSTS\\s*=\\s*\\[\\s*['\"]\\*['\"]", "globs": ["*.py"], "severity_hint": "Low", "description": "Any host accepted; boundary note (delegate detail to headers/infra skills)", "reference": "CWE-16"},
  {"id": "DATABASES-CONFIG", "pattern": "^DATABASES\\s*=|CELERY_BROKER_URL|CHANNEL_LAYERS|CACHES\\s*=", "globs": ["*.py"], "severity_hint": "Info", "description": "Infrastructure edge: map DBs, brokers, caches per settings file", "reference": ""}
]
