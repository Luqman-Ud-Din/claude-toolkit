[
  {"id": "SQL-TEMPLATE-LITERAL", "pattern": "\\.(query|execute|raw|whereRaw|orderByRaw|havingRaw|selectRaw|joinRaw|fromRaw)\\s*\\(\\s*`[^`]*\\$\\{", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "SQL built with a template literal containing ${}", "reference": "CWE-89"},
  {"id": "SQL-CONCAT", "pattern": "\\.(query|execute|raw|whereRaw|orderByRaw|havingRaw|selectRaw|where|andWhere|orWhere|orderBy)\\s*\\(\\s*(\"[^\"]*\"|'[^']*')\\s*\\+", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "SQL built by string concatenation", "reference": "CWE-89"},
  {"id": "SQL-KEYWORD-CONCAT", "pattern": "(\"[^\"]*|'[^']*)\\b(SELECT|INSERT|UPDATE|DELETE|ORDER\\s+BY|WHERE|FROM)\\b[^\"']*[\"']\\s*\\+", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "SQL text literal concatenated with a value", "reference": "CWE-89"},
  {"id": "SQL-KEYWORD-TEMPLATE", "pattern": "`[^`]*\\b(SELECT|INSERT|UPDATE|DELETE|ORDER\\s+BY|WHERE|FROM)\\b[^`]*\\$\\{", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "SQL text in a template literal with ${} - safe only if it is a tagged template (prisma.$queryRaw, sql``)", "reference": "CWE-89"},
  {"id": "SQL-PRISMA-UNSAFE", "pattern": "\\$(queryRawUnsafe|executeRawUnsafe)\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Prisma *Unsafe raw API - text is not parameterized", "reference": "CWE-89"},
  {"id": "SQL-SEQUELIZE-QUERY", "pattern": "sequelize\\.query\\s*\\(\\s*(`|\"[^\"]*\"\\s*\\+|'[^']*'\\s*\\+|[A-Za-z_]\\w*\\s*[,)])", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Sequelize raw query with dynamic text", "reference": "CWE-89"},
  {"id": "NOSQL-BODY-FILTER", "pattern": "\\.(find|findOne|findOneAndUpdate|findOneAndDelete|updateOne|updateMany|deleteOne|deleteMany|countDocuments|aggregate)\\s*\\(\\s*(req\\.(body|query|params)|request\\.(body|query)|JSON\\.parse\\s*\\()", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Mongo filter taken directly from the request (operator injection)", "reference": "CWE-943"},
  {"id": "NOSQL-WHERE", "pattern": "\\$where\\s*:", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Mongo $where executes JavaScript", "reference": "CWE-943"},
  {"id": "NOSQL-DYNAMIC-KEY", "pattern": "\\.(find|findOne|where)\\s*\\(\\s*\\{\\s*\\[\\s*(req|request|query|body|params)\\.", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "Query field name taken from the request", "reference": "CWE-943"},
  {"id": "CMD-EXEC", "pattern": "\\b(exec|execSync)\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "child_process.exec runs through a shell - trace the command string", "reference": "CWE-78"},
  {"id": "CMD-SPAWN-SHELL", "pattern": "(spawn|spawnSync|execFile|execFileSync)\\s*\\([^;]*(shell\\s*:\\s*true|['\"](sh|bash|/bin/sh|/bin/bash|cmd|cmd\\.exe|powershell)['\"])", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "spawn/execFile with a shell", "reference": "CWE-78"},
  {"id": "CMD-SHELLJS", "pattern": "(shell|shelljs|sh)\\.exec\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "shelljs exec (always a shell)", "reference": "CWE-78"},
  {"id": "PATH-JOIN-INPUT", "pattern": "path\\.(join|resolve)\\s*\\([^;]*(req\\.|request\\.|params\\.|query\\.|body\\.|originalname|fileName|filename|\\bname\\b|\\bfile\\b)", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Path built from a request-derived segment (../ walks out; absolute replaces root)", "reference": "CWE-22"},
  {"id": "PATH-FS-API", "pattern": "fs(\\.promises)?\\.(readFile|readFileSync|createReadStream|createWriteStream|writeFile|writeFileSync|unlink|unlinkSync|rm|rmSync|stat|statSync|readdir|readdirSync|access|accessSync|open|openSync)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "fs call with a non-literal path - confirm it cannot be steered", "reference": "CWE-22"},
  {"id": "PATH-SENDFILE", "pattern": "res\\.(sendFile|download|attachment)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "File served by a non-literal path", "reference": "CWE-22"},
  {"id": "PATH-DYNAMIC-REQUIRE", "pattern": "(require|import)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "Dynamic require/import - code loading by name", "reference": "CWE-94"},
  {"id": "LDAP-FILTER-DYNAMIC", "pattern": "filter\\s*:\\s*(`[^`]*\\$\\{|\"[^\"]*\"\\s*\\+|'[^']*'\\s*\\+)", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "LDAP filter built from strings", "reference": "CWE-90"},
  {"id": "XPATH-DYNAMIC", "pattern": "xpath\\.(select|select1|evaluate|parse)\\s*\\(\\s*(`[^`]*\\$\\{|\"[^\"]*\"\\s*\\+|'[^']*'\\s*\\+|[A-Za-z_]\\w*\\s*[,)])", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "XPath built from strings", "reference": "CWE-643"},
  {"id": "XXE-NOENT", "pattern": "noent\\s*:\\s*true", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "libxmljs entity expansion enabled", "reference": "CWE-611"},
  {"id": "TMPL-RENDER-STRING", "pattern": "(ejs\\.render|pug\\.compile|pug\\.render|Handlebars\\.compile|handlebars\\.compile|nunjucks\\.renderString|_\\.template|lodash\\.template|doT\\.template|mustache\\.render)\\s*\\(\\s*[^'\"`)]", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Template compiled from a non-literal (SSTI)", "reference": "CWE-1336"},
  {"id": "TMPL-EVAL", "pattern": "\\b(eval|new\\s+Function|vm\\.runInNewContext|vm\\.runInThisContext|vm\\.runInContext)\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Code evaluation from a string", "reference": "CWE-95"},
  {"id": "SSRF-FETCH-INPUT", "pattern": "\\b(fetch|axios(\\.(get|post|put|delete|request))?|got|request|superagent|needle|undici\\.request|http\\.get|https\\.get|http\\.request|https\\.request)\\s*\\(\\s*(req\\.|request\\.|body\\.|query\\.|params\\.|`[^`]*\\$\\{|[A-Za-z_]*[uU]r[lL]\\b|[A-Za-z_]*[uU]ri\\b|link\\b|target\\b|endpoint\\b)", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Outbound HTTP to a URL derived from a variable", "reference": "CWE-918"},
  {"id": "SSRF-NEW-URL-INPUT", "pattern": "new\\s+URL\\s*\\(\\s*(req\\.|request\\.|body\\.|query\\.|params\\.|[A-Za-z_]*[uU]r[lL]\\b)", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "URL built from input - check scheme/host allow-list", "reference": "CWE-918"},
  {"id": "SSRF-PUPPETEER", "pattern": "\\.(goto|setContent)\\s*\\(\\s*(req\\.|body\\.|query\\.|[A-Za-z_]*[uU]r[lL]\\b)", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "High", "description": "Headless browser navigates to a user URL", "reference": "CWE-918"},
  {"id": "DESER-NODE-SERIALIZE", "pattern": "\\b(unserialize|node-serialize|serialize-to-js|v8\\.deserialize)\\b", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Critical", "description": "Object deserialization that can execute functions", "reference": "CWE-502"},
  {"id": "DESER-YAML-UNSAFE", "pattern": "yaml\\.(load|unsafeLoad)\\s*\\([^;]*(DEFAULT_FULL_SCHEMA|schema)|require\\(['\"]js-yaml['\"]\\)\\.load\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "js-yaml load with a full schema (check version < 4)", "reference": "CWE-502"},
  {"id": "DESER-PROTO-POLLUTION", "pattern": "(_\\.merge|lodash\\.merge|deepmerge|Object\\.assign|_\\.defaultsDeep|extend)\\s*\\([^;]*(req\\.body|req\\.query|request\\.body)", "globs": ["*.js", "*.ts", "*.mjs", "*.cjs"], "severity_hint": "Medium", "description": "Deep merge of request body into an object (prototype pollution)", "reference": "CWE-1321"}
]
