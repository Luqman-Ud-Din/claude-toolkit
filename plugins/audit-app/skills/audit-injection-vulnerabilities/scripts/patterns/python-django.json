[
  {"id": "SQL-EXECUTE-FORMAT", "pattern": "\\.(execute|executemany|executescript)\\s*\\(\\s*(f[\"']|[\"'][^\"']*[\"']\\s*(%|\\+|\\.format)|[\"'][^\"']*[\"']\\s*\\)?\\s*%\\s*)", "globs": ["*.py"], "severity_hint": "High", "description": "cursor.execute with f-string, %, + or .format (not DB-API parameters)", "reference": "CWE-89"},
  {"id": "SQL-EXECUTE-VAR", "pattern": "\\.(execute|executemany)\\s*\\(\\s*[A-Za-z_]\\w*\\s*\\)", "globs": ["*.py"], "severity_hint": "Medium", "description": "cursor.execute with a variable and no params - trace how it is built", "reference": "CWE-89"},
  {"id": "SQL-RAW-DYNAMIC", "pattern": "\\.raw\\s*\\(\\s*(f[\"']|[\"'][^\"']*[\"']\\s*(%|\\+|\\.format)|[A-Za-z_]\\w*\\s*\\))", "globs": ["*.py"], "severity_hint": "High", "description": "Manager.raw() with interpolated text", "reference": "CWE-89"},
  {"id": "SQL-EXTRA-RAWSQL", "pattern": "(\\.extra\\s*\\(|RawSQL\\s*\\(\\s*(f[\"']|[\"'][^\"']*[\"']\\s*(%|\\+|\\.format)|[A-Za-z_]\\w*\\s*[,)]))", "globs": ["*.py"], "severity_hint": "High", "description": "QuerySet.extra / RawSQL with dynamic text", "reference": "CWE-89"},
  {"id": "SQL-SQLALCHEMY-TEXT", "pattern": "(text|execute|exec_driver_sql)\\s*\\(\\s*(f[\"']|[\"'][^\"']*[\"']\\s*(%|\\+|\\.format))", "globs": ["*.py"], "severity_hint": "High", "description": "SQLAlchemy text/execute with interpolated SQL", "reference": "CWE-89"},
  {"id": "SQL-KEYWORD-FSTRING", "pattern": "f[\"'][^\"']*\\b(SELECT|INSERT|UPDATE|DELETE|ORDER\\s+BY|WHERE|FROM)\\b[^\"']*\\{", "globs": ["*.py"], "severity_hint": "High", "description": "SQL text inside an f-string", "reference": "CWE-89"},
  {"id": "SQL-KEYWORD-CONCAT", "pattern": "[\"'][^\"']*\\b(SELECT|INSERT|UPDATE|DELETE|ORDER\\s+BY|WHERE|FROM)\\b[^\"']*[\"']\\s*(\\+|%\\s*[\\(A-Za-z_]|\\.format\\()", "globs": ["*.py"], "severity_hint": "High", "description": "SQL text concatenated or %-formatted", "reference": "CWE-89"},
  {"id": "SQL-LITERAL-COLUMN", "pattern": "(literal_column|column|table)\\s*\\(\\s*[A-Za-z_]\\w*\\s*\\)", "globs": ["*.py"], "severity_hint": "Medium", "description": "SQLAlchemy identifier from a variable", "reference": "CWE-89"},
  {"id": "NOSQL-RAW", "pattern": "(\\$where|__raw__\\s*=|\\.find(_one)?\\s*\\(\\s*(json\\.loads|request\\.(data|GET|POST|json)))", "globs": ["*.py"], "severity_hint": "High", "description": "Mongo filter from raw request data", "reference": "CWE-943"},
  {"id": "CMD-OS-SYSTEM", "pattern": "\\b(os\\.system|os\\.popen|commands\\.getoutput|commands\\.getstatusoutput|pexpect\\.spawn)\\s*\\(", "globs": ["*.py"], "severity_hint": "High", "description": "Shell command from a string", "reference": "CWE-78"},
  {"id": "CMD-SUBPROCESS-SHELL", "pattern": "subprocess\\.(run|call|check_call|check_output|Popen|getoutput|getstatusoutput)\\s*\\([^;\\n]*shell\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "High", "description": "subprocess with shell=True", "reference": "CWE-78"},
  {"id": "CMD-SUBPROCESS-STRING", "pattern": "subprocess\\.(run|call|check_call|check_output|Popen)\\s*\\(\\s*(f[\"']|[\"'][^\"']*[\"']\\s*(%|\\+|\\.format)|[A-Za-z_]\\w*\\s*[,)])", "globs": ["*.py"], "severity_hint": "Medium", "description": "subprocess with a string or variable command - trace it", "reference": "CWE-78"},
  {"id": "PATH-JOIN-INPUT", "pattern": "os\\.path\\.join\\s*\\([^\\n]*(request\\.|req\\.|kwargs|params|\\.name\\b|filename|file_name|\\bname\\b|\\bpath\\b|user)", "globs": ["*.py"], "severity_hint": "High", "description": "os.path.join with a request-derived segment (absolute segment replaces the root)", "reference": "CWE-22"},
  {"id": "PATH-OPEN-VAR", "pattern": "\\b(open|send_file|FileResponse|os\\.remove|os\\.unlink|shutil\\.(copy|copyfile|move|rmtree)|default_storage\\.(open|delete|save))\\s*\\(\\s*[^'\"\\)]", "globs": ["*.py"], "severity_hint": "Medium", "description": "File API with a non-literal path - confirm it cannot be steered", "reference": "CWE-22"},
  {"id": "PATH-PATHLIB-INPUT", "pattern": "Path\\s*\\([^\\n]*\\)\\s*/\\s*(request|req|kwargs|params|name|filename|file_name|user)", "globs": ["*.py"], "severity_hint": "High", "description": "pathlib join with input (needs resolve() + relative_to check)", "reference": "CWE-22"},
  {"id": "PATH-EXTRACTALL", "pattern": "\\.extractall\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Archive extraction (zip/tar slip) - check member names or filter=", "reference": "CWE-22"},
  {"id": "LDAP-FILTER-DYNAMIC", "pattern": "(search_s|search_ext|search_ext_s|\\.search)\\s*\\([^\\n]*(f[\"']|%\\s*[\\(A-Za-z_]|\\.format\\(|\\+)", "globs": ["*.py"], "severity_hint": "High", "description": "LDAP filter built from strings (use escape_filter_chars)", "reference": "CWE-90"},
  {"id": "XPATH-DYNAMIC", "pattern": "\\.(xpath|findall|find|iterfind)\\s*\\(\\s*(f[\"']|[\"'][^\"']*[\"']\\s*(%|\\+|\\.format)|[A-Za-z_]\\w*\\s*\\))", "globs": ["*.py"], "severity_hint": "Medium", "description": "XPath built from strings", "reference": "CWE-643"},
  {"id": "XXE-PARSER", "pattern": "(resolve_entities\\s*=\\s*True|xml\\.dom\\.minidom\\.parse|xml\\.etree\\.ElementTree\\.(parse|fromstring)|xml\\.sax\\.(parse|make_parser)|lxml\\.etree\\.(parse|fromstring|XMLParser))", "globs": ["*.py"], "severity_hint": "Medium", "description": "XML parsed without defusedxml - check for untrusted input", "reference": "CWE-611"},
  {"id": "TMPL-FROM-STRING", "pattern": "(Template\\s*\\(\\s*[A-Za-z_]|from_string\\s*\\(\\s*[A-Za-z_]|render_template_string\\s*\\(\\s*[A-Za-z_]|Environment\\s*\\(\\s*\\)\\.from_string)", "globs": ["*.py"], "severity_hint": "High", "description": "Template compiled from a runtime string (SSTI)", "reference": "CWE-1336"},
  {"id": "TMPL-EVAL", "pattern": "\\b(eval|exec|compile)\\s*\\(\\s*[^'\"\\)]", "globs": ["*.py"], "severity_hint": "High", "description": "eval/exec on a non-literal", "reference": "CWE-95"},
  {"id": "TMPL-FORMAT-USER", "pattern": "(request\\.[A-Za-z_.\\[\\]'\"]+|user_\\w+|template_str\\w*)\\.format\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "User-supplied format string (attribute access via {0.__class__})", "reference": "CWE-134"},
  {"id": "SSRF-REQUESTS-INPUT", "pattern": "(requests|httpx|session|client|urllib\\.request|aiohttp\\.ClientSession\\(\\))\\.(get|post|put|delete|head|request|urlopen)\\s*\\(\\s*(f[\"']|request\\.|data\\[|params\\[|kwargs|[A-Za-z_]*url\\w*|[A-Za-z_]*uri\\w*|link|target|endpoint)", "globs": ["*.py"], "severity_hint": "High", "description": "Outbound HTTP to a URL derived from input", "reference": "CWE-918"},
  {"id": "SSRF-URLOPEN", "pattern": "\\burlopen\\s*\\(\\s*[^'\"\\)]", "globs": ["*.py"], "severity_hint": "Medium", "description": "urlopen with a non-literal URL", "reference": "CWE-918"},
  {"id": "DESER-PICKLE", "pattern": "\\b(pickle|cPickle|dill|shelve|marshal)\\.(load|loads|open)\\s*\\(|jsonpickle\\.decode\\s*\\(|read_pickle\\s*\\(|allow_pickle\\s*=\\s*True|torch\\.load\\s*\\(", "globs": ["*.py"], "severity_hint": "Critical", "description": "pickle-family deserialization (code execution on untrusted input)", "reference": "CWE-502"},
  {"id": "DESER-YAML-UNSAFE", "pattern": "yaml\\.(load|unsafe_load|full_load)\\s*\\(", "globs": ["*.py"], "severity_hint": "High", "description": "yaml.load without SafeLoader (confirm Loader= argument)", "reference": "CWE-502"},
  {"id": "DESER-PICKLE-SERIALIZER", "pattern": "(PickleSerializer|accept_content\\s*=\\s*\\[[^\\]]*pickle)", "globs": ["*.py"], "severity_hint": "High", "description": "Pickle used for sessions or Celery messages", "reference": "CWE-502"}
]
