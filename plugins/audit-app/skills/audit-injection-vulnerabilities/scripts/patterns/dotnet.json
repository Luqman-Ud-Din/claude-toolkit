[
  {"id": "SQL-RAW-INTERP", "pattern": "(FromSqlRaw|ExecuteSqlRaw(Async)?|SqlQueryRaw<[^>]*>)\\s*\\(\\s*\\$\"", "globs": ["*.cs"], "severity_hint": "High", "description": "Interpolated string passed to a *Raw EF Core API (values are inlined, not parameterized)", "reference": "CWE-89"},
  {"id": "SQL-RAW-CONCAT", "pattern": "(FromSqlRaw|ExecuteSqlRaw(Async)?|SqlQueryRaw<[^>]*>)\\s*\\(\\s*\"[^\"]*\"\\s*\\+", "globs": ["*.cs"], "severity_hint": "High", "description": "Raw EF Core SQL built by string concatenation", "reference": "CWE-89"},
  {"id": "SQL-RAW-VAR", "pattern": "(FromSqlRaw|ExecuteSqlRaw(Async)?|SqlQueryRaw<[^>]*>)\\s*\\(\\s*[A-Za-z_]\\w*\\s*[,)]", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Raw EF Core SQL taken from a variable - trace how the variable is built", "reference": "CWE-89"},
  {"id": "SQL-KEYWORD-CONCAT", "pattern": "\"[^\"]*\\b(SELECT|INSERT|UPDATE|DELETE|EXEC|EXECUTE|ORDER\\s+BY|WHERE|FROM|VALUES)\\b[^\"]*\"\\s*\\+", "globs": ["*.cs"], "severity_hint": "High", "description": "SQL text literal concatenated with a value", "reference": "CWE-89"},
  {"id": "SQL-INTERP-TEXT", "pattern": "(?<!FromSqlInterpolated\\()(?<!ExecuteSqlInterpolated\\()(?<!ExecuteSqlInterpolatedAsync\\()(?<!SqlQuery<T>\\()\\$\"[^\"]*\\b(SELECT|INSERT|UPDATE|DELETE|EXEC|ORDER\\s+BY)\\b[^\"]*\\{", "globs": ["*.cs"], "severity_hint": "High", "description": "Interpolated SQL string outside the *Interpolated EF APIs", "reference": "CWE-89"},
  {"id": "SQL-STRING-FORMAT", "pattern": "string\\.Format\\s*\\(\\s*\"[^\"]*\\b(SELECT|INSERT|UPDATE|DELETE|EXEC|ORDER\\s+BY)\\b", "globs": ["*.cs"], "severity_hint": "High", "description": "SQL built with string.Format", "reference": "CWE-89"},
  {"id": "SQL-COMMAND-TEXT", "pattern": "new\\s+(Sql|Npgsql|MySql|Oracle|SQLite|Db)Command\\s*\\(\\s*(\\$\"|\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*[,)])", "globs": ["*.cs"], "severity_hint": "Medium", "description": "ADO.NET command whose text is not a plain literal - check for parameters", "reference": "CWE-89"},
  {"id": "SQL-DAPPER-DYNAMIC", "pattern": "\\.(Query|QueryAsync|Execute|ExecuteAsync|QueryFirst\\w*|QuerySingle\\w*|ExecuteScalar\\w*)(<[^>]*>)?\\s*\\(\\s*(\\$\"|\"[^\"]*\"\\s*\\+)", "globs": ["*.cs"], "severity_hint": "High", "description": "Dapper query text interpolated or concatenated", "reference": "CWE-89"},
  {"id": "SQL-EXEC-DYNAMIC", "pattern": "(sp_executesql|\\bEXEC\\s*\\(\\s*@)", "globs": ["*.cs", "*.sql"], "severity_hint": "Medium", "description": "Dynamic SQL executed inside the database - check how @sql is assembled", "reference": "CWE-89"},
  {"id": "NOSQL-RAW-FILTER", "pattern": "(BsonDocument\\.Parse\\s*\\(|\\$where|new\\s+QueryDefinition\\s*\\(\\s*(\\$\"|\"[^\"]*\"\\s*\\+))", "globs": ["*.cs"], "severity_hint": "High", "description": "Mongo/Cosmos query built from raw text", "reference": "CWE-943"},
  {"id": "CMD-PROCESS-START", "pattern": "Process\\.Start\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "External process launched - trace FileName and Arguments", "reference": "CWE-78"},
  {"id": "CMD-SHELL-STRING", "pattern": "(FileName\\s*=\\s*\"|Process\\.Start\\s*\\(\\s*\")(cmd(\\.exe)?|/bin/(ba)?sh|bash|sh|powershell(\\.exe)?|pwsh)\"", "globs": ["*.cs"], "severity_hint": "High", "description": "A shell is launched; any interpolated argument is command injection", "reference": "CWE-78"},
  {"id": "CMD-ARGS-DYNAMIC", "pattern": "Arguments\\s*=\\s*(\\$\"|\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*\\+)", "globs": ["*.cs"], "severity_hint": "High", "description": "Process arguments built from a string (use ArgumentList)", "reference": "CWE-78"},
  {"id": "CMD-USE-SHELL-EXECUTE", "pattern": "UseShellExecute\\s*=\\s*true", "globs": ["*.cs"], "severity_hint": "Medium", "description": "UseShellExecute=true hands the value to the OS shell", "reference": "CWE-78"},
  {"id": "PATH-COMBINE-INPUT", "pattern": "Path\\.Combine\\s*\\([^;]*(Request\\.|model\\.|request\\.|dto\\.|input\\.|\\.FileName|fileName|filename|\\bname\\b|Query\\[|Form\\[|Headers\\[)", "globs": ["*.cs"], "severity_hint": "High", "description": "Path.Combine with a request-derived segment (absolute or ../ segment escapes the root)", "reference": "CWE-22"},
  {"id": "PATH-FILE-API", "pattern": "(File\\.(ReadAll\\w+|WriteAll\\w+|Delete|OpenRead|OpenWrite|Open|Copy|Move|Exists|AppendAll\\w+)|new\\s+FileStream|Directory\\.(GetFiles|Delete|CreateDirectory|EnumerateFiles)|PhysicalFile\\s*\\(|new\\s+StreamReader\\s*\\(\\s*[A-Za-z_])\\s*\\(?", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Filesystem access - confirm the path cannot be steered by the caller", "reference": "CWE-22"},
  {"id": "PATH-FORMFILE-NAME", "pattern": "\\.FileName\\b(?!\\s*=)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Uploaded file name used - must be reduced to Path.GetFileName and re-generated", "reference": "CWE-22"},
  {"id": "LDAP-FILTER-DYNAMIC", "pattern": "(DirectorySearcher|SearchRequest|\\.Filter\\s*=\\s*(\\$\"|\"[^\"]*\"\\s*\\+)|DirectoryEntry\\s*\\(\\s*(\\$\"|\"[^\"]*\"\\s*\\+))", "globs": ["*.cs"], "severity_hint": "High", "description": "LDAP filter or DN built from strings", "reference": "CWE-90"},
  {"id": "XPATH-DYNAMIC", "pattern": "(Select(Single)?Nodes?|XPathExpression\\.Compile|Evaluate)\\s*\\(\\s*(\\$\"|\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*\\))", "globs": ["*.cs"], "severity_hint": "Medium", "description": "XPath built from strings", "reference": "CWE-643"},
  {"id": "XXE-RESOLVER", "pattern": "(XmlResolver\\s*=\\s*new|DtdProcessing\\s*=\\s*DtdProcessing\\.Parse)", "globs": ["*.cs"], "severity_hint": "High", "description": "XML parser allows DTD/external entities", "reference": "CWE-611"},
  {"id": "TMPL-DYNAMIC", "pattern": "(Razor\\.Parse\\s*\\(|RunCompile\\s*\\(|Template\\.Parse\\s*\\(|Handlebars\\.Compile\\s*\\(|Scriban)", "globs": ["*.cs"], "severity_hint": "High", "description": "Template engine compiling a string - confirm the template source is not user text", "reference": "CWE-1336"},
  {"id": "TMPL-FORMAT-STRING", "pattern": "string\\.Format\\s*\\(\\s*(model|request|dto|input)\\.", "globs": ["*.cs"], "severity_hint": "Medium", "description": "User-supplied format string", "reference": "CWE-134"},
  {"id": "SSRF-HTTP-USER-URL", "pattern": "\\.(GetAsync|GetStringAsync|GetStreamAsync|GetByteArrayAsync|PostAsync|PutAsync|SendAsync|DownloadString\\w*|DownloadFile\\w*|DownloadData\\w*)\\s*\\(\\s*(\\$\"|model\\.|request\\.|dto\\.|input\\.|[A-Za-z_]*[uU]r[lL]\\b|[A-Za-z_]*[uU]ri\\b|link\\b)", "globs": ["*.cs"], "severity_hint": "High", "description": "Outbound HTTP request whose URL is a variable - trace to a request field", "reference": "CWE-918"},
  {"id": "SSRF-WEBREQUEST", "pattern": "(WebRequest\\.Create\\s*\\(|new\\s+WebClient\\s*\\(|new\\s+HttpRequestMessage\\s*\\([^,]*,\\s*(model|request|dto|input|\\w*[uU]rl))", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Legacy or explicit request object - check URL origin", "reference": "CWE-918"},
  {"id": "SSRF-NEW-URI-INPUT", "pattern": "new\\s+Uri\\s*\\(\\s*(model|request|dto|input|\\w*[uU]rl)\\b", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Uri built from input - check for scheme and host allow-list", "reference": "CWE-918"},
  {"id": "DESER-BINARYFORMATTER", "pattern": "\\b(BinaryFormatter|SoapFormatter|NetDataContractSerializer|LosFormatter|ObjectStateFormatter|SimpleTypeResolver)\\b", "globs": ["*.cs"], "severity_hint": "Critical", "description": "Type-carrying .NET serializer (remote code execution on untrusted input)", "reference": "CWE-502"},
  {"id": "DESER-TYPENAMEHANDLING", "pattern": "TypeNameHandling\\s*=\\s*TypeNameHandling\\.(All|Auto|Objects|Arrays)", "globs": ["*.cs"], "severity_hint": "High", "description": "Newtonsoft polymorphic deserialization enabled", "reference": "CWE-502"},
  {"id": "DESER-TYPE-GETTYPE", "pattern": "Type\\.GetType\\s*\\(\\s*(model|request|dto|input|[A-Za-z_]\\w*)\\s*\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Type resolved from a string - check the string source", "reference": "CWE-502"}
]
