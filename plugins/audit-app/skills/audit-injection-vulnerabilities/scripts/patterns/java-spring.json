[
  {"id": "SQL-JPQL-CONCAT", "pattern": "(createQuery|createNativeQuery|createSQLQuery)\\s*\\(\\s*(\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*[,)]|String\\.format\\()", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "JPA/Hibernate query text concatenated or taken from a variable", "reference": "CWE-89"},
  {"id": "SQL-JDBC-CONCAT", "pattern": "(jdbcTemplate|jdbc|template|namedParameterJdbcTemplate)\\.(query|queryForObject|queryForList|queryForMap|update|execute|batchUpdate)\\s*\\(\\s*(\"[^\"]*\"\\s*\\+|String\\.format\\(|[A-Za-z_]\\w*\\s*[,)])", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "JdbcTemplate SQL not a plain literal", "reference": "CWE-89"},
  {"id": "SQL-STATEMENT", "pattern": "\\.(createStatement\\s*\\(\\s*\\)|execute(Query|Update)?\\s*\\(\\s*(\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*\\)))", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "java.sql.Statement with dynamic text (use PreparedStatement)", "reference": "CWE-89"},
  {"id": "SQL-KEYWORD-CONCAT", "pattern": "\"[^\"]*\\b(SELECT|INSERT|UPDATE|DELETE|ORDER\\s+BY|WHERE|FROM)\\b[^\"]*\"\\s*\\+", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "SQL text literal concatenated with a value", "reference": "CWE-89"},
  {"id": "SQL-KOTLIN-TEMPLATE", "pattern": "\"[^\"]*\\b(SELECT|INSERT|UPDATE|DELETE|ORDER\\s+BY|WHERE)\\b[^\"]*\\$\\{?[A-Za-z_]", "globs": ["*.kt"], "severity_hint": "High", "description": "Kotlin string template inside SQL text", "reference": "CWE-89"},
  {"id": "SQL-MYBATIS-DOLLAR", "pattern": "\\$\\{[A-Za-z_][\\w.]*\\}", "globs": ["*Mapper.xml", "*mapper.xml", "*Mapper.java", "*Dao.xml"], "severity_hint": "High", "description": "MyBatis ${} substitution (unbound text) - use #{} or allow-list", "reference": "CWE-89"},
  {"id": "SQL-QUERY-ANNOTATION-CONCAT", "pattern": "@Query\\s*\\([^)]*\"\\s*\\+", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "@Query with concatenated text (constants only unless a variable is involved)", "reference": "CWE-89"},
  {"id": "NOSQL-RAW-QUERY", "pattern": "(new\\s+BasicQuery\\s*\\(|\\$where|wrapperQuery\\s*\\(|Document\\.parse\\s*\\(\\s*[A-Za-z_])", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Mongo/Elasticsearch query from raw JSON text", "reference": "CWE-943"},
  {"id": "CMD-RUNTIME-EXEC", "pattern": "Runtime\\.getRuntime\\s*\\(\\s*\\)\\.exec\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Runtime.exec - string form goes through a tokenizer; trace arguments", "reference": "CWE-78"},
  {"id": "CMD-PROCESSBUILDER-SHELL", "pattern": "ProcessBuilder\\s*\\(\\s*(\"(/bin/)?(ba)?sh\"|\"cmd(\\.exe)?\"|\"powershell\"|[A-Za-z_]\\w*\\s*\\+|\"[^\"]*\"\\s*\\+)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "ProcessBuilder invoking a shell or built from concatenation", "reference": "CWE-78"},
  {"id": "CMD-COMMONS-EXEC", "pattern": "CommandLine\\.parse\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Apache Commons Exec parsing a command string", "reference": "CWE-78"},
  {"id": "PATH-FILE-INPUT", "pattern": "(new\\s+File\\s*\\(|Paths\\.get\\s*\\(|Path\\.of\\s*\\(|FileSystemResource\\s*\\(|resolve\\s*\\()\\s*[^;]*(request\\.|req\\.|param|getOriginalFilename|fileName|filename|\\bname\\b|\\bpath\\b|\\+)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "File path built from a request-derived value", "reference": "CWE-22"},
  {"id": "PATH-FILE-API", "pattern": "Files\\.(readAllBytes|readAllLines|newInputStream|newOutputStream|write|delete|copy|move|readString|writeString|exists|list|walk)\\s*\\(|new\\s+File(Input|Output)Stream\\s*\\(|transferTo\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Filesystem access - confirm the path cannot be steered by the caller", "reference": "CWE-22"},
  {"id": "PATH-CLASSPATH-DYNAMIC", "pattern": "(ClassPathResource|getResource(AsStream)?)\\s*\\(\\s*(\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*\\))", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Resource loaded by a dynamic name", "reference": "CWE-22"},
  {"id": "LDAP-FILTER-DYNAMIC", "pattern": "(ldapTemplate|ctx|context)\\.search\\s*\\([^;]*(\"[^\"]*\"\\s*\\+|String\\.format\\(|\\$\\{)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "LDAP filter concatenated (use LdapQueryBuilder / escape)", "reference": "CWE-90"},
  {"id": "XPATH-DYNAMIC", "pattern": "(xpath|xPath|XPath\\w*)\\.(evaluate|compile)\\s*\\(\\s*(\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*\\s*[,)]|String\\.format\\()", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "XPath expression built from strings", "reference": "CWE-643"},
  {"id": "XXE-PARSER", "pattern": "(DocumentBuilderFactory|SAXParserFactory|XMLInputFactory|TransformerFactory|SchemaFactory)\\.newInstance\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "XML parser factory - confirm disallow-doctype-decl / external entities disabled", "reference": "CWE-611"},
  {"id": "TMPL-DYNAMIC", "pattern": "(new\\s+Template\\s*\\([^;]*StringReader|Velocity\\.evaluate\\s*\\(|renderString\\s*\\(|templateEngine\\.process\\s*\\(\\s*[A-Za-z_]|parseExpression\\s*\\(\\s*[A-Za-z_]|MessageFormat\\.format\\s*\\(\\s*[A-Za-z_])", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Template or expression compiled from a runtime string (SSTI / SpEL injection)", "reference": "CWE-1336"},
  {"id": "SSRF-HTTP-CLIENT", "pattern": "(restTemplate|template|webClient|client)\\.(getForObject|getForEntity|postForObject|postForEntity|exchange|execute|get|post|uri)\\s*\\(\\s*(\"[^\"]*\"\\s*\\+|[A-Za-z_]\\w*[uU]r[lL]\\w*|request\\.|req\\.|dto\\.|body\\.|params\\.)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Outbound HTTP to a URL derived from input", "reference": "CWE-918"},
  {"id": "SSRF-NEW-URL", "pattern": "(new\\s+URL\\s*\\(|URI\\.create\\s*\\(|HttpRequest\\.newBuilder\\s*\\(|ImageIO\\.read\\s*\\(\\s*new\\s+URL)\\s*\\(?\\s*([A-Za-z_]\\w*|\"[^\"]*\"\\s*\\+)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "URL object built from a variable - trace its source", "reference": "CWE-918"},
  {"id": "DESER-OBJECTINPUTSTREAM", "pattern": "(new\\s+ObjectInputStream\\s*\\(|XMLDecoder\\s*\\(|\\.fromXML\\s*\\(|HttpInvokerServiceExporter|readObject\\s*\\(\\s*\\))", "globs": ["*.java", "*.kt"], "severity_hint": "Critical", "description": "Java native/XStream deserialization of a stream", "reference": "CWE-502"},
  {"id": "DESER-JACKSON-DEFAULT-TYPING", "pattern": "(enableDefaultTyping\\s*\\(|activateDefaultTyping\\s*\\(|JsonTypeInfo\\.Id\\.CLASS|JsonTypeInfo\\.Id\\.MINIMAL_CLASS)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Jackson polymorphic typing enabled", "reference": "CWE-502"},
  {"id": "DESER-YAML-UNSAFE", "pattern": "new\\s+Yaml\\s*\\(\\s*\\)|new\\s+Yaml\\s*\\(\\s*new\\s+Constructor\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "SnakeYAML without SafeConstructor (check version >= 2.0)", "reference": "CWE-502"}
]
