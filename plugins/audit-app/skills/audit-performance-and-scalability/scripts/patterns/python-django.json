[
  {"id": "BLOCK-SYNC-IN-ASYNC", "pattern": "^\\s*async\\s+def\\s+\\w+[\\s\\S]{0,600}?(requests\\.(get|post)|time\\.sleep|subprocess\\.run|open\\s*\\()", "globs": ["*.py"], "severity_hint": "High", "description": "Blocking call inside an async def - stalls the event loop", "reference": "CWE-400"},
  {"id": "BLOCK-SLEEP", "pattern": "^\\s+time\\.sleep\\s*\\(", "globs": ["views.py", "*view*.py", "api*.py", "*service*.py"], "severity_hint": "Medium", "description": "sleep on a request path", "reference": "CWE-400"},
  {"id": "SEQ-REQUESTS-CALL", "pattern": "^\\s*\\w+\\s*=\\s*(requests|session|client|httpx|self\\.client|self\\.\\w+_client)\\.(get|post|put|patch|delete|request)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Outbound HTTP call - consecutive independent ones should run via ThreadPoolExecutor/asyncio.gather", "reference": "CWE-1050"},
  {"id": "SEQ-REQUESTS-IN-LOOP", "pattern": "^\\s{8,}\\w*\\s*=?\\s*(requests|session|client|httpx)\\.(get|post|put|request)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Outbound call at loop indentation - serial fan-out", "reference": "CWE-1050"},
  {"id": "CACHE-CONFIG", "pattern": "^CACHES\\s*=|django_redis|RedisCache|MemcachedCache|cache_page|cache\\.get_or_set|cache\\.get\\s*\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "Cache usage present - absence repo-wide is a CACHE finding", "reference": "CWE-400"},
  {"id": "CACHE-LOCMEM", "pattern": "LocMemCache", "globs": ["settings*.py", "*.py"], "severity_hint": "Medium", "description": "LocMemCache - per process; incoherent across workers/instances", "reference": "CWE-400"},
  {"id": "CACHE-NO-INVALIDATION", "pattern": "cache\\.(delete|delete_many|clear|delete_pattern)\\s*\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "Cache invalidation present - absence while caching exists means no trigger", "reference": "CWE-400"},
  {"id": "COMPRESS-GZIP-MIDDLEWARE", "pattern": "GZipMiddleware|flask_compress|Compress\\s*\\(\\s*app|GZipMiddleware\\s*,|add_middleware\\s*\\(\\s*GZipMiddleware", "globs": ["*.py"], "severity_hint": "Info", "description": "Compression middleware present - absence in settings/app is a COMPRESS finding", "reference": "CWE-400"},
  {"id": "PAYLOAD-FIELDS-ALL", "pattern": "fields\\s*=\\s*['\"]__all__['\"]|depth\\s*=\\s*[1-9]", "globs": ["serializers.py", "*serializer*.py"], "severity_hint": "Medium", "description": "Serializer exposes every column / nested depth - over-fetching on the wire", "reference": "CWE-400"},
  {"id": "PAYLOAD-VALUES-WHOLE", "pattern": "JsonResponse\\s*\\(\\s*list\\s*\\(|list\\s*\\(\\s*\\w+\\.objects\\.(all|filter|values)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Whole queryset serialised", "reference": "CWE-400"},
  {"id": "POOL-CONN-MAX-AGE", "pattern": "CONN_MAX_AGE|CONN_HEALTH_CHECKS", "globs": ["settings*.py"], "severity_hint": "Info", "description": "Persistent DB connections configured - absence means a new connection per request", "reference": "CWE-1072"},
  {"id": "POOL-REQUESTS-NO-SESSION", "pattern": "^\\s+requests\\.(get|post|put|patch|delete)\\s*\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "requests.* without a Session - new TCP/TLS per call", "reference": "CWE-1072"},
  {"id": "TIMEOUT-REQUESTS-NO-TIMEOUT", "pattern": "requests\\.(get|post|put|patch|delete|request)\\s*\\((?![^)]*timeout)", "globs": ["*.py"], "severity_hint": "High", "description": "requests call without timeout= - can block forever", "reference": "CWE-1088"},
  {"id": "TIMEOUT-HTTPX-NO-TIMEOUT", "pattern": "httpx\\.(Client|AsyncClient)\\s*\\((?![^)]*timeout)", "globs": ["*.py"], "severity_hint": "Low", "description": "httpx client with default timeout (5 s) - confirm it suits the dependency", "reference": "CWE-1088"},
  {"id": "TIMEOUT-RETRY-PRESENT", "pattern": "urllib3\\.util\\.retry|Retry\\s*\\(|tenacity|pybreaker|backoff\\.on_exception", "globs": ["*.py"], "severity_hint": "Info", "description": "Retry/breaker present - inventory", "reference": "CWE-1088"},
  {"id": "ALLOC-LIST-QUERYSET", "pattern": "list\\s*\\(\\s*\\w+\\.objects\\.", "globs": ["*.py"], "severity_hint": "Low", "description": "Queryset materialised into a list", "reference": "CWE-400"},
  {"id": "ALLOC-PANDAS-IN-VIEW", "pattern": "pd\\.(read_|DataFrame)\\s*\\(", "globs": ["views.py", "*view*.py", "api*.py"], "severity_hint": "Low", "description": "pandas on a request path", "reference": "CWE-400"},
  {"id": "INLINE-BG-WORK", "pattern": "send_mail\\s*\\(|EmailMessage\\s*\\(|\\.send\\s*\\(\\s*\\)|HTML\\s*\\([^)]*\\)\\.write_pdf|Image\\.open\\s*\\(|Workbook\\s*\\(\\)", "globs": ["views.py", "*view*.py", "api*.py", "*viewset*.py"], "severity_hint": "Medium", "description": "Email/PDF/image/Excel work inside a view - move to Celery/RQ", "reference": "CWE-400"},
  {"id": "INLINE-BG-THREAD", "pattern": "threading\\.Thread\\s*\\([^)]*\\)\\.start\\s*\\(|Thread\\s*\\(\\s*target\\s*=", "globs": ["*.py"], "severity_hint": "Medium", "description": "Raw thread as background work - lost on restart, no retry", "reference": "CWE-400"},
  {"id": "STATE-SESSION-ENGINE", "pattern": "SESSION_ENGINE\\s*=\\s*['\"]django\\.contrib\\.sessions\\.backends\\.(file|cache)['\"]", "globs": ["settings*.py"], "severity_hint": "High", "description": "File or cache session engine - per instance unless the cache is shared (Redis)", "reference": "CWE-400"},
  {"id": "STATE-FILE-STORAGE", "pattern": "FileSystemStorage|DEFAULT_FILE_STORAGE\\s*=\\s*['\"]django\\.core\\.files\\.storage", "globs": ["*.py"], "severity_hint": "Medium", "description": "Local file storage for uploads - not shared across instances", "reference": "CWE-400"},
  {"id": "STATE-MODULE-DICT", "pattern": "^_?\\w*(cache|CACHE|store|STORE|sessions|SESSIONS|registry|REGISTRY)\\w*\\s*(:\\s*\\w+)?\\s*=\\s*(\\{\\}|dict\\(\\)|\\[\\])", "globs": ["*.py"], "severity_hint": "Medium", "description": "Module-level cache/store - per process state", "reference": "CWE-400"},
  {"id": "STATE-RATELIMIT-LOCMEM", "pattern": "ratelimit\\s*\\(|RATELIMIT_USE_CACHE", "globs": ["*.py"], "severity_hint": "Low", "description": "Rate limiting - confirm it uses a shared cache, not LocMem", "reference": "CWE-400"},
  {"id": "STATE-BEAT-EVERY-INSTANCE", "pattern": "beat_schedule|CELERY_BEAT_SCHEDULE|@periodic_task", "globs": ["*.py"], "severity_hint": "Low", "description": "Celery beat schedule - beat must run on exactly one instance", "reference": "CWE-400"}
]
