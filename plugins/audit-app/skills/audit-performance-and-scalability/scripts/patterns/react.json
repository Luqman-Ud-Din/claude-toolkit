[
  {"id": "RENDER-BLOCK-SCRIPT", "pattern": "<script\\s+[^>]*src=(?![^>]*(defer|async|type=\"module\"))|strategy=\"beforeInteractive\"", "globs": ["index.html", "_document.tsx", "_document.jsx", "layout.tsx", "layout.jsx"], "severity_hint": "Medium", "description": "Blocking external script", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-STYLESHEET-3P", "pattern": "<link\\s+[^>]*rel=\"stylesheet\"[^>]*href=\"https?://", "globs": ["index.html", "_document.tsx", "layout.tsx"], "severity_hint": "Low", "description": "Third-party stylesheet - render-blocking cross-origin fetch", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-FONT-NOT-OPTIMIZED", "pattern": "fonts\\.googleapis\\.com", "globs": ["*.html", "*.tsx", "*.jsx", "*.css", "*.scss"], "severity_hint": "Low", "description": "Google Fonts via link - use next/font or self-host with font-display", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-NO-PRECONNECT", "pattern": "rel=\"preconnect\"|rel=\"dns-prefetch\"", "globs": ["index.html", "_document.tsx", "layout.tsx"], "severity_hint": "Info", "description": "Preconnect present - absence with a separate API origin is a finding", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-FETCH-IN-EFFECT", "pattern": "useEffect\\s*\\(\\s*\\(\\s*\\)\\s*=>\\s*\\{[\\s\\S]{0,200}?(fetch|axios|api|client)\\.(get|post)?\\s*\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Low", "description": "Fetch in useEffect - no dedup/cache; count per page, duplicates are CHATTY findings", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-USEQUERY", "pattern": "useQuery\\s*\\(|useSWR\\s*\\(|useInfiniteQuery\\s*\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Info", "description": "Query hook - deduped by key; check staleTime for reference data", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-STALE-ZERO", "pattern": "staleTime\\s*:\\s*0\\b|refetchOnWindowFocus\\s*:\\s*true", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Low", "description": "staleTime 0 / refetch on focus - refetch on every mount", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-POLL-FAST", "pattern": "refetchInterval\\s*:\\s*\\d{1,4}\\b|refreshInterval\\s*:\\s*\\d{1,4}\\b|setInterval\\s*\\([^,]+,\\s*\\d{1,4}\\s*\\)", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Polling faster than every 10 s", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-NO-DEBOUNCE", "pattern": "onChange=\\{[^}]*(fetch|search|query|load)\\w*\\(", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Fetch on every onChange - no debounce/deferred value", "reference": "CWE-400"},
  {"id": "CLIENT-CACHE-PRESENT", "pattern": "QueryClient\\s*\\(|SWRConfig|createApi\\s*\\(|staleTime\\s*:|unstable_cache|revalidate\\s*[:=]", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Info", "description": "Client/data cache present - absence with bare fetch is a CLIENT-CACHE finding", "reference": "CWE-400"},
  {"id": "CLIENT-CACHE-NO-STORE", "pattern": "cache\\s*:\\s*['\"]no-store['\"]", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Low", "description": "fetch with no-store - confirm the data is truly uncacheable", "reference": "CWE-400"},
  {"id": "RERENDER-CONTEXT-INLINE-VALUE", "pattern": "\\.Provider\\s+value=\\{\\{", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Medium", "description": "Context value object created inline - every consumer re-renders each render", "reference": "CWE-400"},
  {"id": "RERENDER-INLINE-OBJECT-PROP", "pattern": "\\s(style|options|config|params)=\\{\\{", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Info", "description": "Inline object prop - defeats memoised children", "reference": "CWE-400"},
  {"id": "RERENDER-SELECTOR-NEW-ARRAY", "pattern": "useSelector\\s*\\(\\s*\\(?\\s*\\w+\\s*\\)?\\s*=>\\s*[^)]*\\.(filter|map|slice|sort)\\s*\\(", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Medium", "description": "useSelector returning a new array - re-render on every store change; use createSelector", "reference": "CWE-400"},
  {"id": "RERENDER-INDEX-KEY", "pattern": "key=\\{\\s*(i|idx|index)\\s*\\}", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "Index used as key", "reference": "CWE-400"},
  {"id": "RERENDER-VIRTUALIZATION", "pattern": "react-window|react-virtualized|@tanstack/react-virtual|FixedSizeList|useVirtualizer", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js", "package.json"], "severity_hint": "Info", "description": "Virtualisation present - absence on large lists is a RERENDER finding", "reference": "CWE-400"},
  {"id": "IMAGE-RAW-IMG", "pattern": "<img\\s+(?![^>]*width=)[^>]*src=", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Low", "description": "img without width (CLS) - prefer next/image or explicit dimensions", "reference": "CWE-400"},
  {"id": "IMAGE-NO-LAZY", "pattern": "<img\\s+(?![^>]*loading=)[^>]*>", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Info", "description": "img without loading=lazy - decide per position", "reference": "CWE-400"},
  {"id": "IMAGE-UNOPTIMIZED", "pattern": "unoptimized\\s*:\\s*true|unoptimized(\\s|=)", "globs": ["next.config.*", "*.tsx"], "severity_hint": "Low", "description": "Next image optimisation disabled", "reference": "CWE-400"},
  {"id": "CWV-HEAVY-CLICK-HANDLER", "pattern": "onClick=\\{[^}]*(export|download|generate|print)\\w*", "globs": ["*.tsx", "*.jsx"], "severity_hint": "Info", "description": "Export/generate on click - confirm async/useTransition (INP)", "reference": "CWE-400"},
  {"id": "CWV-SSR-DISABLED", "pattern": "ssr\\s*:\\s*false", "globs": ["*.tsx", "*.jsx", "*.ts", "*.js"], "severity_hint": "Info", "description": "Dynamic import with ssr:false - LCP waits for JS on that component", "reference": "CWE-400"}
]
