[
  {"id": "RENDER-BLOCK-SCRIPT", "pattern": "<script\\s+[^>]*src=(?![^>]*(defer|async|type=\"module\"))", "globs": ["index.html", "app.html"], "severity_hint": "Medium", "description": "Blocking external script", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-HEAD-SCRIPT", "pattern": "script\\s*:\\s*\\[\\s*\\{(?![^}]*(defer|async|tagPosition))", "globs": ["nuxt.config.*"], "severity_hint": "Low", "description": "app.head.script without defer/async/tagPosition", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-STYLESHEET-3P", "pattern": "<link\\s+[^>]*rel=\"stylesheet\"[^>]*href=\"https?://|rel\\s*:\\s*['\"]stylesheet['\"][^}]*href\\s*:\\s*['\"]https?://", "globs": ["index.html", "nuxt.config.*"], "severity_hint": "Low", "description": "Third-party stylesheet - render-blocking", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-FONT-LINK", "pattern": "fonts\\.googleapis\\.com", "globs": ["*.html", "*.vue", "*.css", "*.scss", "nuxt.config.*"], "severity_hint": "Low", "description": "Google Fonts via link - use @nuxt/fonts or self-host", "reference": "CWE-400"},
  {"id": "RENDER-BLOCK-NO-PRECONNECT", "pattern": "preconnect|dns-prefetch", "globs": ["index.html", "nuxt.config.*"], "severity_hint": "Info", "description": "Preconnect present - absence with a separate API origin is a finding", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-FETCH-IN-MOUNT", "pattern": "onMounted\\s*\\(\\s*(async\\s*)?\\(\\s*\\)\\s*=>\\s*\\{[\\s\\S]{0,200}?(fetch|axios|\\$fetch|api|client)\\.(get|post)?\\s*\\(|mounted\\s*\\(\\s*\\)\\s*\\{[\\s\\S]{0,200}?(axios|fetch|\\$fetch|this\\.\\$http)", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Low", "description": "Fetch on mount - no dedup/cache; count per page, duplicates are CHATTY findings", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-USEFETCH-NO-KEY", "pattern": "use(Fetch|AsyncData|LazyFetch|LazyAsyncData)\\s*\\(\\s*[`'\"][^`'\"]*\\$\\{(?![^)]*key\\s*:)", "globs": ["*.vue", "*.ts"], "severity_hint": "Low", "description": "useFetch with dynamic URL and no key - cache miss every time", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-POLL-FAST", "pattern": "setInterval\\s*\\([^,]+,\\s*\\d{1,4}\\s*\\)|useIntervalFn\\s*\\([^,]+,\\s*\\d{1,4}\\s*\\)|refreshInterval\\s*:\\s*\\d{1,4}\\b", "globs": ["*.vue", "*.ts", "*.js"], "severity_hint": "Medium", "description": "Polling faster than every 10 s", "reference": "CWE-400"},
  {"id": "CALLS-PER-PAGE-WATCH-REFETCH", "pattern": "watch\\s*\\([^)]*\\)\\s*=>\\s*\\{?[\\s\\S]{0,120}?(fetch|\\$fetch|axios|refresh)\\s*\\((?![\\s\\S]{0,200}debounce)", "globs": ["*.vue", "*.ts"], "severity_hint": "Low", "description": "watch triggering a fetch without debounce", "reference": "CWE-400"},
  {"id": "CLIENT-CACHE-PRESENT", "pattern": "defineStore\\s*\\(|useQuery\\s*\\(|routeRules|swr\\s*:|isr\\s*:|getCachedData|useNuxtData", "globs": ["*.vue", "*.ts", "*.js", "nuxt.config.*"], "severity_hint": "Info", "description": "Client/data cache present - absence with bare fetch is a CLIENT-CACHE finding", "reference": "CWE-400"},
  {"id": "CLIENT-CACHE-STORE-NO-GUARD", "pattern": "async\\s+(load|fetch|get)\\w*\\s*\\([^)]*\\)\\s*\\{\\s*(this\\.\\w+\\s*=\\s*)?(await\\s+)?(\\$fetch|axios|api)", "globs": ["stores/*.ts", "store/*.ts", "*store*.ts"], "severity_hint": "Low", "description": "Store action fetches unconditionally - no 'already loaded' guard", "reference": "CWE-400"},
  {"id": "RERENDER-METHOD-IN-TEMPLATE", "pattern": "\\{\\{\\s*\\w+\\([^)]*\\)\\s*\\}\\}|:class=\"\\w+\\(|:style=\"\\w+\\(", "globs": ["*.vue"], "severity_hint": "Low", "description": "Method call in template - recomputed every render; use computed", "reference": "CWE-400"},
  {"id": "RERENDER-VFOR-NO-KEY", "pattern": "v-for=\"[^\"]*\"(?![^>]*:key)", "globs": ["*.vue"], "severity_hint": "Low", "description": "v-for without :key", "reference": "CWE-400"},
  {"id": "RERENDER-INDEX-KEY", "pattern": ":key=\"(i|idx|index)\"", "globs": ["*.vue"], "severity_hint": "Low", "description": "Index used as key", "reference": "CWE-400"},
  {"id": "RERENDER-DEEP-WATCH", "pattern": "deep\\s*:\\s*true", "globs": ["*.vue", "*.ts"], "severity_hint": "Low", "description": "Deep watcher - traverses the whole object on every change", "reference": "CWE-400"},
  {"id": "RERENDER-SHALLOWREF", "pattern": "shallowRef\\s*\\(|markRaw\\s*\\(|v-memo|vue-virtual-scroller|v-virtual-scroll|RecycleScroller", "globs": ["*.vue", "*.ts"], "severity_hint": "Info", "description": "Reactivity/virtualisation optimisations present - absence on large lists is a RERENDER finding", "reference": "CWE-400"},
  {"id": "IMAGE-RAW-IMG", "pattern": "<img\\s+(?![^>]*width=)[^>]*(src|:src)=", "globs": ["*.vue"], "severity_hint": "Low", "description": "img without width (CLS) - prefer NuxtImg or explicit dimensions", "reference": "CWE-400"},
  {"id": "IMAGE-NO-LAZY", "pattern": "<img\\s+(?![^>]*loading=)[^>]*>", "globs": ["*.vue"], "severity_hint": "Info", "description": "img without loading=lazy - decide per position", "reference": "CWE-400"},
  {"id": "CWV-SSR-DISABLED", "pattern": "ssr\\s*:\\s*false", "globs": ["nuxt.config.*"], "severity_hint": "Info", "description": "SSR disabled - LCP waits for JS + data", "reference": "CWE-400"},
  {"id": "CWV-HEAVY-CLICK-HANDLER", "pattern": "@click=\"(export|download|generate|print)\\w*", "globs": ["*.vue"], "severity_hint": "Info", "description": "Export/generate on click - confirm async (INP)", "reference": "CWE-400"}
]
