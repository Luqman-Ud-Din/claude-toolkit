[
  {"id": "BLOCK-SYNC-CALL", "pattern": "\\b(readFileSync|writeFileSync|existsSync|readdirSync|execSync|spawnSync|pbkdf2Sync|scryptSync|hashSync|compareSync|gzipSync|deflateSync|deasync)\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "High", "description": "Synchronous call - blocks the event loop for every request if on a request path", "reference": "CWE-400"},
  {"id": "BLOCK-AWAIT-IN-LOOP", "pattern": "^\\s{6,}(const|let|var)?\\s*\\w*\\s*=?\\s*await\\s+(?!Promise\\.)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "await at loop-body indentation - serial work over independent items", "reference": "CWE-1050"},
  {"id": "SEQ-AWAIT-OUTBOUND", "pattern": "^\\s*(const|let|var)\\s+\\w+\\s*=\\s*await\\s+(this\\.)?\\w*(client|Client|service|Service|api|Api|http|axios|fetch|gateway|Gateway)\\w*\\.\\w+\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "Awaited outbound call - consecutive independent ones should use Promise.all", "reference": "CWE-1050"},
  {"id": "SEQ-PROMISE-ALL-PRESENT", "pattern": "Promise\\.(all|allSettled)\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Parallel fan-out present - inventory (negative signal for SEQ)", "reference": "CWE-1050"},
  {"id": "CACHE-LAYER-PRESENT", "pattern": "cache-manager|CacheModule|CacheInterceptor|apicache|lru-cache|ioredis|node-cache|Cache-Control", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Cache layer present - absence repo-wide is a CACHE finding", "reference": "CWE-400"},
  {"id": "CACHE-NO-INVALIDATION", "pattern": "cache\\.(del|delete|reset|clear|invalidate)\\s*\\(|CACHE_MANAGER", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Cache invalidation present - absence while a cache exists means no trigger", "reference": "CWE-400"},
  {"id": "COMPRESS-MIDDLEWARE", "pattern": "compression\\s*\\(|@fastify/compress|koa-compress|fastifyCompress", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Compression middleware present - absence in app/main/server is a COMPRESS finding", "reference": "CWE-400"},
  {"id": "PAYLOAD-ORM-RESULT-RETURNED", "pattern": "res\\.(json|send)\\s*\\(\\s*await\\s+[^)]*\\.(findMany|find|findAll)\\s*\\(|return\\s+(await\\s+)?(this\\.)?\\w*(prisma|repo|repository|Repository|model|Model)\\w*(\\.\\w+)*\\.(findMany|find|findAll)\\s*\\(\\s*(\\)|\\{(?![^}]*\\bselect\\b))", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "ORM result returned without a select/projection - full entities on the wire", "reference": "CWE-400"},
  {"id": "PAYLOAD-INCLUDE-ALL", "pattern": "include\\s*:\\s*\\{[^}]*:\\s*true\\s*,[^}]*:\\s*true", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Multiple relations included - check the response needs them", "reference": "CWE-400"},
  {"id": "CHATTY-PER-ID-ONLY", "pattern": "(router|app)\\.get\\s*\\(\\s*['\"`][^'\"`]*/:id['\"`]|@Get\\s*\\(\\s*['\"]:id['\"]\\s*\\)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Per-id endpoint - if the client calls it per row, add a batch endpoint", "reference": "CWE-400"},
  {"id": "POOL-PG-MAX", "pattern": "new\\s+Pool\\s*\\(\\s*\\{(?![^}]*\\bmax\\b)|connection_limit=|pool\\s*:\\s*\\{\\s*max", "globs": ["*.ts", "*.js", "*.mjs", ".env*", "*.prisma"], "severity_hint": "Info", "description": "DB pool sizing - default 10 per worker; check against DB max_connections x workers x instances", "reference": "CWE-1072"},
  {"id": "POOL-KEEPALIVE-AGENT", "pattern": "new\\s+(http|https)\\.Agent\\s*\\(\\s*\\{[^}]*keepAlive\\s*:\\s*true|keepAliveTimeout\\s*=", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Keep-alive configured - inventory (absence = new TCP per upstream call on Node < 19; 502s behind ALB)", "reference": "CWE-1072"},
  {"id": "TIMEOUT-AXIOS-NO-TIMEOUT", "pattern": "axios\\.create\\s*\\(\\s*\\{(?![^}]*\\btimeout\\b)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "axios instance without timeout", "reference": "CWE-1088"},
  {"id": "TIMEOUT-FETCH-NO-SIGNAL", "pattern": "\\bfetch\\s*\\(\\s*[^,)]+\\s*(\\)|,\\s*\\{(?![^}]*signal)[^}]*\\})", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "fetch without an AbortSignal timeout", "reference": "CWE-1088"},
  {"id": "TIMEOUT-AXIOS-BARE-CALL", "pattern": "\\baxios\\.(get|post|put|delete|patch)\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "Bare axios call - uses global defaults (no timeout unless axios.defaults.timeout set)", "reference": "CWE-1088"},
  {"id": "TIMEOUT-BREAKER-PRESENT", "pattern": "opossum|cockatiel|axios-retry|p-retry|CircuitBreaker", "globs": ["*.ts", "*.js", "*.mjs", "package.json"], "severity_hint": "Info", "description": "Retry/circuit breaker present - inventory", "reference": "CWE-1088"},
  {"id": "ALLOC-JSON-STRINGIFY-LOOP", "pattern": "^\\s{6,}.*JSON\\.(stringify|parse)\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "JSON serialisation inside a loop", "reference": "CWE-400"},
  {"id": "ALLOC-CLONEDEEP", "pattern": "cloneDeep\\s*\\(|structuredClone\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "Deep clone on a request path", "reference": "CWE-400"},
  {"id": "INLINE-BG-WORK", "pattern": "(transporter|mailer|nodemailer)\\.(sendMail|send)\\s*\\(|puppeteer\\.launch\\s*\\(|\\bsharp\\s*\\(|new\\s+PDFDocument\\s*\\(|\\.toFile\\s*\\(", "globs": ["*controller*.ts", "*controller*.js", "*route*.ts", "*route*.js", "*handler*.ts"], "severity_hint": "Medium", "description": "Email/PDF/image work inside a request handler - move to a queue (bullmq)", "reference": "CWE-400"},
  {"id": "INLINE-BG-UNAWAITED", "pattern": "^\\s*(void\\s+)?(this\\.)?\\w+(Service|Client|Mailer|Queue)?\\.\\w+\\s*\\([^;]*\\)\\s*;\\s*//.*(fire|forget|background)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "Fire-and-forget promise as background work - lost on crash", "reference": "CWE-400"},
  {"id": "STATE-MEMORYSTORE-SESSION", "pattern": "express-session|session\\s*\\(\\s*\\{(?![^}]*\\bstore\\b)|new\\s+MemoryStore\\s*\\(|cookieSession", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "High", "description": "Session middleware - without a shared store (Redis) it is per process and breaks horizontal scaling", "reference": "CWE-400"},
  {"id": "STATE-SESSION-STORE-PRESENT", "pattern": "connect-redis|RedisStore|connect-mongo|MongoStore|connect-pg-simple", "globs": ["*.ts", "*.js", "*.mjs", "package.json"], "severity_hint": "Info", "description": "Shared session store present - downgrades STATE-MEMORYSTORE-SESSION", "reference": "CWE-400"},
  {"id": "STATE-MODULE-MAP", "pattern": "^\\s*(export\\s+)?(const|let)\\s+\\w*(cache|Cache|store|Store|sessions|users|registry)\\w*\\s*(:\\s*[\\w<>\\[\\], ]+)?\\s*=\\s*(new\\s+Map|\\{\\}|\\[\\])", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "Module-level cache/store - per-process state, incoherent across workers/instances", "reference": "CWE-400"},
  {"id": "STATE-RATELIMIT-MEMORY", "pattern": "rateLimit\\s*\\(\\s*\\{(?![^}]*\\bstore\\b)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "express-rate-limit without a shared store - limits are per worker", "reference": "CWE-400"},
  {"id": "STATE-LOCAL-UPLOADS", "pattern": "diskStorage\\s*\\(|dest\\s*:\\s*['\"](\\./)?(uploads|tmp|public)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "Uploads written to local disk - not shared across instances", "reference": "CWE-400"},
  {"id": "STATE-SOCKETIO-NO-ADAPTER", "pattern": "new\\s+Server\\s*\\([^)]*\\)(?![\\s\\S]{0,300}adapter)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "socket.io Server - confirm a Redis adapter for multi-instance", "reference": "CWE-400"},
  {"id": "STATE-CRON-EVERY-WORKER", "pattern": "cron\\.schedule\\s*\\(|new\\s+CronJob\\s*\\(|@Cron\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "In-process cron - runs on every worker/instance without a lock", "reference": "CWE-400"}
]
