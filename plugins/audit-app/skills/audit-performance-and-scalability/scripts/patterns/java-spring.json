[
  {"id": "BLOCK-REACTIVE-BLOCK", "pattern": "\\.block\\s*\\(|\\.blockFirst\\s*\\(|\\.blockLast\\s*\\(|\\.toFuture\\s*\\(\\)\\.get\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Blocking a reactive pipeline - fatal on WebFlux event loop, starvation on MVC", "reference": "CWE-400"},
  {"id": "BLOCK-FUTURE-GET", "pattern": "\\.get\\s*\\(\\s*\\)\\s*;|\\.join\\s*\\(\\s*\\)\\s*;|Thread\\.sleep\\s*\\(", "globs": ["*Service.java", "*Controller.java", "*Resource.java", "*.kt"], "severity_hint": "Medium", "description": "Future.get/join or sleep on a request path", "reference": "CWE-400"},
  {"id": "BLOCK-SYNCHRONIZED-HOT", "pattern": "public\\s+synchronized\\s+", "globs": ["*Service.java", "*Controller.java"], "severity_hint": "Medium", "description": "synchronized service method - serialises all requests through one lock", "reference": "CWE-400"},
  {"id": "SEQ-REMOTE-CALL", "pattern": "^\\s*(var|final)?\\s*\\w*\\s*\\w+\\s*=\\s*\\w*(restTemplate|webClient|client|Client|feign|Feign|gateway|Gateway)\\w*\\.(getFor\\w+|postFor\\w+|exchange|get|post|retrieve|call|fetch)\\w*\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Remote call - consecutive independent ones should use CompletableFuture.allOf / Mono.zip", "reference": "CWE-1050"},
  {"id": "SEQ-REMOTE-IN-LOOP", "pattern": "^\\s{12,}.*(restTemplate|webClient|client|feign)\\w*\\.(getFor\\w+|postFor\\w+|exchange|retrieve)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Remote call at loop indentation - serial fan-out", "reference": "CWE-1050"},
  {"id": "CACHE-ENABLED", "pattern": "@EnableCaching|@Cacheable|CacheManager", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Cache abstraction present - absence repo-wide is a CACHE finding", "reference": "CWE-400"},
  {"id": "CACHE-DEFAULT-MANAGER", "pattern": "ConcurrentMapCacheManager|SimpleCacheManager", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Per-instance unbounded cache manager - incoherent across instances", "reference": "CWE-400"},
  {"id": "CACHE-NO-EVICT", "pattern": "@CacheEvict|@CachePut", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Eviction present - absence while @Cacheable exists means no invalidation trigger", "reference": "CWE-400"},
  {"id": "COMPRESS-SETTING", "pattern": "server\\.compression\\.enabled\\s*[:=]|compression:\\s*$|enabled:\\s*true", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "Info", "description": "Compression setting - absence repo-wide is a COMPRESS finding", "reference": "CWE-400"},
  {"id": "PAYLOAD-ENTITY-RETURNED", "pattern": "public\\s+(ResponseEntity<)?(List<)?\\w+(Entity)?>?>?\\s+\\w+\\s*\\([^)]*\\)\\s*\\{\\s*$", "globs": ["*Controller.java", "*Resource.java"], "severity_hint": "Info", "description": "Controller return type - confirm DTO, not JPA entity", "reference": "CWE-400"},
  {"id": "PAYLOAD-JSON-INCLUSION", "pattern": "default-property-inclusion\\s*[:=]\\s*non_null", "globs": ["application*.yml", "application*.properties"], "severity_hint": "Info", "description": "Null-omitting serialisation present", "reference": "CWE-400"},
  {"id": "POOL-HIKARI-SIZE", "pattern": "maximum-pool-size\\s*[:=]|maximumPoolSize\\s*[:=(]", "globs": ["application*.yml", "application*.properties", "*.java", "*.kt"], "severity_hint": "Info", "description": "Hikari pool size - compare with tomcat.threads.max (default 10 vs 200)", "reference": "CWE-1072"},
  {"id": "POOL-ASYNC-UNBOUNDED", "pattern": "@EnableAsync(?![\\s\\S]{0,400}ThreadPoolTaskExecutor)|SimpleAsyncTaskExecutor|Executors\\.newCachedThreadPool", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Async without a bounded executor - unbounded threads under load", "reference": "CWE-400"},
  {"id": "TIMEOUT-RESTTEMPLATE-NEW", "pattern": "new\\s+RestTemplate\\s*\\(\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "RestTemplate with default (infinite) timeouts", "reference": "CWE-1088"},
  {"id": "TIMEOUT-WEBCLIENT-NO-TIMEOUT", "pattern": "WebClient\\.(create|builder)\\s*\\((?![^;]*(responseTimeout|HttpClient\\.create))", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "WebClient without responseTimeout on the same statement", "reference": "CWE-1088"},
  {"id": "TIMEOUT-RESILIENCE-PRESENT", "pattern": "@CircuitBreaker|@TimeLimiter|@Retry\\b|resilience4j|@Bulkhead", "globs": ["*.java", "*.kt", "application*.yml"], "severity_hint": "Info", "description": "Resilience4j present - inventory", "reference": "CWE-1088"},
  {"id": "TIMEOUT-FEIGN-NO-CONFIG", "pattern": "@FeignClient\\s*\\((?![^)]*configuration)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Feign client without explicit configuration - check feign.client.config timeouts", "reference": "CWE-1088"},
  {"id": "ALLOC-OBJECTMAPPER-PER-CALL", "pattern": "^(?!.*static).*new\\s+ObjectMapper\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "ObjectMapper constructed per call", "reference": "CWE-400"},
  {"id": "ALLOC-STRING-CONCAT-LOOP", "pattern": "^\\s{12,}\\w+\\s*\\+=\\s*\"", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "String concatenation in a loop", "reference": "CWE-400"},
  {"id": "INLINE-BG-WORK", "pattern": "(mailSender|javaMailSender)\\.send\\s*\\(|new\\s+(XSSFWorkbook|SXSSFWorkbook|PdfWriter|PdfDocument)\\s*\\(|ImageIO\\.(read|write)\\s*\\(", "globs": ["*Controller.java", "*Resource.java", "*Service.java"], "severity_hint": "Medium", "description": "Email/Excel/PDF/image work on the request path - move to @Async with bounded executor or a queue", "reference": "CWE-400"},
  {"id": "INLINE-BG-THREAD", "pattern": "new\\s+Thread\\s*\\([^)]*\\)\\s*\\.start\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Raw thread as background work - unbounded, lost on restart", "reference": "CWE-400"},
  {"id": "STATE-HTTPSESSION", "pattern": "HttpSession\\b|session\\.setAttribute\\s*\\(|@SessionAttributes|@SessionScope", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Servlet session used - requires spring-session store for multiple instances", "reference": "CWE-400"},
  {"id": "STATE-SESSION-STORE", "pattern": "spring\\.session\\.store-type|store-type\\s*:|spring-session-data-redis|spring-session-jdbc", "globs": ["application*.yml", "application*.properties", "pom.xml", "build.gradle*"], "severity_hint": "Info", "description": "Session store configured - absence with HttpSession usage is a STATE finding", "reference": "CWE-400"},
  {"id": "STATE-STATIC-CACHE", "pattern": "\\bstatic\\s+(final\\s+)?(Map|ConcurrentHashMap|HashMap|List|Set)<", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Static collection - per-instance state", "reference": "CWE-400"},
  {"id": "STATE-LOCAL-FILE", "pattern": "new\\s+File\\s*\\(\\s*\"(uploads|tmp|/tmp|data)|Files\\.write\\s*\\(\\s*Paths\\.get\\s*\\(\\s*\"", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Local filesystem writes as state", "reference": "CWE-400"},
  {"id": "STATE-SCHEDULED-NO-LOCK", "pattern": "@Scheduled\\s*\\((?![\\s\\S]{0,200}@SchedulerLock)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "@Scheduled without ShedLock - runs on every instance", "reference": "CWE-400"}
]
