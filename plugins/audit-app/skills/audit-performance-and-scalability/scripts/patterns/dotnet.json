[
  {"id": "BLOCK-SYNC-OVER-ASYNC", "pattern": "\\.Result\\b(?!\\s*=)|\\.Wait\\s*\\(\\s*\\)|GetAwaiter\\s*\\(\\s*\\)\\s*\\.GetResult\\s*\\(|Thread\\.Sleep\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "Blocking on async / sleeping in request path - thread-pool starvation", "reference": "CWE-400"},
  {"id": "BLOCK-SYNC-IO", "pattern": "File\\.(ReadAllText|ReadAllBytes|ReadAllLines|WriteAllText|WriteAllBytes)\\s*\\(|\\.CopyTo\\s*\\((?!.*Async)|HttpClient\\.Send\\s*\\(|\\.Send\\s*\\(\\s*request\\s*\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Synchronous I/O in code that is likely on a request path", "reference": "CWE-400"},
  {"id": "SEQ-AWAIT-PAIR", "pattern": "^\\s*(var\\s+)?\\w+\\s*=\\s*await\\s+_?\\w+(Client|Service|Http|Api|Gateway|client|service|http|api)\\w*\\.\\w+(Async)?\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Awaited outbound call - two or more consecutive with independent inputs should use Task.WhenAll", "reference": "CWE-1050"},
  {"id": "SEQ-AWAIT-IN-LOOP", "pattern": "^\\s{12,}(var\\s+)?\\w*\\s*=?\\s*await\\s+\\w+(Client|Service|Http|Api|client|service|http|api)\\w*\\.\\w+", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Awaited outbound call at loop indentation - serial fan-out", "reference": "CWE-1050"},
  {"id": "CACHE-NONE-REGISTERED", "pattern": "AddResponseCaching|AddOutputCache|AddMemoryCache|AddDistributedCache|AddStackExchangeRedisCache|AddHybridCache", "globs": ["Program.cs", "Startup.cs", "*Extensions.cs"], "severity_hint": "Info", "description": "Cache registration present - absence across the repo means no server-side caching layer", "reference": "CWE-400"},
  {"id": "CACHE-NOSTORE", "pattern": "ResponseCache\\s*\\([^)]*NoStore\\s*=\\s*true", "globs": ["*.cs"], "severity_hint": "Low", "description": "ResponseCache NoStore on an action - confirm it is not a cacheable GET", "reference": "CWE-400"},
  {"id": "COMPRESS-REGISTERED", "pattern": "AddResponseCompression|UseResponseCompression|EnableForHttps\\s*=\\s*true", "globs": ["*.cs"], "severity_hint": "Info", "description": "Compression present - absence across Program.cs/Startup.cs is a COMPRESS finding", "reference": "CWE-400"},
  {"id": "PAYLOAD-ENTITY-RETURNED", "pattern": "return\\s+Ok\\s*\\(\\s*(await\\s+)?_?\\w*(db|context|manager|repo)\\w*\\.\\w+(\\.\\w+\\([^)]*\\))*\\.(ToList|ToListAsync|ToArray|FirstOrDefault|FirstOrDefaultAsync|Find|FindAsync|GetAll|GetAllAsync)\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Entity returned directly from a controller - full columns and navigation graphs serialised", "reference": "CWE-400"},
  {"id": "PAYLOAD-INCLUDE-GRAPH", "pattern": "\\.Include\\s*\\([^)]*\\)[^;]*\\.ThenInclude\\s*\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Deep Include graph - check the response projects instead of serialising it", "reference": "CWE-400"},
  {"id": "PAYLOAD-BYTES-IN-DTO", "pattern": "public\\s+byte\\[\\]\\s+\\w+\\s*\\{\\s*get", "globs": ["*Dto.cs", "*Model.cs", "*ViewModel.cs"], "severity_hint": "Low", "description": "byte[] in a DTO - base64 blobs in JSON responses", "reference": "CWE-400"},
  {"id": "POOL-MAX-POOL-SIZE", "pattern": "Max\\s*Pool\\s*Size\\s*=", "globs": ["appsettings*.json", "*.config", "*.cs"], "severity_hint": "Info", "description": "Explicit pool size - inventory for pool sizing table (absence = default 100 per connection string)", "reference": "CWE-1072"},
  {"id": "POOL-SETMINTHREADS", "pattern": "ThreadPool\\.SetMinThreads\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "ThreadPool.SetMinThreads - symptom of sync-over-async; find the blocking call", "reference": "CWE-400"},
  {"id": "TIMEOUT-HTTPCLIENT-NEW", "pattern": "new\\s+HttpClient\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "HttpClient constructed - no factory, likely no timeout/resilience", "reference": "CWE-1088"},
  {"id": "TIMEOUT-ADDHTTPCLIENT-NO-TIMEOUT", "pattern": "AddHttpClient\\s*[<(](?![^;]*(Timeout|AddStandardResilienceHandler|AddPolicyHandler|AddResilienceHandler))", "globs": ["*.cs"], "severity_hint": "Medium", "description": "AddHttpClient without Timeout/resilience on the same statement - confirm in the configure lambda", "reference": "CWE-1088"},
  {"id": "TIMEOUT-RESILIENCE-PRESENT", "pattern": "AddStandardResilienceHandler|AddPolicyHandler|AddTransientHttpErrorPolicy|CircuitBreakerAsync|Policy\\.Timeout", "globs": ["*.cs"], "severity_hint": "Info", "description": "Resilience policy present - inventory", "reference": "CWE-1088"},
  {"id": "TIMEOUT-OCELOT-QOS", "pattern": "\"QoSOptions\"|\"TimeoutValue\"|\"ExceptionsAllowedBeforeBreaking\"", "globs": ["ocelot*.json"], "severity_hint": "Info", "description": "Ocelot QoS present - routes without it have no timeout/circuit breaker", "reference": "CWE-1088"},
  {"id": "ALLOC-SERIALIZE-IN-LOOP", "pattern": "^\\s{12,}.*(JsonConvert\\.SerializeObject|JsonSerializer\\.Serialize)\\s*\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Serialization inside a loop", "reference": "CWE-400"},
  {"id": "ALLOC-STRING-CONCAT-LOOP", "pattern": "^\\s{12,}\\w+\\s*\\+=\\s*(\\$?\"|\\w+\\.ToString)", "globs": ["*.cs"], "severity_hint": "Low", "description": "String concatenation in a loop - use StringBuilder", "reference": "CWE-400"},
  {"id": "INLINE-BG-WORK", "pattern": "(SendEmail|SendMail|SendSms|SendAsync\\(\\s*new\\s+MailMessage|new\\s+ExcelPackage|Image\\.Load|GeneratePdf|\\.SaveAsPdf|SubmitToFbr|PostInvoice)\\w*\\s*\\(", "globs": ["*Controller.cs", "*Endpoints.cs"], "severity_hint": "Medium", "description": "Email/SMS/Excel/PDF/image/tax-submission work inside a controller - move to a background job", "reference": "CWE-400"},
  {"id": "INLINE-BG-TASK-RUN", "pattern": "^\\s*(_\\s*=\\s*)?Task\\.Run\\s*\\(", "globs": ["*Controller.cs", "*Manager.cs", "*Service.cs"], "severity_hint": "Medium", "description": "Fire-and-forget Task.Run as background work - lost on restart, unobserved errors; use Hangfire/queue", "reference": "CWE-400"},
  {"id": "STATE-INPROC-SESSION", "pattern": "AddDistributedMemoryCache\\s*\\(|AddSession\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "Session with in-memory distributed cache - breaks horizontal scaling unless Redis/SQL store is registered", "reference": "CWE-400"},
  {"id": "STATE-DATAPROTECTION-LOCAL", "pattern": "AddDataProtection\\s*\\(\\s*\\)(?!.*PersistKeysTo)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Data protection keys not persisted to shared store - cookies/tokens invalid across instances", "reference": "CWE-400"},
  {"id": "STATE-STATIC-CACHE", "pattern": "\\bstatic\\s+(readonly\\s+)?(Dictionary|ConcurrentDictionary|List|HashSet)<", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Static collection - per-instance state; if it caches tenant data it is incoherent across instances", "reference": "CWE-400"},
  {"id": "STATE-LOCAL-FILE", "pattern": "Path\\.Combine\\s*\\(\\s*(_env|env|_hostingEnvironment|_webHostEnvironment)\\.(WebRootPath|ContentRootPath)|Path\\.GetTempPath\\s*\\(|\"wwwroot[/\\\\]uploads", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Local filesystem used for uploads/state - not shared across instances", "reference": "CWE-400"},
  {"id": "STATE-SIGNALR-NO-BACKPLANE", "pattern": "AddSignalR\\s*\\((?!.*AddStackExchangeRedis)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "SignalR without a Redis backplane - messages do not reach clients on other instances", "reference": "CWE-400"},
  {"id": "STATE-HANGFIRE-MEMORY", "pattern": "UseMemoryStorage\\s*\\(|UseInMemoryStorage\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "Hangfire in-memory storage - jobs lost on restart, duplicated across instances", "reference": "CWE-400"}
]
