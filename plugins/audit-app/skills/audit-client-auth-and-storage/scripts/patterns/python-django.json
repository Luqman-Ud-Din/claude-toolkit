[
  {"id": "ISSUE-TOKEN-LIFETIME-LONG", "pattern": "ACCESS_TOKEN_LIFETIME\\s*[\"']?\\s*:\\s*timedelta\\s*\\(\\s*(days|weeks)|JWT_ACCESS_TOKEN_EXPIRES\\s*=\\s*(False|timedelta\\s*\\(\\s*(days|weeks))", "globs": ["*.py"], "severity_hint": "Medium", "description": "Access token lifetime in days or disabled - increases client storage risk", "reference": "CWE-613"},
  {"id": "ISSUE-NO-EXPIRATION", "pattern": "jwt\\.encode\\s*\\(\\s*\\{(?![^}]*[\"']exp[\"'])[^}]*\\}", "globs": ["*.py"], "severity_hint": "High", "description": "jwt.encode payload without an exp claim on the same line - verify manually", "reference": "CWE-613"},
  {"id": "ISSUE-VERIFY-EXP-OFF", "pattern": "verify_exp\\s*[\"']?\\s*:\\s*False|options\\s*=\\s*\\{[^}]*verify_exp[^}]*False", "globs": ["*.py"], "severity_hint": "High", "description": "JWT expiry verification disabled", "reference": "CWE-613"},
  {"id": "ISSUE-TOKEN-IN-BODY", "pattern": "Response\\s*\\(\\s*\\{[^}]*[\"'](access|refresh|token|access_token|refresh_token)[\"']|return\\s*\\{[^}]*[\"'](access_token|refresh_token)[\"']", "globs": ["*.py"], "severity_hint": "Info", "description": "Tokens returned in the JSON body - the client must store them", "reference": "CWE-922"},
  {"id": "ISSUE-COOKIE-SET", "pattern": "set_cookie\\s*\\(|set_access_cookies\\s*\\(|set_refresh_cookies\\s*\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "Cookie issued - check httponly/secure/samesite (headers skill) and which token it carries", "reference": "CWE-1004"},
  {"id": "ISSUE-COOKIE-NOT-HTTPONLY", "pattern": "httponly\\s*=\\s*False|JWT_AUTH_HTTPONLY\\s*[\"']?\\s*[:=]\\s*False|SESSION_COOKIE_HTTPONLY\\s*=\\s*False|JWT_COOKIE_HTTPONLY\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "High", "description": "Cookie explicitly readable by script", "reference": "CWE-1004"},
  {"id": "REFRESH-ENDPOINT", "pattern": "TokenRefreshView|refresh_token_view|path\\s*\\(\\s*[\"'][^\"']*refresh|@jwt_required\\s*\\(\\s*refresh\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Info", "description": "Refresh endpoint present - check ROTATE_REFRESH_TOKENS / BLACKLIST_AFTER_ROTATION / token source", "reference": "CWE-613"},
  {"id": "REFRESH-ROTATION-OFF", "pattern": "ROTATE_REFRESH_TOKENS\\s*[\"']?\\s*:\\s*False|BLACKLIST_AFTER_ROTATION\\s*[\"']?\\s*:\\s*False", "globs": ["*.py"], "severity_hint": "Low", "description": "Refresh rotation or blacklist disabled", "reference": "CWE-613"},
  {"id": "LOGOUT-ENDPOINT", "pattern": "TokenBlacklistView|LogoutView|def\\s+logout|unset_jwt_cookies\\s*\\(|auth\\.logout\\s*\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "Logout/blacklist present - confirm refresh tokens are revoked and cookies unset", "reference": "CWE-613"},
  {"id": "READ-TOKEN-FROM-QUERY", "pattern": "request\\.(GET|query_params)\\.get\\s*\\(\\s*[\"'](token|access_token|jwt)[\"']|query_string.*token", "globs": ["*.py"], "severity_hint": "Low", "description": "Token accepted from the query string", "reference": "CWE-598"},
  {"id": "CONFIG-EXPOSED-TO-CLIENT", "pattern": "path\\s*\\(\\s*[\"'][^\"']*(config|settings)/?[\"']|json_script|window\\.__CONFIG__", "globs": ["*.py", "*.html"], "severity_hint": "Info", "description": "Configuration handed to the client - check for public identifiers only", "reference": "CWE-798"},
  {"id": "CORS-CREDENTIALS-ANY-ORIGIN", "pattern": "CORS_ALLOW_ALL_ORIGINS\\s*=\\s*True|CORS_ORIGIN_ALLOW_ALL\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Medium", "description": "All origins allowed - High if CORS_ALLOW_CREDENTIALS is also True (headers skill owns the finding)", "reference": "CWE-942"}
]
