[
  {"id": "STORE-WEBSTORAGE-TOKEN", "pattern": "(localStorage|sessionStorage)\\.setItem\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|session|refresh|credential|bearer)[^'\"`]*['\"`]|LocalStorage\\.set\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|refresh)", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Token-like key written to web storage (readable by any script)", "reference": "CWE-922"},
  {"id": "STORE-WEBSTORAGE-ANY", "pattern": "(localStorage|sessionStorage)\\.setItem\\s*\\(", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Web storage write - confirm the value is not a credential", "reference": "CWE-922"},
  {"id": "STORE-PINIA-PERSIST-AUTH", "pattern": "persist\\s*:\\s*true|persist\\s*:\\s*\\{[^}]*(paths|pick)\\s*:\\s*\\[[^\\]]*(token|auth|session)|createPersistedState|vuex-persistedstate", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Persisted store plugin - if the auth store is included, tokens land in localStorage", "reference": "CWE-922"},
  {"id": "STORE-COOKIE-SCRIPT", "pattern": "useCookie\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|session)[^)]*\\)\\.value\\s*=|Cookies\\.set\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|session)|document\\.cookie\\s*=\\s*[^;]*(token|jwt|auth|session)", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Credential cookie written by client script (cannot be HttpOnly)", "reference": "CWE-1004"},
  {"id": "STORE-NUXT-USESTATE-TOKEN", "pattern": "useState\\s*(<[^>]*>)?\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|refresh)", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Medium", "description": "Nuxt useState with a token - serialized into the HTML payload", "reference": "CWE-922"},
  {"id": "STORE-CAPACITOR-PREFERENCES", "pattern": "Preferences\\.set\\s*\\(\\s*\\{[^}]*(token|jwt|auth|refresh|credential)", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Capacitor Preferences holding a token - use secure storage", "reference": "CWE-922"},
  {"id": "INTERCEPT-AXIOS-GLOBAL", "pattern": "\\baxios\\.interceptors\\.request\\.use\\s*\\(", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Medium", "description": "Interceptor on the global axios instance applies to every host", "reference": "CWE-522"},
  {"id": "INTERCEPT-SET-AUTH-HEADER", "pattern": "headers(\\.common)?\\s*\\[?\\.?['\"]?Authorization['\"]?\\]?\\s*=|Authorization\\s*:\\s*`Bearer|headers\\.set\\s*\\(\\s*['\"]Authorization|onRequest\\s*\\(", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Medium", "description": "Authorization header attached (axios or $fetch onRequest) - check the URL condition", "reference": "CWE-522"},
  {"id": "INTERCEPT-ORIGIN-CHECK", "pattern": "(config|cfg|request|url)\\.?(url)?\\??\\.(startsWith|includes|match)\\s*\\(|baseURL\\)|apiBase\\)|isOwnApi|isApiUrl", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Origin check near the interceptor - evidence the token is scoped", "reference": "CWE-522"},
  {"id": "INTERCEPT-WITH-CREDENTIALS-GLOBAL", "pattern": "withCredentials\\s*:\\s*true|credentials\\s*:\\s*['\"]include['\"]", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Low", "description": "Credentials sent with requests - fine for own-origin cookie auth; check scope", "reference": "CWE-522"},
  {"id": "INTERCEPT-TOKEN-IN-QUERY", "pattern": "(params|query)\\s*:\\s*\\{[^}]*(token|access_token|jwt)|[?&](token|access_token|jwt)=\\$\\{", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Token sent in a query string", "reference": "CWE-598"},
  {"id": "REFRESH-CALL", "pattern": "refreshToken\\s*\\(|/refresh['\"`]|refreshAccessToken|renewToken", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Refresh logic present - check single-flight and failure -> logout", "reference": "CWE-613"},
  {"id": "REFRESH-SINGLE-FLIGHT", "pattern": "isRefreshing|refreshPromise|refreshing\\s*\\?\\?=|_retry", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Single-flight / retry guard present", "reference": "CWE-613"},
  {"id": "REFRESH-EXP-DECODE", "pattern": "jwtDecode\\s*\\(|jwt_decode\\s*\\(|\\.exp\\s*[*<>]", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Expiry detection by decoding the JWT on the client", "reference": "CWE-613"},
  {"id": "REFRESH-401-HANDLER", "pattern": "status\\s*===?\\s*401|onResponseError", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "401 handling location - trace what it does", "reference": "CWE-613"},
  {"id": "LOGOUT-METHOD", "pattern": "(const|function|async)\\s+(logout|signOut)\\b|\\blogout\\s*\\(\\s*\\)\\s*\\{|\\blogout\\s*=\\s*(async\\s*)?\\(", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Logout implementation - compare with every writer; check $reset on stores and clearNuxtData", "reference": "CWE-613"},
  {"id": "LOGOUT-PARTIAL-CLEAR", "pattern": "(localStorage|sessionStorage)\\.removeItem\\s*\\(|LocalStorage\\.remove\\s*\\(", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Single-key removal - check other keys and persisted store state", "reference": "CWE-613"},
  {"id": "GUARD-DEFINITION", "pattern": "router\\.beforeEach\\s*\\(|beforeEnter\\s*:|definePageMeta\\s*\\(\\s*\\{[^}]*middleware|defineNuxtRouteMiddleware\\s*\\(|requiresAuth", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Route guard / middleware - UX only; cross-reference server-side authorization", "reference": "CWE-602"},
  {"id": "GUARD-ROLE-FROM-JWT", "pattern": "(jwtDecode|jwt_decode)\\s*\\([^)]*\\)\\s*[\\.\\[]\\s*['\"]?(role|roles|permissions|isAdmin)", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Info", "description": "Roles read from the client-decoded JWT - UI only", "reference": "CWE-602"},
  {"id": "SECRET-RUNTIME-CONFIG-PUBLIC", "pattern": "public\\s*:\\s*\\{[^}]*(secret|Secret|privateKey|apiSecret|clientSecret|password|serviceAccount)", "globs": ["nuxt.config.ts", "nuxt.config.js"], "severity_hint": "High", "description": "Secret-looking key under runtimeConfig.public (ships to the client)", "reference": "CWE-798"},
  {"id": "SECRET-PUBLIC-ENV-PREFIX", "pattern": "^\\s*(VITE|NUXT_PUBLIC|VUE_APP)_[A-Z0-9_]*(SECRET|PRIVATE|PASSWORD|TOKEN|SERVICE_ACCOUNT|SIGNING|CLIENT_SECRET|API_KEY|APIKEY)[A-Z0-9_]*\\s*=\\s*\\S{8,}", "globs": [".env", ".env.*", "*.env"], "severity_hint": "High", "description": "Public-prefixed env var with a secret-looking name (inlined into the bundle)", "reference": "CWE-798"},
  {"id": "SECRET-KEY-NAME-LITERAL", "pattern": "(apiKey|api_key|secret|secretKey|clientSecret|client_secret|privateKey|private_key|encryptionKey|jwtSecret|smsApiKey|sendgridKey|awsSecret\\w*|accessKeyId|connectionString|dbPassword)\\s*[:=]\\s*['\"`][^'\"`]{8,}['\"`]", "globs": ["*.ts", "*.js", "*.vue", "*.json"], "severity_hint": "High", "description": "Secret-looking literal in client source", "reference": "CWE-798"},
  {"id": "SECRET-BASIC-AUTH-LITERAL", "pattern": "Authorization\\s*:\\s*['\"`]\\s*Basic\\s+[A-Za-z0-9+/=]{8,}", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "High", "description": "Hard-coded Basic credentials", "reference": "CWE-798"},
  {"id": "SECRET-PROVIDER-PREFIX", "pattern": "(sk_live_[0-9a-zA-Z]{8,}|sk_test_[0-9a-zA-Z]{8,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}|xox[abp]-[0-9A-Za-z-]{10,}|ghp_[0-9A-Za-z]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})", "globs": ["*.ts", "*.js", "*.vue", "*.json", ".env*", "*.env", "*.html"], "severity_hint": "Critical", "description": "Known provider secret prefix, private key, or embedded JWT", "reference": "CWE-798"},
  {"id": "TRANSPORT-HTTP-API-URL", "pattern": "(apiBase|apiUrl|baseURL|API_URL|VITE_API_URL|NUXT_PUBLIC_API_BASE)\\s*[:=]\\s*['\"`]?http://(?!localhost|127\\.0\\.0\\.1)", "globs": [".env.production", ".env.prod", "nuxt.config.ts", "quasar.config.js"], "severity_hint": "Medium", "description": "Plain-http API URL in production config", "reference": "CWE-319"},
  {"id": "TRANSPORT-TOKEN-LOGGED", "pattern": "console\\.(log|debug|info)\\s*\\([^)]*(token|jwt|password|secret)", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Low", "description": "Credential written to the console", "reference": "CWE-532"},
  {"id": "TRANSPORT-POSTMESSAGE-ANY", "pattern": "postMessage\\s*\\([^)]*,\\s*['\"]\\*['\"]", "globs": ["*.ts", "*.js", "*.vue"], "severity_hint": "Low", "description": "postMessage to any origin - check payload for tokens", "reference": "CWE-346"}
]
