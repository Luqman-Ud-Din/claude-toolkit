[
  {"id": "ISSUE-TOKEN-LIFETIME-CONFIG", "pattern": "(jwt|token|access)[\\w.-]*(expiration|expiry|ttl|validity)[\\w.-]*\\s*[:=]\\s*[0-9]{8,}|(expiration|expiry|ttl)[\\w.-]*\\s*[:=]\\s*[0-9]+\\s*[dD]\\b", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "Token lifetime configured in days (or >= 10^8 ms) - increases client storage risk", "reference": "CWE-613"},
  {"id": "ISSUE-NO-EXPIRATION", "pattern": "Jwts\\.builder\\s*\\((?![^;]*setExpiration|[^;]*expiration\\s*\\()|JWT\\.create\\s*\\((?![^;]*withExpiresAt)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "JWT built without an expiration on the same statement - verify manually", "reference": "CWE-613"},
  {"id": "ISSUE-TOKEN-IN-BODY", "pattern": "ResponseEntity\\.ok\\s*\\(\\s*new\\s+\\w*(Token|Jwt|Auth)\\w*Response|new\\s+\\w*TokenResponse\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Tokens returned in the JSON body - the client must store them", "reference": "CWE-922"},
  {"id": "ISSUE-COOKIE-BUILD", "pattern": "ResponseCookie\\.from\\s*\\(|new\\s+Cookie\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Cookie issued - check httpOnly/secure/sameSite (headers skill) and which token it carries", "reference": "CWE-1004"},
  {"id": "ISSUE-COOKIE-NOT-HTTPONLY", "pattern": "httpOnly\\s*\\(\\s*false\\s*\\)|setHttpOnly\\s*\\(\\s*false\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Cookie explicitly readable by script", "reference": "CWE-1004"},
  {"id": "REFRESH-ENDPOINT", "pattern": "@(Post|Get|Request)Mapping\\s*\\([^)]*refresh", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Refresh endpoint present - check rotation, hashing, revocation, token source", "reference": "CWE-613"},
  {"id": "REFRESH-TOKEN-WEAK-RANDOM", "pattern": "refreshToken\\s*=\\s*(UUID\\.randomUUID|new\\s+Random)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Refresh token from UUID/Random - UUID v4 is acceptable if the JDK uses SecureRandom; prefer explicit SecureRandom", "reference": "CWE-338"},
  {"id": "LOGOUT-ENDPOINT", "pattern": "@(Post|Get|Request)Mapping\\s*\\([^)]*(logout|signout|revoke)|\\.logout\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Logout configuration/endpoint present - confirm refresh token deletion and cookie clearing", "reference": "CWE-613"},
  {"id": "READ-TOKEN-FROM-QUERY", "pattern": "allowUriQueryParameter\\s*\\(\\s*true|getParameter\\s*\\(\\s*\"(access_token|token|jwt)\"", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Token accepted from the query string", "reference": "CWE-598"},
  {"id": "CONFIG-EXPOSED-TO-CLIENT", "pattern": "@(Get|Request)Mapping\\s*\\([^)]*(config|settings)\"", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Configuration endpoint handed to the client - check for public identifiers only", "reference": "CWE-798"},
  {"id": "CORS-CREDENTIALS-ANY-ORIGIN", "pattern": "allowedOriginPatterns\\s*\\(\\s*\"\\*\"\\s*\\)|setAllowedOriginPatterns\\s*\\([^)]*\"\\*\"|allowCredentials\\s*\\(\\s*true\\s*\\)[^;]*allowedOrigins\\s*\\(\\s*\"\\*\"", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Credentials allowed from any origin pattern (also reported by the headers skill)", "reference": "CWE-942"}
]
