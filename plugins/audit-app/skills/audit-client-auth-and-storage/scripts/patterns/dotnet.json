[
  {"id": "ISSUE-TOKEN-LIFETIME-LONG", "pattern": "(Expires|expires|ValidTo|NotAfter)\\s*[:=]\\s*DateTime(Offset)?\\.(UtcNow|Now)\\.Add(Days|Months|Years)\\s*\\(|Add(Days|Months|Years)\\s*\\([^)]*\\)\\s*[,)]?\\s*//?\\s*(access|token)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Access token lifetime measured in days or longer - increases client storage risk", "reference": "CWE-613"},
  {"id": "ISSUE-LIFETIME-NOT-VALIDATED", "pattern": "ValidateLifetime\\s*=\\s*false|RequireExpirationTime\\s*=\\s*false", "globs": ["*.cs"], "severity_hint": "High", "description": "JWT expiry not validated", "reference": "CWE-613"},
  {"id": "ISSUE-TOKEN-IN-BODY", "pattern": "return\\s+Ok\\s*\\(\\s*new\\s*\\{[^}]*(Token|token|AccessToken|accessToken|RefreshToken|refreshToken)", "globs": ["*.cs"], "severity_hint": "Info", "description": "Tokens returned in the JSON body - the client must store them (see client STORE rules)", "reference": "CWE-922"},
  {"id": "ISSUE-COOKIE-APPEND", "pattern": "Response\\.Cookies\\.Append\\s*\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "Cookie issued by the API - check HttpOnly/Secure/SameSite (headers skill) and which token it carries", "reference": "CWE-1004"},
  {"id": "ISSUE-COOKIE-NOT-HTTPONLY", "pattern": "HttpOnly\\s*=\\s*false", "globs": ["*.cs"], "severity_hint": "High", "description": "Cookie explicitly readable by script", "reference": "CWE-1004"},
  {"id": "REFRESH-ENDPOINT", "pattern": "\\[Http(Post|Get)\\s*\\(\\s*\"[^\"]*refresh", "globs": ["*.cs"], "severity_hint": "Info", "description": "Refresh endpoint present - check rotation, hashing, revocation, token source", "reference": "CWE-613"},
  {"id": "REFRESH-TOKEN-WEAK-RANDOM", "pattern": "RefreshToken\\s*=\\s*(Guid\\.NewGuid|new\\s+Random|DateTime)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Refresh token generated from a GUID/Random rather than a CSPRNG", "reference": "CWE-338"},
  {"id": "LOGOUT-ENDPOINT", "pattern": "\\[Http(Post|Get)\\s*\\(\\s*\"[^\"]*(logout|signout|revoke)", "globs": ["*.cs"], "severity_hint": "Info", "description": "Logout/revoke endpoint present - confirm it deletes refresh tokens and clears cookies", "reference": "CWE-613"},
  {"id": "READ-TOKEN-FROM-QUERY", "pattern": "Request\\.Query\\s*\\[\\s*\"(access_token|token|jwt)\"\\s*\\]", "globs": ["*.cs"], "severity_hint": "Low", "description": "Token accepted from the query string (acceptable for WebSockets only; ensure not logged)", "reference": "CWE-598"},
  {"id": "CONFIG-EXPOSED-TO-CLIENT", "pattern": "class\\s+\\w*(ClientConfig|ClientSettings|PublicConfig|AppConfig)\\w*|\\[Http(Get)\\s*\\(\\s*\"[^\"]*(config|settings)\"", "globs": ["*.cs"], "severity_hint": "Info", "description": "Configuration endpoint/DTO handed to the client - check it holds public identifiers only", "reference": "CWE-798"},
  {"id": "CORS-CREDENTIALS-ANY-ORIGIN", "pattern": "SetIsOriginAllowed\\s*\\(\\s*_?\\s*=>\\s*true\\s*\\)|AllowAnyOrigin\\s*\\(\\s*\\)[^;]*AllowCredentials", "globs": ["*.cs"], "severity_hint": "High", "description": "Credentials allowed from any origin - makes cookie auth exploitable cross-site (also reported by the headers skill)", "reference": "CWE-942"}
]
