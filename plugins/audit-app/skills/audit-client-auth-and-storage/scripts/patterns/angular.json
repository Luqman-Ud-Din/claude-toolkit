[
  {"id": "STORE-WEBSTORAGE-TOKEN", "pattern": "(localStorage|sessionStorage)\\.setItem\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|session|refresh|credential|bearer)[^'\"`]*['\"`]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Token-like key written to web storage (readable by any script)", "reference": "CWE-922"},
  {"id": "STORE-WEBSTORAGE-ANY", "pattern": "(localStorage|sessionStorage)\\.setItem\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Web storage write - confirm the value is not a credential (wrappers hide the key name)", "reference": "CWE-922"},
  {"id": "STORE-WRAPPER-TOKEN", "pattern": "(storage|storageService|this\\.store|_storage)\\.(set|setItem|save|store)\\s*\\(\\s*['\"`]?[^,)]*(token|jwt|auth|refresh|credential)", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Token written through a storage wrapper - open the wrapper to see the backing store", "reference": "CWE-922"},
  {"id": "STORE-CAPACITOR-PREFERENCES", "pattern": "Preferences\\.set\\s*\\(\\s*\\{[^}]*(token|jwt|auth|refresh|credential)", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Capacitor Preferences (plain SharedPreferences/UserDefaults) holding a token - use secure storage", "reference": "CWE-922"},
  {"id": "STORE-COOKIE-SCRIPT", "pattern": "document\\.cookie\\s*=\\s*[^;]*(token|jwt|auth|session)|cookieService\\.set\\s*\\(\\s*['\"`][^'\"`]*(token|jwt|auth|session)", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Credential cookie written by script (cannot be HttpOnly)", "reference": "CWE-1004"},
  {"id": "STORE-BUNDLED-ENCRYPTION", "pattern": "(AES|CryptoJS)\\.(encrypt|decrypt)\\s*\\([^)]*(environment\\.|secretKey|encryptionKey|ENCRYPTION_KEY)", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Storage encrypted with a key from the bundle - not a control", "reference": "CWE-922"},
  {"id": "INTERCEPT-SET-AUTH-HEADER", "pattern": "(setHeaders|headers)\\s*:\\s*\\{[^}]*Authorization|headers\\.set\\s*\\(\\s*['\"]Authorization|Authorization\\s*:\\s*`Bearer", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Authorization header attached - check the URL condition above it (own API origin only)", "reference": "CWE-522"},
  {"id": "INTERCEPT-ORIGIN-CHECK", "pattern": "req\\.url\\.(startsWith|includes|match)\\s*\\(|allowedDomains\\s*:|isOwnApi|isApiUrl|apiUrl\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Origin check present near the interceptor - evidence the token is scoped", "reference": "CWE-522"},
  {"id": "INTERCEPT-WITH-CREDENTIALS-GLOBAL", "pattern": "withCredentials\\s*:\\s*true", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "withCredentials set - fine for own-origin cookie auth; check it is not applied to every URL", "reference": "CWE-522"},
  {"id": "INTERCEPT-TOKEN-IN-QUERY", "pattern": "(setParams|params)\\s*:\\s*\\{[^}]*(token|access_token|jwt)|[?&](token|access_token|jwt)=\\$\\{", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Token sent in a query string (logged by proxies and referrers)", "reference": "CWE-598"},
  {"id": "REFRESH-CALL", "pattern": "refreshToken\\s*\\(|refresh\\s*\\(\\s*\\)|/refresh['\"`]|tokenRefresh|renewToken", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Refresh logic present - check single-flight (shareReplay/BehaviorSubject) and failure -> logout", "reference": "CWE-613"},
  {"id": "REFRESH-SINGLE-FLIGHT", "pattern": "shareReplay\\s*\\(|isRefreshing|refreshTokenSubject|refreshInProgress|refresh\\$\\s*\\?\\?=", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Single-flight refresh guard present", "reference": "CWE-613"},
  {"id": "REFRESH-EXP-DECODE", "pattern": "isTokenExpired\\s*\\(|jwtDecode\\s*\\(|jwt_decode\\s*\\(|decodeToken\\s*\\(|\\.exp\\s*[*<>]", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Expiry detection by decoding the JWT on the client (fine for scheduling; not a verification)", "reference": "CWE-613"},
  {"id": "REFRESH-401-HANDLER", "pattern": "status\\s*===?\\s*401|HttpStatusCode\\.Unauthorized", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "401 handling location - trace what it does (refresh, logout, loop)", "reference": "CWE-613"},
  {"id": "LOGOUT-METHOD", "pattern": "\\blogout\\s*\\(\\s*\\)\\s*(:|\\{)|\\bsignOut\\s*\\(\\s*\\)\\s*(:|\\{)", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Logout implementation - compare what it clears with every storage key written", "reference": "CWE-613"},
  {"id": "LOGOUT-PARTIAL-CLEAR", "pattern": "(localStorage|sessionStorage)\\.removeItem\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Single-key removal - check refresh token, user, tenant keys are also removed", "reference": "CWE-613"},
  {"id": "GUARD-DEFINITION", "pattern": "CanActivateFn|CanMatchFn|CanActivateChildFn|implements\\s+(CanActivate|CanLoad|CanMatch)\\b", "globs": ["*.ts"], "severity_hint": "Info", "description": "Route guard - UX only; cross-reference server-side authorization", "reference": "CWE-602"},
  {"id": "GUARD-ROLE-FROM-JWT", "pattern": "(decodeToken|jwtDecode|jwt_decode)\\s*\\([^)]*\\)\\s*[\\.\\[]\\s*['\"]?(role|roles|permissions|isAdmin)", "globs": ["*.ts"], "severity_hint": "Info", "description": "Roles read from the client-decoded JWT - fine for UI, must not be the only check", "reference": "CWE-602"},
  {"id": "SECRET-ENV-KEY-NAME", "pattern": "^\\s*(apiKey|api_key|secret|secretKey|clientSecret|client_secret|privateKey|private_key|encryptionKey|jwtSecret|jwtKey|smsApiKey|smsKey|smsToken|sendgridKey|twilio\\w*|awsSecret\\w*|accessKeyId|connectionString|dbPassword|password)\\s*:\\s*['\"`][^'\"`]{8,}['\"`]", "globs": ["environment*.ts", "*.config.ts", "*config*.ts", "*config*.js"], "severity_hint": "High", "description": "Secret-looking key in a file that ships in the bundle", "reference": "CWE-798"},
  {"id": "SECRET-BASIC-AUTH-LITERAL", "pattern": "Authorization\\s*:\\s*['\"`]\\s*Basic\\s+[A-Za-z0-9+/=]{8,}", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Hard-coded Basic credentials", "reference": "CWE-798"},
  {"id": "SECRET-PROVIDER-PREFIX", "pattern": "(sk_live_[0-9a-zA-Z]{8,}|sk_test_[0-9a-zA-Z]{8,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}|xox[abp]-[0-9A-Za-z-]{10,}|ghp_[0-9A-Za-z]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})", "globs": ["*.ts", "*.js", "*.json", "*.env", ".env*", "*.html"], "severity_hint": "Critical", "description": "Known provider secret prefix, private key, or embedded JWT", "reference": "CWE-798"},
  {"id": "TRANSPORT-HTTP-API-URL", "pattern": "(apiUrl|apiBaseUrl|baseUrl|API_URL|serverUrl)\\s*[:=]\\s*['\"`]http://(?!localhost|127\\.0\\.0\\.1)", "globs": ["environment.prod*.ts", "environment.production*.ts", "environment.staging*.ts"], "severity_hint": "Medium", "description": "Plain-http API URL in a production environment file", "reference": "CWE-319"},
  {"id": "TRANSPORT-TOKEN-LOGGED", "pattern": "console\\.(log|debug|info)\\s*\\([^)]*(token|jwt|password|secret)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Credential written to the console", "reference": "CWE-532"},
  {"id": "TRANSPORT-POSTMESSAGE-ANY", "pattern": "postMessage\\s*\\([^)]*,\\s*['\"]\\*['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "postMessage to any origin - check payload for tokens", "reference": "CWE-346"}
]
