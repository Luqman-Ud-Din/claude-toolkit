[
  {"id": "DISP-STREAM-NO-TRY", "pattern": "^(?!.*try\\s*\\().*=\\s*new\\s+(FileInputStream|FileOutputStream|FileReader|FileWriter|BufferedReader|BufferedWriter|ZipInputStream|ZipOutputStream|XSSFWorkbook|HSSFWorkbook)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Stream/workbook created outside try-with-resources", "reference": "CWE-772"},
  {"id": "DISP-FILES-LINES", "pattern": "^(?!.*try\\s*\\().*Files\\.(lines|walk|list|newDirectoryStream|newInputStream|newBufferedReader)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Files.* stream not in try-with-resources - directory handle held", "reference": "CWE-772"},
  {"id": "DISP-JDBC-CONNECTION", "pattern": "^(?!.*try\\s*\\().*\\.getConnection\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Raw JDBC connection acquired outside try-with-resources", "reference": "CWE-772"},
  {"id": "DISP-ENTITYMANAGER-NEW", "pattern": "createEntityManager\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "EntityManager created by hand - confirm close()", "reference": "CWE-772"},
  {"id": "DISP-HTTPCLIENT-PER-CALL", "pattern": "new\\s+RestTemplate\\s*\\(|WebClient\\.create\\s*\\(|new\\s+OkHttpClient\\s*\\(|HttpClients\\.createDefault\\s*\\(|HttpClient\\.newHttpClient\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "HTTP client constructed - confirm once per process (bean), not per call", "reference": "CWE-772"},
  {"id": "DISP-EXECUTOR-PER-CALL", "pattern": "Executors\\.new(Fixed|Cached|Single|Scheduled|WorkStealing)\\w*\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "ExecutorService created - confirm single bean with shutdown, not per request", "reference": "CWE-772"},
  {"id": "TIMER-PER-CALL", "pattern": "new\\s+(java\\.util\\.)?Timer\\s*\\(|new\\s+Thread\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Timer/Thread constructed - per-request threads never join the pool", "reference": "CWE-772"},
  {"id": "STAT-COLLECTION-FIELD", "pattern": "\\bstatic\\s+(final\\s+)?(List|Map|Set|ConcurrentHashMap|HashMap|ArrayList|HashSet|Queue|Deque|ConcurrentLinkedQueue)<", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Static mutable collection - trace add/put vs remove/clear", "reference": "CWE-401"},
  {"id": "STAT-THREADLOCAL", "pattern": "new\\s+ThreadLocal<|ThreadLocal\\.withInitial", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "ThreadLocal - confirm remove() on every exit path (pooled threads live forever)", "reference": "CWE-401"},
  {"id": "SUB-LISTENER-REGISTER", "pattern": "\\.(addListener|addApplicationListener|register)\\s*\\(\\s*this\\s*\\)|\\.subscribe\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Listener/subscription registered - confirm removal or singleton lifetime", "reference": "CWE-401"},
  {"id": "CACHE-CACHEABLE", "pattern": "@Cacheable\\b", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "@Cacheable - check CacheManager has maximumSize/TTL (default ConcurrentMapCacheManager is unbounded)", "reference": "CWE-770"},
  {"id": "CACHE-CONCURRENTMAP-MANAGER", "pattern": "ConcurrentMapCacheManager|SimpleCacheManager", "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "*.properties"], "severity_hint": "High", "description": "Unbounded in-memory cache manager", "reference": "CWE-770"},
  {"id": "CACHE-CAFFEINE-NO-BOUND", "pattern": "Caffeine\\.newBuilder\\s*\\(\\s*\\)\\s*\\.build\\s*\\(|caffeine\\.spec\\s*[=:](?!.*maximumSize)", "globs": ["*.java", "*.kt", "*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "Caffeine cache without maximumSize/expireAfter", "reference": "CWE-770"},
  {"id": "ALLOC-PER-CALL-OBJECTS", "pattern": "^(?!.*static).*new\\s+(ObjectMapper|SimpleDateFormat|Gson)\\s*\\(|(?<!static\\s)Pattern\\.compile\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Expensive object constructed per call - make it a static/bean", "reference": "CWE-400"},
  {"id": "ALLOC-LARGE-BUFFER", "pattern": "new\\s+byte\\s*\\[\\s*(\\d{5,}|\\w+\\.length|\\w+Size)\\s*\\]|readAllBytes\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Whole payload buffered in memory", "reference": "CWE-770"},
  {"id": "BG-EMPTY-CATCH", "pattern": "catch\\s*\\([^)]*\\)\\s*\\{\\s*\\}", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Empty catch block - errors silently dropped", "reference": "CWE-390"},
  {"id": "BG-SCHEDULED", "pattern": "@Scheduled\\b|@Async\\b|implements\\s+Job\\b|extends\\s+QuartzJobBean", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Background entry point - trace exception handling and per-run state", "reference": "CWE-390"},
  {"id": "BG-ASYNC-VOID", "pattern": "@Async[\\s\\S]{0,80}public\\s+void\\s", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "@Async void - exceptions dropped unless AsyncUncaughtExceptionHandler configured", "reference": "CWE-390"},
  {"id": "BG-INFINITE-LOOP", "pattern": "while\\s*\\(\\s*true\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Worker loop - check per-iteration state and EntityManager.clear()", "reference": "CWE-401"}
]
