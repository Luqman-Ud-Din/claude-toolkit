[
  {"id": "DISP-OPEN-NO-WITH", "pattern": "^(?!\\s*with\\b).*=\\s*open\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "open() assigned outside with - confirm close() in finally", "reference": "CWE-772"},
  {"id": "DISP-TEMPFILE-KEEP", "pattern": "NamedTemporaryFile\\s*\\([^)]*delete\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "Medium", "description": "Temp file kept on disk - confirm os.remove on every path", "reference": "CWE-772"},
  {"id": "DISP-REQUESTS-STREAM", "pattern": "requests\\.(get|post|put)\\s*\\([^)]*stream\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Medium", "description": "Streamed response - confirm close() / with", "reference": "CWE-772"},
  {"id": "DISP-HTTP-CLIENT-PER-CALL", "pattern": "^(?!\\s*with\\b)(?!.*^[A-Z_]+\\s*=).*(requests\\.Session|httpx\\.(Async)?Client|aiohttp\\.ClientSession)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "HTTP session constructed - must be once per process or inside with", "reference": "CWE-772"},
  {"id": "DISP-RAW-DB-CONNECT", "pattern": "(psycopg2|psycopg|sqlite3|pymysql|MySQLdb|pyodbc)\\.connect\\s*\\(", "globs": ["*.py"], "severity_hint": "High", "description": "Raw DB connection outside the ORM - confirm close()", "reference": "CWE-772"},
  {"id": "DISP-POPEN-NO-WAIT", "pattern": "subprocess\\.Popen\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Popen - confirm communicate()/wait() and with", "reference": "CWE-772"},
  {"id": "DISP-EXECUTOR-PER-CALL", "pattern": "^(?!\\s*with\\b).*(ThreadPoolExecutor|ProcessPoolExecutor)\\s*\\(", "globs": ["*.py"], "severity_hint": "High", "description": "Executor created outside with - threads never shut down", "reference": "CWE-772"},
  {"id": "DISP-BINARY-NO-WITH", "pattern": "^(?!\\s*with\\b).*=\\s*(zipfile\\.ZipFile|Image\\.open|openpyxl\\.load_workbook|tarfile\\.open)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Archive/image/workbook opened outside with", "reference": "CWE-772"},
  {"id": "TIMER-THREADING-TIMER", "pattern": "threading\\.Timer\\s*\\(|loop\\.call_later\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Timer created - confirm cancel() and not per request", "reference": "CWE-772"},
  {"id": "TIMER-CREATE-TASK-DISCARDED", "pattern": "^\\s*asyncio\\.create_task\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "create_task result discarded - task may be GC'd, exceptions lost", "reference": "CWE-390"},
  {"id": "STAT-MODULE-COLLECTION", "pattern": "^[A-Za-z_]\\w*\\s*(:\\s*[\\w\\[\\], ]+)?\\s*=\\s*(\\[\\]|\\{\\}|set\\(\\)|dict\\(\\)|list\\(\\)|collections\\.(defaultdict|OrderedDict|deque)\\()", "globs": ["*.py"], "severity_hint": "Medium", "description": "Module-level mutable container - trace append/[]= vs pop/del/clear", "reference": "CWE-401"},
  {"id": "STAT-LRU-UNBOUNDED", "pattern": "lru_cache\\s*\\(\\s*maxsize\\s*=\\s*None\\s*\\)|@(functools\\.)?cache\\b", "globs": ["*.py"], "severity_hint": "Medium", "description": "Unbounded function cache (and keeps self alive on methods)", "reference": "CWE-770"},
  {"id": "STAT-LRU-ON-METHOD", "pattern": "@(functools\\.)?lru_cache[\\s\\S]{0,40}def\\s+\\w+\\s*\\(\\s*self", "globs": ["*.py"], "severity_hint": "Medium", "description": "lru_cache on a method - every instance is retained", "reference": "CWE-401"},
  {"id": "SUB-SIGNAL-CONNECT-IN-FUNC", "pattern": "^\\s{4,}\\w+\\.connect\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "signal.connect inside a function - duplicates on every call unless dispatch_uid", "reference": "CWE-401"},
  {"id": "SUB-ADDHANDLER-IN-FUNC", "pattern": "^\\s{4,}\\w+\\.addHandler\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "logging handler added inside a function - handlers accumulate", "reference": "CWE-401"},
  {"id": "CACHE-TIMEOUT-NONE", "pattern": "cache\\.set\\s*\\([^)]*timeout\\s*=\\s*None|['\"]TIMEOUT['\"]\\s*:\\s*None", "globs": ["*.py"], "severity_hint": "Medium", "description": "Cache entry never expires", "reference": "CWE-770"},
  {"id": "CACHE-LOCMEM-MAX-ENTRIES", "pattern": "['\"]MAX_ENTRIES['\"]\\s*:\\s*\\d{6,}", "globs": ["*.py"], "severity_hint": "Low", "description": "LocMemCache MAX_ENTRIES raised very high - effectively unbounded per worker", "reference": "CWE-770"},
  {"id": "ALLOC-READ-WHOLE-UPLOAD", "pattern": "request\\.FILES\\[[^\\]]+\\]\\.read\\s*\\(\\s*\\)|\\.read\\s*\\(\\s*\\)\\s*$", "globs": ["*.py"], "severity_hint": "Medium", "description": "Whole file read into memory - check size limits", "reference": "CWE-770"},
  {"id": "ALLOC-LIST-QUERYSET", "pattern": "list\\s*\\(\\s*\\w+\\.objects\\.(all|filter)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "Whole queryset materialised", "reference": "CWE-770"},
  {"id": "BG-EMPTY-EXCEPT", "pattern": "except(\\s+\\w+(\\s+as\\s+\\w+)?)?\\s*:\\s*(pass|\\.\\.\\.)\\s*$|except(\\s+\\w+)?\\s*:\\s*$", "globs": ["*.py"], "severity_hint": "High", "description": "except with pass / bare except - inspect body for logging", "reference": "CWE-390"},
  {"id": "BG-TASK-ENTRY", "pattern": "@(shared_task|app\\.task|celery\\.task|periodic_task|job)\\b|class\\s+Command\\s*\\(\\s*BaseCommand", "globs": ["*.py"], "severity_hint": "Info", "description": "Background entry point - trace exception handling and per-run state", "reference": "CWE-390"},
  {"id": "BG-INFINITE-LOOP", "pattern": "while\\s+True\\s*:", "globs": ["*.py"], "severity_hint": "Info", "description": "Worker loop - check per-iteration state", "reference": "CWE-401"}
]
