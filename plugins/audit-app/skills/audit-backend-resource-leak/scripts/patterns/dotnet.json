[
  {"id": "DISP-STREAM-NO-USING", "pattern": "^(?!.*\\busing\\b)(?!.*await using).*=\\s*new\\s+(FileStream|StreamReader|StreamWriter|BinaryReader|BinaryWriter|GZipStream|DeflateStream|CryptoStream)\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "Stream created without using/await using on the same line - confirm disposal on every exit path", "reference": "CWE-772"},
  {"id": "DISP-CONNECTION-NO-USING", "pattern": "^(?!.*\\busing\\b).*=\\s*new\\s+(SqlConnection|NpgsqlConnection|MySqlConnection|SqliteConnection|OracleConnection|SqlCommand|NpgsqlCommand)\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "ADO.NET connection/command created without using", "reference": "CWE-772"},
  {"id": "DISP-DBCONTEXT-NEW", "pattern": "^(?!.*\\busing\\b).*=\\s*new\\s+\\w*(DbContext|Context)\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "DbContext constructed by hand outside DI without using - change tracker lives until GC", "reference": "CWE-772"},
  {"id": "DISP-HTTPCLIENT-NEW", "pattern": "new\\s+HttpClient\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "HttpClient instantiated directly - socket exhaustion; use IHttpClientFactory", "reference": "CWE-772"},
  {"id": "DISP-HTTPRESPONSE-NO-USING", "pattern": "^(?!.*\\busing\\b).*=\\s*await\\s+\\w+\\.(SendAsync|GetAsync|PostAsync|PutAsync|DeleteAsync)\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "HttpResponseMessage not disposed - holds the connection until finalized", "reference": "CWE-772"},
  {"id": "DISP-IMAGE-NO-USING", "pattern": "^(?!.*\\busing\\b).*=\\s*(await\\s+)?Image\\.(Load|LoadAsync)\\s*[<(]", "globs": ["*.cs"], "severity_hint": "Medium", "description": "ImageSharp Image loaded without using - native buffers pinned", "reference": "CWE-772"},
  {"id": "DISP-EXCEL-NO-USING", "pattern": "^(?!.*\\busing\\b).*=\\s*new\\s+ExcelPackage\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "EPPlus ExcelPackage without using", "reference": "CWE-772"},
  {"id": "DISP-SCOPE-NO-USING", "pattern": "^(?!.*\\busing\\b).*=\\s*\\w+\\.CreateScope\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "IServiceScope created without using - scoped services never disposed", "reference": "CWE-772"},
  {"id": "TIMER-CTS-NO-USING", "pattern": "^(?!.*\\busing\\b).*=\\s*new\\s+CancellationTokenSource\\s*\\(|CancellationTokenSource\\.CreateLinkedTokenSource\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "CancellationTokenSource created without using - timer callback and registrations retained", "reference": "CWE-772"},
  {"id": "TIMER-PER-REQUEST", "pattern": "new\\s+(System\\.Threading\\.|System\\.Timers\\.)?Timer\\s*\\(|new\\s+PeriodicTimer\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Timer constructed - confirm it is created once, not per request, and disposed", "reference": "CWE-772"},
  {"id": "STAT-COLLECTION-FIELD", "pattern": "\\bstatic\\s+(readonly\\s+)?(List|Dictionary|ConcurrentDictionary|HashSet|ConcurrentBag|ConcurrentQueue|Queue|Stack|IList|IDictionary)<", "globs": ["*.cs"], "severity_hint": "High", "description": "Static mutable collection - trace writers vs removers; unbounded growth candidate", "reference": "CWE-401"},
  {"id": "STAT-EVENT-SUBSCRIBE", "pattern": "\\w+\\.\\w+\\s*\\+=\\s*(\\w+|\\(.*\\)\\s*=>|async)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Event subscription - confirm matching -= or that publisher and subscriber share a lifetime", "reference": "CWE-401"},
  {"id": "STAT-ONCHANGE-DISCARDED", "pattern": "^(?!.*=\\s*).*\\.(OnChange|RegisterChangeCallback)\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "OnChange registration whose IDisposable is discarded", "reference": "CWE-401"},
  {"id": "CACHE-MEMORYCACHE-UNBOUNDED", "pattern": "AddMemoryCache\\s*\\(\\s*\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "IMemoryCache registered without SizeLimit - verify every Set has an expiration and a bounded key space", "reference": "CWE-770"},
  {"id": "CACHE-SET-NO-EXPIRY", "pattern": "_?cache\\.Set\\s*\\([^;]*\\)\\s*;", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Cache Set call - confirm expiration/size options are supplied", "reference": "CWE-770"},
  {"id": "CACHE-GETORCREATE", "pattern": "\\.GetOrCreate(Async)?\\s*\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "GetOrCreate - check the entry factory sets expiration and Size", "reference": "CWE-770"},
  {"id": "ALLOC-LARGE-BUFFER", "pattern": "new\\s+byte\\s*\\[\\s*(\\d{5,}|\\w+\\.Length|\\w+Size)\\s*\\]", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Large byte[] allocated - LOH pressure; consider ArrayPool", "reference": "CWE-770"},
  {"id": "ALLOC-TOARRAY-STREAM", "pattern": "\\.ToArray\\s*\\(\\s*\\)\\s*;", "globs": ["*.cs"], "severity_hint": "Low", "description": "ToArray on stream/collection in request path - buffering whole payload", "reference": "CWE-770"},
  {"id": "ALLOC-REGEX-PER-CALL", "pattern": "^(?!.*static).*new\\s+Regex\\s*\\(", "globs": ["*.cs"], "severity_hint": "Low", "description": "Regex constructed per call - cache as static readonly", "reference": "CWE-400"},
  {"id": "BG-EMPTY-CATCH", "pattern": "catch\\s*(\\(\\s*\\w*(Exception)?\\s*\\w*\\s*\\))?\\s*\\{\\s*\\}", "globs": ["*.cs"], "severity_hint": "High", "description": "Empty catch block - errors silently dropped (critical inside worker loops)", "reference": "CWE-390"},
  {"id": "BG-CATCH-NO-LOG-OPEN", "pattern": "catch\\s*(\\(\\s*Exception\\s*\\w*\\s*\\))?\\s*\\{\\s*$", "globs": ["*.cs"], "severity_hint": "Low", "description": "Catch block opened on its own line - inspect body for logging", "reference": "CWE-390"},
  {"id": "BG-BACKGROUNDSERVICE", "pattern": ":\\s*BackgroundService\\b|IHostedService\\b|\\[AutomaticRetry|RecurringJob\\.AddOrUpdate", "globs": ["*.cs"], "severity_hint": "Info", "description": "Background worker entry point - trace scope-per-iteration, exception handling, state reset", "reference": "CWE-390"},
  {"id": "BG-FIRE-AND-FORGET", "pattern": "^\\s*(_\\s*=\\s*)?Task\\.(Run|Factory\\.StartNew)\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Task.Run whose result is not awaited - exceptions lost, work unbounded", "reference": "CWE-390"},
  {"id": "BG-INFINITE-LOOP", "pattern": "while\\s*\\(\\s*(true|!\\s*\\w+\\.IsCancellationRequested)\\s*\\)", "globs": ["*.cs"], "severity_hint": "Info", "description": "Worker loop - check per-iteration scope and state", "reference": "CWE-401"}
]
