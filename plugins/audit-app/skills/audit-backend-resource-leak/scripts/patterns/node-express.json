[
  {"id": "DISP-STREAM-NO-PIPELINE", "pattern": "fs\\.createReadStream\\s*\\(|fs\\.createWriteStream\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Stream created - confirm pipeline() or destroy() on error paths", "reference": "CWE-772"},
  {"id": "DISP-FS-OPEN", "pattern": "fs(\\.promises)?\\.open\\s*\\(|fsPromises\\.open\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "File handle opened - confirm close() in finally", "reference": "CWE-772"},
  {"id": "DISP-DBCLIENT-PER-REQUEST", "pattern": "new\\s+PrismaClient\\s*\\(|new\\s+MongoClient\\s*\\(|new\\s+Pool\\s*\\(|createConnection\\s*\\(|createPool\\s*\\(|mongoose\\.connect\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "DB client/pool constructed - must be once per process, not per request", "reference": "CWE-772"},
  {"id": "DISP-POOL-CONNECT-NO-RELEASE", "pattern": "await\\s+\\w*pool\\.connect\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Pool client checked out - confirm release() in finally", "reference": "CWE-772"},
  {"id": "DISP-WORKER-PER-REQUEST", "pattern": "new\\s+Worker\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "worker_threads Worker constructed - confirm pooled and terminated", "reference": "CWE-772"},
  {"id": "TIMER-SETINTERVAL", "pattern": "\\bsetInterval\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "setInterval - leak if created per request/connection/instance without clearInterval", "reference": "CWE-772"},
  {"id": "TIMER-SETTIMEOUT-IN-HANDLER", "pattern": "\\bsetTimeout\\s*\\((?!.*clearTimeout)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Low", "description": "setTimeout - check closure does not retain req/res beyond completion", "reference": "CWE-401"},
  {"id": "STAT-MODULE-COLLECTION", "pattern": "^\\s*(export\\s+)?(const|let|var)\\s+\\w+\\s*(:\\s*[\\w<>\\[\\], ]+)?\\s*=\\s*(\\[\\]|new\\s+(Map|Set|Array)\\s*(<[^>]*>)?\\s*\\(\\s*\\)|\\{\\})\\s*;?\\s*$", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Module-level mutable collection - trace push/set vs splice/delete", "reference": "CWE-401"},
  {"id": "STAT-PROVIDER-COLLECTION", "pattern": "^\\s*(private|public|protected|readonly)\\s+(readonly\\s+)?\\w+\\s*(:\\s*[\\w<>\\[\\], ]+)?\\s*=\\s*(\\[\\]|new\\s+(Map|Set)\\b)", "globs": ["*.ts"], "severity_hint": "Medium", "description": "Class-field collection in a (probably singleton) provider - trace writers vs removers", "reference": "CWE-401"},
  {"id": "SUB-EMITTER-ON", "pattern": "\\.(on|addListener|once)\\s*\\(\\s*['\"]\\w+['\"]", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Listener added - leak if inside a per-request/per-connection path without off()/removeListener", "reference": "CWE-401"},
  {"id": "SUB-PROCESS-ON", "pattern": "process\\.on\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "process listener - must be registered once at startup", "reference": "CWE-401"},
  {"id": "SUB-SETMAXLISTENERS", "pattern": "setMaxListeners\\s*\\(\\s*(0|\\d{3,}|Infinity)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "MaxListeners warning disabled - usually hides a listener leak", "reference": "CWE-401"},
  {"id": "CACHE-UNBOUNDED-CONSTRUCT", "pattern": "new\\s+NodeCache\\s*\\(\\s*\\)|new\\s+LRUCache\\s*\\(\\s*\\)|new\\s+LRU\\s*\\(\\s*\\)|CacheModule\\.register\\s*\\(\\s*\\)|new\\s+Keyv\\s*\\(\\s*\\)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Cache constructed with no max/ttl", "reference": "CWE-770"},
  {"id": "CACHE-MEMOIZE", "pattern": "\\b(memoize|memoizee)\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "memoize - unbounded unless maxAge/max/primitive options set", "reference": "CWE-770"},
  {"id": "ALLOC-BUFFER-CONCAT", "pattern": "Buffer\\.concat\\s*\\(|Buffer\\.alloc(Unsafe)?\\s*\\(\\s*(\\d{6,}|\\w+\\.length|\\w+Size)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Medium", "description": "Whole payload buffered - check size limits", "reference": "CWE-770"},
  {"id": "ALLOC-BODY-NO-LIMIT", "pattern": "express\\.json\\s*\\(\\s*\\)|bodyParser\\.json\\s*\\(\\s*\\)|express\\.urlencoded\\s*\\(\\s*\\{\\s*extended", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Low", "description": "Body parser without limit (default 100kb is fine; note if raised)", "reference": "CWE-770"},
  {"id": "BG-EMPTY-CATCH", "pattern": "catch\\s*(\\(\\s*\\w*\\s*\\))?\\s*\\{\\s*\\}", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Empty catch - errors silently dropped", "reference": "CWE-390"},
  {"id": "BG-PROMISE-CATCH-NOOP", "pattern": "\\.catch\\s*\\(\\s*\\(\\s*\\w*\\s*\\)\\s*=>\\s*(\\{\\s*\\}|null|undefined|void 0)\\s*\\)", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "High", "description": "Promise rejection swallowed with a no-op catch", "reference": "CWE-390"},
  {"id": "BG-WORKER-ENTRY", "pattern": "new\\s+(Queue|Worker)\\s*\\(\\s*['\"]|\\.process\\s*\\(\\s*(['\"]|async)|cron\\.schedule\\s*\\(|new\\s+CronJob\\s*\\(|@Cron\\s*\\(|@Interval\\s*\\(", "globs": ["*.js", "*.ts", "*.mjs"], "severity_hint": "Info", "description": "Background entry point - trace exception handling and per-run state", "reference": "CWE-390"}
]
