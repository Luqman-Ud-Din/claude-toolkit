[
  {"id": "NODE-ENV-DEVELOPMENT", "pattern": "NODE_ENV\\s*[=:]\\s*['\"]?development", "globs": ["Dockerfile*", "*.yml", "*.yaml", "*.json", "ecosystem.config.js", "Procfile"], "severity_hint": "High", "description": "Container/process configured as development", "reference": "CWE-489"},
  {"id": "ERRORHANDLER-MIDDLEWARE", "pattern": "require\\(['\"]errorhandler['\"]\\)|from\\s+['\"]errorhandler['\"]|morgan\\(\\s*['\"]dev['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Development error handler / dev logger; confirm NODE_ENV guard", "reference": "CWE-215"},
  {"id": "STACK-IN-RESPONSE", "pattern": "res\\.(status\\(\\d+\\)\\.)?(json|send)\\([^)]*\\.stack", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Stack trace returned to clients", "reference": "CWE-215"},
  {"id": "ORM-SYNC", "pattern": "synchronize\\s*:\\s*true|sync\\(\\s*\\{\\s*(force|alter)\\s*:\\s*true", "globs": ["*.ts", "*.js", "*.json"], "severity_hint": "High", "description": "ORM mutates schema at startup; no controlled migration/rollback", "reference": ""},
  {"id": "COMMITTED-ENV-PRODUCTION", "pattern": "^(DATABASE_URL|JWT_SECRET|SECRET_KEY|\\w*API_KEY|\\w*PASSWORD|\\w*TOKEN)\\s*=\\s*(?!\\s*$|\\$\\{|<|changeme|replace|xxx)[^\\s]{6,}", "globs": [".env.production", ".env.prod", ".env.staging", ".env"], "severity_hint": "Critical", "description": "Secret value in a committed .env file", "reference": "CWE-798"},
  {"id": "DB-URL-CREDENTIALS", "pattern": "(postgres(ql)?|mysql|mongodb(\\+srv)?|amqps?|rediss?)://[^:\\s/]+:[^@\\s/]+@(?!localhost|127\\.0\\.0\\.1|db|database|postgres|mysql|redis|rabbitmq|mongo)[^/\\s'\"]+", "globs": ["*.ts", "*.js", "*.json", "*.yml", "*.yaml", ".env*"], "severity_hint": "Critical", "description": "Connection URL with credentials to a non-local host", "reference": "CWE-798"},
  {"id": "SECRET-FALLBACK-LITERAL", "pattern": "process\\.env\\.\\w*(SECRET|KEY|PASSWORD|TOKEN)\\w*\\s*(\\|\\||\\?\\?)\\s*['\"][^'\"]{4,}['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Secret falls back to a literal default when the env var is missing", "reference": "CWE-798"},
  {"id": "HEALTH-ROUTE", "pattern": "['\"]/health(z|/live|/ready|check)?['\"]|@nestjs/terminus|HealthCheckService", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Health route present (absence is the finding)", "reference": ""},
  {"id": "SIGTERM-HANDLER", "pattern": "process\\.on\\(\\s*['\"]SIGTERM['\"]|enableShutdownHooks\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Graceful shutdown handler present (absence is the finding)", "reference": ""},
  {"id": "HTTP-NO-TIMEOUT", "pattern": "axios\\.create\\((?![^)]*timeout)|axios\\.(get|post|put|delete)\\((?![^)]*timeout)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "axios without timeout", "reference": "CWE-400"},
  {"id": "SOURCEMAP-PROD", "pattern": "GENERATE_SOURCEMAP\\s*=\\s*true|productionBrowserSourceMaps\\s*:\\s*true|sourcemap\\s*:\\s*true", "globs": [".env.production", "next.config.*", "vite.config.*"], "severity_hint": "Low", "description": "Source maps shipped to production", "reference": "CWE-540"},
  {"id": "UNCAUGHT-SWALLOW", "pattern": "process\\.on\\(\\s*['\"]uncaughtException['\"]\\s*,\\s*\\(?\\s*\\w*\\s*\\)?\\s*=>\\s*\\{\\s*\\}|uncaughtException['\"]\\s*,\\s*console\\.(log|error)\\s*\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "uncaughtException swallowed; process keeps running in unknown state", "reference": ""}
]
