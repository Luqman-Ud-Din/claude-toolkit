[
  {"id": "DEV-EXCEPTION-PAGE", "pattern": "UseDeveloperExceptionPage\\(\\)", "globs": ["*.cs"], "severity_hint": "High", "description": "Developer exception page; confirm it is inside if (app.Environment.IsDevelopment())", "reference": "CWE-489"},
  {"id": "SENSITIVE-DATA-LOGGING", "pattern": "EnableSensitiveDataLogging\\(|EnableDetailedErrors\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "EF Core sensitive data logging / detailed errors; must be dev-only", "reference": "CWE-215"},
  {"id": "SWAGGER-UNGUARDED", "pattern": "UseSwaggerUI\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Swagger UI; confirm dev-only or authenticated", "reference": ""},
  {"id": "PROD-CONNECTION-STRING", "pattern": "(Server|Data Source)=(?!localhost|127\\.0\\.0\\.1|\\(localdb\\)|\\.)[^;\"]+;[^\"]*(Password|Pwd)=", "globs": ["appsettings*.json", "*.config", "*.cs"], "severity_hint": "Critical", "description": "Connection string to a non-local host with a password literal", "reference": "CWE-798"},
  {"id": "PROD-CONFIG-SECRET", "pattern": "\"(JwtKey|Jwt:Key|SecretKey|ApiKey|ClientSecret|Password|Token)\"\\s*:\\s*\"(?!\\$\\{|%|<|__|\\s*\")[^\"]{8,}\"", "globs": ["appsettings.Production.json", "appsettings.Staging.json", "appsettings.Release.json"], "severity_hint": "Critical", "description": "Secret literal in production config", "reference": "CWE-798"},
  {"id": "ENV-DEVELOPMENT-IN-CONTAINER", "pattern": "ASPNETCORE_ENVIRONMENT\\s*[=:]\\s*\"?Development", "globs": ["Dockerfile*", "*.yml", "*.yaml", "*.json"], "severity_hint": "High", "description": "Container/compose sets Development environment", "reference": "CWE-489"},
  {"id": "TRUST-SERVER-CERT", "pattern": "TrustServerCertificate\\s*=\\s*True|Encrypt\\s*=\\s*False", "globs": ["appsettings*.json", "*.cs"], "severity_hint": "Medium", "description": "TLS validation to the database relaxed", "reference": "CWE-295"},
  {"id": "HEALTH-CHECK-PRESENT", "pattern": "AddHealthChecks\\(|MapHealthChecks\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "Health check registration (absence is the finding; readiness_probe.py decides)", "reference": ""},
  {"id": "NEW-HTTPCLIENT", "pattern": "new\\s+HttpClient\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Ad hoc HttpClient without timeout/resilience", "reference": "CWE-400"},
  {"id": "SHUTDOWN-TIMEOUT", "pattern": "ShutdownTimeout|IHostApplicationLifetime", "globs": ["*.cs"], "severity_hint": "Info", "description": "Explicit shutdown handling present", "reference": ""},
  {"id": "SERILOG-DEBUG-PROD", "pattern": "\"MinimumLevel\"\\s*:\\s*(\\{\\s*\"Default\"\\s*:\\s*)?\"(Debug|Verbose)\"", "globs": ["appsettings.Production.json", "appsettings.json"], "severity_hint": "Medium", "description": "Debug-level logging in production config", "reference": ""},
  {"id": "ENSURE-CREATED-OR-MIGRATE-ON-START", "pattern": "\\.EnsureCreated\\(\\)|\\.Migrate\\(\\)|MigrateAsync\\(\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Schema changes applied at startup; rollback and multi-instance start need a plan", "reference": ""}
]
