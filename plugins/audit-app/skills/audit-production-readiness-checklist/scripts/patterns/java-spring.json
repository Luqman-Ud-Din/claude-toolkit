[
  {"id": "DEBUG-TRUE", "pattern": "^\\s*debug\\s*[:=]\\s*true|logging\\.level\\.root\\s*[:=]\\s*(DEBUG|TRACE)", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "High", "description": "Debug logging enabled in a config profile", "reference": "CWE-489"},
  {"id": "SHOW-SQL", "pattern": "show-sql\\s*[:=]\\s*true|show_sql\\s*[:=]\\s*true", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "Medium", "description": "SQL logging enabled", "reference": ""},
  {"id": "STACKTRACE-IN-RESPONSE", "pattern": "include-stacktrace\\s*[:=]\\s*always|include-message\\s*[:=]\\s*always", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "Medium", "description": "Stack traces returned to clients", "reference": "CWE-215"},
  {"id": "H2-CONSOLE", "pattern": "h2\\.console\\.enabled\\s*[:=]\\s*true", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "High", "description": "H2 console enabled", "reference": "CWE-489"},
  {"id": "ACTUATOR-EXPOSE-ALL", "pattern": "exposure\\.include\\s*[:=]\\s*\\*|include:\\s*['\"]?\\*", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "Medium", "description": "All actuator endpoints exposed; confirm management port is internal", "reference": "CWE-200"},
  {"id": "DDL-AUTO-UPDATE", "pattern": "ddl-auto\\s*[:=]\\s*(update|create|create-drop)", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "High", "description": "Schema mutated at startup; no controlled migration/rollback", "reference": ""},
  {"id": "PROD-PASSWORD-LITERAL", "pattern": "(password|secret|api-key|apiKey)\\s*[:=]\\s*(?!\\$\\{)[^\\s$]{6,}", "globs": ["application-prod.yml", "application-prod.yaml", "application-production.yml", "application-prod.properties", "application-production.properties"], "severity_hint": "Critical", "description": "Secret literal in a production profile", "reference": "CWE-798"},
  {"id": "JDBC-URL-CREDENTIALS", "pattern": "jdbc:\\w+://(?!localhost|127\\.0\\.0\\.1)[^\\s]*(password|pwd)=", "globs": ["*.yml", "*.yaml", "*.properties", "*.java"], "severity_hint": "Critical", "description": "JDBC URL with embedded credentials to a non-local host", "reference": "CWE-798"},
  {"id": "PROFILE-HARDCODED", "pattern": "spring\\.profiles\\.active\\s*[:=]\\s*(prod|production)|profiles:\\s*\\n\\s*active:\\s*(prod|production)", "globs": ["application.yml", "application.yaml", "application.properties"], "severity_hint": "Low", "description": "Active profile hard-coded in the base config", "reference": ""},
  {"id": "ACTUATOR-PRESENT", "pattern": "spring-boot-starter-actuator", "globs": ["pom.xml", "build.gradle", "build.gradle.kts"], "severity_hint": "Info", "description": "Actuator present (absence is the health-check finding)", "reference": ""},
  {"id": "GRACEFUL-SHUTDOWN", "pattern": "server\\.shutdown\\s*[:=]\\s*graceful|shutdown:\\s*graceful", "globs": ["application*.yml", "application*.yaml", "application*.properties"], "severity_hint": "Info", "description": "Graceful shutdown configured (absence is the finding)", "reference": ""},
  {"id": "NEW-RESTTEMPLATE", "pattern": "new\\s+RestTemplate\\s*\\(\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "RestTemplate without timeouts", "reference": "CWE-400"}
]
