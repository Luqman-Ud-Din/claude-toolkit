[
  {"id": "FLOAT-MONEY-FIELD", "pattern": "private\\s+(double|float|Double|Float)\\s+\\w*(price|amount|total|cost|balance|tax|discount|rate|fee|salary|credit|debit|paid|charge|vat|commission)\\w*\\s*[;=]", "globs": ["*.java", "*.kt"], "severity_hint": "Critical", "description": "Money-named field typed as binary floating point", "reference": "CWE-682"},
  {"id": "FLOAT-MONEY-SQL", "pattern": "\\b\\w*(price|amount|total|cost|balance|tax|discount|fee|paid|charge|vat|commission)\\w*\\s+(FLOAT|REAL|DOUBLE( PRECISION)?|FLOAT8|FLOAT4)\\b", "globs": ["*.sql", "*.xml", "*.yaml", "*.yml"], "severity_hint": "Critical", "description": "Money-named column declared as float in a migration", "reference": "CWE-682"},
  {"id": "BIGDECIMAL-NO-SCALE", "pattern": "private\\s+BigDecimal\\s+\\w+\\s*;", "globs": ["*.java"], "severity_hint": "Low", "description": "BigDecimal field; confirm @Column(precision, scale) precedes it", "reference": ""},
  {"id": "LOCALDATETIME-FIELD", "pattern": "private\\s+(LocalDateTime|java\\.util\\.Date|Timestamp)\\s+\\w+", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Zone-less timestamp type; prefer Instant/OffsetDateTime", "reference": ""},
  {"id": "DDL-AUTO-UPDATE", "pattern": "ddl-auto\\s*[:=]\\s*(update|create|create-drop)", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "High", "description": "Hibernate generates schema at runtime; migrations bypassed", "reference": "CWE-1188"},
  {"id": "CASCADE-REMOVE", "pattern": "CascadeType\\.(ALL|REMOVE)|orphanRemoval\\s*=\\s*true|OnDeleteAction\\.CASCADE|ON\\s+DELETE\\s+CASCADE", "globs": ["*.java", "*.kt", "*.sql", "*.xml"], "severity_hint": "Medium", "description": "Cascade delete; confirm target is an owned child, not shared data", "reference": ""},
  {"id": "MIGRATION-DESTRUCTIVE", "pattern": "\\b(DROP\\s+(TABLE|COLUMN)|TRUNCATE|DELETE\\s+FROM|ALTER\\s+COLUMN\\s+\\w+\\s+TYPE)\\b", "globs": ["*.sql"], "severity_hint": "High", "description": "Destructive DDL/DML in a migration script", "reference": ""},
  {"id": "LIQUIBASE-SQL-CHANGE", "pattern": "<sql>|<dropColumn|<dropTable|<modifyDataType|^\\s*-\\s*(sql|dropColumn|dropTable|modifyDataType):", "globs": ["*.xml", "*.yaml", "*.yml"], "severity_hint": "Medium", "description": "Liquibase change with no automatic rollback; needs explicit rollback", "reference": ""},
  {"id": "FLYWAY-CLEAN-ENABLED", "pattern": "flyway\\.clean-disabled\\s*[:=]\\s*false|clean-on-validation-error\\s*[:=]\\s*true", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Critical", "description": "Flyway may drop the whole schema", "reference": ""},
  {"id": "PLAINTEXT-PASSWORD-FIELD", "pattern": "private\\s+String\\s+(password|pwd|pin|cardNumber|cvv|ssn|nationalId|iban|apiKey|secret)\\s*;", "globs": ["*.java", "*.kt"], "severity_hint": "Critical", "description": "Sensitive value as plain String field (expect hash/AttributeConverter)", "reference": "CWE-312"},
  {"id": "SEED-PEOPLE-ROWS", "pattern": "INSERT\\s+INTO\\s+\\w*(user|customer|employee|person|account)", "globs": ["*.sql"], "severity_hint": "Info", "description": "Seed rows for a people table; check for real PII", "reference": "CWE-359"},
  {"id": "ENTITY-PRESENT", "pattern": "^\\s*@Entity\\b", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Entity present; confirm @Version on editable aggregates and @Index on FK join columns", "reference": ""}
]
