[
  {"id": "FLOATFIELD-MONEY", "pattern": "\\w*(price|amount|total|cost|balance|tax|discount|rate|fee|salary|credit|debit|paid|charge|vat|commission)\\w*\\s*=\\s*models\\.FloatField", "globs": ["*.py"], "severity_hint": "Critical", "description": "Money-named Django field is FloatField", "reference": "CWE-682"},
  {"id": "SQLALCHEMY-FLOAT-MONEY", "pattern": "\\w*(price|amount|total|cost|balance|tax|discount|fee|paid|charge|vat|commission)\\w*\\s*(:\\s*Mapped\\[float\\])?\\s*=\\s*(mapped_column|Column)\\(\\s*Float", "globs": ["*.py"], "severity_hint": "Critical", "description": "Money-named SQLAlchemy column is Float", "reference": "CWE-682"},
  {"id": "DECIMAL-TWO-PLACES-RATE", "pattern": "\\w*(rate|unit_cost|unit_price|factor|percentage)\\w*\\s*=\\s*models\\.DecimalField\\([^)]*decimal_places\\s*=\\s*[12]\\b", "globs": ["*.py"], "severity_hint": "Low", "description": "Rate/unit cost with only 1-2 decimal places", "reference": ""},
  {"id": "USE-TZ-FALSE", "pattern": "USE_TZ\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "High", "description": "Naive datetimes stored; timezone bugs across DST/regions", "reference": ""},
  {"id": "SQLALCHEMY-NAIVE-DATETIME", "pattern": "(mapped_column|Column)\\(\\s*DateTime\\s*[,)]", "globs": ["*.py"], "severity_hint": "Low", "description": "DateTime without timezone=True", "reference": ""},
  {"id": "TEXTFIELD-FOR-CODE", "pattern": "\\w*(code|sku|name|email|phone|slug|number|title)\\w*\\s*=\\s*models\\.TextField", "globs": ["*.py"], "severity_hint": "Medium", "description": "Unbounded TextField used for a short bounded value", "reference": ""},
  {"id": "FK-CASCADE-SHARED", "pattern": "ForeignKey\\(\\s*['\"]?\\w*(Company|Tenant|Branch|User|Product|Customer|Supplier|Category|Currency|Account)\\w*['\"]?[^)]*on_delete\\s*=\\s*models\\.CASCADE", "globs": ["*.py"], "severity_hint": "High", "description": "CASCADE from a shared reference model; deleting the parent wipes business rows", "reference": ""},
  {"id": "FK-NO-INDEX", "pattern": "ForeignKey\\([^)]*db_index\\s*=\\s*False", "globs": ["*.py"], "severity_hint": "Medium", "description": "FK index explicitly disabled", "reference": ""},
  {"id": "RUNPYTHON-NO-REVERSE", "pattern": "RunPython\\(\\s*\\w+\\s*\\)|RunPython\\.noop|RunSQL\\(\\s*['\"][^,]*['\"]\\s*\\)", "globs": ["*.py"], "severity_hint": "Medium", "description": "Data migration without a working reverse", "reference": ""},
  {"id": "MIGRATION-DESTRUCTIVE", "pattern": "migrations\\.(RemoveField|DeleteModel)\\(|op\\.(drop_table|drop_column)\\(|DROP\\s+(TABLE|COLUMN)", "globs": ["*.py", "*.sql"], "severity_hint": "High", "description": "Destructive migration step", "reference": ""},
  {"id": "ALEMBIC-DOWNGRADE-STUB", "pattern": "def downgrade\\(\\)\\s*(->\\s*None\\s*)?:\\s*(pass|raise|\\.\\.\\.)\\s*$", "globs": ["*.py"], "severity_hint": "Medium", "description": "Alembic downgrade stub on one line (the reversibility script catches the multi-line form)", "reference": ""},
  {"id": "PLAINTEXT-PASSWORD", "pattern": "^\\s*(password|pwd|pin|card_number|cvv|ssn|national_id|cnic|iban|api_key|secret)\\s*=\\s*models\\.(CharField|TextField)", "globs": ["*.py"], "severity_hint": "Critical", "description": "Sensitive value as a plain char field (expect hash/encrypted field)", "reference": "CWE-312"},
  {"id": "FIXTURE-PEOPLE", "pattern": "\"model\"\\s*:\\s*\"\\w+\\.(user|customer|employee|person|profile)\"", "globs": ["*.json", "*.yaml", "*.yml"], "severity_hint": "Info", "description": "Fixture rows for a people model; check for real PII", "reference": "CWE-359"}
]
