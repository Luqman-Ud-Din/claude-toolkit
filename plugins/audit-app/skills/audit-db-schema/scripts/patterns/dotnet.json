[
  {"id": "FLOAT-MONEY-PROPERTY", "pattern": "public\\s+(double|float|Single|Double)\\??\\s+\\w*(Price|Amount|Total|Cost|Balance|Tax|Discount|Rate|Fee|Salary|Credit|Debit|Paid|Charge|Vat|Commission)\\w*\\s*\\{", "globs": ["*.cs"], "severity_hint": "Critical", "description": "Money-named property typed as binary floating point", "reference": "CWE-682", "ignore_case": false},
  {"id": "FLOAT-MONEY-SQL", "pattern": "\\b\\w*(Price|Amount|Total|Cost|Balance|Tax|Discount|Fee|Paid|Charge|Vat|Commission)\\w*\\]?\\s+(FLOAT|REAL|DOUBLE( PRECISION)?)\\b", "globs": ["*.sql"], "severity_hint": "Critical", "description": "Money-named column declared FLOAT/REAL/DOUBLE in DDL", "reference": "CWE-682"},
  {"id": "NAIVE-DATETIME-PROPERTY", "pattern": "public\\s+DateTime\\??\\s+\\w+\\s*\\{", "globs": ["*.cs"], "severity_hint": "Low", "description": "DateTime (no offset) property; confirm UTC convention or use DateTimeOffset", "reference": "", "ignore_case": false},
  {"id": "NVARCHAR-MAX", "pattern": "nvarchar\\s*\\(\\s*max\\s*\\)|varchar\\s*\\(\\s*max\\s*\\)", "globs": ["*.sql", "*.cs"], "severity_hint": "Medium", "description": "Unbounded string column; cannot be indexed, bloats rows", "reference": "CWE-400"},
  {"id": "CASCADE-DELETE-BEHAVIOUR", "pattern": "DeleteBehavior\\.Cascade|ON\\s+DELETE\\s+CASCADE", "globs": ["*.cs", "*.sql"], "severity_hint": "Medium", "description": "Cascade delete configured; confirm it does not point at a shared reference table", "reference": ""},
  {"id": "MIGRATION-RAW-SQL", "pattern": "migrationBuilder\\.Sql\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Hand-written SQL inside a migration; review reversibility by hand", "reference": ""},
  {"id": "MIGRATION-DROP", "pattern": "migrationBuilder\\.(DropColumn|DropTable)\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "Destructive migration step; needs backup/expand-contract", "reference": ""},
  {"id": "MIGRATION-NOT-SUPPORTED", "pattern": "throw new (NotSupportedException|NotImplementedException)\\(", "globs": ["*Migrations*.cs", "2*.cs"], "severity_hint": "High", "description": "Migration Down() explicitly refuses to run", "reference": ""},
  {"id": "SEED-DATA", "pattern": "\\.HasData\\(|\\.InsertData\\(", "globs": ["*.cs"], "severity_hint": "Info", "description": "Seed data present; check for real PII/credentials", "reference": "CWE-359"},
  {"id": "PLAINTEXT-PASSWORD-COLUMN", "pattern": "public\\s+string\\??\\s+(Password|Pwd|Passwd|Pin|CardNumber|Cvv|Ssn|NationalId|Cnic|Iban|ApiKey|Secret)\\s*\\{", "globs": ["*.cs"], "severity_hint": "Critical", "description": "Sensitive value mapped as a plain string property (expect hash/encrypted)", "reference": "CWE-312", "ignore_case": false},
  {"id": "ENSURE-CREATED", "pattern": "\\.EnsureCreated\\(\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "EnsureCreated bypasses migrations; schema cannot be evolved", "reference": ""},
  {"id": "HARD-DELETE-IN-REPOSITORY", "pattern": "\\.Remove\\(\\s*\\w+\\s*\\)|\\.RemoveRange\\(", "globs": ["*Repository*.cs", "*Manager*.cs", "*Service*.cs"], "severity_hint": "Info", "description": "Hard delete via Remove(); check against the soft-delete convention", "reference": ""},
  {"id": "NO-KEY-ENTITY", "pattern": "\\.HasNoKey\\(\\)|\\[Keyless\\]", "globs": ["*.cs"], "severity_hint": "Info", "description": "Keyless entity; must be read-only", "reference": ""},
  {"id": "DECIMAL-DEFAULT-PRECISION", "pattern": "public\\s+decimal\\??\\s+\\w*(Rate|UnitCost|UnitPrice|Percentage|Factor)\\w*\\s*\\{", "globs": ["*.cs"], "severity_hint": "Low", "description": "decimal that likely needs more than the default 2 decimal places; check HasPrecision", "reference": "", "ignore_case": false}
]
