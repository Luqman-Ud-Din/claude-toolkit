[
  {"id": "PRISMA-FLOAT-MONEY", "pattern": "^\\s*\\w*(price|amount|total|cost|balance|tax|discount|rate|fee|paid|charge|vat|commission)\\w*\\s+Float", "globs": ["*.prisma"], "severity_hint": "Critical", "description": "Money-named Prisma field typed Float", "reference": "CWE-682"},
  {"id": "TYPEORM-FLOAT-COLUMN", "pattern": "@Column\\(\\s*(\\{[^}]*type\\s*:\\s*)?['\"](float|double|real|double precision)['\"]", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "TypeORM float column; Critical if it holds money", "reference": "CWE-682"},
  {"id": "KNEX-FLOAT-MONEY", "pattern": "\\.(float|double)\\(\\s*['\"]\\w*(price|amount|total|cost|balance|tax|discount|fee|paid|charge|vat|commission)", "globs": ["*.js", "*.ts"], "severity_hint": "Critical", "description": "Knex float/double on a money column", "reference": "CWE-682"},
  {"id": "KNEX-DECIMAL-DEFAULT", "pattern": "\\.decimal\\(\\s*['\"]\\w+['\"]\\s*\\)", "globs": ["*.js", "*.ts"], "severity_hint": "Medium", "description": "Knex decimal without precision defaults to (8,2)", "reference": ""},
  {"id": "SEQUELIZE-FLOAT", "pattern": "DataTypes\\.(FLOAT|DOUBLE|REAL)", "globs": ["*.js", "*.ts"], "severity_hint": "High", "description": "Sequelize float type; Critical if money", "reference": "CWE-682"},
  {"id": "SQL-FLOAT-MONEY", "pattern": "\\b\\w*(price|amount|total|cost|balance|tax|discount|fee|paid|charge|vat|commission)\\w*\\\"?\\s+(FLOAT|REAL|DOUBLE( PRECISION)?|FLOAT8)\\b", "globs": ["*.sql"], "severity_hint": "Critical", "description": "Money-named column declared float in SQL migration", "reference": "CWE-682"},
  {"id": "PRISMA-NAIVE-TIMESTAMP", "pattern": "^\\s*\\w+\\s+DateTime\\??(?!.*@db\\.Timestamptz)", "globs": ["*.prisma"], "severity_hint": "Low", "description": "Prisma DateTime without @db.Timestamptz (naive on Postgres)", "reference": ""},
  {"id": "KNEX-NAIVE-TIMESTAMP", "pattern": "\\.(timestamp|dateTime)\\(\\s*['\"]\\w+['\"]\\s*\\)|\\.timestamps\\(\\s*\\)", "globs": ["*.js", "*.ts"], "severity_hint": "Low", "description": "Knex timestamp without useTz", "reference": ""},
  {"id": "SYNCHRONIZE-TRUE", "pattern": "synchronize\\s*:\\s*true|sync\\(\\s*\\{\\s*(force|alter)\\s*:\\s*true", "globs": ["*.ts", "*.js", "*.json"], "severity_hint": "High", "description": "ORM auto-syncs schema at runtime; migrations bypassed, data loss on alter", "reference": "CWE-1188"},
  {"id": "CASCADE-DELETE", "pattern": "onDelete\\s*:\\s*['\"]?CASCADE|onDelete\\(\\s*['\"]CASCADE|ON\\s+DELETE\\s+CASCADE", "globs": ["*.ts", "*.js", "*.prisma", "*.sql"], "severity_hint": "Medium", "description": "Cascade delete; confirm target is an owned child", "reference": ""},
  {"id": "MIGRATION-DROP", "pattern": "\\.(dropTable|dropColumn|dropColumns|removeColumn)\\(|DROP\\s+(TABLE|COLUMN)", "globs": ["*.js", "*.ts", "*.sql"], "severity_hint": "High", "description": "Destructive migration step", "reference": ""},
  {"id": "MIGRATION-DOWN-STUB", "pattern": "(down|exports\\.down)\\s*[:=(].{0,60}(\\{\\s*\\}|Promise\\.resolve\\(\\)|throw new Error)", "globs": ["*.js", "*.ts"], "severity_hint": "High", "description": "Migration down() is empty or throws (single-line form; the reversibility script catches multi-line)", "reference": ""},
  {"id": "PRISMA-DATA-LOSS-WARNING", "pattern": "Warnings:|data will be lost|You are about to drop", "globs": ["migration.sql"], "severity_hint": "High", "description": "Prisma recorded a data-loss warning in this migration", "reference": ""},
  {"id": "PLAINTEXT-PASSWORD", "pattern": "^\\s*(password|pwd|pin|cardNumber|cvv|ssn|nationalId|iban|apiKey|secret)\\s*[?!]?:\\s*string|^\\s*(password|cardNumber|ssn|iban)\\s+String\\b", "globs": ["*.entity.ts", "*.prisma", "*.model.ts"], "severity_hint": "Critical", "description": "Sensitive value as a plain string column", "reference": "CWE-312"},
  {"id": "SEED-PEOPLE", "pattern": "(insert|createMany|create)\\(.*(user|customer|employee|person)|INSERT\\s+INTO\\s+\\w*(user|customer|employee|person)", "globs": ["*seed*", "*.sql"], "severity_hint": "Info", "description": "Seed rows for a people table; check for real PII", "reference": "CWE-359"}
]
