[
  {
    "id": "PII-REACT-CONSOLE-LOG-PII",
    "pattern": "console\\.(?:log|info|debug|warn|error)\\s*\\([^;]*\\b(?:email|phone|mobile|firstName|lastName|fullName|address|dob|ssn|password|user|profile|token)\\b",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Medium",
    "description": "console.* with a PII or user object - browser console, error trackers and session replay capture it",
    "reference": "CWE-532"
  },
  {
    "id": "PII-REACT-LOCALSTORAGE-PII",
    "pattern": "(?:localStorage|sessionStorage)\\.setItem\\s*\\(\\s*['\"][^'\"]*(?:email|phone|user|profile|customer)[^'\"]*['\"]|(?:localStorage|sessionStorage)\\.setItem\\s*\\([^;]*JSON\\.stringify\\s*\\(\\s*(?:user|profile|customer)",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Medium",
    "description": "PII / user profile persisted in web storage - a client-side storage location",
    "reference": "CWE-922"
  },
  {
    "id": "PII-REACT-ANALYTICS-CALL",
    "pattern": "\\b(?:gtag|ga|fbq|mixpanel|amplitude|posthog|analytics|hj|clarity|logEvent|trackEvent|track|identify|setUserId|setUserProperties|dataLayer\\.push)\\s*[.(]",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Info",
    "description": "Analytics / telemetry call - check the properties for PII",
    "reference": "GDPR-Art.28"
  },
  {
    "id": "PII-REACT-ANALYTICS-WITH-PII",
    "pattern": "\\b(?:gtag|mixpanel|amplitude|posthog|analytics|logEvent|trackEvent|track|identify|setUserProperties|dataLayer\\.push)\\b[^;]*\\b(?:email|phone|mobile|firstName|lastName|fullName|name)\\s*:",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "High",
    "description": "Analytics event whose properties include PII",
    "reference": "CWE-359"
  },
  {
    "id": "PII-REACT-SENTRY-SET-USER",
    "pattern": "Sentry\\.setUser\\s*\\(\\s*\\{[^}]*(?:email|username)",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Medium",
    "description": "Sentry user context includes email/username",
    "reference": "CWE-359"
  },
  {
    "id": "PII-REACT-PII-IN-QUERY",
    "pattern": "[?&](?:email|phone|mobile|ssn)=\\$\\{|searchParams\\.(?:set|append)\\s*\\(\\s*['\"](?:email|phone|mobile)['\"]|params\\s*:\\s*\\{[^}]*\\b(?:email|phone|mobile)\\b",
    "globs": ["*.js", "*.jsx", "*.ts", "*.tsx"],
    "severity_hint": "Medium",
    "description": "PII sent as a query parameter",
    "reference": "CWE-598"
  },
  {
    "id": "PII-REACT-THIRD-PARTY-SCRIPT",
    "pattern": "<(?:script|Script)[^>]*src\\s*=\\s*[{'\"]+https?://(?:www\\.googletagmanager\\.com|www\\.google-analytics\\.com|static\\.hotjar\\.com|cdn\\.segment\\.com|js\\.intercomcdn\\.com|widget\\.intercom\\.io|www\\.clarity\\.ms|connect\\.facebook\\.net|cdn\\.mxpnl\\.com|js\\.stripe\\.com)",
    "globs": ["*.html", "*.jsx", "*.tsx"],
    "severity_hint": "Info",
    "description": "Third-party tag loaded in the page",
    "reference": "GDPR-Art.28"
  },
  {
    "id": "PII-REACT-FORM-FIELD-PII",
    "pattern": "(?:name|id)\\s*=\\s*['\"{]+(?:email|phone|mobile|firstName|lastName|fullName|address|dob|ssn|iban|cardNumber)['\"}]|register\\s*\\(\\s*['\"](?:email|phone|mobile|firstName|lastName|address|dob|ssn|iban|cardNumber)['\"]",
    "globs": ["*.jsx", "*.tsx"],
    "severity_hint": "Info",
    "description": "Form input collecting PII - a collection point",
    "reference": "GDPR-Art.30"
  },
  {
    "id": "PII-REACT-SERVER-ACTION-OR-API-OUTBOUND",
    "pattern": "\\b(?:fetch|axios)\\s*(?:\\.(?:post|put|patch|get))?\\s*\\(\\s*[`'\"]https?://(?!localhost)",
    "globs": ["route.ts", "route.js", "*.server.ts", "*.server.js", "pages/api/*.ts", "pages/api/*.js", "actions.ts", "*.ts", "*.tsx"],
    "severity_hint": "Info",
    "description": "Outbound call to an external host from React/Next code - inspect the body for PII",
    "reference": "GDPR-Art.28"
  }
]
