[
  {"id": "NPLUS1-ORM-IN-LOOP-INDENTED", "pattern": "^\\s{8,}\\w*\\s*=?\\s*\\w+\\.objects\\.(get|filter|first|exists|count|all)\\s*\\(", "globs": ["*.py"], "severity_hint": "High", "description": "ORM call at loop-body indentation - confirm N+1", "reference": "CWE-1049"},
  {"id": "NPLUS1-RELATED-IN-LOOP", "pattern": "^\\s{8,}.*\\b\\w+\\.\\w+_set\\.(all|filter|count|exists)\\s*\\(|^\\s{8,}.*\\b\\w+\\.\\w+\\.(all|filter|count)\\s*\\(\\)", "globs": ["*.py"], "severity_hint": "High", "description": "Related manager accessed inside a loop - needs prefetch_related", "reference": "CWE-1049"},
  {"id": "NPLUS1-SERIALIZER-METHOD-FIELD", "pattern": "SerializerMethodField\\s*\\(|source\\s*=\\s*['\"]\\w+\\.\\w+['\"]", "globs": ["serializers.py", "*serializer*.py"], "severity_hint": "Medium", "description": "Serializer field that walks a relation per row - confirm select_related/prefetch_related in the view", "reference": "CWE-1049"},
  {"id": "NPLUS1-NESTED-SERIALIZER", "pattern": "^\\s+\\w+\\s*=\\s*\\w+Serializer\\s*\\([^)]*many\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Medium", "description": "Nested many=True serializer - one query per parent unless prefetched", "reference": "CWE-1049"},
  {"id": "NPLUS1-TEMPLATE-RELATION", "pattern": "\\{\\{\\s*\\w+\\.\\w+\\.\\w+", "globs": ["*.html"], "severity_hint": "Low", "description": "Template walks a relation - inside a for loop this is N+1 unless select_related", "reference": "CWE-1049"},
  {"id": "UNBOUNDED-OBJECTS-ALL", "pattern": "\\.objects\\.all\\s*\\(\\s*\\)\\s*$|\\.objects\\.all\\s*\\(\\s*\\)\\s*\\)|queryset\\s*=\\s*\\w+\\.objects\\.all\\s*\\(\\s*\\)", "globs": ["*.py"], "severity_hint": "Medium", "description": "objects.all() with no slice - unbounded unless paginated by the view", "reference": "CWE-770"},
  {"id": "UNBOUNDED-PAGINATION-NONE", "pattern": "pagination_class\\s*=\\s*None", "globs": ["*.py"], "severity_hint": "High", "description": "DRF pagination disabled on a view", "reference": "CWE-770"},
  {"id": "UNBOUNDED-LIST-QUERYSET", "pattern": "list\\s*\\(\\s*\\w+\\.objects\\.(all|filter)\\s*\\(|serializer\\s*=\\s*\\w+\\(\\s*\\w+\\.objects\\.(all|filter)[^)]*\\)\\s*,\\s*many\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Medium", "description": "Queryset materialised/serialised in full", "reference": "CWE-770"},
  {"id": "UNBOUNDED-NO-DEFAULT-PAGINATION", "pattern": "REST_FRAMEWORK\\s*=\\s*\\{(?![\\s\\S]*DEFAULT_PAGINATION_CLASS)", "globs": ["settings*.py"], "severity_hint": "Medium", "description": "REST_FRAMEWORK settings without DEFAULT_PAGINATION_CLASS", "reference": "CWE-770"},
  {"id": "TRACKING-LEN-QUERYSET", "pattern": "\\blen\\s*\\(\\s*\\w+\\.objects\\.(all|filter)|\\blen\\s*\\(\\s*(qs|queryset)\\s*\\)", "globs": ["*.py"], "severity_hint": "Low", "description": "len() materialises the queryset - use count()", "reference": "CWE-400"},
  {"id": "TRACKING-FULL-INSTANCE-ONE-FIELD", "pattern": "\\.objects\\.(get|filter)\\s*\\([^)]*\\)(\\.first\\(\\))?\\.\\w+\\s*$", "globs": ["*.py"], "severity_hint": "Low", "description": "Whole instance loaded to read one field - use values_list(..., flat=True)", "reference": "CWE-400"},
  {"id": "INDEX-ICONTAINS", "pattern": "__(icontains|contains|iendswith|endswith|iregex|regex)\\s*=", "globs": ["*.py"], "severity_hint": "Low", "description": "Substring/regex filter - btree index unusable; cross-check audit-db-schema (trigram)", "reference": "CWE-400"},
  {"id": "INDEX-ORDER-BY", "pattern": "\\.order_by\\s*\\(\\s*['\"]-?\\w+['\"]", "globs": ["*.py"], "severity_hint": "Info", "description": "Sort column - add to the index cross-check table", "reference": "CWE-400"},
  {"id": "INDEX-DECLARED", "pattern": "db_index\\s*=\\s*True|models\\.Index\\s*\\(|AddIndex\\s*\\(|unique\\s*=\\s*True", "globs": ["*.py"], "severity_hint": "Info", "description": "Index declaration - inventory for cross-check", "reference": "CWE-400"},
  {"id": "TXN-MULTI-WRITE", "pattern": "^\\s{4,}\\w*\\s*=?\\s*\\w+\\.objects\\.(create|bulk_create|update|bulk_update|get_or_create|update_or_create)\\s*\\(|^\\s{4,}\\w+\\.save\\s*\\(\\s*\\)|^\\s{4,}\\w+\\.delete\\s*\\(\\s*\\)", "globs": ["*.py"], "severity_hint": "Info", "description": "ORM write - two or more per function on different models need transaction.atomic()", "reference": "CWE-662"},
  {"id": "TXN-ATOMIC", "pattern": "transaction\\.atomic\\s*\\(|@transaction\\.atomic|ATOMIC_REQUESTS\\s*[:=]\\s*True", "globs": ["*.py"], "severity_hint": "Info", "description": "Transaction boundary - confirm it wraps every model written", "reference": "CWE-662"},
  {"id": "TXN-TASK-INSIDE-ATOMIC", "pattern": "\\.delay\\s*\\(|\\.apply_async\\s*\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "Task enqueued - if inside atomic(), wrap with transaction.on_commit", "reference": "CWE-662"},
  {"id": "INEFFICIENT-COUNT-VS-EXISTS", "pattern": "\\.count\\s*\\(\\s*\\)\\s*(>\\s*0|>=\\s*1|==\\s*0|!=\\s*0)|if\\s+len\\s*\\(\\s*\\w+\\.objects", "globs": ["*.py"], "severity_hint": "Low", "description": "count() compared to zero - use exists()", "reference": "CWE-400"},
  {"id": "INEFFICIENT-FILTER-IN-PYTHON", "pattern": "\\[\\s*\\w+\\s+for\\s+\\w+\\s+in\\s+\\w+\\.objects\\.(all|filter)\\s*\\([^)]*\\)\\s+if\\s+", "globs": ["*.py"], "severity_hint": "Medium", "description": "Queryset filtered in a Python comprehension - move predicate to filter()", "reference": "CWE-400"},
  {"id": "INEFFICIENT-INDEX-ZERO", "pattern": "\\.objects\\.(filter|all)\\s*\\([^)]*\\)\\s*\\[\\s*0\\s*\\]", "globs": ["*.py"], "severity_hint": "Low", "description": "qs[0] - use first() (raises vs None semantics, same query)", "reference": "CWE-400"},
  {"id": "INEFFICIENT-SAVE-IN-LOOP", "pattern": "^\\s{8,}\\w+\\.save\\s*\\(\\s*\\)", "globs": ["*.py"], "severity_hint": "Low", "description": "save() at loop indentation - use bulk_create/bulk_update", "reference": "CWE-400"},
  {"id": "UNBOUNDED-REPO-COLLECTION", "globs": ["*.py"], "severity_hint": "Medium", "ignore_case": false, "pattern": "def\\s+(get|find|list|all|fetch)_\\w*\\s*\\([^)]*\\)\\s*(->\\s*(list|List)\\[\\w+\\])", "description": "Repository/service function annotated to return list[X] (confirm no paging)", "reference": "CWE-770"}
]
