[
  {"id": "NPLUS1-AWAIT-ORM-INDENTED", "pattern": "^\\s{6,}(const|let|var)?\\s*\\w*\\s*=?\\s*await\\s+(this\\.)?\\w*(prisma|repo|repository|Repository|model|Model|db|knex|sequelize)\\w*(\\.\\w+)*\\.(findUnique|findFirst|findMany|findOne|findById|findByPk|findAll|find|get|first|query|count)\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "High", "description": "await on an ORM call at loop-body indentation - confirm N+1", "reference": "CWE-1049"},
  {"id": "NPLUS1-MAP-ASYNC-ORM", "pattern": "\\.(map|forEach)\\s*\\(\\s*async\\s*\\(?\\s*\\w+\\s*\\)?\\s*=>", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "async map/forEach - if the body queries, it is N parallel queries (still N+1)", "reference": "CWE-1049"},
  {"id": "NPLUS1-FOR-AWAIT", "pattern": "for\\s*(await)?\\s*\\(\\s*(const|let)\\s+\\w+\\s+of\\s+", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "for-of loop - inspect body for awaited ORM calls", "reference": "CWE-1049"},
  {"id": "NPLUS1-SEQUELIZE-GETTER", "pattern": "await\\s+\\w+\\.get[A-Z]\\w+\\s*\\(\\s*\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Sequelize association getter per instance - use include", "reference": "CWE-1049"},
  {"id": "UNBOUNDED-FINDMANY-NO-TAKE", "pattern": "\\.findMany\\s*\\(\\s*(\\)|\\{(?![^}]*\\btake\\b)[^}]*\\}\\s*\\))", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Prisma findMany with no take", "reference": "CWE-770"},
  {"id": "UNBOUNDED-TYPEORM-FIND", "pattern": "\\.find\\s*\\(\\s*(\\)|\\{(?![^}]*\\b(take|skip)\\b)[^}]*\\}\\s*\\))", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "TypeORM/Mongoose find with no take/limit on the same line - confirm", "reference": "CWE-770"},
  {"id": "UNBOUNDED-FINDALL", "pattern": "\\.findAll\\s*\\(\\s*(\\)|\\{(?![^}]*\\blimit\\b)[^}]*\\}\\s*\\))", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Sequelize findAll with no limit", "reference": "CWE-770"},
  {"id": "UNBOUNDED-KNEX-SELECT", "pattern": "knex\\s*\\(\\s*['\"]\\w+['\"]\\s*\\)\\s*\\.select\\s*\\((?!.*limit)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "Knex select with no limit on the same line", "reference": "CWE-770"},
  {"id": "UNBOUNDED-RES-JSON-DIRECT", "pattern": "res\\.(json|send)\\s*\\(\\s*await\\s+.*\\.(findMany|find|findAll)\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Route returns an unpaged ORM result directly", "reference": "CWE-770"},
  {"id": "TRACKING-NO-SELECT", "pattern": "\\.findMany\\s*\\(\\s*\\{(?![^}]*\\bselect\\b)[^}]*\\binclude\\b", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "findMany with include but no select - full entities plus relations", "reference": "CWE-400"},
  {"id": "TRACKING-MONGOOSE-NO-LEAN", "pattern": "^(?!.*\\.lean\\s*\\().*\\.find\\s*\\([^)]*\\)\\s*(\\.\\w+\\([^)]*\\))*\\s*;", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Mongoose find without lean() - hydration cost on read-only paths", "reference": "CWE-400"},
  {"id": "TRACKING-EAGER-RELATION", "pattern": "eager\\s*:\\s*true", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "TypeORM eager relation - joined on every find", "reference": "CWE-400"},
  {"id": "INDEX-CONTAINS-FILTER", "pattern": "contains\\s*:|\\$regex|Like\\s*\\(\\s*[`'\"]%|ILike\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Substring filter - index unusable; cross-check audit-db-schema", "reference": "CWE-400"},
  {"id": "INDEX-DECLARED", "pattern": "@@index\\s*\\(|@Index\\s*\\(|index\\s*:\\s*true|\\.index\\s*\\(\\s*\\{", "globs": ["*.prisma", "*.ts", "*.js"], "severity_hint": "Info", "description": "Index declaration - inventory for cross-check", "reference": "CWE-400"},
  {"id": "INDEX-ORDERBY", "pattern": "orderBy\\s*:\\s*\\{\\s*(\\w+)|\\.orderBy\\s*\\(|order\\s*:\\s*\\[\\[", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Sort column - add to the index cross-check table", "reference": "CWE-400"},
  {"id": "TXN-MULTI-WRITE", "pattern": "^\\s{4,}(await\\s+)?(this\\.)?\\w*(prisma|repo|repository|Repository|model|Model|db)\\w*(\\.\\w+)*\\.(create|createMany|update|updateMany|delete|deleteMany|save|insert|upsert|bulkCreate|destroy)\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "ORM write - two or more per function on different models need a transaction", "reference": "CWE-662"},
  {"id": "TXN-BOUNDARY", "pattern": "\\$transaction\\s*\\(|\\.transaction\\s*\\(|startSession\\s*\\(|withTransaction\\s*\\(|createQueryRunner\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "Transaction boundary - confirm the inner calls use tx/{ transaction }/session", "reference": "CWE-662"},
  {"id": "TXN-GLOBAL-CLIENT-IN-TX", "pattern": "\\$transaction\\s*\\(\\s*async\\s*\\(\\s*tx\\s*\\)[\\s\\S]{0,400}\\bprisma\\.\\w+\\.(create|update|delete)", "globs": ["*.ts", "*.js"], "severity_hint": "High", "description": "Global prisma used inside $transaction callback instead of tx", "reference": "CWE-662"},
  {"id": "INEFFICIENT-COUNT-VS-EXISTS", "pattern": "\\.count\\s*\\([^)]*\\)\\s*\\)?\\s*(>\\s*0|>=\\s*1|===?\\s*0|!==?\\s*0)|\\.length\\s*(>\\s*0|===?\\s*0)\\s*;?\\s*//.*(exist|check)", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "count compared to zero - use findFirst/exists", "reference": "CWE-400"},
  {"id": "INEFFICIENT-FILTER-IN-JS", "pattern": "\\(\\s*await\\s+[^)]*\\.(findMany|find|findAll)\\s*\\([^)]*\\)\\s*\\)\\s*\\.(filter|find|some|length)", "globs": ["*.ts", "*.js"], "severity_hint": "Medium", "description": "ORM result filtered/counted in JS - move predicate to the query", "reference": "CWE-400"},
  {"id": "INEFFICIENT-PROMISE-ALL-UNBOUNDED", "pattern": "Promise\\.all\\s*\\(\\s*\\w+\\.map\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Promise.all over a mapped collection - unbounded concurrency if the body queries", "reference": "CWE-400"},
  {"id": "UNBOUNDED-REPO-COLLECTION", "globs": ["*.ts"], "severity_hint": "Medium", "ignore_case": false, "pattern": "(async\\s+)?(get|find|list|all|fetch)\\w*\\s*\\([^)]*\\)\\s*:\\s*Promise<\\s*\\w+\\[\\]\\s*>", "description": "Repository/service method returns Promise<X[]> (confirm no paging)", "reference": "CWE-770"}
]
