[
  {"id": "NPLUS1-REPO-CALL-INDENTED", "pattern": "^\\s{12,}(\\w+\\s*=\\s*)?\\w*(repo|repository|Repository|dao|Dao|entityManager|em)\\w*\\.(findById|findOne|findBy\\w+|getOne|getReferenceById|find|createQuery|getResultList)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Repository call at deep indentation - usually inside a loop; confirm N+1", "reference": "CWE-1049"},
  {"id": "NPLUS1-STREAM-MAP-REPO", "pattern": "\\.(map|forEach|flatMap)\\s*\\(\\s*\\w+\\s*->\\s*\\w*(repo|repository|Repository|dao|service)\\w*\\.", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Stream map/forEach calling a repository per element", "reference": "CWE-1049"},
  {"id": "NPLUS1-OPEN-IN-VIEW", "pattern": "open-in-view\\s*[:=]\\s*true|spring\\.jpa\\.open-in-view\\s*=\\s*true", "globs": ["*.yml", "*.yaml", "*.properties"], "severity_hint": "Medium", "description": "open-in-view enabled - lazy loads during serialization become N+1", "reference": "CWE-1049"},
  {"id": "NPLUS1-OPEN-IN-VIEW-DEFAULT", "pattern": "spring-boot-starter-data-jpa", "globs": ["pom.xml", "build.gradle", "build.gradle.kts"], "severity_hint": "Info", "description": "JPA present - open-in-view defaults to true unless set false; check application*.yml", "reference": "CWE-1049"},
  {"id": "NPLUS1-EAGER-COLLECTION", "pattern": "@(OneToMany|ManyToMany)\\s*\\([^)]*fetch\\s*=\\s*FetchType\\.EAGER", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "EAGER collection - loaded on every parent query, cartesian risk", "reference": "CWE-400"},
  {"id": "UNBOUNDED-FINDALL", "pattern": "\\.findAll\\s*\\(\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "findAll() with no Pageable - unbounded unless reference table", "reference": "CWE-770"},
  {"id": "UNBOUNDED-QUERY-LIST-NO-PAGEABLE", "pattern": "@Query\\s*\\((?!.*Pageable).*\\)\\s*(public\\s+)?List<", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "@Query returning List without a Pageable parameter", "reference": "CWE-770"},
  {"id": "UNBOUNDED-GETRESULTLIST", "pattern": "^(?!.*setMaxResults).*\\.getResultList\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "getResultList without setMaxResults on the same line - confirm a bound", "reference": "CWE-770"},
  {"id": "UNBOUNDED-CONTROLLER-LIST", "pattern": "public\\s+(ResponseEntity<)?List<\\w+>>?\\s+\\w+\\s*\\((?!.*Pageable)", "globs": ["*Controller.java", "*Resource.java", "*Controller.kt"], "severity_hint": "Medium", "description": "Controller method returns List with no Pageable parameter", "reference": "CWE-770"},
  {"id": "TRACKING-NO-READONLY", "pattern": "@Transactional\\s*(\\(\\s*\\))?\\s*$", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "@Transactional without readOnly - if the method only reads, add readOnly = true", "reference": "CWE-400"},
  {"id": "TRACKING-ENTITY-RETURNED", "pattern": "public\\s+(ResponseEntity<)?(List<)?\\w+(Entity)?>?>?\\s+\\w+\\s*\\(.*\\)\\s*\\{?\\s*$", "globs": ["*Controller.java", "*Resource.java"], "severity_hint": "Info", "description": "Controller returns a type - confirm it is a DTO/projection, not a managed entity", "reference": "CWE-400"},
  {"id": "INDEX-LIKE-LEADING-WILDCARD", "pattern": "like\\s+['\"]?%|Containing\\w*\\(|IgnoreCase\\w*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Leading-wildcard / case-insensitive filter - index unusable; cross-check audit-db-schema", "reference": "CWE-400"},
  {"id": "INDEX-DERIVED-QUERY", "pattern": "(List|Page|Optional|Slice)<\\w+>\\s+findBy\\w+\\s*\\(", "globs": ["*Repository.java", "*Repository.kt"], "severity_hint": "Info", "description": "Derived query - extract filter/sort columns for the index cross-check", "reference": "CWE-400"},
  {"id": "INDEX-DECLARED", "pattern": "@Index\\s*\\(|indexes\\s*=\\s*\\{|CREATE\\s+INDEX", "globs": ["*.java", "*.kt", "*.sql", "*.xml", "*.yaml", "*.yml"], "severity_hint": "Info", "description": "Index declaration - inventory for cross-check", "reference": "CWE-400"},
  {"id": "TXN-MULTI-SAVE", "pattern": "^\\s{8,}\\w*(repo|repository|Repository)\\w*\\.(save|saveAll|delete|deleteById|update)\\s*\\(", "globs": ["*Service.java", "*Service.kt", "*Manager.java"], "severity_hint": "Info", "description": "Repository write in a service - two or more per method need @Transactional", "reference": "CWE-662"},
  {"id": "TXN-PRIVATE-TRANSACTIONAL", "pattern": "@Transactional[\\s\\S]{0,60}(private|protected)\\s+\\w", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "@Transactional on non-public method - proxy bypass, no transaction", "reference": "CWE-662"},
  {"id": "TXN-CONTROLLER-TRANSACTIONAL", "pattern": "@Transactional", "globs": ["*Controller.java", "*Resource.java"], "severity_hint": "Low", "description": "@Transactional on a controller - move to the service layer", "reference": "CWE-662"},
  {"id": "INEFFICIENT-COUNT-VS-EXISTS", "pattern": "\\.count\\s*\\([^)]*\\)\\s*(>\\s*0|>=\\s*1|==\\s*0|!=\\s*0)|\\.findAll\\s*\\(\\)\\.(size|isEmpty)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "count()/findAll().size() compared to zero - use existsBy...", "reference": "CWE-400"},
  {"id": "INEFFICIENT-FILTER-IN-JAVA", "pattern": "\\.findAll\\s*\\([^)]*\\)\\s*\\.stream\\s*\\(\\)\\s*\\.filter", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "findAll then filter in Java - move the predicate to the query", "reference": "CWE-400"},
  {"id": "INEFFICIENT-SAVE-IN-LOOP", "pattern": "^\\s{12,}\\w*(repo|repository|Repository)\\w*\\.save\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "save() at deep indentation - use saveAll with jdbc.batch_size", "reference": "CWE-400"},
  {"id": "UNBOUNDED-REPO-COLLECTION", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "ignore_case": false, "pattern": "(List|Collection|Set|Iterable)<\\w+>\\s+(find|get|list|all)\\w*\\s*\\((?!.*Pageable)", "description": "Repository/service method returns a materialised collection without Pageable (confirm no paging)", "reference": "CWE-770"}
]
