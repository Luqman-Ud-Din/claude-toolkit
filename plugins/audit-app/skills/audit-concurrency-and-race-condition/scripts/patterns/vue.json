[
  {
    "id": "FE-RETRY-ON-MUTATION",
    "pattern": "\\$fetch\\.create\\(\\s*\\{[^}]*retry:\\s*[1-9]|\\$fetch\\([^)]*method:\\s*['\"]POST['\"][^)]*retry:\\s*[1-9]|axiosRetry\\(|retries:\\s*[1-9]",
    "globs": ["*.ts", "*.js", "*.vue"],
    "severity_hint": "Medium",
    "description": "Retry configured for mutations or globally; each retry replays a POST",
    "reference": "CWE-362"
  },
  {
    "id": "FE-MUTATION-IN-WATCHER",
    "pattern": "watch(Effect)?\\([\\s\\S]{0,120}(\\.post\\(|\\$fetch\\([^)]*POST|create\\w*\\(|submit\\w*\\(|pay\\w*\\(|save\\w*\\()",
    "globs": ["*.ts", "*.js", "*.vue"],
    "severity_hint": "Medium",
    "description": "Mutation fired from a watcher; every reactive change re-sends it",
    "reference": "CWE-362"
  },
  {
    "id": "FE-BUTTON-NO-DISABLE",
    "pattern": "<(button|v-btn|el-button)[^>]*@click=\"[^\"]*(pay|checkout|submit|placeOrder|confirm|save)[^\"]*\"(?![^>]*:disabled)",
    "globs": ["*.vue"],
    "severity_hint": "Low",
    "description": "Submit button without :disabled binding; a double click sends two requests",
    "reference": "CWE-362"
  },
  {
    "id": "FE-PARALLEL-MUTATIONS",
    "pattern": "Promise\\.all\\(\\s*\\[[^\\]]*(\\.post\\(|\\$fetch|create|save)",
    "globs": ["*.ts", "*.js", "*.vue"],
    "severity_hint": "Low",
    "description": "Parallel dependent mutations; ordering and partial failure are undefined",
    "reference": "CWE-362"
  },
  {
    "id": "FE-IDEMPOTENCY-KEY",
    "pattern": "Idempotency-Key|idempotencyKey|randomUUID\\(\\)",
    "globs": ["*.ts", "*.js", "*.vue"],
    "severity_hint": "Info",
    "description": "Client-generated idempotency key present; record as client mitigation",
    "reference": "CWE-362"
  },
  {
    "id": "FE-SERVER-MODULE-STATE",
    "pattern": "^\\s*(export\\s+)?(const|let)\\s+\\w*(cache|store|sessions|map|counter|locks|pending)\\w*\\s*(:\\s*[^=]+)?=\\s*(new\\s+Map\\(|\\{\\s*\\}|\\[\\s*\\]|0\\b)|cron\\.schedule\\(|new\\s+CronJob\\(",
    "globs": ["*.ts", "*.js"],
    "severity_hint": "Medium",
    "description": "Module-level mutable state or cron in a Nuxt server route/plugin; shared across requests, started per instance",
    "reference": "CWE-662"
  }
]
