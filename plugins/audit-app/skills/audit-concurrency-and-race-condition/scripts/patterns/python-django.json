[
  {
    "id": "CHECK-THEN-ACT",
    "pattern": "if\\s+not\\s+\\w+(\\.\\w+)*\\.filter\\([^)]*\\)\\.exists\\(\\)|if\\s+\\w+(\\.\\w+)*\\.filter\\([^)]*\\)\\.(exists|count)\\(\\)|if\\s+\\w+\\.(balance|quantity|qty|stock|available|credit)\\w*\\s*(>=|>|<|<=)",
    "globs": ["*.py"],
    "severity_hint": "High",
    "description": "Existence/threshold check; if create()/save() or a decrement follows without select_for_update/F()/constraint, it races",
    "reference": "CWE-367"
  },
  {
    "id": "GET-OR-CREATE",
    "pattern": "\\.(get_or_create|update_or_create)\\(",
    "globs": ["*.py"],
    "severity_hint": "Medium",
    "description": "get_or_create/update_or_create races unless the lookup fields have a unique constraint",
    "reference": "CWE-367"
  },
  {
    "id": "STATUS-GUARD-IN-MEMORY",
    "pattern": "if\\s+\\w+\\.(status|state)\\s*(==|!=)\\s*",
    "globs": ["*.py"],
    "severity_hint": "Medium",
    "description": "Status checked in memory; the later write needs filter(status=...).update(...) with rows checked, or a version field",
    "reference": "CWE-367"
  },
  {
    "id": "MODULE-MUTABLE-STATE",
    "pattern": "^(_?\\w*(cache|CACHE|store|STORE|sessions|SESSIONS|registry|REGISTRY|counter|COUNTER|locks|LOCKS|pending|PENDING)\\w*)\\s*(:\\s*[^=]+)?=\\s*(\\{\\s*\\}|\\[\\s*\\]|set\\(\\)|dict\\(\\)|list\\(\\)|0)\\s*$|^\\s*global\\s+\\w+",
    "globs": ["*.py"],
    "severity_hint": "Medium",
    "description": "Module-level mutable state or global statement; shared by threads in a worker, invisible to other workers",
    "reference": "CWE-662"
  },
  {
    "id": "CLASS-LEVEL-MUTABLE",
    "pattern": "^\\s{4}\\w+\\s*(:\\s*[^=]+)?=\\s*(\\{\\s*\\}|\\[\\s*\\]|set\\(\\)|dict\\(\\)|list\\(\\))\\s*$",
    "globs": ["views.py", "viewsets.py", "services.py", "api.py", "*_service.py", "*_views.py"],
    "severity_hint": "Medium",
    "description": "Mutable class attribute on a view/service; shared across requests handled by the same class",
    "reference": "CWE-662"
  },
  {
    "id": "PAYMENT-NO-KEY",
    "pattern": "def\\s+(post|create|perform_create|charge|pay|refund|capture|debit|credit|transfer|withdraw|deposit|checkout|place_order|redeem)\\w*\\s*\\(|@app\\.post\\(|@router\\.post\\(",
    "globs": ["*payment*", "*pay*", "*checkout*", "*wallet*", "*refund*", "*order*", "*billing*"],
    "severity_hint": "High",
    "description": "Money-moving handler; confirm an Idempotency-Key is stored before the side effect and passed as idempotency_key= to the provider",
    "reference": "CWE-362"
  },
  {
    "id": "IDEMPOTENCY-PRESENT",
    "pattern": "Idempotency-Key|HTTP_IDEMPOTENCY_KEY|idempotency_key|event\\[['\"]id['\"]\\]|event_id",
    "globs": ["*.py"],
    "severity_hint": "Info",
    "description": "Idempotency marker present; record in the inventory",
    "reference": "CWE-362"
  },
  {
    "id": "WEBHOOK-HANDLER",
    "pattern": "@csrf_exempt|construct_event\\(|webhook",
    "globs": ["*.py"],
    "severity_hint": "High",
    "description": "Provider callback handler; confirm event-id dedupe with a unique constraint before processing",
    "reference": "CWE-362"
  },
  {
    "id": "TASK-RETRY-SIDE-EFFECT",
    "pattern": "autoretry_for|self\\.retry\\(|acks_late\\s*=\\s*True|max_retries\\s*=",
    "globs": ["*.py"],
    "severity_hint": "Medium",
    "description": "Task retry / at-least-once delivery; the body must be idempotent by key",
    "reference": "CWE-362"
  },
  {
    "id": "VERSION-DEFINED",
    "pattern": "IntegerVersionField|AutoIncVersionField|version_id_col|version_id_generator",
    "globs": ["*.py"],
    "severity_hint": "Info",
    "description": "Optimistic version present; check RecordModifiedError/StaleDataError handling",
    "reference": "CWE-362"
  },
  {
    "id": "UNIQUE-CONSTRAINT",
    "pattern": "unique\\s*=\\s*True|UniqueConstraint\\(|unique_together|CREATE\\s+UNIQUE|UNIQUE\\s*\\(",
    "globs": ["*.py", "*.sql"],
    "severity_hint": "Info",
    "description": "Unique constraint present; match against each CHECK-THEN-ACT existence check",
    "reference": "CWE-362"
  },
  {
    "id": "LOCK-OR-ATOMIC-PRESENT",
    "pattern": "select_for_update\\(|transaction\\.atomic|F\\(\\s*['\"]\\w+['\"]\\s*\\)\\s*[-+]|with_for_update\\(|threading\\.Lock\\(|cache\\.add\\(",
    "globs": ["*.py"],
    "severity_hint": "Info",
    "description": "Row lock, atomic block, F() update, thread lock or cache.add lock present; record in the inventory",
    "reference": "CWE-362"
  },
  {
    "id": "JOB-NO-LOCK",
    "pattern": "beat_schedule|@periodic_task|CronTrigger\\(|add_job\\(|CRONJOBS\\s*=|class\\s+Command\\(BaseCommand\\)",
    "globs": ["*.py"],
    "severity_hint": "Low",
    "description": "Scheduled task/command; confirm a single scheduler process and a per-task lock, and an idempotent body",
    "reference": "CWE-362"
  }
]
