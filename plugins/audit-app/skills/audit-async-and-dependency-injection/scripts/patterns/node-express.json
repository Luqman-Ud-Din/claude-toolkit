[
  {"id": "BLOCK-SYNC-CALL", "pattern": "\\b(deasync|Atomics\\.wait|execSync|spawnSync|readFileSync|writeFileSync|pbkdf2Sync|scryptSync|hashSync|compareSync|gzipSync)\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "High", "description": "Synchronous/blocking call - stalls the event loop for all requests", "reference": "CWE-400"},
  {"id": "VOID-ASYNC-ROUTE-EXPRESS4", "pattern": "(router|app)\\.(get|post|put|delete|patch|use)\\s*\\([^,]*,\\s*async\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "async Express handler - on Express 4 without a wrapper, rejections hang the request", "reference": "CWE-248"},
  {"id": "VOID-ASYNC-CALLBACK", "pattern": "\\.(on|once|forEach|addListener)\\s*\\([^,]*,\\s*async\\b|setInterval\\s*\\(\\s*async\\b|setTimeout\\s*\\(\\s*async\\b", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "async callback where void expected - rejection unobserved", "reference": "CWE-248"},
  {"id": "VOID-THEN-NO-CATCH", "pattern": "\\.then\\s*\\([^;]*\\)\\s*;\\s*$", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": ".then without .catch on the same statement", "reference": "CWE-390"},
  {"id": "CANCEL-FETCH-NO-SIGNAL", "pattern": "\\b(fetch|axios\\.(get|post|put|delete))\\s*\\([^)]*\\)(?![^;]*signal)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "Outbound call without an AbortSignal", "reference": "CWE-400"},
  {"id": "CANCEL-REQ-CLOSE", "pattern": "req\\.on\\s*\\(\\s*['\"]close['\"]|request\\.signal|req\\.aborted", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Info", "description": "Client-disconnect handling present - inventory", "reference": "CWE-400"},
  {"id": "FIRE-VOID-PROMISE", "pattern": "^\\s*void\\s+(this\\.)?\\w+[\\w.]*\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "void <promise> - fire-and-forget without catch", "reference": "CWE-390"},
  {"id": "FIRE-BARE-ASYNC-CALL", "pattern": "^\\s*(this\\.)?\\w+(Service|Client|Queue|Mailer|Repo)?\\.(send|notify|submit|sync|process|enqueue|add|publish|emit)\\w*\\s*\\([^;]*\\)\\s*;\\s*$", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "Likely-async call not awaited - confirm return type", "reference": "CWE-390"},
  {"id": "FIRE-SETIMMEDIATE-BG", "pattern": "setImmediate\\s*\\(\\s*(async\\s*)?\\(|process\\.nextTick\\s*\\(\\s*(async\\s*)?\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "Background work via setImmediate/nextTick - lost on crash", "reference": "CWE-390"},
  {"id": "HTTP-CLIENT-IN-FUNCTION", "pattern": "^\\s{4,}(const|let|var)\\s+\\w+\\s*=\\s*(axios\\.create|got\\.extend|new\\s+(https?\\.Agent|PrismaClient|Pool|MongoClient|Redis|S3Client))\\s*\\(", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "Client/pool constructed inside a function - per-request instance", "reference": "CWE-772"},
  {"id": "TIMEOUT-AXIOS-CREATE", "pattern": "axios\\.create\\s*\\(\\s*\\{(?![^}]*timeout)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Medium", "description": "axios instance without timeout", "reference": "CWE-1088"},
  {"id": "TIMEOUT-FETCH-NO-TIMEOUT", "pattern": "\\bfetch\\s*\\([^)]*\\)(?![^;]*(AbortSignal\\.timeout|signal))", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "Low", "description": "fetch without timeout signal", "reference": "CWE-1088"},
  {"id": "DI-NEST-REQUEST-SCOPE", "pattern": "scope\\s*:\\s*Scope\\.(REQUEST|TRANSIENT)|@Inject\\s*\\(\\s*REQUEST\\s*\\)", "globs": ["*.ts"], "severity_hint": "Info", "description": "Nest request/transient scope - consumers bubble to that scope (di_lifetimes.py)", "reference": "CWE-362"},
  {"id": "DI-NEST-MODULEREF-GET-SCOPED", "pattern": "moduleRef\\.get\\s*[<(]", "globs": ["*.ts"], "severity_hint": "Low", "description": "ModuleRef.get - fails for request-scoped providers; use resolve() with contextId", "reference": "CWE-1188"},
  {"id": "DI-CONTAINER-SCOPES", "pattern": "inRequestScope\\s*\\(|\\.scoped\\s*\\(\\)|Lifecycle\\.(ContainerScoped|ResolutionScoped)|inSingletonScope\\s*\\(|\\.singleton\\s*\\(\\)", "globs": ["*.ts", "*.js"], "severity_hint": "Info", "description": "inversify/awilix/tsyringe lifetime - cross-check consumers", "reference": "CWE-362"},
  {"id": "DI-MODULE-MUTABLE-STATE", "pattern": "^\\s*(export\\s+)?let\\s+\\w*(current|active|request|user|tenant|session)\\w*\\s*(:\\s*[\\w<>| \\[\\]]+)?\\s*(=|;)", "globs": ["*.ts", "*.js", "*.mjs"], "severity_hint": "High", "description": "Module-level mutable per-request state - shared across concurrent requests", "reference": "CWE-362"},
  {"id": "DI-NEW-SERVICE", "pattern": "new\\s+\\w+(Service|Repository|Manager)\\s*\\(", "globs": ["*.ts", "*.js"], "severity_hint": "Low", "description": "Service constructed by hand - bypasses the container", "reference": "CWE-1188"}
]
