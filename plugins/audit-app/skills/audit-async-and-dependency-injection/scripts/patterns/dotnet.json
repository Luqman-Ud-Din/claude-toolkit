[
  {"id": "BLOCK-RESULT", "pattern": "\\.Result\\b(?!\\s*=)(?!.*Task\\.FromResult)", "globs": ["*.cs"], "severity_hint": "High", "description": "Task.Result - synchronous block on async work", "reference": "CWE-833"},
  {"id": "BLOCK-WAIT", "pattern": "\\.Wait\\s*\\(\\s*\\)|Task\\.WaitAll\\s*\\(|Task\\.WaitAny\\s*\\(|\\.RunSynchronously\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "Task.Wait/WaitAll - synchronous block on async work", "reference": "CWE-833"},
  {"id": "BLOCK-GETAWAITER-GETRESULT", "pattern": "GetAwaiter\\s*\\(\\s*\\)\\s*\\.GetResult\\s*\\(", "globs": ["*.cs"], "severity_hint": "High", "description": "GetAwaiter().GetResult() - synchronous block on async work", "reference": "CWE-833"},
  {"id": "BLOCK-SLEEP", "pattern": "Thread\\.Sleep\\s*\\(|SemaphoreSlim\\b[^;]*\\.Wait\\s*\\((?!Async)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Thread.Sleep / SemaphoreSlim.Wait on a possibly-async path", "reference": "CWE-400"},
  {"id": "VOID-ASYNC-VOID", "pattern": "\\basync\\s+void\\s+\\w+\\s*\\((?!\\s*object\\s+\\w+\\s*,\\s*\\w*EventArgs)", "globs": ["*.cs"], "severity_hint": "High", "description": "async void method (not an event handler) - exceptions cannot be observed", "reference": "CWE-248"},
  {"id": "VOID-ASYNC-LAMBDA-FOREACH", "pattern": "\\.ForEach\\s*\\(\\s*async\\b", "globs": ["*.cs"], "severity_hint": "Medium", "description": "async lambda passed to List.ForEach - becomes async void", "reference": "CWE-248"},
  {"id": "CANCEL-ACTION-NO-TOKEN", "pattern": "public\\s+async\\s+Task<?\\w*(IActionResult|ActionResult)?>?\\s+\\w+\\s*\\((?![^)]*CancellationToken)[^)]*\\)", "globs": ["*Controller.cs"], "severity_hint": "Low", "description": "Async controller action without a CancellationToken parameter", "reference": "CWE-400"},
  {"id": "CANCEL-NONE-PASSED", "pattern": "CancellationToken\\.None|,\\s*default\\s*\\)\\s*;", "globs": ["*.cs"], "severity_hint": "Low", "description": "CancellationToken.None / default passed explicitly - cancellation broken here", "reference": "CWE-400"},
  {"id": "CANCEL-DELAY-NO-TOKEN", "pattern": "Task\\.Delay\\s*\\([^,)]*\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Task.Delay without a token - background loop cannot stop", "reference": "CWE-400"},
  {"id": "CANCEL-EF-CALL-NO-TOKEN", "pattern": "\\.(ToListAsync|FirstOrDefaultAsync|SingleOrDefaultAsync|SaveChangesAsync|AnyAsync|CountAsync|ExecuteUpdateAsync)\\s*\\(\\s*\\)", "globs": ["*.cs"], "severity_hint": "Low", "description": "EF async call without cancellation token", "reference": "CWE-400"},
  {"id": "FIRE-DISCARDED-TASK", "pattern": "^\\s*_\\s*=\\s*\\w+[\\w.]*Async\\s*\\(|^\\s*\\w+[\\w.]*Async\\s*\\([^;]*\\)\\s*;\\s*$", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Async call result discarded (CS4014) - exceptions lost", "reference": "CWE-390"},
  {"id": "FIRE-TASK-RUN", "pattern": "^\\s*(_\\s*=\\s*)?Task\\.(Run|Factory\\.StartNew)\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Task.Run not awaited/tracked - fire-and-forget", "reference": "CWE-390"},
  {"id": "HTTP-NEW-HTTPCLIENT", "pattern": "new\\s+HttpClient\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "HttpClient constructed - use IHttpClientFactory", "reference": "CWE-772"},
  {"id": "HTTP-LEGACY-CLIENT", "pattern": "new\\s+WebClient\\s*\\(|WebRequest\\.Create\\s*\\(|new\\s+RestClient\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Legacy/sync HTTP client or RestClient per call", "reference": "CWE-772"},
  {"id": "TIMEOUT-ADDHTTPCLIENT", "pattern": "AddHttpClient\\s*[<(]", "globs": ["*.cs"], "severity_hint": "Info", "description": "AddHttpClient registration - confirm Timeout and resilience handler in its configure lambda", "reference": "CWE-1088"},
  {"id": "TIMEOUT-INFINITE", "pattern": "Timeout\\.InfiniteTimeSpan|CommandTimeout\\s*=\\s*0|CommandTimeout\\s*\\(\\s*0\\s*\\)", "globs": ["*.cs"], "severity_hint": "Medium", "description": "Infinite timeout configured", "reference": "CWE-1088"},
  {"id": "DI-SINGLETON-REG", "pattern": "\\.AddSingleton\\s*[<(]|\\.AddHostedService\\s*<", "globs": ["*.cs"], "severity_hint": "Info", "description": "Singleton registration - cross-check its constructor with di_lifetimes.py", "reference": "CWE-362"},
  {"id": "DI-BUILD-PROVIDER", "pattern": "\\.BuildServiceProvider\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "BuildServiceProvider inside registration - second container, duplicated singletons", "reference": "CWE-1188"},
  {"id": "DI-SERVICE-LOCATOR", "pattern": "_?serviceProvider\\.GetService\\s*[<(]|GetRequiredService\\s*<(?![^;]*CreateScope)", "globs": ["*Service.cs", "*Manager.cs", "*Controller.cs"], "severity_hint": "Low", "description": "Service-locator resolution in a service - hides lifetimes; check it is inside a scope", "reference": "CWE-1188"},
  {"id": "DI-STATIC-SERVICE", "pattern": "\\bstatic\\s+\\w*(DbContext|Context|Manager|Service|Repository)\\s+_?\\w+\\s*[;=]", "globs": ["*.cs"], "severity_hint": "High", "description": "Static field holding a service/DbContext - process-wide captive instance", "reference": "CWE-362"},
  {"id": "DI-MANUAL-NEW-CONTEXT", "pattern": "new\\s+\\w*DbContext\\s*\\(", "globs": ["*.cs"], "severity_hint": "Medium", "description": "DbContext constructed by hand - bypasses DI lifetime", "reference": "CWE-362"}
]
