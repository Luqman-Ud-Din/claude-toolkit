[
  {"id": "BLOCK-SYNC-IN-ASYNC-HINT", "pattern": "^\\s*async\\s+def\\s+", "globs": ["*.py"], "severity_hint": "Info", "description": "async def - inspect body for requests./time.sleep/sync ORM (blocks the loop)", "reference": "CWE-400"},
  {"id": "BLOCK-ASYNCIO-RUN-IN-VIEW", "pattern": "asyncio\\.run\\s*\\(|run_until_complete\\s*\\(|async_to_sync\\s*\\(", "globs": ["views.py", "*view*.py", "api*.py", "*service*.py"], "severity_hint": "Medium", "description": "Event loop driven synchronously from request code", "reference": "CWE-833"},
  {"id": "BLOCK-SLEEP", "pattern": "^\\s+time\\.sleep\\s*\\(", "globs": ["views.py", "*view*.py", "api*.py", "*service*.py"], "severity_hint": "Medium", "description": "time.sleep on a request path", "reference": "CWE-400"},
  {"id": "BLOCK-ASYNC-UNSAFE-ENV", "pattern": "DJANGO_ALLOW_ASYNC_UNSAFE", "globs": ["*.py", "*.env*", "*.yml", "*.yaml", "Dockerfile"], "severity_hint": "High", "description": "DJANGO_ALLOW_ASYNC_UNSAFE set - hides SynchronousOnlyOperation, ORM calls block the loop", "reference": "CWE-400"},
  {"id": "VOID-CREATE-TASK-DISCARDED", "pattern": "^\\s*asyncio\\.create_task\\s*\\(|^\\s*loop\\.create_task\\s*\\(|ensure_future\\s*\\((?![^)]*\\))", "globs": ["*.py"], "severity_hint": "Medium", "description": "Task created and reference dropped - may be GC'd, exception never retrieved", "reference": "CWE-248"},
  {"id": "VOID-EXCEPT-PASS", "pattern": "except(\\s+\\w+(\\s+as\\s+\\w+)?)?\\s*:\\s*(pass|\\.\\.\\.)\\s*$", "globs": ["tasks.py", "*task*.py", "*worker*.py", "*job*.py"], "severity_hint": "High", "description": "Exception swallowed in background task", "reference": "CWE-390"},
  {"id": "CANCEL-NO-WAIT-FOR", "pattern": "await\\s+\\w+\\.(get|post|put|request|fetch|read)\\s*\\((?![^)]*timeout)", "globs": ["*.py"], "severity_hint": "Low", "description": "Awaited I/O without timeout/wait_for", "reference": "CWE-400"},
  {"id": "CANCEL-CANCELLED-SWALLOWED", "pattern": "except\\s+(BaseException|asyncio\\.CancelledError|CancelledError)\\s*:", "globs": ["*.py"], "severity_hint": "Medium", "description": "CancelledError caught - confirm it is re-raised", "reference": "CWE-400"},
  {"id": "FIRE-THREAD-START", "pattern": "threading\\.Thread\\s*\\([^)]*\\)\\s*\\.start\\s*\\(|Thread\\s*\\(\\s*target\\s*=", "globs": ["*.py"], "severity_hint": "Medium", "description": "Raw thread as background work - lost on restart, unobserved", "reference": "CWE-390"},
  {"id": "FIRE-EXECUTOR-SUBMIT-DISCARDED", "pattern": "^\\s*\\w*executor\\w*\\.submit\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "executor.submit result discarded - exception lost in the Future", "reference": "CWE-390"},
  {"id": "FIRE-DELAY-IN-ATOMIC", "pattern": "\\.delay\\s*\\(|\\.apply_async\\s*\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "Celery enqueue - if inside transaction.atomic(), use transaction.on_commit", "reference": "CWE-390"},
  {"id": "FIRE-BACKGROUNDTASKS", "pattern": "BackgroundTasks\\b|background_tasks\\.add_task\\s*\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "FastAPI BackgroundTasks - in-process, lost on restart; not for critical work", "reference": "CWE-390"},
  {"id": "HTTP-REQUESTS-NO-SESSION", "pattern": "^\\s+requests\\.(get|post|put|patch|delete)\\s*\\(", "globs": ["*.py"], "severity_hint": "Low", "description": "requests.* without a shared Session", "reference": "CWE-772"},
  {"id": "HTTP-CLIENT-PER-CALL", "pattern": "^\\s{4,}(with\\s+)?\\w*\\s*=?\\s*(requests\\.Session|httpx\\.(Async)?Client|aiohttp\\.ClientSession|boto3\\.client)\\s*\\(", "globs": ["*.py"], "severity_hint": "Medium", "description": "HTTP client/session constructed inside a function - per call", "reference": "CWE-772"},
  {"id": "TIMEOUT-REQUESTS", "pattern": "requests\\.(get|post|put|patch|delete|request)\\s*\\((?![^)]*timeout)", "globs": ["*.py"], "severity_hint": "High", "description": "requests call without timeout= - blocks forever", "reference": "CWE-1088"},
  {"id": "TIMEOUT-URLOPEN", "pattern": "urlopen\\s*\\((?![^)]*timeout)", "globs": ["*.py"], "severity_hint": "Medium", "description": "urlopen without timeout", "reference": "CWE-1088"},
  {"id": "TIMEOUT-CELERY-LIMITS", "pattern": "time_limit|soft_time_limit", "globs": ["*.py"], "severity_hint": "Info", "description": "Celery time limits present - inventory", "reference": "CWE-1088"},
  {"id": "DI-MODULE-GLOBAL-PER-REQUEST", "pattern": "^\\s{4,}global\\s+\\w+", "globs": ["*.py"], "severity_hint": "High", "description": "Function writes a module global - per-request state shared across requests in the worker", "reference": "CWE-362"},
  {"id": "DI-CLASS-ATTR-STATE", "pattern": "^\\s{4,}(self\\.__class__|cls|[A-Z]\\w+)\\.\\w*(user|tenant|request|current)\\w*\\s*=", "globs": ["*.py"], "severity_hint": "High", "description": "Class attribute used as per-request storage", "reference": "CWE-362"},
  {"id": "DI-LRU-ON-REQUEST-ARGS", "pattern": "@(functools\\.)?lru_cache[\\s\\S]{0,60}def\\s+get_\\w*(user|tenant|db|session)", "globs": ["*.py"], "severity_hint": "Medium", "description": "lru_cache on a request-varying dependency - cached forever per args", "reference": "CWE-362"},
  {"id": "DI-APP-STATE-SESSION", "pattern": "app\\.state\\.\\w*(db|session|conn)\\w*\\s*=", "globs": ["*.py"], "severity_hint": "High", "description": "DB session on app.state - one session shared by all requests", "reference": "CWE-362"},
  {"id": "DI-THREADLOCAL-SET", "pattern": "threading\\.local\\s*\\(|ContextVar\\s*\\(", "globs": ["*.py"], "severity_hint": "Info", "description": "Thread/context local - confirm reset in finally", "reference": "CWE-362"}
]
