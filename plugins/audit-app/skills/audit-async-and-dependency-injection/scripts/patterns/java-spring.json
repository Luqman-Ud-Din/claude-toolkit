[
  {"id": "BLOCK-REACTIVE", "pattern": "\\.block\\s*\\(|\\.blockFirst\\s*\\(|\\.blockLast\\s*\\(|\\.toFuture\\s*\\(\\)\\.get\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Blocking a Mono/Flux - fatal on WebFlux, starvation on MVC", "reference": "CWE-833"},
  {"id": "BLOCK-FUTURE-GET", "pattern": "\\.get\\s*\\(\\s*\\)\\s*;|\\.join\\s*\\(\\s*\\)\\s*;|\\.await\\s*\\(\\s*\\)\\s*;", "globs": ["*Service.java", "*Controller.java", "*Resource.java", "*.kt"], "severity_hint": "Medium", "description": "Future.get/join/latch.await on a request path", "reference": "CWE-833"},
  {"id": "BLOCK-SLEEP", "pattern": "Thread\\.sleep\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Thread.sleep", "reference": "CWE-400"},
  {"id": "BLOCK-SYNCHRONIZED", "pattern": "public\\s+synchronized\\s+", "globs": ["*Service.java", "*Controller.java"], "severity_hint": "Medium", "description": "synchronized service method - serialises requests", "reference": "CWE-400"},
  {"id": "VOID-ASYNC-VOID", "pattern": "@Async\\b[^\\n]*\\n?\\s*public\\s+void\\s+|@Async\\s*(\\([^)]*\\))?\\s*$", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "@Async - if void, exceptions go to AsyncUncaughtExceptionHandler (usually only logs)", "reference": "CWE-248"},
  {"id": "VOID-SUBSCRIBE-NO-ERROR", "pattern": "\\.subscribe\\s*\\(\\s*\\)|\\.subscribe\\s*\\(\\s*\\w+\\s*->\\s*[^,)]*\\)\\s*;", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "subscribe without an error consumer", "reference": "CWE-390"},
  {"id": "CANCEL-NO-QUERY-TIMEOUT", "pattern": "@Transactional\\s*\\((?![^)]*timeout)", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "@Transactional without timeout - long transactions hold connections", "reference": "CWE-400"},
  {"id": "CANCEL-DEFERRED-NO-TIMEOUT", "pattern": "new\\s+DeferredResult\\s*<[^>]*>\\s*\\(\\s*\\)", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "DeferredResult without timeout", "reference": "CWE-400"},
  {"id": "FIRE-RUNASYNC-DISCARDED", "pattern": "^\\s*CompletableFuture\\.(runAsync|supplyAsync)\\s*\\(|^\\s*\\w*[eE]xecutor\\w*\\.(submit|execute)\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Async work submitted and result discarded - exceptions swallowed in the Future", "reference": "CWE-390"},
  {"id": "FIRE-NEW-THREAD", "pattern": "new\\s+Thread\\s*\\([^)]*\\)\\s*\\.start\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "Raw thread started - unbounded, unobserved", "reference": "CWE-390"},
  {"id": "HTTP-CLIENT-PER-CALL", "pattern": "new\\s+RestTemplate\\s*\\(|WebClient\\.create\\s*\\(|HttpClients\\.createDefault\\s*\\(|new\\s+OkHttpClient\\s*\\(|Feign\\.builder\\s*\\(", "globs": ["*.java", "*.kt"], "severity_hint": "Medium", "description": "HTTP client constructed - must be a single bean, with timeouts", "reference": "CWE-772"},
  {"id": "TIMEOUT-RESTTEMPLATE-BUILDER", "pattern": "RestTemplateBuilder\\b(?![^;]*(setConnectTimeout|connectTimeout))", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "RestTemplateBuilder without timeouts on the same statement", "reference": "CWE-1088"},
  {"id": "TIMEOUT-FEIGN-CONFIG", "pattern": "feign\\.client\\.config|readTimeout|connectTimeout|responseTimeout", "globs": ["application*.yml", "application*.properties", "*.java", "*.kt"], "severity_hint": "Info", "description": "Timeout configuration present - inventory", "reference": "CWE-1088"},
  {"id": "DI-REQUEST-SCOPE", "pattern": "@RequestScope|@SessionScope|@Scope\\s*\\(\\s*(value\\s*=\\s*)?\"(request|session|prototype)\"", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Non-singleton scope - check consumers use proxyMode/ObjectProvider (di_lifetimes.py)", "reference": "CWE-362"},
  {"id": "DI-FIELD-INJECTION", "pattern": "@Autowired\\s*(\\([^)]*\\))?\\s*$|@Autowired\\s+private\\s+", "globs": ["*.java", "*.kt"], "severity_hint": "Low", "description": "Field injection - hides dependencies and lifetimes", "reference": "CWE-1188"},
  {"id": "DI-PROXY-BYPASS", "pattern": "@(Transactional|Async|Cacheable)[^\\n]*\\n?\\s*(private|protected|final)\\s+", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Proxy-based annotation on non-public/final method - silently ignored", "reference": "CWE-1188"},
  {"id": "DI-SELF-INVOCATION", "pattern": "this\\.\\w+\\s*\\([^)]*\\)\\s*;\\s*//.*(transactional|async|cache)", "globs": ["*.java", "*.kt"], "severity_hint": "Info", "description": "Self-invocation noted - proxied annotations do not apply", "reference": "CWE-1188"},
  {"id": "DI-GETBEAN", "pattern": "applicationContext\\.getBean\\s*\\(|context\\.getBean\\s*\\(", "globs": ["*Service.java", "*Controller.java", "*.kt"], "severity_hint": "Low", "description": "Service locator in a service", "reference": "CWE-1188"},
  {"id": "DI-STATIC-BEAN", "pattern": "\\bstatic\\s+\\w*(Service|Repository|Client|Template)\\s+\\w+\\s*[;=]", "globs": ["*.java", "*.kt"], "severity_hint": "High", "description": "Static field holding a bean", "reference": "CWE-362"},
  {"id": "DI-MUTABLE-SINGLETON-FIELD", "pattern": "^\\s+private\\s+(?!final)(?!static)(String|Long|Integer|int|long|boolean|Boolean|\\w*Context|\\w*User|\\w*Tenant)\\s+\\w+\\s*;", "globs": ["*Service.java", "*Component.java"], "severity_hint": "Medium", "description": "Mutable non-final field in a singleton service - per-request state shared across requests", "reference": "CWE-362"}
]
