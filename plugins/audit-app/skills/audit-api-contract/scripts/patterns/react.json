[
  {
    "id": "FE-ERROR-SHAPES",
    "pattern": "(response\\.data|error\\.data|err\\.data|body)\\??\\.(message|error|detail|errors|title|msg)\\b",
    "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"],
    "severity_hint": "Info",
    "description": "Client parses a server error field; each distinct field name is a distinct server error shape",
    "reference": "ASVS-13.2"
  },
  {
    "id": "FE-SENSITIVE-MODEL-FIELD",
    "pattern": "\\b(passwordHash|salt|securityStamp|refreshToken|apiKey|isDeleted|costPrice)\\s*[?:]",
    "globs": ["*.ts", "*.tsx", "*.d.ts"],
    "severity_hint": "Medium",
    "description": "Client type declares a field the server should not expose; evidence for the backend over-exposure finding",
    "reference": "CWE-200"
  },
  {
    "id": "FE-CLIENT-SIDE-PAGING",
    "pattern": "\\.slice\\(\\s*(page|pageIndex|start)\\w*\\s*\\*|\\.slice\\(\\s*\\w+\\s*\\*\\s*\\w*(size|pageSize)",
    "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"],
    "severity_hint": "Medium",
    "description": "Array sliced client-side for paging; the list endpoint probably returns everything",
    "reference": "CWE-770"
  },
  {
    "id": "SERVER-ENTITY-RETURNED",
    "pattern": "NextResponse\\.json\\(\\s*(await\\s+)?\\w+\\.\\w+\\.(findMany|findFirst|findUnique|find)\\(|return\\s+(await\\s+)?prisma\\.\\w+\\.(findMany|findFirst|findUnique)\\(",
    "globs": ["route.ts", "route.js", "*.action.ts"],
    "severity_hint": "High",
    "description": "Next.js route handler / server action returns an ORM result directly; check for secret fields and select/omit",
    "reference": "CWE-200"
  },
  {
    "id": "SERVER-ADHOC-ERROR",
    "pattern": "NextResponse\\.json\\(\\s*\\{\\s*(error|message|msg|success)\\b|res\\.status\\(\\s*[45]\\d\\d\\s*\\)\\.json\\(\\s*\\{\\s*(error|message|msg)\\b",
    "globs": ["route.ts", "route.js", "*.ts", "*.js"],
    "severity_hint": "Low",
    "description": "Ad-hoc error body in a Next.js API route; collect shapes across routes",
    "reference": "CWE-209"
  },
  {
    "id": "SERVER-UNVALIDATED-BODY",
    "pattern": "await\\s+req(uest)?\\.json\\(\\)(?![^\\n]*(parse|safeParse|validate))|formData\\.get\\(",
    "globs": ["route.ts", "route.js", "*.action.ts"],
    "severity_hint": "Medium",
    "description": "Body read without a schema parse on the same line; confirm validation follows",
    "reference": "CWE-20"
  },
  {
    "id": "FE-UNVERSIONED-URL",
    "pattern": "['\"`]/?api/(?!v\\d)\\w+",
    "globs": ["*.ts", "*.tsx", "*.js", "*.jsx"],
    "severity_hint": "Info",
    "description": "Unversioned API path; compare with versioned calls elsewhere",
    "reference": "ASVS-13.1"
  }
]
